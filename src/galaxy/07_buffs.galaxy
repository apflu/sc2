//--------------------------------------------------------------------------------------------------
// Conditional buffs.
//
// The one primitive behind every effect that has to be able to stop.
//
// SC2 upgrades do not unwind. The level counter can be decremented -- Blizzard
// does it for flag-only upgrades -- but the EffectArray data modifications an
// upgrade applies are not reverted by taking the level away, and nothing in the
// stock data relies on them being. So an upgrade is the right home for a
// permanent fact and the wrong home for anything conditional.
//
// That splits department effects in two, and the split is a placement decision
// rather than a label on the upgrade:
//
//   Never turns off  -> EffectArray on the CUpgrade. No script at all.
//   Can turn off     -> a CBehaviorBuff, applied and removed through here.
//
// Baseline 7.3 needs the second kind: while a player's inner layer is lost the
// effects that run on installations stop, and the pure numbers keep working.
// Anything that has to obey that rule is a behavior, and the upgrade beside it
// is only the record that it was bought.
//
// Applying and removing rather than leaving it on also means the buff icon on
// the unit is an honest readout of what is actually helping right now.
//--------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
// Brings one unit's buff into line with whether it should have it.
//--------------------------------------------------------------------------------------------------
void Buffs_Set (unit who, string behaviorId, bool wanted) {
    bool held;

    if (who == null || !UnitIsAlive(who)) {
        return;
    }

    held = UnitHasBehavior2(who, behaviorId);
    if (wanted && !held) {
        UnitBehaviorAdd(who, behaviorId, who, 1);
    }
    else if (!wanted && held) {
        UnitBehaviorRemove(who, behaviorId, 1);
    }
}

//--------------------------------------------------------------------------------------------------
// The same for a whole group, where every member gets the same answer.
//--------------------------------------------------------------------------------------------------
void Buffs_SetGroup (unitgroup who, string behaviorId, bool wanted) {
    int count;
    int i;

    count = UnitGroupCount(who, c_unitCountAlive);
    i = 1;
    while (i <= count) {
        Buffs_Set(UnitGroupUnit(who, i), behaviorId, wanted);
        i = i + 1;
    }
}
