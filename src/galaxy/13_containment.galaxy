//--------------------------------------------------------------------------------------------------
// Containment cells, and what gets out of them.
//
// The other half of the verb. 11_employee.galaxy owns the person you send; this
// owns the thing you send them to.
//
// Three unit types per abnormality, sharing a variant segment:
//
//     Lob_Cont_<X>       the cell, working
//     Lob_ContDown_<X>   the cell, breached or wrecked
//     Lob_Abno_<X>       the abnormality itself, loose
//
// The first two are an ordinary downable pair (08_downable), which is not a
// convenience -- it is the whole of design section 5. A breach must never cost
// a player their slot, because in a five-player game that is one person
// spectating for forty minutes, and it picks the newest player. Reusing
// "disabled -> repair -> online" makes recovery structural rather than a
// balance number: the cost of a breach is employees, time, and the defensive
// pressure on everybody, and none of those are permanent.
//
// Tool abnormalities are a separate family, Lob_Tool_<X> / Lob_ToolDown_<X>,
// rather than a variant of Cont. That follows the contract's rule that a plain
// scan should answer the common question without filtering, and the common
// question here excludes tools: meltdown does not count them, Control Team's
// cross-department clauses treat them separately, and Training Team's practice
// rabbit is one. Asking for "cells including tools" is two scans and says so.
//
// What this module does NOT decide, because it is not decided:
//
//   How a loose abnormality behaves. Some walk to the rest hall, some never
//   move at all. That is per-abnormality authoring, so nothing here issues them
//   an order; a blanket attack-move would be inventing content.
//
//   What suppression pays out. Design 5.1 says it pays; the amount is open. A
//   system that wants to count suppressions registers its own death trigger,
//   the way 25_clearing does for debris.
//
//   Qliphoth counters and meltdown. Separate module, and it needs cells to
//   exist first, which is why this one is before it.
//--------------------------------------------------------------------------------------------------

const string c_contUpPrefix = "Lob_Cont_";
const string c_contDownPrefix = "Lob_ContDown_";
const string c_abnoPrefix = "Lob_Abno_";

const string c_toolUpPrefix = "Lob_Tool_";
const string c_toolDownPrefix = "Lob_ToolDown_";

const fixed c_contPeriod = 1.0;

trigger gt_contFatal;
trigger gt_contTick;

//--------------------------------------------------------------------------------------------------
// The variant segment of a cell, a downed cell or an abnormality: the name the
// three share. Empty for anything that is none of them.
//--------------------------------------------------------------------------------------------------
string Cont_VariantOfType (string unitType) {
    if (StringSub(unitType, 1, StringLength(c_contDownPrefix)) == c_contDownPrefix) {
        return StringSub(unitType, StringLength(c_contDownPrefix) + 1, StringLength(unitType));
    }
    if (StringSub(unitType, 1, StringLength(c_toolDownPrefix)) == c_toolDownPrefix) {
        return StringSub(unitType, StringLength(c_toolDownPrefix) + 1, StringLength(unitType));
    }
    if (StringSub(unitType, 1, StringLength(c_contUpPrefix)) == c_contUpPrefix) {
        return StringSub(unitType, StringLength(c_contUpPrefix) + 1, StringLength(unitType));
    }
    if (StringSub(unitType, 1, StringLength(c_toolUpPrefix)) == c_toolUpPrefix) {
        return StringSub(unitType, StringLength(c_toolUpPrefix) + 1, StringLength(unitType));
    }
    if (StringSub(unitType, 1, StringLength(c_abnoPrefix)) == c_abnoPrefix) {
        return StringSub(unitType, StringLength(c_abnoPrefix) + 1, StringLength(unitType));
    }
    return "";
}

string Cont_Variant (unit which) {
    if (which == null) {
        return "";
    }
    return Cont_VariantOfType(UnitGetType(which));
}

bool Cont_IsTool (unit which) {
    return ObjectsGen_IsTool(which) || ObjectsGen_IsToolDown(which);
}

//--------------------------------------------------------------------------------------------------
// Every containment cell a player holds, working or not, tools included.
//
// Ownership is the unit's owner rather than which sector it stands in. A cell
// belongs to whoever is answerable for it, and that has to survive the cell
// being placed a little outside the region somebody drew.
//--------------------------------------------------------------------------------------------------
unitgroup Cont_AllOf (int player) {
    unitgroup all;
    unitgroup mine;
    unit cell;
    int count;
    int i;

    all = ObjectsGen_ScanCont();
    UnitGroupAddUnitGroup(all, ObjectsGen_ScanContDown());
    UnitGroupAddUnitGroup(all, ObjectsGen_ScanTool());
    UnitGroupAddUnitGroup(all, ObjectsGen_ScanToolDown());

    mine = UnitGroupEmpty();
    count = UnitGroupCount(all, c_unitCountAlive);
    i = 1;
    while (i <= count) {
        cell = UnitGroupUnit(all, i);
        if (cell != null && UnitGetOwner(cell) == player) {
            UnitGroupAdd(mine, cell);
        }
        i = i + 1;
    }
    return mine;
}

//--------------------------------------------------------------------------------------------------
// Cells that are working. Control Team's passive scales on exactly this count
// and says tools do not count towards it, which is what the family split buys.
//--------------------------------------------------------------------------------------------------
int Cont_OnlineCount (int player) {
    unitgroup online;
    unit cell;
    int total;
    int count;
    int i;

    online = ObjectsGen_ScanCont();
    total = 0;
    count = UnitGroupCount(online, c_unitCountAlive);

    i = 1;
    while (i <= count) {
        cell = UnitGroupUnit(online, i);
        if (cell != null && UnitGetOwner(cell) == player) {
            total = total + 1;
        }
        i = i + 1;
    }
    return total;
}

//--------------------------------------------------------------------------------------------------
// Whether this abnormality is currently loose.
//
// Asked of the world, like everything else: a variant is out if a Lob_Abno_ of
// that name is alive. There is no flag to fall out of step with the unit that
// is actually standing there.
//--------------------------------------------------------------------------------------------------
bool Cont_VariantIsLoose (string variant) {
    unitgroup loose;
    unit which;
    int count;
    int i;

    loose = ObjectsGen_ScanAbno();
    count = UnitGroupCount(loose, c_unitCountAlive);

    i = 1;
    while (i <= count) {
        which = UnitGroupUnit(loose, i);
        if (which != null && Cont_Variant(which) == variant) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

//--------------------------------------------------------------------------------------------------
// Lets one out.
//
// The cell goes down the way a device does, and the abnormality appears where
// the cell is, owned by the abnormality player. That player is hostile to the
// zerg as well as to everybody else, which is an alliance setting rather than
// anything script can arrange -- design 5.1 turns on it, because releasing an
// easy one to meet a wave is meant to be a real tactic rather than an accident.
//
// Nothing is ordered. See the header.
//--------------------------------------------------------------------------------------------------
void Cont_Breach (unit cell) {
    string variant;
    string upPrefix;
    string downPrefix;
    point where;

    if (cell == null) {
        return;
    }

    variant = Cont_Variant(cell);
    if (variant == "") {
        return;
    }
    if (Cont_VariantIsLoose(variant)) {
        return;
    }

    if (Cont_IsTool(cell)) {
        upPrefix = c_toolUpPrefix;
        downPrefix = c_toolDownPrefix;
    }
    else {
        upPrefix = c_contUpPrefix;
        downPrefix = c_contDownPrefix;
    }

    where = UnitGetPosition(cell);
    Downable_TakeDown(cell, upPrefix, downPrefix);

    // A variant with no Lob_Abno_ authored simply stays contained-but-broken.
    // That is the right failure for a tool, and it keeps a half-authored
    // abnormality from taking the map down.
    if (c_typesAbnoCount > 0) {
        UnitCreate(1, c_abnoPrefix + variant, c_unitCreateIgnorePlacement,
                   c_abnoPlayer, where, 270.0);
    }

    UIDisplayMessage(
        PlayerGroupAll(),
        c_messageAreaSubtitle,
        StringToText(Risk_Name(Risk_OfType(c_contUpPrefix + variant))
                     + " containment breach -- " + variant)
    );
}

//--------------------------------------------------------------------------------------------------
// A cell that takes a killing blow lets its occupant out.
//
// Which is a decision, not a mechanism: the alternative is a wrecked cell that
// somehow still holds. Reading it this way is what makes a neighbour losing
// their outer layer cost the table something, without touching anybody's own
// numbers -- the pressure travels, the punishment does not. One handler, so it
// is one line to change if that turns out to play badly.
//--------------------------------------------------------------------------------------------------
bool Cont_Fatal_Func (bool testConds, bool runActions) {
    unit victim;

    if (!runActions) {
        return true;
    }

    victim = EventUnit();
    if (!ObjectsGen_IsCont(victim) && !ObjectsGen_IsTool(victim)) {
        return true;
    }

    Cont_Breach(victim);
    return true;
}

//--------------------------------------------------------------------------------------------------
// Puts repaired cells back online.
//
// Not Downable_RestoreRepaired, and the difference is the point: a cell whose
// occupant is still loose must not come back, or repairing the room would put
// the abnormality in two places at once. Suppression first, repair second, and
// the order is enforced here rather than asked of the player.
//--------------------------------------------------------------------------------------------------
void Cont_RestoreRepaired (unitgroup down, string downPrefix, string upPrefix) {
    unit cell;
    int count;
    int i;

    count = UnitGroupCount(down, c_unitCountAlive);

    // Counting down: a morph removes the unit, and a unit group drops units
    // that stop existing, so walking forwards would skip every second cell that
    // finished repairing on the same tick.
    i = count;
    while (i >= 1) {
        cell = UnitGroupUnit(down, i);
        if (cell != null
            && UnitGetPropertyFixed(cell, c_unitPropLifePercent, true) >= 99.0
            && !Cont_VariantIsLoose(Cont_Variant(cell))) {
            Downable_Morph(cell,
                           Downable_Retype(UnitGetType(cell), downPrefix, upPrefix),
                           UnitGetPropertyFixed(cell, c_unitPropLifeMax, true));
        }
        i = i - 1;
    }
}

bool Cont_Tick_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }

    Cont_RestoreRepaired(ObjectsGen_ScanContDown(), c_contDownPrefix, c_contUpPrefix);
    Cont_RestoreRepaired(ObjectsGen_ScanToolDown(), c_toolDownPrefix, c_toolUpPrefix);
    return true;
}

void Containment_Init () {
    gt_contFatal = TriggerCreate("Cont_Fatal_Func");
    TriggerAddEventUnitDamaged(gt_contFatal, null, c_unitDamageTypeAny, c_unitDamageFatal, null);

    gt_contTick = TriggerCreate("Cont_Tick_Func");
    TriggerAddEventTimePeriodic(gt_contTick, c_contPeriod, c_timeGame);
}
