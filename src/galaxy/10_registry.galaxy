//--------------------------------------------------------------------------------------------------
// Object registry.
//
// The bridge between the editor side and the code side. Editor-placed objects
// are classified by WHICH PLAYER OWNS THEM, not by unit id and not by unit
// type, so the code never has to track editor ids and you are free to use
// whatever unit you like as a stand-in while greyboxing.
//
// See docs/dev/authoring-contract.md for the player slot table.
//--------------------------------------------------------------------------------------------------

// Marker player slots. Human players are 1..6.
const int c_playerZerg    = 7;   // hostile; spawned at runtime, nothing preplaced
const int c_playerDebris  = 8;   // one unit per clearable debris pile
const int c_playerDevice  = 9;   // one unit per resource device
const int c_playerSpawn   = 10;  // pure markers: zerg entry points, removed after init

// Array length must be a literal here -- Galaxy is picky about constants in
// array declarations, so c_maxSpawnPoints only guards the loop. Keep in sync.
const int c_maxSpawnPoints = 16;

unitgroup gv_debris;
unitgroup gv_devices;
point[16] gv_spawnPoints;
int gv_spawnCount;

//--------------------------------------------------------------------------------------------------
// Reads the spawn markers' positions and removes the marker units themselves --
// they exist only to carry a position from the editor into the script.
//--------------------------------------------------------------------------------------------------
void Registry_ConsumeSpawnMarkers () {
    unitgroup markers;
    unit marker;
    int count;
    int i;

    markers = UnitGroup(null, c_playerSpawn, RegionEntireMap(), null, 0);
    count = UnitGroupCount(markers, c_unitCountAll);
    gv_spawnCount = 0;

    i = 1;
    while (i <= count) {
        marker = UnitGroupUnit(markers, i);
        if (gv_spawnCount < c_maxSpawnPoints) {
            gv_spawnPoints[gv_spawnCount] = UnitGetPosition(marker);
            gv_spawnCount = gv_spawnCount + 1;
        }
        UnitRemove(marker);
        i = i + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// Prints what the scan found. While greyboxing this is the fastest way to catch
// "I forgot to set the Player field on that one" -- the count will be off.
//--------------------------------------------------------------------------------------------------
void Registry_Report () {
    UIDisplayMessage(
        PlayerGroupAll(),
        c_messageAreaSubtitle,
        StringToText(
            "registry: debris=" + IntToString(UnitGroupCount(gv_debris, c_unitCountAlive))
            + " devices=" + IntToString(UnitGroupCount(gv_devices, c_unitCountAlive))
            + " spawns=" + IntToString(gv_spawnCount)
        )
    );
}

void Registry_Init () {
    gv_debris = UnitGroup(null, c_playerDebris, RegionEntireMap(), null, 0);
    gv_devices = UnitGroup(null, c_playerDevice, RegionEntireMap(), null, 0);
    Registry_ConsumeSpawnMarkers();
    Registry_Report();
}
