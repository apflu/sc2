//--------------------------------------------------------------------------------------------------
// Resource devices.
//
// Devices hold up the power grid while intact, and lethal damage disables them
// instead of destroying them, per the design baseline.
//
// Both halves of that live in data rather than here:
//
//   Power is the engine's supply meter. An online device carries Food, so the
//   engine counts it into supplies-made by itself, per owning player, which is
//   exactly the independent grid the baseline asks for and costs nothing. The
//   readout is free and turns red on its own. Nothing in this file writes it.
//
//   Disablement is a unit type. A device that takes a killing blow is replaced
//   by Lob_DeviceDown_Basic, which carries no Food and so leaves the grid the
//   moment it appears, and which is Invulnerable -- and Invulnerable happens to
//   mean exactly the two things wanted here, because the zergling weapon's
//   target filters exclude it while the Repair ability's filters do not. So
//   nothing keeps chewing on a device that is already down, and an SCV or the
//   player can still work on it.
//
// This module is therefore only the two morphs and a count for the readout.
// There is no "is it disabled" flag, no health threshold standing in for one,
// and no supply bookkeeping -- asking which units exist answers all of it.
//--------------------------------------------------------------------------------------------------

const fixed c_devicePeriod = 1.0;

// Type-name prefixes. A device and its downed form differ only in this segment,
// so one is derived from the other rather than tabulated; adding a variant
// means authoring the pair in the editor and nothing here.
const string c_deviceUpPrefix = "Lob_Device_";
const string c_deviceDownPrefix = "Lob_DeviceDown_";

// Devices online on the last tick, and devices in total. Only the greybox
// readout needs these; the grid itself is the engine's business.
int gv_devicesOnline;
int gv_devicesTotal;

trigger gt_deviceFatal;
trigger gt_deviceTick;

//--------------------------------------------------------------------------------------------------
// Devices worth sending a worker to: anything down, plus anything still online
// but chipped. Down comes first because a downed device is off the grid, while
// a chipped one is still paying out.
//--------------------------------------------------------------------------------------------------
unitgroup Devices_Damaged () {
    unitgroup found;
    unitgroup online;
    unit device;
    int count;
    int i;

    found = ObjectsGen_ScanDeviceDown();

    online = ObjectsGen_ScanDevice();
    count = UnitGroupCount(online, c_unitCountAlive);
    i = 1;
    while (i <= count) {
        device = UnitGroupUnit(online, i);
        if (device != null && UnitGetPropertyFixed(device, c_unitPropLifePercent, true) < 99.0) {
            UnitGroupAdd(found, device);
        }
        i = i + 1;
    }
    return found;
}

//--------------------------------------------------------------------------------------------------
// Intercepts the killing blow and puts the downed device in its place.
//--------------------------------------------------------------------------------------------------
bool Devices_Fatal_Func (bool testConds, bool runActions) {
    unit victim;

    if (!runActions) {
        return true;
    }

    victim = EventUnit();
    if (!ObjectsGen_IsDevice(victim)) {
        return true;
    }

    Downable_TakeDown(victim, c_deviceUpPrefix, c_deviceDownPrefix);
    return true;
}

//--------------------------------------------------------------------------------------------------
// Brings repaired devices back onto the grid, and counts for the readout.
//--------------------------------------------------------------------------------------------------
bool Devices_Tick_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }

    Downable_RestoreRepaired(ObjectsGen_ScanDeviceDown(),
                             c_deviceDownPrefix, c_deviceUpPrefix);

    gv_devicesOnline = UnitGroupCount(ObjectsGen_ScanDevice(), c_unitCountAlive);
    gv_devicesTotal = gv_devicesOnline
                      + UnitGroupCount(ObjectsGen_ScanDeviceDown(), c_unitCountAlive);
    return true;
}

void Devices_Init () {
    gv_devicesOnline = 0;
    gv_devicesTotal = 0;

    gt_deviceFatal = TriggerCreate("Devices_Fatal_Func");
    TriggerAddEventUnitDamaged(gt_deviceFatal, null, c_unitDamageTypeAny, c_unitDamageFatal, null);

    gt_deviceTick = TriggerCreate("Devices_Tick_Func");
    TriggerAddEventTimePeriodic(gt_deviceTick, c_devicePeriod, c_timeGame);
}
