//--------------------------------------------------------------------------------------------------
// Resource devices.
//
// Devices hold up the power grid while intact, and lethal damage disables them
// instead of destroying them, per the design baseline. Disabling is not a
// separate state flag: a device is online when its health is above a threshold,
// and fatal damage is intercepted and clamped to near zero. Repair is then just
// the native SCV repair ability putting health back, and the device comes back
// online on its own.
//
// Power is the engine's supply meter. That is not a shortcut, it is the right
// model: supply is a capacity rather than a bank, it is per-player natively
// (which is what the baseline's independent grids need, for free), it comes
// with an always-visible readout that turns red on its own, and device output
// stays a data field rather than a script constant.
//
// A disabled device has to stop counting, and Food on the unit cannot express
// that -- it is static, and the engine derives supplies-made from whichever
// units are alive. So devices carry no Food and this module writes the total
// each tick instead. Whether the engine leaves that write alone is the one
// thing about this that is unproven; see the read-back below.
//
// Modelling it that way means the health bar already shows the disabled state,
// repair needs no bespoke mechanic, and there is no flag that can drift out of
// sync with the unit it describes.
//--------------------------------------------------------------------------------------------------

// Fast, because this is what makes a device being chewed on legible: capacity
// has to fall while the player is still deciding whether to go over there.
const fixed c_devicePeriod = 1.0;

// Capacity each online device contributes. Not an income rate -- power is the
// supply meter now, so this is a ceiling that exists while the device does.
const int c_powerPerDevice = 3;

// Above this share of max health the device runs; below it, it is disabled.
const fixed c_deviceOnlineLifePercent = 50.0;

// What a device is left on after lethal damage. Not zero -- zero is death.
const fixed c_deviceDisabledLife = 1.0;

// Read back from the engine after we write it, rather than trusted from what we
// wrote. Supply-made is normally derived from units that carry a Food value, so
// there is a real chance the engine recomputes it out from under us on the next
// unit birth or death. Reading it back means the greybox readout shows what the
// player's UI actually shows, and a mismatch is visible instead of silent.
int gv_powerMade;
int gv_powerUsed;

int gv_devicesOnline;
int gv_devicesTotal;

trigger gt_deviceFatal;
trigger gt_deviceTick;

//--------------------------------------------------------------------------------------------------
// Devices that have taken any damage, for the workers to prioritise.
//--------------------------------------------------------------------------------------------------
unitgroup Devices_Damaged () {
    unitgroup all;
    unitgroup damaged;
    unit device;
    int count;
    int i;

    all = ObjectsGen_ScanDevice();
    damaged = UnitGroupEmpty();
    count = UnitGroupCount(all, c_unitCountAlive);

    i = 1;
    while (i <= count) {
        device = UnitGroupUnit(all, i);
        if (device != null && UnitGetPropertyFixed(device, c_unitPropLifePercent, true) < 99.0) {
            UnitGroupAdd(damaged, device);
        }
        i = i + 1;
    }
    return damaged;
}

//--------------------------------------------------------------------------------------------------
// Intercepts the killing blow and leaves the device standing at minimum health.
//--------------------------------------------------------------------------------------------------
bool Devices_Fatal_Func (bool testConds, bool runActions) {
    unit victim;

    if (!runActions) {
        return true;
    }

    victim = EventUnit();
    if (!ObjectsGen_IsDevice(victim)) {
        return true;
    }

    UnitSetPropertyFixed(victim, c_unitPropLife, c_deviceDisabledLife);
    return true;
}

bool Devices_Tick_Func (bool testConds, bool runActions) {
    unitgroup devices;
    unit device;
    int count;
    int i;

    if (!runActions) {
        return true;
    }

    devices = ObjectsGen_ScanDevice();
    count = UnitGroupCount(devices, c_unitCountAlive);

    gv_devicesTotal = count;
    gv_devicesOnline = 0;

    i = 1;
    while (i <= count) {
        device = UnitGroupUnit(devices, i);
        if (device != null
            && UnitGetPropertyFixed(device, c_unitPropLifePercent, true) >= c_deviceOnlineLifePercent) {
            gv_devicesOnline = gv_devicesOnline + 1;
        }
        i = i + 1;
    }

    PlayerModifyPropertyInt(c_p0Player, c_playerPropSuppliesMade,
                            c_playerPropOperSetTo,
                            gv_devicesOnline * c_powerPerDevice);
    gv_powerMade = PlayerGetPropertyInt(c_p0Player, c_playerPropSuppliesMade);
    gv_powerUsed = PlayerGetPropertyInt(c_p0Player, c_playerPropSuppliesUsed);
    return true;
}

void Devices_Init () {
    gv_powerMade = 0;
    gv_powerUsed = 0;
    gv_devicesOnline = 0;
    gv_devicesTotal = 0;

    gt_deviceFatal = TriggerCreate("Devices_Fatal_Func");
    TriggerAddEventUnitDamaged(gt_deviceFatal, null, c_unitDamageTypeAny, c_unitDamageFatal, null);

    gt_deviceTick = TriggerCreate("Devices_Tick_Func");
    TriggerAddEventTimePeriodic(gt_deviceTick, c_devicePeriod, c_timeGame);
}
