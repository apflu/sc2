//--------------------------------------------------------------------------------------------------
// Ordeals.
//
// The meltdown clock's other output. 13_meltdown turns a level into cells that
// have to be worked; this turns the same level into something that walks in and
// has to be killed. Both are the same pressure arriving through two doors, which
// is why nothing here has a timer of its own -- an Ordeal is not scheduled, it
// is a CONSEQUENCE of a meltdown level, and giving it an independent clock would
// let the two drift into arriving together by accident.
//
//   meltdown 2        -> Dawn
//   meltdown 3, 4, 5  -> Noon
//   meltdown 6, 7     -> Dusk
//   meltdown 8 and up -> Midnight
//
// Difficulty is a CEILING on the tier, not a schedule (Diff_OrdealCap, and the
// reasoning is in systems/difficulty.md). It SKIPS rather than clamps: on Casual
// the Dawn arrives and nothing after it does, because one Ordeal per tier per
// game is the schedule and a capped tier is a tier that does not happen. Clamping
// would have kept handing out Dawns at meltdown 3, 6 and 8 -- the same fight
// four times for four different rewards, which reads as padding rather than as
// an easier night.
//
// WHICH Ordeal is drawn from the units that exist. Lob_Ordeal_Dawn_Amber lands
// in the generated Ordeal_Dawn table, so the pool for a tier is whatever has
// been authored for it -- adding an Ordeal is building a unit, and this file
// does not change. A tier with no units draws nothing and says so.
//
// The next one is rolled the moment the previous is scheduled, because the
// design requires the players to KNOW what is coming and at which meltdown
// level. That is the whole tactical content of an Ordeal for the ten minutes
// before it lands: you cannot prepare for a surprise.
//
// Numbered 27 because it reads locations off 26_fortify and is called by nobody.
//--------------------------------------------------------------------------------------------------

// Percent of the shared energy target paid for suppressing one, by tier.
//
// Of the TARGET rather than of the pool, so an Ordeal is worth the same whether
// it arrives while you are flush or while you are scraping -- which is the point,
// since the tier is already the difficulty axis and the pool is not.
int[4] gvg_ordealRewardPct;

const fixed c_ordealTick = 1.0;

// Spawned entities, by handle. Same argument as the fortification slots: a
// handle IS the world, where a count could disagree with it.
const int c_ordealUnitMax = 64;
unit[64] gvg_ordealUnit;
int gv_ordealCount;

// What is running, if anything.
bool gv_ordealActive;
int gv_ordealTier;
string gv_ordealType;
int gv_ordealKilled;

// What is coming, and when. gv_ordealNextType is "" when a tier has no units
// authored yet, which is the inert-not-broken case.
int gv_ordealNextLevel;
int gv_ordealNextTier;
string gv_ordealNextType;

// The meltdown level each tier arrives at, drawn once at init from that tier's
// range, and whether it has already happened. One Ordeal per tier per game.
int[4] gvg_ordealAtLevel;
bool[4] gvg_ordealSpent;

//--------------------------------------------------------------------------------------------------
// What an Ordeal DOES beyond existing and being killable.
//
// Most of an Ordeal is unit data -- life, damage, speed, the four defences --
// and needs nothing here. Three of the dawns are not: Crimson robs cells and
// moves on, Violet is a timer that ends the night early if it is ignored, and
// Amber will not stay in the hallway you found it in. None of the three is
// expressible as a stat.
//
// The type-to-behaviour map is a hardcoded list in Ordeal_ActOf, which is worth
// being uncomfortable about: it is the one place an Ordeal's unit id has to be
// spelled out in script. It stays a list rather than a channel because there is
// no per-type value channel yet and inventing one here is what the standing note
// in build-order.md forbids. A type not in the list simply fights.
//--------------------------------------------------------------------------------------------------
const int c_ordealActPlain = 0;
const int c_ordealActThief = 1;
const int c_ordealActBomb = 2;
const int c_ordealActDigger = 3;

int gv_ordealAct;

// The ability a thief casts on a containment door. Its PrepTime IS the twenty
// seconds and the engine draws the bar; nothing here counts them.
const string c_ordealRobAbil = "Lob_Ordeal_Rob";

// Percent of that cell's PE boxes it leaves with.
const int c_ordealRobPct = 30;

// How long a bomb waits. Drawn per entity, so the departments do not all go up
// on the same second.
const fixed c_ordealFuseMin = 60.0;
const fixed c_ordealFuseMax = 70.0;

// White damage the burst does to everybody in that department.
const int c_ordealBurstMin = 10;
const int c_ordealBurstMax = 14;

// What a thief's corpse does. Red, in a radius, and it is the ONLY damage a
// Crimson Dawn ever deals -- they walk past employees without touching them,
// which is what makes ignoring one until it is convenient a real temptation.
// The doc measures the radius in spear lengths.
const int c_ordealBlastMin = 10;
const int c_ordealBlastMax = 15;
const fixed c_ordealBlastRadius = 2.0;

// How long a worm stays in one hallway before it goes under. The wiki's 40-60
// seconds, drawn per entity so the departments do not all lose sight of theirs
// on the same second.
const fixed c_ordealDigMin = 40.0;
const fixed c_ordealDigMax = 60.0;

// What comes up with it: Red on everyone standing where it surfaces. Small,
// because the point of a relocation is that it MOVED, not that it hit.
const int c_ordealSproutMin = 1;
const int c_ordealSproutMax = 2;
const fixed c_ordealSproutReach = 4.0;

// The two halves of a burrow, FOUND rather than named.
//
// Burrowing is a CAbilMorph pair -- BurrowRoachDown turns a Roach into a
// RoachBurrowed and BurrowRoachUp turns it back -- so which two ids a worm
// carries depends entirely on which stock unit it was copied from, and the
// data side of this map is not this file's to know. Every burrow in stock is
// named Burrow<something>Down / Burrow<something>Up, across thirty-odd of them,
// so the convention is a real one and Ordeal_DigAbil reads it off the unit.
//
// It also has to be read off the unit rather than remembered, because the Down
// half only exists while the worm is above ground and the Up half only exists
// while it is under: a morph swaps the unit's whole ability list along with its
// type.
const string c_ordealDigPrefix = "Burrow";
const string c_ordealDigDown = "Down";
const string c_ordealDigUp = "Up";

// The two explosions, as pictures. See Ordeal_Boom for why they are only that.
const string c_ordealBlastModel = "DOM_Explosion_Sm";
const string c_ordealGlowModel = "ArchonMergeExplosion";

// Close enough to a door to start casting at it. The same number as the
// ability's Range and as Interact's, and it has to be: a door is a wall
// footprint, so range is measured from a centre nothing can stand on.
const fixed c_ordealReach = 4.0;

// Per entity, parallel to gvg_ordealUnit.
//
//   gvg_ordealHome   the department it belongs to -- a bomb's burst is scoped
//                    to it, and a thief prefers its own cells
//   gvg_ordealMark   the cell a thief is walking to or working on
//   gvg_ordealAt     the entity's one deadline, and each act reads it as its
//                    own: a bomb's fuse burning out, a worm's stay in this
//                    hallway running out. A thief has none -- its twenty
//                    seconds belong to the ability, not to this file
int[64] gvg_ordealHome;
unit[64] gvg_ordealMark;
fixed[64] gvg_ordealAt;

int Ordeal_ActOf (string type) {
    if (type == "Lob_Ordeal_Dawn_Crimson") {
        return c_ordealActThief;
    }
    if (type == "Lob_Ordeal_Dawn_Violet") {
        return c_ordealActBomb;
    }
    if (type == "Lob_Ordeal_Dawn_Amber") {
        return c_ordealActDigger;
    }
    return c_ordealActPlain;
}

int gv_ordealObj;

// Ordeals suppressed this game, by tier. Table-wide, because an Ordeal is:
// every department gets one entity and it is over when the last of them falls,
// so there is no per-player half of it to count. Control Team 4 and
// Disciplinary Team 4 read this.
int[4] gvg_ordealBeaten;

trigger gt_ordealTick;
trigger gt_ordealRob;
trigger gt_ordealDeath;

//--------------------------------------------------------------------------------------------------
// How many Ordeals of at least this tier have been put down.
//
// At LEAST, because "survive a Dusk Ordeal" is satisfied by a Midnight. A task
// that asked for exactly a Dusk would get harder as the night got worse, which
// is backwards.
//--------------------------------------------------------------------------------------------------
int Ordeal_BeatenAtLeast (int tier) {
    int total;
    int i;

    total = 0;
    i = tier;
    while (i < c_diffCount) {
        if (i >= 0) {
            total = total + gvg_ordealBeaten[i];
        }
        i = i + 1;
    }
    return total;
}

//--------------------------------------------------------------------------------------------------
// The meltdown levels a tier is allowed to arrive at.
//
//   Dawn      2
//   Noon      3, 4, 5
//   Dusk      6, 7
//   Midnight  8
//
// A RANGE, not a set of separate occasions. Each tier happens exactly once in a
// game and the level inside its range is drawn at init, which is why the whole
// schedule can be announced before it starts. Reading the ranges as "every level
// in them" gave three Noons and then a Midnight at every level from 8 upward,
// and an Ordeal that keeps coming back is not an escalation, it is a wave timer
// wearing an Ordeal's name.
//--------------------------------------------------------------------------------------------------
int Ordeal_LevelMin (int tier) {
    if (tier == c_ordealDawn) { return 2; }
    if (tier == c_ordealNoon) { return 3; }
    if (tier == c_ordealDusk) { return 6; }
    if (tier == c_ordealMidnight) { return 8; }
    return 0;
}

int Ordeal_LevelMax (int tier) {
    if (tier == c_ordealDawn) { return 2; }
    if (tier == c_ordealNoon) { return 5; }
    if (tier == c_ordealDusk) { return 7; }
    if (tier == c_ordealMidnight) { return 8; }
    return 0;
}

//--------------------------------------------------------------------------------------------------
// Every type authored for a tier, drawable or not.
//
// Galaxy has no array parameters, so a tier cannot be looked up in a table --
// hence the four-way branch. It is written twice rather than once because the
// alternative is copying the type names into a table this file owns, and then
// there would be two lists of Ordeals that could disagree.
//--------------------------------------------------------------------------------------------------
int Ordeal_TierSize (int tier) {
    if (tier == c_ordealDawn) { return c_typesOrdeal_DawnCount; }
    if (tier == c_ordealNoon) { return c_typesOrdeal_NoonCount; }
    if (tier == c_ordealDusk) { return c_typesOrdeal_DuskCount; }
    if (tier == c_ordealMidnight) { return c_typesOrdeal_MidnightCount; }
    return 0;
}

string Ordeal_TierAt (int tier, int i) {
    if (i < 0 || i >= Ordeal_TierSize(tier)) {
        return "";
    }
    if (tier == c_ordealDawn) { return gvg_typesOrdeal_Dawn[i]; }
    if (tier == c_ordealNoon) { return gvg_typesOrdeal_Noon[i]; }
    if (tier == c_ordealDusk) { return gvg_typesOrdeal_Dusk[i]; }
    if (tier == c_ordealMidnight) { return gvg_typesOrdeal_Midnight[i]; }
    return "";
}

//--------------------------------------------------------------------------------------------------
// A unit that is the OTHER SHAPE of an Ordeal rather than an Ordeal.
//
// Burrowing is a morph, so a worm that can hide needs a second CUnit for the
// hidden form, and the id convention that puts it in the right generated table
// -- Lob_Ordeal_Dawn_Amber_Underground, exactly as Lob_Turret_Fire_Underground
// is the buried half of a turret -- also drops it into the Dawn DRAW POOL. One
// night in five would then open with an Ordeal that spawns underground and
// never comes up, because nothing above ground would ever order it to.
//
// The suffix is load-bearing in both directions and it is already the map's
// convention for this exact thing, which is why it is read here rather than
// worked around by naming the burrowed form something unrelated: a unit that
// falls out of the Ordeal_ namespace also falls out of every scan that has to
// find it.
//--------------------------------------------------------------------------------------------------
const string c_ordealFormSuffix = "_Underground";

bool Ordeal_IsForm (string type) {
    return StringContains(type, c_ordealFormSuffix, c_stringEnd, c_stringNoCase);
}

//--------------------------------------------------------------------------------------------------
// The same tier, less the alternate forms: what a draw is allowed to land on.
//--------------------------------------------------------------------------------------------------
int Ordeal_PoolSize (int tier) {
    int size;
    int found;
    int i;

    size = Ordeal_TierSize(tier);
    found = 0;
    i = 0;
    while (i < size) {
        if (!Ordeal_IsForm(Ordeal_TierAt(tier, i))) {
            found = found + 1;
        }
        i = i + 1;
    }
    return found;
}

string Ordeal_PoolAt (int tier, int i) {
    int size;
    int j;

    if (i < 0) {
        return "";
    }
    size = Ordeal_TierSize(tier);
    j = 0;
    while (j < size) {
        if (!Ordeal_IsForm(Ordeal_TierAt(tier, j))) {
            if (i == 0) {
                return Ordeal_TierAt(tier, j);
            }
            i = i - 1;
        }
        j = j + 1;
    }
    return "";
}

string Ordeal_Draw (int tier) {
    int size;

    size = Ordeal_PoolSize(tier);
    if (size <= 0) {
        return "";
    }
    return Ordeal_PoolAt(tier, RandomInt(0, size - 1));
}

//--------------------------------------------------------------------------------------------------
// What to call one, for a player to read.
//
// The unit's own display name, not a second string of ours. The editor already
// wrote Unit/Name/Lob_Ordeal_Dawn_Amber and the panel already shows it; a
// parallel Lob/ key would be a copy free to drift from the thing it names.
//--------------------------------------------------------------------------------------------------
text Ordeal_NameOf (string type) {
    if (type == "") {
        return StringExternal("Lob/Ordeal/None");
    }
    return StringExternal("Unit/Name/" + type);
}

int Ordeal_RewardFor (int tier) {
    if (tier < 0 || tier >= c_diffCount) {
        return 0;
    }
    return gv_energyGoal * gvg_ordealRewardPct[tier] / 100;
}

//--------------------------------------------------------------------------------------------------
// The objective line, which is a STATUS line rather than a thing to complete.
//
// One line that says either what is coming or what is here. Bonus, because an
// Ordeal pays energy and energy is spent when the ship leaves -- the same
// reasoning that makes the energy target itself a bonus objective.
//--------------------------------------------------------------------------------------------------
void Ordeal_Refresh () {
    if (gv_ordealObj == c_invalidObjectiveId) {
        return;
    }

    if (gv_ordealActive) {
        ObjectiveSetName(
            gv_ordealObj,
            TextReplaceWord(StringExternal("Lob/Objective/Ordeal/Here"),
                            StringToText("%NAME%"), Ordeal_NameOf(gv_ordealType),
                            c_stringReplaceAll, c_stringCase)
            + StringToText(" <s val=\"" + c_questProgressStyle + "\">("
                           + IntToString(gv_ordealKilled) + "/"
                           + IntToString(gv_ordealCount) + ")</s>"));
        return;
    }

    if (gv_ordealNextType == "") {
        ObjectiveSetName(gv_ordealObj, StringExternal("Lob/Objective/Ordeal/Nothing"));
        return;
    }

    ObjectiveSetName(
        gv_ordealObj,
        TextReplaceWord(
            TextReplaceWord(StringExternal("Lob/Objective/Ordeal/Next"),
                            StringToText("%NAME%"), Ordeal_NameOf(gv_ordealNextType),
                            c_stringReplaceAll, c_stringCase),
            StringToText("%LEVEL%"), IntToText(gv_ordealNextLevel),
            c_stringReplaceAll, c_stringCase));
}

//--------------------------------------------------------------------------------------------------
// Picks the next tier that has not happened yet, and tells everybody.
//
// Called after each Ordeal is dispatched rather than when it is defeated, so
// the warning is as early as it can possibly be. An Ordeal announced while it
// is already walking down the corridor is not a warning.
//
// Difficulty SKIPS rather than clamps. On Casual the night has one Ordeal in it
// and then no more -- clamping instead would have meant a Dawn at every level
// forever, which is not a gentler night, it is a longer one.
//--------------------------------------------------------------------------------------------------
void Ordeal_ScheduleNext () {
    int tier;

    gv_ordealNextTier = -1;
    gv_ordealNextType = "";
    gv_ordealNextLevel = 0;

    tier = 0;
    while (tier < c_diffCount) {
        if (!gvg_ordealSpent[tier] && tier <= Diff_OrdealCap()) {
            gv_ordealNextTier = tier;
            gv_ordealNextLevel = gvg_ordealAtLevel[tier];
            gv_ordealNextType = Ordeal_Draw(tier);
            tier = c_diffCount;
        }
        else {
            tier = tier + 1;
        }
    }

    Ordeal_Refresh();

    if (gv_ordealNextType != "") {
        UIDisplayMessage(
            PlayerGroupAll(), c_messageAreaSubtitle,
            Msg2("Lob/Msg/OrdealNext",
                 "%NAME%", Ordeal_NameOf(gv_ordealNextType),
                 "%LEVEL%", MsgInt(gv_ordealNextLevel)));
    }
}

//--------------------------------------------------------------------------------------------------
// One of a player's corridors or rooms, at random, or -1 if they have none.
//
// AVOID is a loc to leave out of the draw, which is what makes a worm's
// relocation a relocation: coming up in the hallway you just left reads as the
// mechanic being broken, not as bad luck. Pass -1 to draw from all of them.
//
// A department with exactly one drawn location has nowhere else to be, and the
// draw falls back to including it rather than returning nothing -- staying put
// is the honest answer to "go somewhere else" when there is no somewhere else,
// and it still costs the room the sprout.
//--------------------------------------------------------------------------------------------------
int Ordeal_HallFor (int player, int avoid) {
    int found;
    int pick;
    int loc;

    found = 0;
    loc = 0;
    while (loc < gv_locCount) {
        if (Fort_OwnerOf(loc) == player && loc != avoid) {
            found = found + 1;
        }
        loc = loc + 1;
    }

    if (found == 0) {
        if (avoid >= 0) {
            return Ordeal_HallFor(player, -1);
        }
        return -1;
    }

    pick = RandomInt(1, found);
    loc = 0;
    while (loc < gv_locCount) {
        if (Fort_OwnerOf(loc) == player && loc != avoid) {
            pick = pick - 1;
            if (pick == 0) {
                return loc;
            }
        }
        loc = loc + 1;
    }
    return -1;
}

//--------------------------------------------------------------------------------------------------
// Where one entity belonging to a player appears.
//
// A corridor or room of theirs, chosen at random, which is the doc's "one per
// department in a random hallway". Their core is the fallback for a sector with
// no regions drawn yet, so the system works before the editor side is finished
// rather than silently spawning nothing.
//--------------------------------------------------------------------------------------------------
point Ordeal_SpawnPointFor (int player) {
    unit core;
    int loc;

    loc = Ordeal_HallFor(player, -1);
    if (loc >= 0) {
        return gvg_locCenter[loc];
    }

    core = Sector_AnyCore(player);
    if (core != null) {
        return UnitGetPosition(core);
    }
    return Point(0.0, 0.0);
}

//--------------------------------------------------------------------------------------------------
// A cell a thief could rob: a contained abnormality with a door still up.
//
// Its own department first, any department second. The doc has the clowns
// spawning in a hallway that has a Containment Unit's door, so a department
// with no cells at all should not make them stand still -- it should make them
// somebody else's problem, which is the same thing the meltdown does.
//--------------------------------------------------------------------------------------------------
unit Ordeal_CellFor (int player, bool ownOnly) {
    unit abno;
    int found;
    int pick;
    int slot;

    found = 0;
    slot = 0;
    while (slot < gv_cellCount) {
        abno = gvg_cellAbno[slot];
        if (abno != null && UnitIsAlive(abno) && Cont_State(abno) == c_cellContained
            && Cont_DoorIsUp(abno)
            && (!ownOnly || Cont_OwnerOf(slot) == player)) {
            found = found + 1;
        }
        slot = slot + 1;
    }

    if (found == 0) {
        if (ownOnly) {
            return Ordeal_CellFor(player, false);
        }
        return null;
    }

    pick = RandomInt(1, found);
    slot = 0;
    while (slot < gv_cellCount) {
        abno = gvg_cellAbno[slot];
        if (abno != null && UnitIsAlive(abno) && Cont_State(abno) == c_cellContained
            && Cont_DoorIsUp(abno)
            && (!ownOnly || Cont_OwnerOf(slot) == player)) {
            pick = pick - 1;
            if (pick == 0) {
                return abno;
            }
        }
        slot = slot + 1;
    }
    return null;
}

//--------------------------------------------------------------------------------------------------
// What a thief leaves with: 30% of that cell's boxes, and one off the counter.
//
// The boxes come off the CELL OWNER's pile, because that is whose research it
// was. The counter is the part that hurts on a delay -- a cell one step closer
// to zero is a breach that has not happened yet.
//--------------------------------------------------------------------------------------------------
void Ordeal_Rob (unit abno) {
    int slot;
    int owner;
    int index;
    int taken;

    slot = Cont_SlotOf(abno);
    index = AbnoGen_IndexOf(abno);
    if (slot < 0 || index < 0) {
        return;
    }
    owner = Cont_OwnerOf(slot);

    taken = 0;
    if (owner >= 1 && owner <= 15) {
        taken = Cont_BoxesOf(owner, index) * c_ordealRobPct / 100;
        Cont_AddBoxes(owner, index, -taken);
    }
    if (Cont_Counter(abno) > 0) {
        Cont_SetCounter(abno, Cont_Counter(abno) - 1);
    }

    // Told to the person whose cell it was. A theft nobody is told about is
    // indistinguishable from a bug in the counter.
    if (owner >= 1 && owner <= 15) {
        UIDisplayMessage(
            PlayerGroupSingle(owner), c_messageAreaSubtitle,
            Msg3("Lob/Msg/OrdealRobbed",
                 "%NAME%", Ordeal_NameOf(gv_ordealType),
                 "%ABNO%", AbnoGen_NameText(index),
                 "%BOXES%", MsgInt(taken)));
    }
}

//--------------------------------------------------------------------------------------------------
// One thief, once a tick.
//
// Three states and no flags to hold them: walking (has a mark, not there yet),
// working (gvg_ordealAt is set), and between jobs (no mark). Each is a question
// about the world rather than a bit somebody remembered to clear.
//--------------------------------------------------------------------------------------------------
void Ordeal_ThiefStep (int i) {
    unit who;
    unit door;

    who = gvg_ordealUnit[i];
    if (who == null || !UnitIsAlive(who)) {
        return;
    }

    // Already casting, or walking to somewhere to cast. The ability carries the
    // approach and the twenty seconds with it, so an entity with an order is an
    // entity with nothing to decide.
    if (UnitOrderCount(who) > 0) {
        return;
    }

    if (gvg_ordealMark[i] == null || !UnitIsAlive(gvg_ordealMark[i])
        || Cont_State(gvg_ordealMark[i]) != c_cellContained) {
        gvg_ordealMark[i] = Ordeal_CellFor(gvg_ordealHome[i], true);
    }
    if (gvg_ordealMark[i] == null) {
        return;
    }

    // The DOOR, never the abnormality. The abnormality is behind a wall the
    // clown cannot path through, so an order aimed at it is an order that never
    // arrives -- which is exactly what the first version did, silently.
    door = Cont_DoorOf(gvg_ordealMark[i]);
    if (door == null) {
        gvg_ordealMark[i] = null;
        return;
    }

    UnitIssueOrder(who,
                   OrderTargetingUnit(AbilityCommand(c_ordealRobAbil, 0), door),
                   c_orderQueueReplace);
}

//--------------------------------------------------------------------------------------------------
// A robbery finished.
//
// Heard rather than counted. The ability's PrepTime is the twenty seconds, so
// dying halfway through means this never fires and nothing was taken -- which is
// the fight the clown is supposed to be worth having, and which a script timer
// would have had to reimplement badly.
//
// Registered on every stage and filtered here, the same way 14_work does it,
// because the stage sequence of a prepare-time cast is not obvious and finding
// it out again would be a second trace through the same ground.
//--------------------------------------------------------------------------------------------------
bool Ordeal_Rob_Func (bool testConds, bool runActions) {
    unit who;
    unit door;
    int i;
    int slot;

    if (!runActions) {
        return true;
    }
    if (EventUnitAbilityStage() != c_unitAbilStageComplete) {
        return true;
    }

    who = EventUnit();
    door = EventUnitTargetUnit();
    if (who == null || door == null) {
        return true;
    }

    slot = 0;
    while (slot < gv_cellCount) {
        if (Cont_DoorAt(gvg_cellHome[slot]) == door) {
            Ordeal_Rob(gvg_cellAbno[slot]);
            slot = gv_cellCount;
        }
        else {
            slot = slot + 1;
        }
    }

    // The smoke cloud: it leaves the cell it just robbed and turns up somewhere
    // else in its own department, then picks a new one on the next tick.
    i = 0;
    while (i < gv_ordealCount) {
        if (gvg_ordealUnit[i] == who) {
            gvg_ordealMark[i] = null;
            UnitSetPosition(who, Ordeal_SpawnPointFor(gvg_ordealHome[i]), false);
            i = gv_ordealCount;
        }
        else {
            i = i + 1;
        }
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// An explosion, in two halves: the picture and the numbers.
//
// The picture is a detached model dropped at a point, and that is all the
// catalog does for either of these. The numbers are Emp_CombatDamage, in script.
// That split is not a shortcut taken to avoid learning the effect system -- it
// is forced, three times over, and it is worth writing down because a copied
// Baneling burst looks like it would do the job:
//
//   CEffectDamage cannot say White. The engine has Amount and Kind
//   (Melee / Ranged / Splash / Ability) and no field anywhere that means "spend
//   sanity", because sanity is ours and nothing in the catalog has heard of it.
//   Violet's burst is White, so a catalog effect cannot deal even part of it.
//
//   CEffectDamage cannot say "the department". AreaArray is a radius, and
//   Violet's burst is scoped to the employees ASSIGNED to a sector -- who may be
//   standing anywhere on the map, including next to somebody else's cells. A
//   radius wide enough to catch them all would also catch the ones it must not.
//
//   Crimson's blast IS Red, which the engine could deal honestly, and it still
//   must not. Damage dealt by the engine never passes through Emp_CombatDamage,
//   so it would skip Emp_DamageScale -- the seam E.G.O resistance lands on -- skip
//   the rule that an employee at zero life dies outright rather than going to a
//   downed state that does not exist, and skip Emp_DamageShown, which is where
//   the Information Team's damage numbers are going to be read from. One funnel,
//   or half the damage in this game is invisible.
//
// So: no CAbilEffectInstant, no CEffectDamage, no suicide effect. A model and a
// function call.
//--------------------------------------------------------------------------------------------------
void Ordeal_Boom (point at, string model) {
    if (at == null) {
        return;
    }
    libNtve_gf_CreateModelAtPoint(model, at);
}

//--------------------------------------------------------------------------------------------------
// Everybody of one kind close enough to the corpse.
//
// Split out because employees and players are two scans and the same rule, and
// because a player standing over the thing they just killed should eat the blast
// -- being the one holding the weapon is not cover.
//--------------------------------------------------------------------------------------------------
void Ordeal_BlastGroup (unitgroup people, point at, int amount) {
    unit who;
    int count;
    int j;

    count = UnitGroupCount(people, c_unitCountAlive);
    j = 1;
    while (j <= count) {
        who = UnitGroupUnit(people, j);
        if (who != null && UnitIsAlive(who)
            && DistanceBetweenPoints(UnitGetPosition(who), at) <= c_ordealBlastRadius) {
            Emp_CombatDamage(who, c_dmgRed, amount);
        }
        j = j + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// A thief's death.
//
// Rolled once and applied to everyone, rather than rolled per victim: it is one
// explosion, and two people standing shoulder to shoulder taking 10 and 15 from
// the same bang would read as a bug.
//--------------------------------------------------------------------------------------------------
void Ordeal_Blast (unit who) {
    point at;
    int amount;

    if (who == null) {
        return;
    }

    at = UnitGetPosition(who);
    amount = RandomInt(c_ordealBlastMin, c_ordealBlastMax);

    Ordeal_Boom(at, c_ordealBlastModel);
    Ordeal_BlastGroup(ObjectsGen_ScanEmp(), at, amount);
    Ordeal_BlastGroup(ObjectsGen_ScanHero(), at, amount);
}

//--------------------------------------------------------------------------------------------------
// Which types go off when killed.
//
// A second hardcoded list rather than another value on Ordeal_ActOf's enum,
// because robbing and exploding are two separate facts about a Crimson Dawn and
// only one of them is about to be shared: Green Dawn's overkill splash wants
// this hook and wants nothing to do with containment doors. Folding them into
// one enum would mean Green had to pretend to be a thief to get a death event.
//--------------------------------------------------------------------------------------------------
bool Ordeal_BlastsOnDeath (string type) {
    return type == "Lob_Ordeal_Dawn_Crimson";
}

//--------------------------------------------------------------------------------------------------
// Which spawned entity a unit is, or -1.
//--------------------------------------------------------------------------------------------------
int Ordeal_IndexOf (unit who) {
    int i;

    if (who == null) {
        return -1;
    }
    i = 0;
    while (i < gv_ordealCount) {
        if (gvg_ordealUnit[i] == who) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

//--------------------------------------------------------------------------------------------------
// Every death on the map, filtered down to ours.
//
// Registered on no unit in particular rather than per spawned entity, because
// the alternative accumulates event registrations on one trigger for the whole
// game -- sixty-four of them by the fourth Ordeal, all pointed at units that
// were removed. The filter is two comparisons and a short walk of an array that
// is at most the size of the table.
//
// Ordeal_End removes survivors with UnitRemove rather than killing them, which
// is what keeps a Violet burst from also setting off every clown still standing
// somewhere else: removal is not death and this never hears about it.
//--------------------------------------------------------------------------------------------------
bool Ordeal_Died_Func (bool testConds, bool runActions) {
    unit who;

    if (!runActions || !gv_ordealActive) {
        return true;
    }
    if (!Ordeal_BlastsOnDeath(gv_ordealType)) {
        return true;
    }

    who = EventUnit();
    if (Ordeal_IndexOf(who) < 0) {
        return true;
    }

    Ordeal_Blast(who);
    return true;
}

//--------------------------------------------------------------------------------------------------
// What a bomb does when nobody dealt with it.
//
// Every counter in that department to zero and White damage to everyone in it.
// Zeroing a counter is not "a breach happens" -- it is the condition under which
// one is about to, so the punishment arrives as a room full of cells that are
// all one bad second away, which is worse than any single explosion.
//--------------------------------------------------------------------------------------------------
void Ordeal_Burst (int i) {
    unitgroup people;
    unit abno;
    int player;
    int count;
    int slot;
    int j;

    player = gvg_ordealHome[i];

    // The doc's "large glow", and it goes off before the counters do so the
    // flash and the alarm arrive in that order.
    if (gvg_ordealUnit[i] != null) {
        Ordeal_Boom(UnitGetPosition(gvg_ordealUnit[i]), c_ordealGlowModel);
    }

    slot = 0;
    while (slot < gv_cellCount) {
        abno = gvg_cellAbno[slot];
        if (abno != null && UnitIsAlive(abno) && Cont_OwnerOf(slot) == player) {
            Cont_SetCounter(abno, 0);
        }
        slot = slot + 1;
    }

    people = Emp_Of(player);
    count = UnitGroupCount(people, c_unitCountAlive);
    j = 1;
    while (j <= count) {
        Emp_CombatDamage(UnitGroupUnit(people, j), c_dmgWhite,
                         RandomInt(c_ordealBurstMin, c_ordealBurstMax));
        j = j + 1;
    }

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle,
                     Msg1("Lob/Msg/OrdealBurst", "%NAME%", Ordeal_NameOf(gv_ordealType)));
}

//--------------------------------------------------------------------------------------------------
// Which ability on this unit is the half of a burrow we want.
//
// Read off the unit every time rather than looked up once, because a burrow is
// a MORPH: BurrowRoachDown does not toggle a flag on a Roach, it turns it into
// a RoachBurrowed, and the two unit types carry one half of the pair each. There
// is no moment at which a worm has both.
//
// The same fact is a trap on the data side and it is worth writing here because
// this is where somebody will be standing when it bites: the burrowed form is a
// SECOND CUnit, so it needs the same Lob_Def_ table as the form above ground or
// the worm's four defences change every time it hides. 26_fortify already lost
// an afternoon to the other end of this -- a turret that burrows stops answering
// to its own unit type, and every search for it reads empty.
//--------------------------------------------------------------------------------------------------
string Ordeal_DigAbil (unit who, string tail) {
    string abil;
    int count;
    int i;

    if (who == null) {
        return "";
    }
    count = UnitAbilityCount(who);
    i = 1;
    while (i <= count) {
        abil = UnitAbilityGet(who, i);
        if (StringContains(abil, c_ordealDigPrefix, c_stringBegin, c_stringNoCase)
            && StringContains(abil, tail, c_stringEnd, c_stringNoCase)) {
            return abil;
        }
        i = i + 1;
    }
    return "";
}

//--------------------------------------------------------------------------------------------------
// Everyone standing where a worm comes up.
//
// The room if there is one drawn and a radius if there is not, which is
// Fort_InRoom's whole job -- a hallway's walls are the honest scope and most of
// the map does not have them yet.
//--------------------------------------------------------------------------------------------------
void Ordeal_SproutGroup (unitgroup people, point at, int loc, int amount) {
    unit who;
    int count;
    int j;

    count = UnitGroupCount(people, c_unitCountAlive);
    j = 1;
    while (j <= count) {
        who = UnitGroupUnit(people, j);
        if (Fort_InRoom(who, at, loc, c_ordealSproutReach)) {
            Emp_CombatDamage(who, c_dmgRed, amount);
        }
        j = j + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// The floor opening up. Rolled once for the room, the same way a blast is.
//--------------------------------------------------------------------------------------------------
void Ordeal_Sprout (unit who) {
    point at;
    int loc;
    int amount;

    if (who == null) {
        return;
    }
    at = UnitGetPosition(who);
    loc = Fort_LocOfPoint(at);
    amount = RandomInt(c_ordealSproutMin, c_ordealSproutMax);

    Ordeal_SproutGroup(ObjectsGen_ScanEmp(), at, loc, amount);
    Ordeal_SproutGroup(ObjectsGen_ScanHero(), at, loc, amount);
}

//--------------------------------------------------------------------------------------------------
// One worm, once a tick.
//
// Three states again, and again none of them is a bit somebody has to remember
// to clear. Two of the three questions are asked of the engine -- is it under
// (c_unitStateBuried), is it busy (an order, which is what a half-finished morph
// looks like from out here) -- and the third is the deadline it already had.
//
// The deadline does double duty on purpose. Above ground it means "time to go
// under". Under, still reading as expired, it means "this one has not moved
// yet", because SETTING THE NEXT DEADLINE IS THE SAME ACT AS ARRIVING. A
// separate has-moved flag would be a fourth thing that can disagree with the
// other three.
//
// A worm is only under for about a second of that -- the tick that orders it
// down and the tick that moves it and sends it back up. The forty to sixty
// seconds are spent in the hallway, which is where the wiki spends them and
// where it has to be spent for the mechanic to mean anything: a worm underground
// is a worm that cannot be shot, and one that hid for half its life would be
// unkillable rather than annoying.
//
// The sprout lands when the worm is ORDERED up rather than when it finishes
// surfacing, which is about half a second early. Half a second inside a
// forty-second cycle is not a thing a player can perceive, and the alternative
// -- an ability-completed event, the way Ordeal_Rob_Func hears a robbery -- would
// mean naming the Up ability in a trigger registration, which is exactly the
// thing Ordeal_DigAbil exists to avoid having to know.
//--------------------------------------------------------------------------------------------------
void Ordeal_DigStep (int i) {
    unit who;
    string abil;
    fixed now;
    int loc;

    who = gvg_ordealUnit[i];
    if (who == null || !UnitIsAlive(who)) {
        return;
    }

    // Mid-morph. The engine is holding an order for as long as the animation
    // runs, and an entity with an order is an entity with nothing to decide.
    if (UnitOrderCount(who) > 0) {
        return;
    }

    now = GameGetMissionTime();

    if (!UnitTestState(who, c_unitStateBuried)) {
        if (now < gvg_ordealAt[i]) {
            return;
        }
        abil = Ordeal_DigAbil(who, c_ordealDigDown);
        if (abil != "") {
            UnitIssueOrder(who, Order(AbilityCommand(abil, 0)), c_orderQueueReplace);
        }
        return;
    }

    if (now >= gvg_ordealAt[i]) {
        loc = Ordeal_HallFor(gvg_ordealHome[i], Fort_LocOfPoint(UnitGetPosition(who)));
        if (loc >= 0) {
            UnitSetPosition(who, gvg_locCenter[loc], false);
        }
        gvg_ordealAt[i] = now + RandomFixed(c_ordealDigMin, c_ordealDigMax);
        Ordeal_Sprout(who);
    }

    // Re-issued every tick until it takes, rather than once and hoped for. A
    // worm that failed to come up is a worm that is gone from the fight, and
    // nothing else on the map would ever notice.
    abil = Ordeal_DigAbil(who, c_ordealDigUp);
    if (abil != "") {
        UnitIssueOrder(who, Order(AbilityCommand(abil, 0)), c_orderQueueReplace);
    }
}

//--------------------------------------------------------------------------------------------------
// Puts the drawn Ordeal on the map, one entity per player at the table.
//
// One each, not a number scaled by anything. How many an Ordeal brings is a
// per-TYPE fact -- Amber Dawn's worms arrive in fives and the clowns arrive
// alone -- and there is no channel for a per-type number yet. That decision is
// pending and shared with three other systems (see build-order.md); inventing a
// fourth channel for it here is exactly what that note forbids.
//--------------------------------------------------------------------------------------------------
void Ordeal_Begin (int tier, string type) {
    unit made;
    int player;

    if (type == "") {
        return;
    }

    gv_ordealActive = true;
    gv_ordealTier = tier;
    gv_ordealType = type;
    gv_ordealCount = 0;
    gv_ordealKilled = 0;
    gv_ordealAct = Ordeal_ActOf(type);

    player = 1;
    while (player <= 15) {
        if (Slot_IsTablePlayer(player) && gv_ordealCount < c_ordealUnitMax) {
            UnitCreate(1, type, c_unitCreateIgnorePlacement, c_zergPlayer,
                       Ordeal_SpawnPointFor(player), 270.0);
            made = UnitLastCreated();
            if (made != null) {
                gvg_ordealUnit[gv_ordealCount] = made;
                gvg_ordealHome[gv_ordealCount] = player;
                gvg_ordealMark[gv_ordealCount] = null;
                // A bomb's fuse is drawn per entity so the departments do not
                // all reach zero on the same second; a thief starts with none.
                if (gv_ordealAct == c_ordealActBomb) {
                    gvg_ordealAt[gv_ordealCount] =
                        GameGetMissionTime()
                        + RandomFixed(c_ordealFuseMin, c_ordealFuseMax);
                }
                else if (gv_ordealAct == c_ordealActDigger) {
                    gvg_ordealAt[gv_ordealCount] =
                        GameGetMissionTime()
                        + RandomFixed(c_ordealDigMin, c_ordealDigMax);
                }
                else {
                    gvg_ordealAt[gv_ordealCount] = 0.0;
                }
                gv_ordealCount = gv_ordealCount + 1;
            }
        }
        player = player + 1;
    }

    if (gv_ordealCount == 0) {
        // Nowhere to put anything. Not an Ordeal that was survived.
        gv_ordealActive = false;
        return;
    }

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle,
                     Msg1("Lob/Msg/OrdealBegin", "%NAME%", Ordeal_NameOf(type)));

    // Scaffolding, and it should never fire in a finished map: a worm whose unit
    // was never given a burrow will simply stand in one hallway for the rest of
    // the night, which is indistinguishable from the whole mechanic being
    // unwritten. Asked once, of one entity, at the moment somebody would
    // otherwise start wondering.
    if (gv_ordealAct == c_ordealActDigger
        && Ordeal_DigAbil(gvg_ordealUnit[0], c_ordealDigDown) == "") {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle,
                         Msg1("Lob/Msg/OrdealNoDig", "%NAME%", Ordeal_NameOf(type)));
    }

    Ordeal_Refresh();
}

//--------------------------------------------------------------------------------------------------
// How many of the spawned entities are still standing.
//--------------------------------------------------------------------------------------------------
int Ordeal_Standing () {
    int alive;
    int i;

    alive = 0;
    i = 0;
    while (i < gv_ordealCount) {
        if (gvg_ordealUnit[i] != null && UnitIsAlive(gvg_ordealUnit[i])) {
            alive = alive + 1;
        }
        i = i + 1;
    }
    return alive;
}

//--------------------------------------------------------------------------------------------------
// The end of one, and there are two of those.
//
// SUPPRESSED means every entity was put down, and it pays. Anything else does
// not -- an Ordeal that ended because a bomb went off is the failure case the
// bomb exists to threaten, and paying for it would make ignoring Violet the
// cheapest way to farm energy.
//
// Whatever is left standing is removed rather than left wandering: the Ordeal is
// over, and an entity that outlives it belongs to no bookkeeping at all.
//--------------------------------------------------------------------------------------------------
void Ordeal_End (bool suppressed) {
    int reward;
    int i;

    if (suppressed) {
        reward = Ordeal_RewardFor(gv_ordealTier);
        Energy_Add(reward);
        gvg_ordealBeaten[gv_ordealTier] = gvg_ordealBeaten[gv_ordealTier] + 1;
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle,
                         Msg2("Lob/Msg/OrdealDone",
                              "%NAME%", Ordeal_NameOf(gv_ordealType),
                              "%ENERGY%", MsgInt(reward)));
    }
    else {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle,
                         Msg1("Lob/Msg/OrdealLost", "%NAME%", Ordeal_NameOf(gv_ordealType)));
    }

    i = 0;
    while (i < gv_ordealCount) {
        if (gvg_ordealUnit[i] != null && UnitIsAlive(gvg_ordealUnit[i])) {
            UnitRemove(gvg_ordealUnit[i]);
        }
        gvg_ordealUnit[i] = null;
        gvg_ordealMark[i] = null;
        i = i + 1;
    }

    gv_ordealActive = false;
    gv_ordealCount = 0;
    gv_ordealKilled = 0;
    gv_ordealType = "";
    Ordeal_Refresh();
}

//--------------------------------------------------------------------------------------------------
// The one clock, and it is not the Ordeal's own.
//
// Two jobs, and both are readings of state that changes underneath rather than
// events this module could have subscribed to: the meltdown level is owned by a
// module that loads BEFORE this one and so cannot call into it, and "the last
// entity died" has no event that is not a death event per spawned unit.
//--------------------------------------------------------------------------------------------------
bool Ordeal_Tick_Func (bool testConds, bool runActions) {
    fixed now;
    int level;
    int killed;
    int i;

    if (!runActions) {
        return true;
    }

    if (gv_ordealActive) {
        now = GameGetMissionTime();

        // Per-entity behaviour first, because a bomb going off this tick ends
        // the Ordeal and there is nothing to count afterwards.
        i = 0;
        while (i < gv_ordealCount) {
            if (gvg_ordealUnit[i] != null && UnitIsAlive(gvg_ordealUnit[i])) {
                if (gv_ordealAct == c_ordealActThief) {
                    Ordeal_ThiefStep(i);
                }
                else if (gv_ordealAct == c_ordealActDigger) {
                    Ordeal_DigStep(i);
                }
                else if (gv_ordealAct == c_ordealActBomb && now >= gvg_ordealAt[i]) {
                    Ordeal_Burst(i);
                    UnitKill(gvg_ordealUnit[i]);
                    Ordeal_End(false);
                    return true;
                }
            }
            i = i + 1;
        }

        killed = gv_ordealCount - Ordeal_Standing();
        if (killed != gv_ordealKilled) {
            gv_ordealKilled = killed;
            Ordeal_Refresh();
        }
        if (Ordeal_Standing() == 0) {
            Ordeal_End(true);
        }
        return true;
    }

    // Not "the level changed" but "the level has reached it". A tier whose
    // level went by while an earlier Ordeal was still being fought is late
    // rather than cancelled, and arrives the moment the corridor is clear.
    level = Melt_Level();
    if (gv_ordealNextTier >= 0 && gv_ordealNextType != ""
        && level >= gv_ordealNextLevel) {
        gvg_ordealSpent[gv_ordealNextTier] = true;
        Ordeal_Begin(gv_ordealNextTier, gv_ordealNextType);
        Ordeal_ScheduleNext();
    }
    return true;
}

void Ordeals_Init () {
    int tier;

    // TUNING is not the word: these four are from the design directly, 10 / 15 /
    // 20 / 25 percent of the energy target by tier.
    gvg_ordealRewardPct[c_ordealDawn] = 10;
    gvg_ordealRewardPct[c_ordealNoon] = 15;
    gvg_ordealRewardPct[c_ordealDusk] = 20;
    gvg_ordealRewardPct[c_ordealMidnight] = 25;

    gv_ordealActive = false;
    gv_ordealCount = 0;
    gv_ordealKilled = 0;
    gv_ordealType = "";

    // Where in its range each tier lands, drawn once so the whole night's
    // schedule exists before the first minute of it does.
    tier = 0;
    while (tier < c_diffCount) {
        gvg_ordealAtLevel[tier] = RandomInt(Ordeal_LevelMin(tier), Ordeal_LevelMax(tier));
        gvg_ordealSpent[tier] = false;
        tier = tier + 1;
    }

    gvg_ordealBeaten[c_ordealDawn] = 0;
    gvg_ordealBeaten[c_ordealNoon] = 0;
    gvg_ordealBeaten[c_ordealDusk] = 0;
    gvg_ordealBeaten[c_ordealMidnight] = 0;

    gv_ordealObj = ObjectiveCreate(
        StringExternal("Lob/Objective/Ordeal/Nothing"),
        StringExternal("Lob/Objective/Ordeal/Desc"),
        c_objectiveStateActive,
        false);

    // The first warning goes out before anything has happened, which is the
    // point: the players should walk into meltdown 1 already knowing what
    // meltdown 2 brings.
    Ordeal_ScheduleNext();

    gt_ordealTick = TriggerCreate("Ordeal_Tick_Func");
    TriggerAddEventTimePeriodic(gt_ordealTick, c_ordealTick, c_timeGame);

    gt_ordealRob = TriggerCreate("Ordeal_Rob_Func");
    TriggerAddEventUnitAbility(gt_ordealRob, null, AbilityCommand(c_ordealRobAbil, 0),
                               c_unitAbilStageAll, true);

    gt_ordealDeath = TriggerCreate("Ordeal_Died_Func");
    TriggerAddEventUnitDied(gt_ordealDeath, null);
}
