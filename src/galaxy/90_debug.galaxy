//--------------------------------------------------------------------------------------------------
// Chat commands.
//
// A test harness, not a feature. Everything here exists so that a mechanic can
// be driven by hand in a running game before the system that will drive it for
// real is written -- the alternative is testing employee stats only through a
// work order that does not exist yet, which would mean the first time either
// one runs is also the first time both run.
//
// Numbered last so it can call into anything.
//
// One trigger, one event per player, matching "-" loosely; every command is
// then parsed out of the message text. Registering an event per command would
// mean touching Init every time a command is added, and this file will collect
// commands for as long as there are unfinished systems.
//
// Deliberately not gated behind a flag. It only reaches things a player already
// owns, the map is not shipped from this branch, and a debug console that has
// to be switched on is a debug console nobody switches on. When that stops
// being true the gate goes in Debug_Init and nowhere else.
//--------------------------------------------------------------------------------------------------

const string c_debugPrefix = "-";

trigger gt_debugChat;

// The debug area, which is what it is for and which has room. Chat does not:
// -emp and -cont are several lines each and they push the actual conversation
// out of a window that is small to begin with.
//
// This went to chat for a while on a suspicion that the debug area was behind
// "TextError: 无法找到字体样式[]", because some DEBUG-tagged styles in core's
// FontStyles are marked requiredtoload. That suspicion is dead: the error was
// an unescaped <s> in the old chat help text, and the debug area never had
// anything to do with it.
//--------------------------------------------------------------------------------------------------
// What to call an abnormality in DEVELOPER output.
//
// Its unit type, not its display name. The name is a localised string now and
// cannot come back as a Galaxy string at all -- but the type is also the better
// answer: "O_03_03" is the document filename, the CUnit id and the thing you
// would grep for, where the display name is the player's handle for it.
//--------------------------------------------------------------------------------------------------
string Debug_AbnoName (unit abno) {
    int index;

    index = AbnoGen_IndexOf(abno);
    if (index < 0) {
        return UnitGetType(abno);
    }
    return gvg_abnoType[index];
}

void Debug_Say (int player, string line) {
    UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaDebug, StringToText(line));
}

// For a line that has to include a LOCALISED string. Galaxy has StringToText and
// no TextToString, so a localised string can never come back as a Galaxy string
// -- once a readout needs one of them it has to be assembled as text the whole
// way. Only the quest readout needs this; everything else in here is developer
// text and stays a plain string on purpose.
void Debug_SayText (int player, text line) {
    UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaDebug, line);
}

//--------------------------------------------------------------------------------------------------
// Which stat a word means. -1 for "all", -2 for "not a stat".
//--------------------------------------------------------------------------------------------------
const int c_debugStatAll = -1;
const int c_debugStatBad = -2;

int Debug_StatFromWord (string word) {
    if (StringEqual(word, "fort", false) || StringEqual(word, "f", false)) {
        return c_statFortitude;
    }
    if (StringEqual(word, "prud", false) || StringEqual(word, "p", false)) {
        return c_statPrudence;
    }
    if (StringEqual(word, "temp", false) || StringEqual(word, "t", false)) {
        return c_statTemperance;
    }
    if (StringEqual(word, "just", false) || StringEqual(word, "j", false)) {
        return c_statJustice;
    }
    if (StringEqual(word, "all", false) || StringEqual(word, "a", false)) {
        return c_debugStatAll;
    }
    return c_debugStatBad;
}

//--------------------------------------------------------------------------------------------------
// StringToInt raises a trigger error on an empty string rather than returning
// zero, and StringWord returns an empty string for a word that was not typed.
// So every optional argument has to come through here; -stat with no value and
// -emp spawn with no count both hit it.
//--------------------------------------------------------------------------------------------------
int Debug_Int (string word, int fallback) {
    if (word == "") {
        return fallback;
    }
    return StringToInt(word);
}

string Debug_PanicTag (unit who) {
    if (Emp_IsPanicked(who)) {
        return " PANICKED";
    }
    return "";
}

string Debug_RankName (int rank) {
    if (rank == 1) { return "I"; }
    if (rank == 2) { return "II"; }
    if (rank == 3) { return "III"; }
    if (rank == 4) { return "IV"; }
    if (rank == 5) { return "V"; }
    return "?";
}

string Debug_StatLevelName (int level) {
    if (level == 6) { return "EX"; }
    return Debug_RankName(level);
}

//--------------------------------------------------------------------------------------------------
// The employees in a player's current selection.
//
// Selection rather than a name or an index, because the point of the exercise
// is to look at one specific unit's panel while changing it. Falling back to
// every employee the player owns when nothing employee-ish is selected keeps
// "-stat all 90" useful for setting up a scenario.
//--------------------------------------------------------------------------------------------------
unitgroup Debug_TargetEmployees (int player) {
    unitgroup selected;
    unitgroup found;
    unit who;
    int count;
    int i;

    found = UnitGroupEmpty();
    selected = UnitGroupSelected(player);
    count = UnitGroupCount(selected, c_unitCountAlive);

    i = 1;
    while (i <= count) {
        who = UnitGroupUnit(selected, i);
        if (who != null && ObjectsGen_IsEmp(who)) {
            UnitGroupAdd(found, who);
        }
        i = i + 1;
    }

    if (UnitGroupCount(found, c_unitCountAlive) == 0) {
        found = Emp_Of(player);
    }
    return found;
}

//--------------------------------------------------------------------------------------------------
// Where a debug spawn goes: at the player's character, else at their core, else
// wherever they are looking.
//--------------------------------------------------------------------------------------------------
point Debug_SpawnPoint (int player) {
    unit hero;
    unit core;

    hero = Hero_Of(player);
    if (hero != null && UnitIsAlive(hero)) {
        return UnitGetPosition(hero);
    }
    core = Sector_AnyCore(player);
    if (core != null) {
        return UnitGetPosition(core);
    }
    return CameraGetTarget(player);
}

//--------------------------------------------------------------------------------------------------
// -emp
//
// One line per employee: the four raw values, the four levels they land on,
// their sum, and the rank that sum buys. Printed together on purpose -- the
// thing worth checking is that the derivation agrees with the panel, and that
// only shows up when every step of it is on screen at once.
//--------------------------------------------------------------------------------------------------
void Debug_ReportEmployees (int player) {
    unitgroup mine;
    unit who;
    int count;
    int i;
    int stat;
    int sum;
    string line;

    mine = Debug_TargetEmployees(player);
    count = UnitGroupCount(mine, c_unitCountAlive);

    if (count == 0) {
        Debug_Say(player, "emp: none (spawn some with -emp spawn 3)");
        return;
    }

    i = 1;
    while (i <= count) {
        who = UnitGroupUnit(mine, i);
        line = "emp " + IntToString(i) + ":";
        sum = 0;

        stat = 0;
        while (stat < c_statCount) {
            line = line + " " + StringSub(Emp_StatName(stat), 1, 4)
                   + "=" + IntToString(Emp_Stat(who, stat))
                   + "(" + Debug_StatLevelName(Emp_StatLevel(who, stat)) + ")";
            sum = sum + Emp_StatLevel(who, stat);
            stat = stat + 1;
        }

        line = line + "  sum=" + IntToString(sum)
               + " rank=" + Debug_RankName(Emp_Rank(who))
               + " panel=" + IntToString(UnitXPGetCurrentLevel(who, c_rankBehavior))
               + " sp=" + IntToString(Emp_SP(who)) + "/" + IntToString(Emp_SPMax(who));
        line = line + Debug_PanicTag(who);
        // Whether the room is doing anything for them. A broken employee cannot
        // walk, so one outside is not recovering at all until somebody shoots
        // them with a White round -- and that is invisible from the numbers.
        if (Sector_InRestHall(who)) {
            line = line + " [resting]";
        }
        Debug_Say(player, line);
        i = i + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// -cont
//
// One line per abnormality: grade, state, Qliphoth counter, and what its door
// is doing. The state and the door are printed together because the pairing is
// the whole mechanic -- an abnormality that has decided to leave and a door
// that is still standing is the only situation where anybody has time to react.
//--------------------------------------------------------------------------------------------------
string Debug_CellStateName (int state) {
    if (state == c_cellContained) { return "contained"; }
    if (state == c_cellEscaping) { return "ESCAPING (on its door)"; }
    if (state == c_cellLoose) { return "LOOSE"; }
    if (state == c_cellReturning) { return "returning"; }
    return "?";
}

void Debug_ReportCells (int player) {
    unit abno;
    unit door;
    string line;
    int slot;

    if (gv_cellCount == 0) {
        Debug_Say(player, "cont: no abnormality placed ("
                          + IntToString(c_abnoCount) + " have docs)");
        return;
    }

    slot = 0;
    while (slot < gv_cellCount) {
        abno = gvg_cellAbno[slot];
        door = Cont_DoorAt(gvg_cellHome[slot]);

        line = "cell " + IntToString(slot) + " " + Debug_AbnoName(abno)
               + " [" + Risk_Name(Risk_Of(abno)) + "]"
               + " " + Debug_CellStateName(gvg_cellState[slot])
               + " qlip=" + IntToString(Cont_Counter(abno))
               + " obs=" + IntToString(Cont_ObservationOfPlayer(player, AbnoGen_IndexOf(abno)))
               + "/4 box=" + IntToString(Cont_BoxesOf(player, AbnoGen_IndexOf(abno)))
               + "(next " + IntToString(AbnoGen_ObsCost(AbnoGen_IndexOf(abno),
                     Cont_ObservationOfPlayer(player, AbnoGen_IndexOf(abno)))) + ")";

        if (door == null) {
            line = line + " door=none";
        }
        else if (UnitIsAlive(door)) {
            line = line + " door=up "
                   + IntToString(FixedToInt(
                         UnitGetPropertyFixed(door, c_unitPropLifePercent, true)))
                   + "% strain=" + IntToString(UnitBehaviorCount(door, c_doorStrainBuff));
        }
        else {
            line = line + " door=DOWN";
        }

        if (Melt_IsHeld(slot)) {
            line = line + " melt=HELD";
        }
        else if (Melt_IsFlagged(slot)) {
            line = line + " melt=NAMED " + IntToString(FixedToInt(Melt_SecondsLeft(slot))) + "s";
        }

        Debug_Say(player, line);
        slot = slot + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// -ordeal | -ordeal now | -ordeal dawn|noon|dusk|midnight
//
// The pool per tier, what is coming, and what is standing.
//
// "now" runs the SCHEDULED one early and consumes it, which is the real path
// through the system. A tier name runs one of that tier out of band and does
// NOT consume the schedule -- it is how a Midnight gets looked at without a
// game that has reached meltdown 8, and how a tier the difficulty has skipped
// gets tested at all.
//--------------------------------------------------------------------------------------------------
string Debug_OrdealTier (int tier) {
    return Diff_OrdealName(tier) + " " + IntToString(Ordeal_PoolSize(tier)) + " type(s)";
}

int Debug_OrdealTierFromWord (string word) {
    if (StringEqual(word, "dawn", false)) { return c_ordealDawn; }
    if (StringEqual(word, "noon", false)) { return c_ordealNoon; }
    if (StringEqual(word, "dusk", false)) { return c_ordealDusk; }
    if (StringEqual(word, "midnight", false) || StringEqual(word, "mid", false)) {
        return c_ordealMidnight;
    }
    return -1;
}

void Debug_Ordeal (int player, string word) {
    string line;
    int tier;

    tier = Debug_OrdealTierFromWord(word);

    if (gv_ordealActive && (tier >= 0 || StringEqual(word, "now", false))) {
        Debug_Say(player, "ordeal: one is already running");
    }
    else if (tier >= 0) {
        if (Ordeal_PoolSize(tier) == 0) {
            Debug_Say(player, "ordeal: no " + Diff_OrdealName(tier) + " units authored");
        }
        else {
            // Out of band on purpose: the schedule is untouched, so the real
            // one still arrives at its own level afterwards.
            Ordeal_Begin(tier, Ordeal_Draw(tier));
        }
    }
    else if (StringEqual(word, "now", false)) {
        if (gv_ordealNextType == "") {
            Debug_Say(player, "ordeal: nothing scheduled -- no tier left within the cap");
        }
        else {
            gvg_ordealSpent[gv_ordealNextTier] = true;
            Ordeal_Begin(gv_ordealNextTier, gv_ordealNextType);
            Ordeal_ScheduleNext();
        }
    }

    line = "ordeal pool:";
    tier = 0;
    while (tier < c_diffCount) {
        line = line + "  " + Debug_OrdealTier(tier);
        tier = tier + 1;
    }
    Debug_Say(player, line);

    // The whole night's schedule, drawn at init. A spent tier will not come
    // back and a tier above the cap will never come at all.
    line = "ordeal schedule:";
    tier = 0;
    while (tier < c_diffCount) {
        line = line + "  " + Diff_OrdealName(tier) + "@" + IntToString(gvg_ordealAtLevel[tier]);
        if (tier > Diff_OrdealCap()) {
            line = line + "(capped)";
        }
        else if (gvg_ordealSpent[tier]) {
            line = line + "(done)";
        }
        tier = tier + 1;
    }
    Debug_Say(player, line);
    Debug_Say(player, "ordeal cap " + Diff_OrdealName(Diff_OrdealCap())
                      + "  melt " + IntToString(Melt_Level()));

    if (gv_ordealActive) {
        Debug_Say(player, "ordeal RUNNING " + gv_ordealType
                          + " (" + Diff_OrdealName(gv_ordealTier) + ")  standing "
                          + IntToString(Ordeal_Standing()) + "/" + IntToString(gv_ordealCount)
                          + "  pays " + IntToString(Ordeal_RewardFor(gv_ordealTier)));

        // What each entity is up to. A thief walking to a cell and a thief
        // standing next to one look identical on screen, and the twenty seconds
        // between them is the whole mechanic.
        tier = 0;
        while (tier < gv_ordealCount) {
            line = "  ent " + IntToString(tier) + " p" + IntToString(gvg_ordealHome[tier]);
            if (gvg_ordealUnit[tier] == null || !UnitIsAlive(gvg_ordealUnit[tier])) {
                line = line + " dead";
            }
            else if (gv_ordealAct == c_ordealActThief) {
                if (gvg_ordealMark[tier] == null) {
                    line = line + " idle -- no cell to rob";
                }
                else if (UnitOrderHasAbil(gvg_ordealUnit[tier], c_ordealRobAbil)) {
                    line = line + " on " + Debug_AbnoName(gvg_ordealMark[tier]);
                }
                else {
                    line = line + " marked " + Debug_AbnoName(gvg_ordealMark[tier])
                           + " but not ordered";
                }
            }
            else if (gv_ordealAct == c_ordealActBomb) {
                line = line + " fuse "
                       + IntToString(FixedToInt(gvg_ordealAt[tier] - GameGetMissionTime())) + "s";
            }
            else {
                line = line + " alive";
            }
            Debug_Say(player, line);
            tier = tier + 1;
        }
        return;
    }

    if (gv_ordealNextTier < 0) {
        Debug_Say(player, "ordeal next: NONE -- every tier within the cap has happened");
    }
    else {
        line = "ordeal next at melt " + IntToString(gv_ordealNextLevel)
               + " (" + Diff_OrdealName(gv_ordealNextTier) + "): ";
        if (gv_ordealNextType == "") {
            line = line + "NOTHING -- no units authored for that tier";
        }
        else {
            line = line + gv_ordealNextType;
        }
        Debug_Say(player, line);
    }
    Debug_Say(player, "ordeal beaten: dusk+ " + IntToString(Ordeal_BeatenAtLeast(c_ordealDusk))
                      + "  midnight " + IntToString(Ordeal_BeatenAtLeast(c_ordealMidnight)));
}

//--------------------------------------------------------------------------------------------------
// -fort [slot]
//
// Every room and corridor: level, owner, how much of it is standing. With an
// index, buys the next level there -- standing in for the upgrade button, which
// needs a room UI that does not exist.
//
// Prints the refusal reason rather than failing quietly, because "the current
// level is not finished being built" is a rule people will hit constantly and
// a dead button teaches nothing.
//--------------------------------------------------------------------------------------------------
void Debug_Fortify (int player, string word) {
    string line;
    int loc;
    int slot;
    int standing;
    int total;
    int unbuildable;
    int want;

    want = Debug_Int(word, -1);
    if (want >= 0) {
        if (Fort_UpgradeRefusal(player, want) != "") {
            Debug_Say(player, "fort: " + Fort_UpgradeRefusal(player, want));
        }
        else {
            Fort_Upgrade(player, want);
        }
    }

    if (gv_locCount == 0) {
        Debug_Say(player, "fort: no room_* or corridor_* region drawn yet ("
                          + IntToString(c_regionCount) + " regions total)");
        return;
    }

    loc = 0;
    while (loc < gv_locCount) {
        standing = 0;
        total = 0;
        slot = 0;
        while (slot < gv_slotCount) {
            if (gvg_slotLoc[slot] == loc && gvg_slotLevel[slot] <= gvg_locLevel[loc]) {
                total = total + 1;
                if (Fort_SlotFilled(slot)) {
                    standing = standing + 1;
                }
            }
            slot = slot + 1;
        }

        line = "fort " + IntToString(loc) + " " + gvg_locName[loc]
               + "  lv" + IntToString(gvg_locLevel[loc]) + "/" + IntToString(c_fortMaxLevel)
               + "  owner=";
        if (Fort_OwnerOf(loc) == 0) {
            line = line + "NOBODY";
        }
        else {
            line = line + IntToString(Fort_OwnerOf(loc));
        }
        line = line + "  standing " + IntToString(standing) + "/" + IntToString(total);
        if (unbuildable > 0) {
            // No CAbilBuild row for that unit type, so nothing can order it
            // built and the position will stay empty forever. Silence here
            // would look exactly like a lazy worker.
            line = line + "  (" + IntToString(unbuildable) + " have no build command)";
        }
        if (gvg_locLevel[loc] < c_fortMaxLevel) {
            line = line + "  next " + IntToString(gvg_fortCost[gvg_locLevel[loc] + 1]) + "m";
        }
        Debug_Say(player, line);

        // One line per position. "standing 0/1" is what a slot whose handle was
        // never recorded prints, and it is indistinguishable from a worker that
        // has not got there yet -- which is how that bug stayed hidden. Say
        // what is actually in the slot instead.
        slot = 0;
        while (slot < gv_slotCount) {
            if (gvg_slotLoc[slot] == loc) {
                line = "  slot " + IntToString(slot)
                       + " lv" + IntToString(gvg_slotLevel[slot])
                       + " " + gvg_slotType[slot] + " ";
                if (gvg_slotGuard[slot]) {
                    line = line + "[guard] ";
                }
                if (!Fort_SlotFilled(slot)) {
                    line = line + "empty";
                    if (!Fort_SlotBuildable(slot)) {
                        line = line + " (no build command)";
                    }
                    else if (Fort_SlotClaimed(slot)) {
                        line = line + " (a worker is on it)";
                    }
                }
                else if (Fort_SlotBuilding(slot)) {
                    line = line + "under construction";
                }
                else {
                    line = line + "held by " + UnitGetType(Fort_OccupantOfSlot(slot));
                }
                Debug_Say(player, line);
            }
            slot = slot + 1;
        }
        loc = loc + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// -quest [0-8] | -quest saved N
//
// The four tasks of the department you are holding: progress against goal,
// whether it is done, and which of the two halves it is in. With a number,
// moves you to that department first -- there is no selection screen,
// departments are dealt round-robin, and one tester cannot otherwise reach the
// other three sets.
//
// "saved N" pretends you arrived with N of them already in the record, which is
// the only way to see the second, third and fourth game before 16_bank can
// remember anything. It is also the only way to reach the later tasks as MAIN
// objectives rather than as tonight's bonuses.
//
// An uncountable task prints WHY it cannot be counted rather than 0/1. A task
// nobody has started and a task the map has no channel for look identical
// otherwise, and only one of those is worth working on.
//--------------------------------------------------------------------------------------------------
void Debug_Quests (int player, string word, string second) {
    string line;
    string tail;
    int step;
    int want;
    int dept;
    int quest;
    int last;
    int main;

    if (StringEqual(word, "saved", false)) {
        Quest_SetSaved(player, Dept_Of(player), Debug_Int(second, 0));
        Quest_Publish(player);
    }
    else {
        want = Debug_Int(word, -1);
        if (want >= 0 && want < c_deptCount) {
            Dept_SetOf(player, want);
            // The panel is four objectives belonging to the department you were
            // holding a moment ago, so it has to be torn down and rebuilt.
            Quest_Publish(player);
            Debug_Say(player, "quest: you are now " + gvg_deptName[want]);
        }
    }

    dept = Dept_Of(player);
    if (dept < 0 || dept >= c_deptCount) {
        Debug_Say(player, "quest: you hold no department");
        return;
    }

    main = Quest_MainOf(player);
    Debug_Say(player, "quest: " + gvg_deptName[dept]
                      + " -- record " + IntToString(Quest_SavedOf(player, dept))
                      + "/" + IntToString(c_questPerDept)
                      + ", done this game " + IntToString(Quest_DoneCount(player)));

    quest = dept * c_questPerDept;
    last = quest + c_questPerDept;
    while (quest < last) {
        line = "  " + IntToString(Quest_NumberOf(quest)) + ". ";
        if (Quest_IsSaved(player, quest)) {
            line = line + "[record] ";
        }
        else if (quest == main) {
            line = line + "[MAIN] ";
        }
        else {
            line = line + "[bonus] ";
        }

        // One line per STEP, so a split task reads here the way it reads in
        // the panel. A task with one step is unchanged by this.
        step = 0;
        while (step < Quest_StepCount(quest)) {
            tail = "  ";
            if (Quest_IsDone(player, quest)) {
                tail = tail + "DONE";
            }
            else if (!Quest_IsCountable(quest)) {
                tail = tail + "(no channel yet)";
            }
            else {
                tail = tail + IntToString(Quest_StepProgress(player, quest, step))
                       + "/" + IntToString(Quest_StepGoal(quest, step));
                if (!Quest_IsOpen(player, quest)) {
                    tail = tail + " (locked)";
                }
            }

            if (step == 0) {
                Debug_SayText(player, StringToText(line)
                              + Quest_StepTitle(quest, step) + StringToText(tail));
            }
            else {
                Debug_SayText(player, StringToText("     and ")
                              + Quest_StepTitle(quest, step) + StringToText(tail));
            }
            step = step + 1;
        }
        quest = quest + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// -bank [save|wipe]
//
// What is on disk for this player, next to what is in memory. Printed together
// because the only interesting bank question is whether they agree.
//--------------------------------------------------------------------------------------------------
void Debug_Bank (int player, string word) {
    int index;
    string line;

    if (StringEqual(word, "wipe", false)) {
        Bank_Wipe(player);
        Debug_Say(player, "bank: wiped -- this is what a first game looks like");
    }
    else if (StringEqual(word, "save", false)) {
        if (!gv_bankLoaded) {
            Debug_Say(player, "bank: not loaded yet, refusing to write over it");
        }
        else {
            Bank_WritePlayer(player);
            Debug_Say(player, "bank: saved");
        }
    }

    if (!gv_bankLoaded) {
        Debug_Say(player, "bank: still syncing (nothing is written until it lands)");
        return;
    }

    line = "bank " + c_bankName;
    if (gvg_bank[player] == null) {
        Debug_Say(player, line + ": none for this slot");
        return;
    }
    if (!BankVerify(gvg_bank[player])) {
        line = line + " [UNSIGNED/edited -- accepted anyway, it only holds unlocks]";
    }
    Debug_Say(player, line);

    index = 0;
    while (index < c_abnoCount) {
        Debug_Say(player, "  " + gvg_abnoType[index]
                          + "  obs=" + IntToString(Cont_ObservationOfPlayer(player, index)) + "/4"
                          + "  box=" + IntToString(Cont_BoxesOf(player, index))
                          + "  (on disk obs="
                          + IntToString(gvg_bankSavedLevel[Cont_BoxIndex(player, index)])
                          + " box="
                          + IntToString(gvg_bankSavedBoxes[Cont_BoxIndex(player, index)]) + ")");
        index = index + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// -diff [easy|normal|hard|brutal]
//
// Stands in for the lobby dropdown. Prints the whole table, because the point of
// per-player difficulty is that the settings differ, and a readout that only
// showed yours would make that impossible to check.
//--------------------------------------------------------------------------------------------------
void Debug_Difficulty (int player, string word) {
    int level;
    int other;

    level = Diff_FromWord(word);
    if (word != "" && level < 0) {
        Debug_Say(player, "diff: want casual, normal, hard or brutal");
        return;
    }
    if (level >= 0) {
        Diff_SetOf(player, level);
        // Immediately. A debug command exists to put the game into a state so
        // it can be looked at, and one that changed a setting while leaving
        // everything derived from it at the old value would be testing a
        // situation that cannot occur in a real game.
        Energy_Retarget();
    }

    // The mean, and what hangs off it. Printed first because it is the thing
    // that changed when somebody typed this, and it is not visible from any one
    // player's row.
    Debug_Say(player, "table = " + Diff_GlobalName()
                      + "  ordeal cap " + Diff_OrdealName(Diff_OrdealCap())
                      + "  energy " + IntToString(gv_energy)
                      + "/" + IntToString(gv_energyGoal));

    other = 1;
    while (other <= 15) {
        if (Slot_IsTablePlayer(other)) {
            Debug_Say(player, "diff p" + IntToString(other) + " = "
                              + Diff_NameOf(other)
                              + " (waves " + IntToString(Diff_WavePct(other)) + "%"
                              + ", next " + IntToString(Waves_SizeFor(other)) + ")"
                              + "  dept=" + Dept_NameOf(other));
        }
        other = other + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// -melt [now]
//
// The clock, and a way to make it fire without waiting out the countdown.
//
// Prints the owner of every cell as well, because ownership is spatial -- panel
// first, nearest core second -- and a cell that silently belongs to nobody is
// a cell that is never named, which looks exactly like a broken meltdown.
//--------------------------------------------------------------------------------------------------
void Debug_Meltdown (int player, string word) {
    int slot;
    int owner;
    string line;

    if (StringEqual(word, "now", false)) {
        Melt_Advance();
    }

    Debug_Say(player, "meltdown level " + IntToString(Melt_Level())
                      + "  next round in " + IntToString(FixedToInt(Melt_SecondsToRound())) + "s"
                      + "  up to " + IntToString(Melt_Targets()) + " outstanding per player"
                      + "  answered=" + IntToString(Melt_AnsweredBy(player))
                      + " missed=" + IntToString(Melt_MissedBy(player)));

    slot = 0;
    while (slot < gv_cellCount) {
        owner = Cont_OwnerOf(slot);
        line = "  cell " + IntToString(slot) + " "
               + Debug_AbnoName(gvg_cellAbno[slot]) + " owner=";
        if (owner == 0) {
            line = line + "NOBODY (no panel, no core)";
        }
        else {
            line = line + IntToString(owner);
        }
        if (Melt_IsHeld(slot)) {
            line = line + " HELD (a work is still running)";
        }
        else if (Melt_IsFlagged(slot)) {
            line = line + " NAMED " + IntToString(FixedToInt(Melt_SecondsLeft(slot))) + "s left";
        }
        Debug_Say(player, line);
        slot = slot + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// -breach [slot]
//
// Drives the decision the meltdown clock will drive later: the abnormality
// decides to leave. It still has to get through its own door, which is the part
// worth watching.
//--------------------------------------------------------------------------------------------------
void Debug_Breach (int player, string slotWord) {
    int slot;

    if (gv_cellCount == 0) {
        Debug_Say(player, "breach: nothing to let out");
        return;
    }

    slot = Debug_Int(slotWord, 0);
    if (slot < 0 || slot >= gv_cellCount) {
        Debug_Say(player, "breach: slot 0.." + IntToString(gv_cellCount - 1));
        return;
    }

    Cont_BeginEscape(gvg_cellAbno[slot]);
    Debug_ReportCells(player);
}

//--------------------------------------------------------------------------------------------------
// -obs <slot>
//
// Buys the next section of that abnormality's encyclopedia with the boxes this
// player took out of it. Stands in for the panel's buttons, which cannot exist
// as a generic unit -- see the module note in 13_containment.
//--------------------------------------------------------------------------------------------------
void Debug_Observe (int player, string word) {
    int slot;
    int index;

    slot = Debug_Int(word, -1);
    if (slot < 0 || slot >= gv_cellCount) {
        Debug_Say(player, "obs: want a slot 0.." + IntToString(gv_cellCount - 1));
        return;
    }

    index = AbnoGen_IndexOf(gvg_cellAbno[slot]);
    if (!Cont_Observe(player, index)) {
        Debug_Say(player, "obs: not enough boxes, or nothing left to learn");
    }
    Debug_ReportCells(player);
}

//--------------------------------------------------------------------------------------------------
// -sp <n> | -sp me <n>
//
// Signed, so -sp -30 is how panic gets tested without waiting for thirty failed
// boxes. Panic latches at zero and only lets go at full, so getting back out is
// -sp 999 rather than -sp 1 -- which is the rule, not a rounding.
//
// "me" targets the player character, whose breakdown is a different behavior
// with different consequences and which nothing else in the greybox can reach:
// no source of player SP loss exists yet on purpose.
//--------------------------------------------------------------------------------------------------
void Debug_SP (int player, string word, string more) {
    unitgroup mine;
    unit who;
    int count;
    int i;

    if (StringEqual(word, "me", false)) {
        mine = UnitGroupEmpty();
        UnitGroupAdd(mine, Hero_Of(player));
    }
    else {
        mine = Debug_TargetEmployees(player);
        more = word;
    }

    // break / full are absolute; a bare number is a delta. Both forms exist
    // because "-sp 0" is what anybody reaches for first to break somebody, and
    // as a delta it does exactly nothing -- a command that silently no-ops is
    // worse than one that does not exist.
    count = UnitGroupCount(mine, c_unitCountAlive);
    i = 1;
    while (i <= count) {
        who = UnitGroupUnit(mine, i);
        if (StringEqual(more, "break", false)) {
            SP_Add(who, -Emp_SPMax(who));
        }
        else if (StringEqual(more, "full", false)) {
            SP_Add(who, Emp_SPMax(who));
        }
        else {
            SP_Add(who, Debug_Int(more, 0));
        }
        i = i + 1;
    }
    Debug_ReportEmployees(player);
    Debug_Say(player, "sp me " + IntToString(Emp_SP(Hero_Of(player)))
                      + "/" + IntToString(Emp_SPMax(Hero_Of(player)))
                      + Debug_PanicTag(Hero_Of(player)));
}

//--------------------------------------------------------------------------------------------------
// -work <inst|insi|atta|repr>
//
// Sets what the next employee sent to a door will do. Sending is the game's own
// right-click; there is no order UI yet and this stands in for the part of it
// that chooses.
//--------------------------------------------------------------------------------------------------
int Debug_WorkFromWord (string word) {
    if (StringEqual(word, "inst", false) || StringEqual(word, "i", false)) {
        return c_workInstinct;
    }
    if (StringEqual(word, "insi", false) || StringEqual(word, "n", false)) {
        return c_workInsight;
    }
    if (StringEqual(word, "atta", false) || StringEqual(word, "a", false)) {
        return c_workAttachment;
    }
    if (StringEqual(word, "repr", false) || StringEqual(word, "r", false)) {
        return c_workRepression;
    }
    return -1;
}

void Debug_Work (int player, string word) {
    unit abno;
    int work;
    int slot;
    string line;

    work = Debug_WorkFromWord(word);
    if (work >= 0) {
        Work_SetDefault(player, work);
    }

    Debug_Say(player, "work: sending an employee to a door does "
                      + Work_Name(Work_DefaultOf(player))
                      + " (inst|insi|atta|repr)");

    // The odds for that work against each abnormality, at this player's
    // employees' current level in the matching stat. This is the whole reason
    // to choose one work over another, so it should not need a wiki open.
    slot = 0;
    while (slot < gv_cellCount) {
        abno = gvg_cellAbno[slot];
        // The cost of being wrong belongs next to the odds of being wrong. On
        // one abnormality a missed box is a bad afternoon; on another it is a
        // funeral, and that is not visible from a percentage.
        line = "  " + Debug_AbnoName(abno)
               + " [miss: " + AbnoGen_DmgText(AbnoGen_IndexOf(abno)) + "]:";
        work = 0;
        while (work < c_workCount) {
            line = line + " " + StringSub(Work_Name(work), 1, 4) + "=";
            if (UnitGroupCount(Emp_Of(player), c_unitCountAlive) > 0) {
                line = line + IntToString(AbnoGen_Pref(
                    AbnoGen_IndexOf(abno), work,
                    Emp_StatLevel(UnitGroupUnit(Emp_Of(player), 1), Work_Stat(work))))
                    + "%";
            }
            else {
                line = line + IntToString(AbnoGen_Pref(AbnoGen_IndexOf(abno), work, 1))
                       + "%@I";
            }
            work = work + 1;
        }
        Debug_Say(player, line);
        slot = slot + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// -energy
//--------------------------------------------------------------------------------------------------
void Debug_Energy (int player, string word) {
    if (StringEqual(word, "submit", false)) {
        if (Energy_CanSubmit()) {
            Energy_Submit(player);
        }
        else {
            Debug_Say(player, "energy: not enough yet");
        }
        return;
    }
    if (word != "") {
        Energy_Add(Debug_Int(word, 0));
    }
    // Galaxy has no conditional expression, so this is two statements.
    if (Energy_CanSubmit()) {
        Debug_Say(player, "energy " + IntToString(gv_energy) + "/"
                          + IntToString(gv_energyGoal) + "  -- -energy submit to end it");
        return;
    }
    Debug_Say(player, "energy " + IntToString(gv_energy) + "/" + IntToString(gv_energyGoal));
}

//--------------------------------------------------------------------------------------------------
// -qlip <slot> <n>
//
// The counter without the thing that moves it, since the thing that moves it is
// the meltdown clock and work results, neither of which exists.
//--------------------------------------------------------------------------------------------------
void Debug_SetCounter (int player, string slotWord, string valueWord) {
    int slot;

    slot = Debug_Int(slotWord, -1);
    if (slot < 0 || slot >= gv_cellCount) {
        Debug_Say(player, "qlip: want a slot 0.." + IntToString(gv_cellCount - 1));
        return;
    }

    Cont_SetCounter(gvg_cellAbno[slot], Debug_Int(valueWord, 0));
    Debug_ReportCells(player);
}

//--------------------------------------------------------------------------------------------------
// -emp spawn [n]
//--------------------------------------------------------------------------------------------------
void Debug_SpawnEmployees (int player, int howMany) {
    if (c_typesEmpCount == 0) {
        Debug_Say(player, "emp: no Lob_Emp_* unit type is authored");
        return;
    }
    if (howMany < 1) {
        howMany = 1;
    }

    UnitCreate(howMany, gvg_typesEmp[0], c_unitCreateIgnorePlacement,
               player, Debug_SpawnPoint(player), 270.0);
    Debug_Say(player, "emp: spawned " + IntToString(howMany) + " " + gvg_typesEmp[0]);
}

//--------------------------------------------------------------------------------------------------
// -stat <fort|prud|temp|just|all> <value>
//
// A leading + or - on the value makes it relative, which is the only way to
// exercise Emp_StatAdd's signed path -- the one Training Team's "push a stat
// back down" will use.
//--------------------------------------------------------------------------------------------------
void Debug_SetStat (int player, string whichWord, string valueWord) {
    unitgroup mine;
    unit who;
    int which;
    int value;
    int count;
    int i;
    int stat;
    bool relative;
    string firstChar;

    which = Debug_StatFromWord(whichWord);
    if (which == c_debugStatBad) {
        Debug_Say(player, "stat: want fort|prud|temp|just|all");
        return;
    }
    if (valueWord == "") {
        Debug_Say(player, "stat: want a value, or +n / -n to move it");
        return;
    }

    firstChar = StringSub(valueWord, 1, 1);
    relative = firstChar == "+" || firstChar == "-";
    if (firstChar == "+") {
        // StringToInt does not have to know what a leading + means.
        valueWord = StringSub(valueWord, 2, StringLength(valueWord));
    }
    value = Debug_Int(valueWord, 0);

    mine = Debug_TargetEmployees(player);
    count = UnitGroupCount(mine, c_unitCountAlive);

    i = 1;
    while (i <= count) {
        who = UnitGroupUnit(mine, i);
        stat = 0;
        while (stat < c_statCount) {
            if (which == c_debugStatAll || which == stat) {
                if (relative) {
                    Emp_StatAdd(who, stat, value);
                }
                else {
                    Emp_StatSet(who, stat, value);
                }
            }
            stat = stat + 1;
        }
        Emp_SyncRank(who);
        i = i + 1;
    }

    Debug_ReportEmployees(player);
}

//--------------------------------------------------------------------------------------------------
// The command reference, in the help panel rather than in chat.
//
// Placeholders are written NAME and VALUE rather than <name> and <value>, and
// that is not a style preference. SC2 parses < > in displayed text as markup:
// <s> is the font style tag, and a style tag with no val asks for the style
// named "", which is where "TextError: 无法找到字体样式[]" came from. The old
// chat help printed "-stat <s> <v>", so that error fired every time somebody
// typed -help. Any angle bracket in text that reaches a player has to be
// escaped or avoided.
//
// It used to print itself into the chat window, and it had quietly stopped
// being a reference: the list outgrew the panel, so it scrolled its own top
// off, and a list you can only read the bottom of is worse than no list. The
// help panel is paged, scrollable and already bound to F12, and it is where a
// player looks for "what can I do".
//
// The descriptions say what the mechanic is rather than only what the syntax
// is, because there is room for that here and it is what somebody reading this
// actually wants. Half of these commands stand in for a system that does not
// exist yet, and which one is which is worth knowing.
//
// Added once at init, to everybody. Nothing removes them; the panel is not a
// place state lives.
//--------------------------------------------------------------------------------------------------
void Debug_Tip (string title, string body, string icon) {
    HelpPanelAddTip(PlayerGroupAll(), StringToText(title), StringToText(body),
                    StringToText(""), icon);
}

void Debug_BuildHelp () {
    Debug_Tip(
        "Debug console",
        "Type these into chat. Everything here is a test harness: it drives a "
        + "mechanic by hand so it can be watched before the system that will "
        + "drive it for real exists.<n/><n/>"
        + "Nothing here reaches anything a player does not already own.",
        "Assets\\Textures\\btn-ability-terran-battlefieldawareness.dds");

    Debug_Tip(
        "Employees",
        "<c val=\"ffff8a\">-emp</c>  the selected employees: four stats, the level "
        + "each lands on, their sum, the rank that sum buys, and SP.<n/>"
        + "<c val=\"ffff8a\">-emp spawn [n]</c>  spawn n at your character.<n/>"
        + "<c val=\"ffff8a\">-stat NAME VALUE</c>  set a stat. s is fort, prud, temp, just or all.<n/>"
        + "<c val=\"ffff8a\">-stat NAME +5</c>  move it instead of setting it; negatives work.<n/>"
        + "<c val=\"ffff8a\">-sp break</c>  straight to zero, which latches panic.  "
        + "<c val=\"ffff8a\">-sp full</c>  back to the top, which opens it.  "
        + "<c val=\"ffff8a\">-sp N</c>  move it by N.<n/>"
        + "Applies to the employees you have SELECTED, or to all of yours if "
        + "none are.  <c val=\"ffff8a\">-sp me break</c>  for your own character.<n/><n/>"
        + "Rank is the SUM of the four stat levels, not the lowest, so a "
        + "three-stat specialist with one stat left deliberately low is still "
        + "rank V. Abnormalities that require a stat to stay BELOW some value "
        + "depend on that.",
        "Assets\\Textures\\btn-upgrade-terran-infantryarmorlevel1.dds");

    Debug_Tip(
        "Containment",
        "<c val=\"ffff8a\">-cont</c>  every cell: grade, state, Qliphoth counter, "
        + "observation, and what its door is doing.<n/>"
        + "<c val=\"ffff8a\">-breach [slot]</c>  that abnormality decides to leave. It "
        + "still has to get through its own door, which is the part worth watching.<n/>"
        + "<c val=\"ffff8a\">-qlip SLOT N</c>  set a Qliphoth counter.<n/>"
        + "<c val=\"ffff8a\">-obs SLOT</c>  buy the next encyclopedia section with the "
        + "PE-Boxes taken out of that abnormality.<n/><n/>"
        + "Suppression is defeat, not death: a beaten abnormality goes home, its "
        + "counter resets and its door comes back whole. A breach costs "
        + "employees, time and everybody's attention, and never a slot.",
        "Assets\\Textures\\btn-ability-terran-holdfire.dds");

    Debug_Tip(
        "Work",
        "Select an employee, press Work, click a containment door. One second of "
        + "casting, then the boxes start.<n/><n/>"
        + "<c val=\"ffff8a\">-work TYPE</c>  what the next one will do: inst, insi, atta "
        + "or repr. Prints each abnormality's odds for all four at your "
        + "employees' current levels, so the choice needs no wiki.<n/><n/>"
        + "One roll per box. The chance is keyed to the LEVEL of the stat that "
        + "work uses, so 30 and 44 of a stat are the same to an abnormality.<n/><n/>"
        + "What a missed box costs is the abnormality's own, printed next to its "
        + "odds. <c val=\"ffff8a\">White</c> is the mind and shows nowhere until "
        + "the person breaks. <c val=\"ffff8a\">Red</c> is the body. "
        + "<c val=\"ffff8a\">Black</c> splits evenly between the two, so the "
        + "number printed is the total. "
        + "<c val=\"ffff8a\">Pale</c> is a percentage of maximum life -- and "
        + "since Fortitude IS maximum life, it is the one an employee cannot "
        + "outgrow. Employees do not go down; they die.",
        "Assets\\Textures\\btn-upgrade-terran-infantryweaponslevel1.dds");

    Debug_Tip(
        "Meltdown",
        "<c val=\"ffff8a\">-melt</c>  the clock, and who owns each cell.<n/>"
        + "<c val=\"ffff8a\">-melt now</c>  start the next round immediately.<n/><n/>"
        + "Every 60 seconds a meltdown names cells in each player's own sector, "
        + "and a named cell has 60 seconds for a work to BEGIN on it. Begin, not "
        + "finish: what it asks is that somebody was sent. A cell that is missed "
        + "has its Qliphoth counter set to zero, not reduced, and the table "
        + "loses a share of the energy pool.<n/><n/>"
        + "A cell that was already busy when it got named is HELD -- it does not "
        + "start counting until that work ends, however it ends. The employee "
        + "inside cannot be sent again, so the window would not be a window. The "
        + "work in flight does not answer the meltdown either; when it ends, "
        + "somebody still has to go.<n/><n/>"
        + "The clock is shared but the named cells are yours. A neighbour who "
        + "ignores theirs breaches their own abnormality, and what reaches you "
        + "is a fight -- never a cut to your income or your employees.",
        "Assets\\Textures\\btn-ability-terran-nuclearstrike.dds");

    Debug_Tip(
        "Energy, and how this ends",
        "<c val=\"ffff8a\">-energy</c>  the meter.  <c val=\"ffff8a\">-energy N</c>  add to it.  "
        + "<c val=\"ffff8a\">-energy submit</c>  end the game.<n/><n/>"
        + "Every box pays twice: once into your own stock for that one "
        + "abnormality's encyclopedia, and the same amount again into a pool the "
        + "whole table shares. Filling the pool is the win condition, so studying "
        + "abnormalities and winning are the same activity.<n/><n/>"
        + "Nothing is ever spent out of the pool and nobody's rate depends on "
        + "anybody else's. It is a scoreboard, not a wallet.",
        "Assets\\Textures\\btn-ability-terran-stimpack-color.dds");

    Debug_Tip(
        "Damage types, and the bridge",
        "<c val=\"ffff8a\">-dmg on|off</c>  echo every White hit the bridge "
        + "intercepts, with every number the engine exposes.<n/><n/>"
        + "THE ENGINE\'S Kind FIELD IS OUR DAMAGE TYPE.  Melee = RED, Ranged = "
        + "WHITE, Spell = BLACK, Splash = PALE.  Kind takes exactly four values "
        + "in all of StarCraft and we have exactly four types, so E.G.O weapons "
        + "carry REAL numbers and the unit panel shows the truth.<n/><n/>"
        + "An abnormality\'s four defences are then four lines of "
        + "DamageTakenFraction and no script at all -- the Crimson Dawn already "
        + "has its wiki table on it.<n/><n/>"
        + "Only one direction needs us: White, Black and Pale landing on a "
        + "PERSON, because SP is not something the engine can be told to spend.  "
        + "A hidden buff takes the life loss to zero and this file spends the "
        + "number instead.  Against a monster every type is just damage, Pale "
        + "included.<n/><n/>"
        + "The player carries a probe White weapon.  Point it at a broken "
        + "colleague: it should give sanity BACK, and it should pick them up on "
        + "its own without being ordered, because being broken sets Passive and "
        + "that is what the weapon hunts.",
        "Assets\\Textures\\btn-ability-terran-heal.dds");

    Debug_Tip(
        "Ordeals",
        "<c val=\"ffff8a\">-ordeal</c>  the whole night's schedule, what is coming, and "
        + "how many types each tier has to draw from.<n/>"
        + "<c val=\"ffff8a\">-ordeal now</c>  run the scheduled one early; it is used up.<n/>"
        + "<c val=\"ffff8a\">-ordeal dawn|noon|dusk|midnight</c>  run one out of band, "
        + "leaving the schedule alone.<n/><n/>"
        + "FOUR in a night, one per tier: a Dawn at meltdown 2, a Noon somewhere "
        + "in 3 to 5, a Dusk in 6 or 7, a Midnight at 8. Which level inside each "
        + "range is drawn when the game starts, so the schedule exists before the "
        + "first minute of it does.<n/><n/>"
        + "Difficulty SKIPS the tiers above it rather than weakening them. On "
        + "Casual the night has one Ordeal in it and then none.<n/><n/>"
        + "You are always told which one is next before it lands, because a "
        + "surprise cannot be prepared for and preparing is the whole game.<n/><n/>"
        + "One entity per department. Suppressing all of them pays 10 / 15 / 20 / "
        + "25 percent of the ENERGY TARGET into the pool, by tier.",
        "Assets\\Textures\\btn-ability-terran-holdfire.dds");

    Debug_Tip(
        "Fortifications",
        "<c val=\"ffff8a\">-fort</c>  every room and corridor: level, owner, how much "
        + "of it is standing.<n/>"
        + "<c val=\"ffff8a\">-fort N</c>  buy the next level there.<n/><n/>"
        + "The upgrade completes instantly and the level never drops, however "
        + "much is destroyed. The BUILDINGS are not instant -- workers walk over "
        + "and put them up, then repair and rebuild them free forever. So money "
        + "and time are separate costs, and how fast you get what you paid for "
        + "depends on how many workers you built ten minutes ago.<n/><n/>"
        + "A level cannot be bought until the previous one is fully standing, "
        + "and buildings under attack never finish. So a place that is being "
        + "overrun cannot be reinforced: win the fight, then buy the answer.<n/><n/>"
        + "Garrison warps in the first time a level stands, and buying a level "
        + "replaces earlier casualties. Rebuilding after a massacre does not -- "
        + "dead guards stay dead until somebody spends money.",
        "Assets\\Textures\\btn-building-terran-bunker.dds");

    Debug_Tip(
        "The save file",
        "<c val=\"ffff8a\">-bank</c>  what is in memory next to what is on disk.<n/>"
        + "<c val=\"ffff8a\">-bank save</c>  write now.  "
        + "<c val=\"ffff8a\">-bank wipe</c>  throw it away, which is the only way to "
        + "ask \"does a fresh account work\" more than once.<n/><n/>"
        + "It stores unlocks and never numbers: your observation level on each "
        + "abnormality and the PE-Boxes left to buy the next section with. Not "
        + "employee stats, not upgrades, not resources -- a persisted number "
        + "would make a character's strength a function of hours played rather "
        + "than of skill.<n/><n/>"
        + "Nothing is written until every player's file has finished syncing. "
        + "Writing during that window would put a fresh empty table over a real "
        + "save, and nobody would be able to tell what happened.<n/><n/>"
        + "<c val=\"ffff8a\">-codec</c>  round-trips the packer the save format "
        + "will switch to when a key per value stops being enough. Nothing uses "
