//--------------------------------------------------------------------------------------------------
// Chat commands.
//
// A test harness, not a feature. Everything here exists so that a mechanic can
// be driven by hand in a running game before the system that will drive it for
// real is written -- the alternative is testing employee stats only through a
// work order that does not exist yet, which would mean the first time either
// one runs is also the first time both run.
//
// Numbered last so it can call into anything.
//
// One trigger, one event per player, matching "-" loosely; every command is
// then parsed out of the message text. Registering an event per command would
// mean touching Init every time a command is added, and this file will collect
// commands for as long as there are unfinished systems.
//
// Deliberately not gated behind a flag. It only reaches things a player already
// owns, the map is not shipped from this branch, and a debug console that has
// to be switched on is a debug console nobody switches on. When that stops
// being true the gate goes in Debug_Init and nowhere else.
//--------------------------------------------------------------------------------------------------

const string c_debugPrefix = "-";

trigger gt_debugChat;

// The debug area, which is what it is for and which has room. Chat does not:
// -emp and -cont are several lines each and they push the actual conversation
// out of a window that is small to begin with.
//
// This went to chat for a while on a suspicion that the debug area was behind
// "TextError: 无法找到字体样式[]", because some DEBUG-tagged styles in core's
// FontStyles are marked requiredtoload. That suspicion is dead: the error was
// an unescaped <s> in the old chat help text, and the debug area never had
// anything to do with it.
void Debug_Say (int player, string line) {
    UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaDebug, StringToText(line));
}

//--------------------------------------------------------------------------------------------------
// Which stat a word means. -1 for "all", -2 for "not a stat".
//--------------------------------------------------------------------------------------------------
const int c_debugStatAll = -1;
const int c_debugStatBad = -2;

int Debug_StatFromWord (string word) {
    if (StringEqual(word, "fort", false) || StringEqual(word, "f", false)) {
        return c_statFortitude;
    }
    if (StringEqual(word, "prud", false) || StringEqual(word, "p", false)) {
        return c_statPrudence;
    }
    if (StringEqual(word, "temp", false) || StringEqual(word, "t", false)) {
        return c_statTemperance;
    }
    if (StringEqual(word, "just", false) || StringEqual(word, "j", false)) {
        return c_statJustice;
    }
    if (StringEqual(word, "all", false) || StringEqual(word, "a", false)) {
        return c_debugStatAll;
    }
    return c_debugStatBad;
}

//--------------------------------------------------------------------------------------------------
// StringToInt raises a trigger error on an empty string rather than returning
// zero, and StringWord returns an empty string for a word that was not typed.
// So every optional argument has to come through here; -stat with no value and
// -emp spawn with no count both hit it.
//--------------------------------------------------------------------------------------------------
int Debug_Int (string word, int fallback) {
    if (word == "") {
        return fallback;
    }
    return StringToInt(word);
}

string Debug_RankName (int rank) {
    if (rank == 1) { return "I"; }
    if (rank == 2) { return "II"; }
    if (rank == 3) { return "III"; }
    if (rank == 4) { return "IV"; }
    if (rank == 5) { return "V"; }
    return "?";
}

string Debug_StatLevelName (int level) {
    if (level == 6) { return "EX"; }
    return Debug_RankName(level);
}

//--------------------------------------------------------------------------------------------------
// The employees in a player's current selection.
//
// Selection rather than a name or an index, because the point of the exercise
// is to look at one specific unit's panel while changing it. Falling back to
// every employee the player owns when nothing employee-ish is selected keeps
// "-stat all 90" useful for setting up a scenario.
//--------------------------------------------------------------------------------------------------
unitgroup Debug_TargetEmployees (int player) {
    unitgroup selected;
    unitgroup found;
    unit who;
    int count;
    int i;

    found = UnitGroupEmpty();
    selected = UnitGroupSelected(player);
    count = UnitGroupCount(selected, c_unitCountAlive);

    i = 1;
    while (i <= count) {
        who = UnitGroupUnit(selected, i);
        if (who != null && ObjectsGen_IsEmp(who)) {
            UnitGroupAdd(found, who);
        }
        i = i + 1;
    }

    if (UnitGroupCount(found, c_unitCountAlive) == 0) {
        found = Emp_Of(player);
    }
    return found;
}

//--------------------------------------------------------------------------------------------------
// Where a debug spawn goes: at the player's character, else at their core, else
// wherever they are looking.
//--------------------------------------------------------------------------------------------------
point Debug_SpawnPoint (int player) {
    unit core;

    if (gv_hero != null && UnitIsAlive(gv_hero) && UnitGetOwner(gv_hero) == player) {
        return UnitGetPosition(gv_hero);
    }
    core = Sector_AnyCore(player);
    if (core != null) {
        return UnitGetPosition(core);
    }
    return CameraGetTarget(player);
}

//--------------------------------------------------------------------------------------------------
// -emp
//
// One line per employee: the four raw values, the four levels they land on,
// their sum, and the rank that sum buys. Printed together on purpose -- the
// thing worth checking is that the derivation agrees with the panel, and that
// only shows up when every step of it is on screen at once.
//--------------------------------------------------------------------------------------------------
void Debug_ReportEmployees (int player) {
    unitgroup mine;
    unit who;
    int count;
    int i;
    int stat;
    int sum;
    string line;

    mine = Debug_TargetEmployees(player);
    count = UnitGroupCount(mine, c_unitCountAlive);

    if (count == 0) {
        Debug_Say(player, "emp: none (spawn some with -emp spawn 3)");
        return;
    }

    i = 1;
    while (i <= count) {
        who = UnitGroupUnit(mine, i);
        line = "emp " + IntToString(i) + ":";
        sum = 0;

        stat = 0;
        while (stat < c_statCount) {
            line = line + " " + StringSub(Emp_StatName(stat), 1, 4)
                   + "=" + IntToString(Emp_Stat(who, stat))
                   + "(" + Debug_StatLevelName(Emp_StatLevel(who, stat)) + ")";
            sum = sum + Emp_StatLevel(who, stat);
            stat = stat + 1;
        }

        line = line + "  sum=" + IntToString(sum)
               + " rank=" + Debug_RankName(Emp_Rank(who))
               + " panel=" + IntToString(UnitXPGetCurrentLevel(who, c_rankBehavior))
               + " sp=" + IntToString(Emp_SP(who)) + "/" + IntToString(Emp_SPMax(who));
        if (Emp_IsPanicked(who)) {
            line = line + " PANICKED";
        }
        Debug_Say(player, line);
        i = i + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// -cont
//
// One line per abnormality: grade, state, Qliphoth counter, and what its door
// is doing. The state and the door are printed together because the pairing is
// the whole mechanic -- an abnormality that has decided to leave and a door
// that is still standing is the only situation where anybody has time to react.
//--------------------------------------------------------------------------------------------------
string Debug_CellStateName (int state) {
    if (state == c_cellContained) { return "contained"; }
    if (state == c_cellEscaping) { return "ESCAPING (on its door)"; }
    if (state == c_cellLoose) { return "LOOSE"; }
    if (state == c_cellReturning) { return "returning"; }
    return "?";
}

void Debug_ReportCells (int player) {
    unit abno;
    unit door;
    string line;
    int slot;

    if (gv_cellCount == 0) {
        Debug_Say(player, "cont: no abnormality placed ("
                          + IntToString(c_abnoCount) + " have docs)");
        return;
    }

    slot = 0;
    while (slot < gv_cellCount) {
        abno = gvg_cellAbno[slot];
        door = Cont_DoorAt(gvg_cellHome[slot]);

        line = "cell " + IntToString(slot) + " " + gvg_abnoName[AbnoGen_IndexOf(abno)]
               + " [" + Risk_Name(Risk_Of(abno)) + "]"
               + " " + Debug_CellStateName(gvg_cellState[slot])
               + " qlip=" + IntToString(Cont_Counter(abno))
               + " obs=" + IntToString(Cont_ObservationOfPlayer(player, AbnoGen_IndexOf(abno)))
               + "/4 box=" + IntToString(Cont_BoxesOf(player, AbnoGen_IndexOf(abno)))
               + "(next " + IntToString(AbnoGen_ObsCost(AbnoGen_IndexOf(abno),
                     Cont_ObservationOfPlayer(player, AbnoGen_IndexOf(abno)))) + ")";

        if (door == null) {
            line = line + " door=none";
        }
        else if (UnitIsAlive(door)) {
            line = line + " door=up "
                   + IntToString(FixedToInt(
                         UnitGetPropertyFixed(door, c_unitPropLifePercent, true)))
                   + "% strain=" + IntToString(UnitBehaviorCount(door, c_doorStrainBuff));
        }
        else {
            line = line + " door=DOWN";
        }

        if (Melt_IsHeld(slot)) {
            line = line + " melt=HELD";
        }
        else if (Melt_IsFlagged(slot)) {
            line = line + " melt=NAMED " + IntToString(FixedToInt(Melt_SecondsLeft(slot))) + "s";
        }

        Debug_Say(player, line);
        slot = slot + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// -melt [now]
//
// The clock, and a way to make it fire without waiting out the countdown.
//
// Prints the owner of every cell as well, because ownership is spatial -- panel
// first, nearest core second -- and a cell that silently belongs to nobody is
// a cell that is never named, which looks exactly like a broken meltdown.
//--------------------------------------------------------------------------------------------------
void Debug_Meltdown (int player, string word) {
    int slot;
    int owner;
    string line;

    if (StringEqual(word, "now", false)) {
        Melt_Advance();
    }

    Debug_Say(player, "meltdown level " + IntToString(Melt_Level())
                      + "  next round in " + IntToString(FixedToInt(Melt_SecondsToRound())) + "s"
                      + "  up to " + IntToString(Melt_Targets()) + " outstanding per player"
                      + "  answered=" + IntToString(Melt_AnsweredBy(player))
                      + " missed=" + IntToString(Melt_MissedBy(player)));

    slot = 0;
    while (slot < gv_cellCount) {
        owner = Melt_OwnerOf(slot);
        line = "  cell " + IntToString(slot) + " "
               + gvg_abnoName[AbnoGen_IndexOf(gvg_cellAbno[slot])] + " owner=";
        if (owner == 0) {
            line = line + "NOBODY (no panel, no core)";
        }
        else {
            line = line + IntToString(owner);
        }
        if (Melt_IsHeld(slot)) {
            line = line + " HELD (a work is still running)";
        }
        else if (Melt_IsFlagged(slot)) {
            line = line + " NAMED " + IntToString(FixedToInt(Melt_SecondsLeft(slot))) + "s left";
        }
        Debug_Say(player, line);
        slot = slot + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// -breach [slot]
//
// Drives the decision the meltdown clock will drive later: the abnormality
// decides to leave. It still has to get through its own door, which is the part
// worth watching.
//--------------------------------------------------------------------------------------------------
void Debug_Breach (int player, string slotWord) {
    int slot;

    if (gv_cellCount == 0) {
        Debug_Say(player, "breach: nothing to let out");
        return;
    }

    slot = Debug_Int(slotWord, 0);
    if (slot < 0 || slot >= gv_cellCount) {
        Debug_Say(player, "breach: slot 0.." + IntToString(gv_cellCount - 1));
        return;
    }

    Cont_BeginEscape(gvg_cellAbno[slot]);
    Debug_ReportCells(player);
}

//--------------------------------------------------------------------------------------------------
// -obs <slot>
//
// Buys the next section of that abnormality's encyclopedia with the boxes this
// player took out of it. Stands in for the panel's buttons, which cannot exist
// as a generic unit -- see the module note in 13_containment.
//--------------------------------------------------------------------------------------------------
void Debug_Observe (int player, string word) {
    int slot;
    int index;

    slot = Debug_Int(word, -1);
    if (slot < 0 || slot >= gv_cellCount) {
        Debug_Say(player, "obs: want a slot 0.." + IntToString(gv_cellCount - 1));
        return;
    }

    index = AbnoGen_IndexOf(gvg_cellAbno[slot]);
    if (!Cont_Observe(player, index)) {
        Debug_Say(player, "obs: not enough boxes, or nothing left to learn");
    }
    Debug_ReportCells(player);
}

//--------------------------------------------------------------------------------------------------
// -sp <n>
//
// Signed, so -sp -30 is how panic gets tested without waiting for thirty failed
// boxes.
//--------------------------------------------------------------------------------------------------
void Debug_SP (int player, string word) {
    unitgroup mine;
    int count;
    int i;

    mine = Debug_TargetEmployees(player);
    count = UnitGroupCount(mine, c_unitCountAlive);
    i = 1;
    while (i <= count) {
        SP_Add(UnitGroupUnit(mine, i), Debug_Int(word, 0));
        i = i + 1;
    }
    Debug_ReportEmployees(player);
}

//--------------------------------------------------------------------------------------------------
// -work <inst|insi|atta|repr>
//
// Sets what the next employee sent to a door will do. Sending is the game's own
// right-click; there is no order UI yet and this stands in for the part of it
// that chooses.
//--------------------------------------------------------------------------------------------------
int Debug_WorkFromWord (string word) {
    if (StringEqual(word, "inst", false) || StringEqual(word, "i", false)) {
        return c_workInstinct;
    }
    if (StringEqual(word, "insi", false) || StringEqual(word, "n", false)) {
        return c_workInsight;
    }
    if (StringEqual(word, "atta", false) || StringEqual(word, "a", false)) {
        return c_workAttachment;
    }
    if (StringEqual(word, "repr", false) || StringEqual(word, "r", false)) {
        return c_workRepression;
    }
    return -1;
}

void Debug_Work (int player, string word) {
    unit abno;
    int work;
    int slot;
    string line;

    work = Debug_WorkFromWord(word);
    if (work >= 0) {
        Work_SetDefault(player, work);
    }

    Debug_Say(player, "work: sending an employee to a door does "
                      + Work_Name(Work_DefaultOf(player))
                      + " (inst|insi|atta|repr)");

    // The odds for that work against each abnormality, at this player's
    // employees' current level in the matching stat. This is the whole reason
    // to choose one work over another, so it should not need a wiki open.
    slot = 0;
    while (slot < gv_cellCount) {
        abno = gvg_cellAbno[slot];
        line = "  " + gvg_abnoName[AbnoGen_IndexOf(abno)] + ":";
        work = 0;
        while (work < c_workCount) {
            line = line + " " + StringSub(Work_Name(work), 1, 4) + "=";
            if (UnitGroupCount(Emp_Of(player), c_unitCountAlive) > 0) {
                line = line + IntToString(AbnoGen_Pref(
                    AbnoGen_IndexOf(abno), work,
                    Emp_StatLevel(UnitGroupUnit(Emp_Of(player), 1), Work_Stat(work))))
                    + "%";
            }
            else {
                line = line + IntToString(AbnoGen_Pref(AbnoGen_IndexOf(abno), work, 1))
                       + "%@I";
            }
            work = work + 1;
        }
        Debug_Say(player, line);
        slot = slot + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// -energy
//--------------------------------------------------------------------------------------------------
void Debug_Energy (int player, string word) {
    if (StringEqual(word, "submit", false)) {
        if (Energy_CanSubmit()) {
            Energy_Submit(player);
        }
        else {
            Debug_Say(player, "energy: not enough yet");
        }
        return;
    }
    if (word != "") {
        Energy_Add(Debug_Int(word, 0));
    }
    // Galaxy has no conditional expression, so this is two statements.
    if (Energy_CanSubmit()) {
        Debug_Say(player, "energy " + IntToString(gv_energy) + "/"
                          + IntToString(gv_energyGoal) + "  -- -energy submit to end it");
        return;
    }
    Debug_Say(player, "energy " + IntToString(gv_energy) + "/" + IntToString(gv_energyGoal));
}

//--------------------------------------------------------------------------------------------------
// -qlip <slot> <n>
//
// The counter without the thing that moves it, since the thing that moves it is
// the meltdown clock and work results, neither of which exists.
//--------------------------------------------------------------------------------------------------
void Debug_SetCounter (int player, string slotWord, string valueWord) {
    int slot;

    slot = Debug_Int(slotWord, -1);
    if (slot < 0 || slot >= gv_cellCount) {
        Debug_Say(player, "qlip: want a slot 0.." + IntToString(gv_cellCount - 1));
        return;
    }

    Cont_SetCounter(gvg_cellAbno[slot], Debug_Int(valueWord, 0));
    Debug_ReportCells(player);
}

//--------------------------------------------------------------------------------------------------
// -emp spawn [n]
//--------------------------------------------------------------------------------------------------
void Debug_SpawnEmployees (int player, int howMany) {
    if (c_typesEmpCount == 0) {
        Debug_Say(player, "emp: no Lob_Emp_* unit type is authored");
        return;
    }
    if (howMany < 1) {
        howMany = 1;
    }

    UnitCreate(howMany, gvg_typesEmp[0], c_unitCreateIgnorePlacement,
               player, Debug_SpawnPoint(player), 270.0);
    Debug_Say(player, "emp: spawned " + IntToString(howMany) + " " + gvg_typesEmp[0]);
}

//--------------------------------------------------------------------------------------------------
// -stat <fort|prud|temp|just|all> <value>
//
// A leading + or - on the value makes it relative, which is the only way to
// exercise Emp_StatAdd's signed path -- the one Training Team's "push a stat
// back down" will use.
//--------------------------------------------------------------------------------------------------
void Debug_SetStat (int player, string whichWord, string valueWord) {
    unitgroup mine;
    unit who;
    int which;
    int value;
    int count;
    int i;
    int stat;
    bool relative;
    string firstChar;

    which = Debug_StatFromWord(whichWord);
    if (which == c_debugStatBad) {
        Debug_Say(player, "stat: want fort|prud|temp|just|all");
        return;
    }
    if (valueWord == "") {
        Debug_Say(player, "stat: want a value, or +n / -n to move it");
        return;
    }

    firstChar = StringSub(valueWord, 1, 1);
    relative = firstChar == "+" || firstChar == "-";
    if (firstChar == "+") {
        // StringToInt does not have to know what a leading + means.
        valueWord = StringSub(valueWord, 2, StringLength(valueWord));
    }
    value = Debug_Int(valueWord, 0);

    mine = Debug_TargetEmployees(player);
    count = UnitGroupCount(mine, c_unitCountAlive);

    i = 1;
    while (i <= count) {
        who = UnitGroupUnit(mine, i);
        stat = 0;
        while (stat < c_statCount) {
            if (which == c_debugStatAll || which == stat) {
                if (relative) {
                    Emp_StatAdd(who, stat, value);
                }
                else {
                    Emp_StatSet(who, stat, value);
                }
            }
            stat = stat + 1;
        }
        Emp_SyncRank(who);
        i = i + 1;
    }

    Debug_ReportEmployees(player);
}

//--------------------------------------------------------------------------------------------------
// The command reference, in the help panel rather than in chat.
//
// Placeholders are written NAME and VALUE rather than <name> and <value>, and
// that is not a style preference. SC2 parses < > in displayed text as markup:
// <s> is the font style tag, and a style tag with no val asks for the style
// named "", which is where "TextError: 无法找到字体样式[]" came from. The old
// chat help printed "-stat <s> <v>", so that error fired every time somebody
// typed -help. Any angle bracket in text that reaches a player has to be
// escaped or avoided.
//
// It used to print itself into the chat window, and it had quietly stopped
// being a reference: the list outgrew the panel, so it scrolled its own top
// off, and a list you can only read the bottom of is worse than no list. The
// help panel is paged, scrollable and already bound to F12, and it is where a
// player looks for "what can I do".
//
// The descriptions say what the mechanic is rather than only what the syntax
// is, because there is room for that here and it is what somebody reading this
// actually wants. Half of these commands stand in for a system that does not
// exist yet, and which one is which is worth knowing.
//
// Added once at init, to everybody. Nothing removes them; the panel is not a
// place state lives.
//--------------------------------------------------------------------------------------------------
void Debug_Tip (string title, string body, string icon) {
    HelpPanelAddTip(PlayerGroupAll(), StringToText(title), StringToText(body),
                    StringToText(""), icon);
}

void Debug_BuildHelp () {
    Debug_Tip(
        "Debug console",
        "Type these into chat. Everything here is a test harness: it drives a "
        + "mechanic by hand so it can be watched before the system that will "
        + "drive it for real exists.<n/><n/>"
        + "Nothing here reaches anything a player does not already own.",
        "Assets\\Textures\\btn-ability-terran-battlefieldawareness.dds");

    Debug_Tip(
        "Employees",
        "<c val=\"ffff8a\">-emp</c>  the selected employees: four stats, the level "
        + "each lands on, their sum, the rank that sum buys, and SP.<n/>"
        + "<c val=\"ffff8a\">-emp spawn [n]</c>  spawn n at your character.<n/>"
        + "<c val=\"ffff8a\">-stat NAME VALUE</c>  set a stat. s is fort, prud, temp, just or all.<n/>"
        + "<c val=\"ffff8a\">-stat NAME +5</c>  move it instead of setting it; negatives work.<n/>"
        + "<c val=\"ffff8a\">-sp N</c>  move SP. -sp -30 is how panic gets tested.<n/><n/>"
        + "Rank is the SUM of the four stat levels, not the lowest, so a "
        + "three-stat specialist with one stat left deliberately low is still "
        + "rank V. Abnormalities that require a stat to stay BELOW some value "
        + "depend on that.",
        "Assets\\Textures\\btn-upgrade-terran-infantryarmorlevel1.dds");

    Debug_Tip(
        "Containment",
        "<c val=\"ffff8a\">-cont</c>  every cell: grade, state, Qliphoth counter, "
        + "observation, and what its door is doing.<n/>"
        + "<c val=\"ffff8a\">-breach [slot]</c>  that abnormality decides to leave. It "
        + "still has to get through its own door, which is the part worth watching.<n/>"
        + "<c val=\"ffff8a\">-qlip SLOT N</c>  set a Qliphoth counter.<n/>"
        + "<c val=\"ffff8a\">-obs SLOT</c>  buy the next encyclopedia section with the "
        + "PE-Boxes taken out of that abnormality.<n/><n/>"
        + "Suppression is defeat, not death: a beaten abnormality goes home, its "
        + "counter resets and its door comes back whole. A breach costs "
        + "employees, time and everybody's attention, and never a slot.",
        "Assets\\Textures\\btn-ability-terran-holdfire.dds");

    Debug_Tip(
        "Work",
        "Select an employee, press Work, click a containment door. One second of "
        + "casting, then the boxes start.<n/><n/>"
        + "<c val=\"ffff8a\">-work TYPE</c>  what the next one will do: inst, insi, atta "
        + "or repr. Prints each abnormality's odds for all four at your "
        + "employees' current levels, so the choice needs no wiki.<n/><n/>"
        + "One roll per box. The chance is keyed to the LEVEL of the stat that "
        + "work uses, so 30 and 44 of a stat are the same to an abnormality. A "
        + "missed box is White damage to SP, which has nothing to do with the "
        + "health bar -- a badly chosen work costs nothing visible until the "
        + "person breaks.",
        "Assets\\Textures\\btn-upgrade-terran-infantryweaponslevel1.dds");

    Debug_Tip(
        "Meltdown",
        "<c val=\"ffff8a\">-melt</c>  the clock, and who owns each cell.<n/>"
        + "<c val=\"ffff8a\">-melt now</c>  start the next round immediately.<n/><n/>"
        + "Every 60 seconds a meltdown names cells in each player's own sector, "
        + "and a named cell has 60 seconds for a work to BEGIN on it. Begin, not "
        + "finish: what it asks is that somebody was sent. A cell that is missed "
        + "has its Qliphoth counter set to zero, not reduced, and the table "
        + "loses a share of the energy pool.<n/><n/>"
        + "A cell that was already busy when it got named is HELD -- it does not "
        + "start counting until that work ends, however it ends. The employee "
        + "inside cannot be sent again, so the window would not be a window. The "
        + "work in flight does not answer the meltdown either; when it ends, "
        + "somebody still has to go.<n/><n/>"
        + "The clock is shared but the named cells are yours. A neighbour who "
        + "ignores theirs breaches their own abnormality, and what reaches you "
        + "is a fight -- never a cut to your income or your employees.",
        "Assets\\Textures\\btn-ability-terran-nuclearstrike.dds");

    Debug_Tip(
        "Energy, and how this ends",
        "<c val=\"ffff8a\">-energy</c>  the meter.  <c val=\"ffff8a\">-energy N</c>  add to it.  "
        + "<c val=\"ffff8a\">-energy submit</c>  end the game.<n/><n/>"
        + "Every box pays twice: once into your own stock for that one "
        + "abnormality's encyclopedia, and the same amount again into a pool the "
        + "whole table shares. Filling the pool is the win condition, so studying "
        + "abnormalities and winning are the same activity.<n/><n/>"
        + "Nothing is ever spent out of the pool and nobody's rate depends on "
        + "anybody else's. It is a scoreboard, not a wallet.",
        "Assets\\Textures\\btn-ability-terran-stimpack-color.dds");

    Debug_Tip(
        "The world",
        "<c val=\"ffff8a\">-status</c>  debris, ore, power, devices, sector, energy.<n/>"
        + "<c val=\"ffff8a\">-scan</c>  what the generated object tables can actually see.<n/><n/>"
        + "If -scan shows a type count above zero next to a group count of zero, "
        + "the build did not run after the last editor save.",
        "Assets\\Textures\\btn-ability-terran-battlefieldawareness.dds");
}

void Debug_Help (int player) {
    Debug_Say(player, "the command list is in the help panel -- press F12");
}

bool Debug_Chat_Func (bool testConds, bool runActions) {
    string message;
    string command;
    int player;

    if (!runActions) {
        return true;
    }

    player = EventPlayer();
    message = EventChatMessage(false);

    // The event matches loosely, so a message that merely contains a hyphen
    // gets here too. A command has to start with one.
    if (StringSub(message, 1, 1) != c_debugPrefix) {
        return true;
    }

    command = StringWord(message, 1);

    if (StringEqual(command, "-help", false)) {
        Debug_Help(player);
    }
    else if (StringEqual(command, "-emp", false)) {
        if (StringEqual(StringWord(message, 2), "spawn", false)) {
            Debug_SpawnEmployees(player, Debug_Int(StringWord(message, 3), 1));
        }
        else {
            Debug_ReportEmployees(player);
        }
    }
    else if (StringEqual(command, "-stat", false)) {
        Debug_SetStat(player, StringWord(message, 2), StringWord(message, 3));
    }
    else if (StringEqual(command, "-rank", false)) {
        Emp_Tick_Func(false, true);
        Debug_ReportEmployees(player);
    }
    else if (StringEqual(command, "-status", false)) {
        Debug_Say(player, Economy_StatusLine(player));
    }
    else if (StringEqual(command, "-scan", false)) {
        Debug_Say(player, Registry_ScanLine());
    }
    else if (StringEqual(command, "-cont", false)) {
        Debug_ReportCells(player);
    }
    else if (StringEqual(command, "-breach", false)) {
        Debug_Breach(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-obs", false)) {
        Debug_Observe(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-sp", false)) {
        Debug_SP(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-work", false)) {
        Debug_Work(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-energy", false)) {
        Debug_Energy(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-melt", false)) {
        Debug_Meltdown(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-qlip", false)) {
        Debug_SetCounter(player, StringWord(message, 2), StringWord(message, 3));
    }
    return true;
}

void Debug_Init () {
    int player;

    Debug_BuildHelp();

    gt_debugChat = TriggerCreate("Debug_Chat_Func");
    player = 1;
    while (player <= 15) {
        TriggerAddEventChatMessage(gt_debugChat, player, c_debugPrefix, false);
        player = player + 1;
    }
}
