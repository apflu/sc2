        + "rather than an assumption.",
        "Assets\\Textures\\btn-ability-terran-supplydrop.dds");

    Debug_Tip(
        "Difficulty",
        "<c val=\"ffff8a\">-diff</c>  the whole table's settings.<n/>"
        + "<c val=\"ffff8a\">-diff casual|normal|hard|brutal</c>  set yours.<n/><n/>"
        + "Difficulty is PER PLAYER and sizes only your own waves, so a novice "
        + "can sit in a lobby of veterans on Casual and still be learning the "
        + "same game. It is not a handicap anybody else pays for -- fewer zerg "
        + "spawn in that sector, so fewer leak out of it into yours.<n/><n/>"
        + "Two things are shared and read the table's MEAN difficulty instead: "
        + "the energy target, and the worst Ordeal that can be dealt (Dawn, "
        + "Noon, Dusk, Midnight -- one per difficulty). The mean and not the "
        + "highest, so one player on Brutal cannot pull five others into "
        + "Midnight.<n/><n/>"
        + "Scaling the target is what keeps a personal setting honest against a "
        + "shared objective: Casual is a genuinely smaller game, not a discount "
        + "on a fixed one.<n/><n/>"
        + "This stands in for a lobby dropdown that does not exist yet; it reads "
        + "a per-player game attribute and answers Normal until one is created.",
        "Assets\\Textures\\btn-ability-terran-scannersweep.dds");

    Debug_Tip(
        "Tasks",
        "<c val=\"ffff8a\">-quest</c>  your department's four tasks.<n/>"
        + "<c val=\"ffff8a\">-quest 0-8</c>  move yourself to that department first.<n/><n/>"
        + "Eleven of the thirty-six are counted. The rest print \"no channel "
        + "yet\" rather than 0, because a task nobody has started and a task the "
        + "map cannot observe look identical as a number, and only one of them "
        + "is worth working on. Four need Ordeals, four need an end-of-game "
        + "hook, one needs a zerg queen, and two are blank in the source "
        + "document.<n/><n/>"
        + "Progress is read fresh every two seconds and kept nowhere, except for "
        + "four things that erase their own evidence: works finished, works "
        + "ending Good, meltdown rounds handled, and which abnormalities have "
        + "been suppressed. Those are counted where they happen.<n/><n/>"
        + "Completion is a latch -- employees die and buildings fall, but a task "
        + "that was done stays done. It is NOT saved yet, so it is forgotten "
        + "when the game ends.<n/><n/>"
        + "<c val=\"ffff8a\">-quest saved N</c>  arrive with N already "
        + "recorded.<n/><n/>"
        + "One task per game reaches the record: the first you have not "
        + "recorded. That one is a MAIN objective. Finishing it opens the next, "
        + "which appears under BONUS -- still worth playing for, but gone "
        + "tomorrow, and locked again next game.<n/><n/>"
        + "Nothing persists yet, so every game you can only bank task 1. "
        + "-quest saved N is the only way to see the second, third and fourth "
        + "game, and the only way to reach a later task as MAIN.<n/><n/>"
        + "Player-facing text is in src/strings/enUS.txt and reaches the panel "
        + "by key; this command is developer text and stays inline.",
        "Assets\\Textures\\btn-ability-terran-scannersweep.dds");

    Debug_Tip(
        "The world",
        "<c val=\"ffff8a\">-status</c>  debris, ore, power, devices, sector, energy.<n/>"
        + "<c val=\"ffff8a\">-scan</c>  what the generated object tables can actually see.<n/><n/>"
        + "If -scan shows a type count above zero next to a group count of zero, "
        + "the build did not run after the last editor save.",
        "Assets\\Textures\\btn-ability-terran-battlefieldawareness.dds");
}

//--------------------------------------------------------------------------------------------------
// -dmg -- echo every White hit the bridge intercepts.
//
// Off by default because it is loud, and the point of it is to answer three
// questions about the engine that were reasoned out rather than witnessed. See
// the header of 17_damage.galaxy.
//--------------------------------------------------------------------------------------------------
void Debug_DamageTrace (int player, string word) {
    if (StringEqual(word, "off", false)) {
        gv_dmgTrace = false;
    }
    else if (StringEqual(word, "on", false) || word == "") {
        gv_dmgTrace = true;
    }
    else {
        Debug_Say(player, "-dmg on | off");
        return;
    }

    if (gv_dmgTrace) {
        Debug_Say(player, "damage trace ON -- shoot a colleague with the mercy weapon. "
                        + "attempted is the number before Lob_Mind_White ate it; "
                        + "actual should be 0. If nothing prints at all, the damage "
                        + "event does not survive ModifyFraction=0 and the bridge "
                        + "needs a different hook.");
    }
    else {
        Debug_Say(player, "damage trace off");
    }
}

void Debug_Help (int player) {
    Debug_Say(player, "the command list is in the help panel -- press F12");
}

bool Debug_Chat_Func (bool testConds, bool runActions) {
    string message;
    string command;
    int player;

    if (!runActions) {
        return true;
    }

    player = EventPlayer();
    message = EventChatMessage(false);

    // The event matches loosely, so a message that merely contains a hyphen
    // gets here too. A command has to start with one.
    if (StringSub(message, 1, 1) != c_debugPrefix) {
        return true;
    }

    command = StringWord(message, 1);

    if (StringEqual(command, "-help", false)) {
        Debug_Help(player);
    }
    else if (StringEqual(command, "-emp", false)) {
        if (StringEqual(StringWord(message, 2), "spawn", false)) {
            Debug_SpawnEmployees(player, Debug_Int(StringWord(message, 3), 1));
        }
        else {
            Debug_ReportEmployees(player);
        }
    }
    else if (StringEqual(command, "-stat", false)) {
        Debug_SetStat(player, StringWord(message, 2), StringWord(message, 3));
    }
    else if (StringEqual(command, "-rank", false)) {
        Emp_Tick_Func(false, true);
        Debug_ReportEmployees(player);
    }
    else if (StringEqual(command, "-status", false)) {
        Debug_Say(player, Economy_StatusLine(player));
    }
    else if (StringEqual(command, "-scan", false)) {
        Debug_Say(player, Registry_ScanLine());
    }
    else if (StringEqual(command, "-cont", false)) {
        Debug_ReportCells(player);
    }
    else if (StringEqual(command, "-breach", false)) {
        Debug_Breach(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-obs", false)) {
        Debug_Observe(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-sp", false)) {
        Debug_SP(player, StringWord(message, 2), StringWord(message, 3));
    }
    else if (StringEqual(command, "-work", false)) {
        Debug_Work(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-energy", false)) {
        Debug_Energy(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-ordeal", false)) {
        Debug_Ordeal(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-fort", false)) {
        Debug_Fortify(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-quest", false)) {
        Debug_Quests(player, StringWord(message, 2), StringWord(message, 3));
    }
    else if (StringEqual(command, "-codec", false)) {
        Debug_Say(player, Codec_SelfTest());
    }
    else if (StringEqual(command, "-bank", false)) {
        Debug_Bank(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-diff", false)) {
        Debug_Difficulty(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-melt", false)) {
        Debug_Meltdown(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-dmg", false)) {
        Debug_DamageTrace(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-qlip", false)) {
        Debug_SetCounter(player, StringWord(message, 2), StringWord(message, 3));
    }
    return true;
}

void Debug_Init () {
    int player;

    Debug_BuildHelp();

    gt_debugChat = TriggerCreate("Debug_Chat_Func");
    player = 1;
    while (player <= 15) {
        TriggerAddEventChatMessage(gt_debugChat, player, c_debugPrefix, false);
        player = player + 1;
    }
}
