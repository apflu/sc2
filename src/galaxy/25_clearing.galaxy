//--------------------------------------------------------------------------------------------------
// Debris clearing.
//
// Clearing is modelled as damage, not as a custom progress bar: debris is a
// destructible with a large health pool, and both the player and the workers
// clear it by attacking it. That buys the health bar as progress feedback for
// free, and makes the "player clears far faster than a worker" curve a pure
// weapon-damage question that lives in data where it can be tuned, rather than
// in two hand-written rate constants here.
//
// Worker assignment lives in 30_workers.galaxy; this module only owns what
// clearing pays out.
//--------------------------------------------------------------------------------------------------

// Credit banked into the ore pile when a piece of debris is finished off.
//
// The pile is a real harvestable node, so this is the only place the number
// exists: from here on the engine owns it, and turning it into spendable
// resources is miners walking to it and carrying it back. Nothing converts it
// on their behalf.
// Sized against how long the pile then takes to drain, not against how much a
// piece of debris "should" be worth. At 25 the two starting miners ate a whole
// debris in five seconds, so the pile was empty essentially always -- which
// makes miner headcount irrelevant and quietly guts the separate miner upgrade
// line in baseline section 5.2. At 120 a debris is about 24 seconds of mining
// against about 30 seconds of a player clearing it, so the pile backs up as
// soon as the workers help, and more miners start being worth something.
const int c_oreCreditPerDebris = 120;

int gv_debrisCleared;

trigger gt_debrisDied;

//--------------------------------------------------------------------------------------------------
// Any unit death, filtered down to debris. Cheaper and far less bookkeeping
// than registering a death event per placed object, and it covers debris
// spawned at runtime for free -- which is where debris is headed.
//--------------------------------------------------------------------------------------------------
bool Clearing_DebrisDied_Func (bool testConds, bool runActions) {
    unit pile;

    if (!runActions) {
        return true;
    }
    if (!ObjectsGen_IsDebris(EventUnit())) {
        return true;
    }

    // Nearest pile, not "the" pile. With one sector that is the same thing;
    // with several it is the only reading that does not quietly pay a sector
    // for work done on the far side of the ship.
    pile = UnitGroupClosestToPoint(ObjectsGen_ScanPile(), UnitGetPosition(EventUnit()));
    if (pile != null) {
        UnitSetPropertyInt(pile, c_unitPropResources,
                           UnitGetPropertyInt(pile, c_unitPropResources, true)
                           + c_oreCreditPerDebris);
    }
    gv_debrisCleared = gv_debrisCleared + 1;
    return true;
}

void Clearing_Init () {
    gv_debrisCleared = 0;

    gt_debrisDied = TriggerCreate("Clearing_DebrisDied_Func");
    TriggerAddEventUnitDied(gt_debrisDied, null);
}
