//--------------------------------------------------------------------------------------------------
// Shared constants.
//
// Lives in the lowest-numbered module because Galaxy needs a declaration before
// its use and modules are concatenated in filename order.
//--------------------------------------------------------------------------------------------------

// Slots, read out of the map's own MapInfo rather than remembered: the player
// records carry their race id in slot order, and they read
//
//     1-6  Terr          the six players
//     7    Zerg          the swarm
//     8    Abnormality   whatever is loose
//
// The zerg used to be slot 2, which is now a player, so anything still saying 2
// would have been spawning waves for a teammate.
//
// Slot 8 is its own race because a loose abnormality has to be hostile to the
// zerg as well as to everybody else -- design 5.1 makes releasing an easy one
// to meet a wave a real tactic, and that is an alliance setting rather than
// anything script can arrange.
const int c_zergPlayer = 7;
const int c_abnoPlayer = 8;

// There used to be a c_p0Player = 1 here, for the parts of P0 that had not been
// made per-player yet -- the character, the department, the economy readout. It
// is gone because they all have been, and nothing refers to it. If a new one
// appears, that is the signal to write the per-player version instead: this
// constant is how a single-player assumption spreads, because it reads like a
// configuration value and is actually a claim that there is one player.

//--------------------------------------------------------------------------------------------------
// Somebody at the table, as opposed to the swarm or whatever is loose.
//
// Asked of PlayerStatus rather than of Dept_Of: a department is chosen on a
// selection screen that does not exist, so today only player 1 has one, and
// anything keyed to that would treat a six-player game as a single-player one.
//
// Here rather than in a system module because it is a fact about slots, and
// slots are what this file is.
//--------------------------------------------------------------------------------------------------
bool Slot_IsTablePlayer (int player) {
    if (player < 1 || player > 15) {
        return false;
    }
    if (player == c_zergPlayer || player == c_abnoPlayer) {
        return false;
    }
    return PlayerStatus(player) == c_playerStatusActive;
}

//--------------------------------------------------------------------------------------------------
// The style the objectives panel puts a progress counter in.
//
// The count goes in an objective NAME, in a style of its own, which is Blizzard's own
// format for a counted objective. LotV and the Nova pack both keep it in a
// string called [Default]_FormatText and it reads:
//
//     ~NAME~ <s val="ObjectivePanelProgress_Terran">(~CURRENT~/~GOAL~)</s>
//
// So the counter is a different colour from the task -- 52e787 for Terran,
// ff7900 for Zerg, 84adff for Protoss -- and the eye can find "how far along
// am I" down a column of six lines without reading any of them.
//
// The named style rather than a raw <c val="52e787">, because it also carries
// ObjectivePanelActive's height and shadow, so the counter matches the line it
// sits on rather than merely being green. It is defined unconditionally in
// core.sc2mod: requiredtoload appears twice in that whole file and both are
// DEBUG-gated, so there is no availability question.
//
// A task with a goal of one gets no counter at all. "(0/1)" is a worse way of
// saying yes-or-no than the tick box already sitting next to the line, and
// Blizzard has a separate _FormatTextSingle that leaves the block empty for
// exactly this case.
//--------------------------------------------------------------------------------------------------
const string c_questProgressStyle = "ObjectivePanelProgress_Terran";

//--------------------------------------------------------------------------------------------------
// Assembling a message out of a translated string and some numbers.
//
// NOT by concatenation. "%RISK% containment breach" is one sentence in the
// strings file and stays one sentence in every language; glued together from
// three fragments it is three fragments that only line up in English, and the
// translator who needs the number in front has nowhere to put it.
//
// So the string owns the whole sentence including its placeholders, and the
// code substitutes. That is Blizzard's own shape -- their campaign strings are
// full of "Do Not Let %NumberDead% Colonists Die" driven through exactly this
// native.
//
// Tokens are written %LIKE_THIS% so that a translator can see at a glance which
// pieces they must keep and must not translate.
//--------------------------------------------------------------------------------------------------
text Msg (string key) {
    return StringExternal(key);
}

text Msg1 (string key, string token, text value) {
    return TextReplaceWord(StringExternal(key), StringToText(token), value,
                           c_stringReplaceAll, c_stringCase);
}

text Msg2 (string key, string t1, text v1, string t2, text v2) {
    return TextReplaceWord(Msg1(key, t1, v1), StringToText(t2), v2,
                           c_stringReplaceAll, c_stringCase);
}

text Msg3 (string key, string t1, text v1, string t2, text v2, string t3, text v3) {
    return TextReplaceWord(Msg2(key, t1, v1, t2, v2), StringToText(t3), v3,
                           c_stringReplaceAll, c_stringCase);
}

// The commonest substitution by a distance: a plain number.
text MsgInt (int value) {
    return IntToText(value);
}
