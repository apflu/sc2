//--------------------------------------------------------------------------------------------------
// The second stage of the resource chain: ore pile -> spendable resources.
//
// There is no conversion step here any more, because there is nothing to
// convert. The pile is a harvestable node and the recycler is a drop-off, so
// miners walk over, carry, and walk back, and the engine credits the player.
// That was the point of the change: the old version moved numbers from a script
// variable into the player's account while the miners stood there, which is a
// claim about work that never happened.
//
// What is left is dispatch -- pointing idle miners at the pile -- and the
// greybox readout. Throughput is tuned on the pile's own CBehaviorResource:
// HarvestTime against HarvestAmount. (IdealHarvesterCount is display only and
// changes no yield.) Those get designed directly.
// Where the pile sits is a spatial question and should stay one; deriving the
// rate from the walk would tie two decisions together that want to move apart.
//
// Fully automatic and independent of power, per the design baseline. The player
// never touches this; their only job is to keep the pile stocked, which is what
// makes clearing feel like it feeds something rather than paying out directly.
//--------------------------------------------------------------------------------------------------

const fixed c_minerAssignPeriod = 2.0;

//--------------------------------------------------------------------------------------------------
// Salvage: a slow trickle into the ore pile.
//
// A level-0 fixture in a room, per docs/usr/Defense.md. Its job is narrow and
// worth stating so nobody later mistakes it for an economy: it exists so that a
// sector with every scrap of debris cleared and every abnormality temporarily
// unworkable does not sit at zero income with nothing to do about it.
//
// It pays into the PILE, not into the player's minerals, and that is the whole
// reason it does not change the shape of anything. Baseline 4.4 has the second
// stage of the chain fully automatic and driven by miners walking; this adds a
// floor under the FIRST stage instead of a bypass around the second. The player
// still needs miners, the miners still walk, and a player whose pile is being
// worked is not affected by this at all.
//
// The rate is deliberately bad. It is a floor, not a strategy.
//--------------------------------------------------------------------------------------------------
const fixed c_salvagePeriod = 10.0;

// TUNING. Per salvage device, per period, into the nearest pile.
const int c_salvageAmount = 5;

trigger gt_minerAssign;
trigger gt_salvage;

bool Economy_Salvage_Func (bool testConds, bool runActions) {
    unitgroup devices;
    unit device;
    unit pile;
    int count;
    int i;

    if (!runActions) {
        return true;
    }

    devices = ObjectsGen_ScanSalvage();
    count = UnitGroupCount(devices, c_unitCountAlive);

    i = 1;
    while (i <= count) {
        device = UnitGroupUnit(devices, i);
        if (device != null && UnitIsAlive(device)) {
            // Nearest pile, which is the same spatial idiom the doors and the
            // control panels use. A salvage device in a room feeds that room's
            // sector without anything having to be told which sector it is in.
            pile = UnitGroupClosestToPoint(ObjectsGen_ScanPile(), UnitGetPosition(device));
            if (pile != null && UnitIsAlive(pile)) {
                UnitSetPropertyInt(
                    pile, c_unitPropResources,
                    UnitGetPropertyInt(pile, c_unitPropResources, true) + c_salvageAmount);
            }
        }
        i = i + 1;
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// How much is sitting in the pile, across every pile there is.
//--------------------------------------------------------------------------------------------------
int Economy_PileContents () {
    unitgroup piles;
    unit pile;
    int total;
    int count;
    int i;

    piles = ObjectsGen_ScanPile();
    count = UnitGroupCount(piles, c_unitCountAlive);
    total = 0;

    i = 1;
    while (i <= count) {
        pile = UnitGroupUnit(piles, i);
        if (pile != null) {
            total = total + UnitGetPropertyInt(pile, c_unitPropResources, true);
        }
        i = i + 1;
    }
    return total;
}

//--------------------------------------------------------------------------------------------------
// Idle miners get sent to the nearest stocked pile. Only idle ones: a miner
// already hauling has a multi-step order queue that reissuing would reset, and
// it would never finish a trip.
//
// Skipping empty piles matters more than it looks. Without the check, miners
// ordered onto a dry pile go idle on arrival and get reordered every couple of
// seconds, which reads as a bug rather than as an economy waiting on the player.
//--------------------------------------------------------------------------------------------------
bool Economy_MinerAssign_Func (bool testConds, bool runActions) {
    unitgroup miners;
    unit miner;
    unit pile;
    int count;
    int i;

    if (!runActions) {
        return true;
    }

    miners = ObjectsGen_ScanSCV_Miner();
    count = UnitGroupCount(miners, c_unitCountAlive);

    i = 1;
    while (i <= count) {
        miner = UnitGroupUnit(miners, i);
        if (miner != null && UnitIsAlive(miner) && UnitOrderCount(miner) == 0) {
            pile = UnitGroupClosestToPoint(ObjectsGen_ScanPile(), UnitGetPosition(miner));
            if (pile != null && UnitGetPropertyInt(pile, c_unitPropResources, true) > 0) {
                UnitIssueOrder(
                    miner,
                    OrderTargetingUnit(AbilityCommand("SCVHarvest", 0), pile),
                    c_orderQueueReplace
                );
            }
        }
        i = i + 1;
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// Greybox readout, on request.
//
// It used to print itself into the subtitle area every five seconds, back when
// nothing else could report and the question P0 was asking -- does the loop
// really pull in three directions at once -- could only be answered by watching
// the numbers move. It answered it. What is left is a screen that cannot show
// anything else, including the one-shot startup scan and every message a real
// mechanic will want to send.
//
// So the line stays and the timer goes: 90_debug.galaxy prints this on -status.
// Nothing is lost, because a number you can ask for at any moment is strictly
// more than the same number arriving whether or not you wanted it.
//
// Anything ownable is counted for the asking player, and anything genuinely
// shared says so on the line. That distinction is not cosmetic: the whole
// baseline turns on which numbers are yours and which are the table's, and a
// readout that quietly showed six players' SCVs as "workers" would be teaching
// the opposite of the rule the design is built on.
//--------------------------------------------------------------------------------------------------
int Economy_CountOwned (unitgroup group, int player) {
    unit who;
    int count;
    int mine;
    int i;

    count = UnitGroupCount(group, c_unitCountAlive);
    mine = 0;
    i = 1;
    while (i <= count) {
        who = UnitGroupUnit(group, i);
        if (who != null && UnitGetOwner(who) == player) {
            mine = mine + 1;
        }
        i = i + 1;
    }
    return mine;
}

string Economy_StatusLine (int player) {
    return "debris left=" + IntToString(UnitGroupCount(ObjectsGen_ScanDebris(), c_unitCountAlive))
           + " (map)  cleared=" + IntToString(gv_debrisCleared)
           + "  pile=" + IntToString(Economy_PileContents())
           + "  power=" + IntToString(PlayerGetPropertyInt(player, c_playerPropSuppliesUsed))
           + "/" + IntToString(PlayerGetPropertyInt(player, c_playerPropSuppliesMade))
           + " (" + IntToString(gv_devicesOnline) + "/" + IntToString(gv_devicesTotal)
           + " devices online, map)"
           + "  dept=" + Dept_NameOf(player)
           + "  diff=" + Diff_NameOf(player)
           + "  inner=" + Sector_HeldText(player)
           + "  workers=" + IntToString(Economy_CountOwned(ObjectsGen_ScanSCV_Worker(), player))
           + "  miners=" + IntToString(Economy_CountOwned(ObjectsGen_ScanSCV_Miner(), player))
           + "  emp=" + IntToString(Economy_CountOwned(ObjectsGen_ScanEmp(), player))
           + "  melt=" + IntToString(Melt_Level())
           + "  energy=" + IntToString(gv_energy) + "/" + IntToString(gv_energyGoal)
           + " (table)";
}

void Economy_Init () {
    gt_minerAssign = TriggerCreate("Economy_MinerAssign_Func");
    TriggerAddEventTimePeriodic(gt_minerAssign, c_minerAssignPeriod, c_timeGame);

    gt_salvage = TriggerCreate("Economy_Salvage_Func");
    TriggerAddEventTimePeriodic(gt_salvage, c_salvagePeriod, c_timeGame);
}
