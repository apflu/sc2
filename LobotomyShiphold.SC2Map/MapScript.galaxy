include "TriggerLibs/NativeLib"

//--------------------------------------------------------------------------------------------------
// src/galaxy/00_config.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Shared constants.
//
// Lives in the lowest-numbered module because Galaxy needs a declaration before
// its use and modules are concatenated in filename order.
//--------------------------------------------------------------------------------------------------

// Slots, read out of the map's own MapInfo rather than remembered: the player
// records carry their race id in slot order, and they read
//
//     1-6  Terr          the six players
//     7    Zerg          the swarm
//     8    Abnormality   whatever is loose
//
// The zerg used to be slot 2, which is now a player, so anything still saying 2
// would have been spawning waves for a teammate.
//
// Slot 8 is its own race because a loose abnormality has to be hostile to the
// zerg as well as to everybody else -- design 5.1 makes releasing an easy one
// to meet a wave a real tactic, and that is an alliance setting rather than
// anything script can arrange.
const int c_zergPlayer = 7;
const int c_abnoPlayer = 8;

// There used to be a c_p0Player = 1 here, for the parts of P0 that had not been
// made per-player yet -- the character, the department, the economy readout. It
// is gone because they all have been, and nothing refers to it. If a new one
// appears, that is the signal to write the per-player version instead: this
// constant is how a single-player assumption spreads, because it reads like a
// configuration value and is actually a claim that there is one player.

//--------------------------------------------------------------------------------------------------
// Somebody at the table, as opposed to the swarm or whatever is loose.
//
// Asked of PlayerStatus rather than of Dept_Of: a department is chosen on a
// selection screen that does not exist, so today only player 1 has one, and
// anything keyed to that would treat a six-player game as a single-player one.
//
// Here rather than in a system module because it is a fact about slots, and
// slots are what this file is.
//--------------------------------------------------------------------------------------------------
bool Slot_IsTablePlayer (int player) {
    if (player < 1 || player > 15) {
        return false;
    }
    if (player == c_zergPlayer || player == c_abnoPlayer) {
        return false;
    }
    return PlayerStatus(player) == c_playerStatusActive;
}

//--------------------------------------------------------------------------------------------------
// The style the objectives panel puts a progress counter in.
//
// The count goes in an objective NAME, in a style of its own, which is Blizzard's own
// format for a counted objective. LotV and the Nova pack both keep it in a
// string called [Default]_FormatText and it reads:
//
//     ~NAME~ <s val="ObjectivePanelProgress_Terran">(~CURRENT~/~GOAL~)</s>
//
// So the counter is a different colour from the task -- 52e787 for Terran,
// ff7900 for Zerg, 84adff for Protoss -- and the eye can find "how far along
// am I" down a column of six lines without reading any of them.
//
// The named style rather than a raw <c val="52e787">, because it also carries
// ObjectivePanelActive's height and shadow, so the counter matches the line it
// sits on rather than merely being green. It is defined unconditionally in
// core.sc2mod: requiredtoload appears twice in that whole file and both are
// DEBUG-gated, so there is no availability question.
//
// A task with a goal of one gets no counter at all. "(0/1)" is a worse way of
// saying yes-or-no than the tick box already sitting next to the line, and
// Blizzard has a separate _FormatTextSingle that leaves the block empty for
// exactly this case.
//--------------------------------------------------------------------------------------------------
const string c_questProgressStyle = "ObjectivePanelProgress_Terran";

//--------------------------------------------------------------------------------------------------
// Assembling a message out of a translated string and some numbers.
//
// NOT by concatenation. "%RISK% containment breach" is one sentence in the
// strings file and stays one sentence in every language; glued together from
// three fragments it is three fragments that only line up in English, and the
// translator who needs the number in front has nowhere to put it.
//
// So the string owns the whole sentence including its placeholders, and the
// code substitutes. That is Blizzard's own shape -- their campaign strings are
// full of "Do Not Let %NumberDead% Colonists Die" driven through exactly this
// native.
//
// Tokens are written %LIKE_THIS% so that a translator can see at a glance which
// pieces they must keep and must not translate.
//--------------------------------------------------------------------------------------------------
text Msg (string key) {
    return StringExternal(key);
}

text Msg1 (string key, string token, text value) {
    return TextReplaceWord(StringExternal(key), StringToText(token), value,
                           c_stringReplaceAll, c_stringCase);
}

text Msg2 (string key, string t1, text v1, string t2, text v2) {
    return TextReplaceWord(Msg1(key, t1, v1), StringToText(t2), v2,
                           c_stringReplaceAll, c_stringCase);
}

text Msg3 (string key, string t1, text v1, string t2, text v2, string t3, text v3) {
    return TextReplaceWord(Msg2(key, t1, v1, t2, v2), StringToText(t3), v3,
                           c_stringReplaceAll, c_stringCase);
}

// The commonest substitution by a distance: a plain number.
text MsgInt (int value) {
    return IntToText(value);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/01_difficulty.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Difficulty, chosen per player.
//
// This replaces "scaled by that player's own development" as the thing personal
// wave strength reads. Development was never a real quantity -- it would have
// had to be invented out of some weighted count of devices and upgrades, and
// inventing a number to hang a system on is the mistake this project already
// made once with a User2 attribute that does not exist.
//
// A difficulty setting is better than the metric it replaces on its own merits,
// not merely as a stand-in:
//
//   It is chosen rather than measured, so nobody is punished for playing well.
//   Scaling by development means the better you do the harder it gets, which is
//   a treadmill dressed as a curve.
//
//   It is per player, so a novice can take Easy and still sit in a lobby of
//   people who have played fifty games. That is the same shape as the
//   encyclopedia admission rule in design 4.4 -- the table's difficulty is a
//   function of what each person can actually handle, and nobody has to be told
//   they are the reason everyone else is being held back.
//
//   It is legible. "I am on Hard" is something a player can say out loud, and
//   "my development coefficient is 1.4" is not.
//
// A novice on Easy is not a heavier burden on their neighbours either: fewer
// zerg spawn in their sector, so fewer leak out of it. The one negative transfer
// the baseline allows gets smaller, not larger.
//
//--------------------------------------------------------------------------------------------------
// The channel is a per-player lobby Game Attribute.
//
// GameAttributePlayerValue(name, player) is exactly "a dropdown in the lobby,
// one per slot", which is the thing being described, and it is the same channel
// design 7.8 already picked for core suppression. It returns "" when no such
// attribute exists, so this reads the native channel today and quietly answers
// Normal until somebody creates the attribute in the editor -- no code changes
// when it lands, and no half-built lobby in the meantime.
//
// Values are matched loosely on their first letters, so whatever the attribute's
// value ids end up being named, they work.
//
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// There is a global difficulty as well, and it is the MEAN.
//
// Personal difficulty sizes personal waves. But two things are shared and so
// cannot read a personal number: the energy target, and the ceiling on how bad
// an Ordeal is allowed to be.
//
// The mean, not the maximum. Baseline 2 already settled this exact argument for
// the ship-wide surge -- "按全队总量缩放，而非按最强玩家缩放" -- and the reason
// carries over intact: taking the max lets one player on Brutal drag the whole
// table into Midnight Ordeals, which is a person's choice reaching into
// everybody else's game. Taking the mean means each player moves the shared
// number by their own share of it and no further.
//
// It also closes a hole this file used to have to apologise for. The energy
// target is shared while difficulty is personal, so a table that all picked
// Casual would have been beating an unchanged objective with weakened
// opposition. Scaling the target by the mean makes Casual a genuinely smaller
// game rather than a discount on a fixed one, which is what a difficulty setting
// is supposed to mean.
//
//--------------------------------------------------------------------------------------------------
// Ordeals are not implemented. Their CEILING is, because it is a fact about
// difficulty rather than a fact about Ordeals: four difficulties map onto the
// four tiers one for one, so Diff_OrdealCap is the whole of what difficulty has
// to say and needs nothing that does not exist yet.
//
// When Ordeals land they read Diff_OrdealCap and Diff_Of. Nothing should grow a
// second copy of either scale.
//--------------------------------------------------------------------------------------------------

// Blizzard's campaign scale, which is where the names come from. The bottom
// rung is Casual; this said Easy for one commit and that was simply wrong.
const int c_diffCasual = 0;
const int c_diffNormal = 1;
const int c_diffHard = 2;
const int c_diffBrutal = 3;
const int c_diffCount = 4;

// The four Ordeal tiers, in the order they get worse. One per difficulty, which
// is not a coincidence to be tidied away later -- it is the mapping.
const int c_ordealDawn = 0;
const int c_ordealNoon = 1;
const int c_ordealDusk = 2;
const int c_ordealMidnight = 3;

string[4] gvg_ordealName;

const string c_diffAttribute = "difficulty";

string[4] gvg_diffName;

// TUNING. Percent of the baseline personal wave. Blizzard's own campaign scale
// is the reference for the NAMES, not for these numbers -- nobody has designed
// a curve, and this is a deliberately plain spread rather than a guess dressed
// up as one.
int[4] gvg_diffWavePct;

// TUNING. Percent of the baseline energy target, read off the MEAN difficulty.
// Deliberately flatter than the wave spread: a harder game should be a longer
// game as well as a busier one, but doubling both at once multiplies.
int[4] gvg_diffGoalPct;

int[16] gvg_diffOf;

int Diff_Of (int player) {
    if (player < 1 || player > 15) {
        return c_diffNormal;
    }
    return gvg_diffOf[player];
}

void Diff_SetOf (int player, int level) {
    if (player < 1 || player > 15 || level < 0 || level >= c_diffCount) {
        return;
    }
    gvg_diffOf[player] = level;
}

string Diff_Name (int level) {
    if (level < 0 || level >= c_diffCount) {
        return "?";
    }
    return gvg_diffName[level];
}

string Diff_NameOf (int player) {
    return Diff_Name(Diff_Of(player));
}

int Diff_WavePct (int player) {
    return gvg_diffWavePct[Diff_Of(player)];
}

//--------------------------------------------------------------------------------------------------
// The table's difficulty: the mean of everybody's, rounded to nearest.
//
// Rounded to nearest rather than down. Three on Brutal and one on Casual comes
// to 2.25 and lands on Hard; rounding down would call that table Normal and cap
// its Ordeals at Noon, which is one player's pick quietly deciding for three who
// chose otherwise -- the same objection as taking the maximum, pointed the other
// way.
//
// An empty table answers Normal. Nothing should ever ask before players exist,
// but a difficulty of "no players" is not a thing and the alternative is a
// division by zero.
//--------------------------------------------------------------------------------------------------
int Diff_Global () {
    int total;
    int count;
    int player;

    total = 0;
    count = 0;
    player = 1;
    while (player <= 15) {
        if (Slot_IsTablePlayer(player)) {
            total = total + gvg_diffOf[player];
            count = count + 1;
        }
        player = player + 1;
    }
    if (count == 0) {
        return c_diffNormal;
    }
    return (total * 2 + count) / (count * 2);
}

string Diff_GlobalName () {
    return Diff_Name(Diff_Global());
}

//--------------------------------------------------------------------------------------------------
// The worst Ordeal this table can be dealt. A ceiling, not a schedule: which
// Ordeal actually arrives and when is the Ordeal system's business, and it does
// not exist yet.
//--------------------------------------------------------------------------------------------------
int Diff_OrdealCap () {
    return Diff_Global();
}

string Diff_OrdealName (int tier) {
    if (tier < 0 || tier > c_ordealMidnight) {
        return "?";
    }
    return gvg_ordealName[tier];
}

//--------------------------------------------------------------------------------------------------
// What the shared energy target should be, given a baseline.
//--------------------------------------------------------------------------------------------------
int Diff_GoalFrom (int base) {
    int goal;

    goal = base * gvg_diffGoalPct[Diff_Global()] / 100;
    if (goal < 1) {
        goal = 1;
    }
    return goal;
}

//--------------------------------------------------------------------------------------------------
// Which level a word means, or -1. First letter only, because this has to accept
// both what a player types into chat and whatever the lobby attribute's value
// ids turn out to be called.
//--------------------------------------------------------------------------------------------------
int Diff_FromWord (string word) {
    string first;

    if (word == "") {
        return -1;
    }
    first = StringCase(StringSub(word, 1, 1), false);

    if (first == "c") { return c_diffCasual; }
    if (first == "n") { return c_diffNormal; }
    if (first == "h") { return c_diffHard; }
    if (first == "b") { return c_diffBrutal; }

    // Melee calls its bottom rung Easy and half the people typing this will
    // reach for that word, so it means the same thing.
    if (first == "e") { return c_diffCasual; }
    return -1;
}

void Difficulty_Init () {
    int player;
    int level;

    gvg_diffName[c_diffCasual] = "Casual";
    gvg_diffName[c_diffNormal] = "Normal";
    gvg_diffName[c_diffHard] = "Hard";
    gvg_diffName[c_diffBrutal] = "Brutal";

    gvg_ordealName[c_ordealDawn] = "Dawn";
    gvg_ordealName[c_ordealNoon] = "Noon";
    gvg_ordealName[c_ordealDusk] = "Dusk";
    gvg_ordealName[c_ordealMidnight] = "Midnight";

    gvg_diffWavePct[c_diffCasual] = 60;
    gvg_diffWavePct[c_diffNormal] = 100;
    gvg_diffWavePct[c_diffHard] = 145;
    gvg_diffWavePct[c_diffBrutal] = 200;

    gvg_diffGoalPct[c_diffCasual] = 70;
    gvg_diffGoalPct[c_diffNormal] = 100;
    gvg_diffGoalPct[c_diffHard] = 125;
    gvg_diffGoalPct[c_diffBrutal] = 155;

    player = 1;
    while (player <= 15) {
        gvg_diffOf[player] = c_diffNormal;
        level = Diff_FromWord(GameAttributePlayerValue(c_diffAttribute, player));
        if (level >= 0) {
            gvg_diffOf[player] = level;
        }
        player = player + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// The four names for a PLAYER to read. Diff_Name stays a Galaxy string for the
// debug console, which is not translated.
//--------------------------------------------------------------------------------------------------
text Diff_NameText (int level) {
    if (level == c_diffCasual) { return Msg("Lob/Diff/Casual"); }
    if (level == c_diffHard) { return Msg("Lob/Diff/Hard"); }
    if (level == c_diffBrutal) { return Msg("Lob/Diff/Brutal"); }
    return Msg("Lob/Diff/Normal");
}

text Diff_NameTextOf (int player) {
    return Diff_NameText(Diff_Of(player));
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/02_codec.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Packing small numbers into short strings.
//
// This exists to answer one question before it becomes urgent: when the save
// file outgrows a key per value, can this project pack everything into one
// string? Yes, and this is the proof rather than the assurance.
//
// Nothing uses it yet. That is on purpose -- 16_bank works, no save file exists
// in the world, and putting untested code into the one path that can destroy a
// player's progress is a bad trade for bytes nobody is short of. What was worth
// doing now is establishing that the capability is real, because "we will
// compress it later" is only a plan if somebody has checked.
//
//--------------------------------------------------------------------------------------------------
// What Galaxy actually has, checked rather than remembered.
//
// CONFIRMED, from shipped Blizzard code:
//
//   <<   `attackersLimit = 1 << diff;`                        (MeleeAI.galaxy)
//   |    `(1 << (c_targetFilterDead - 32)) | (1 << ...)`       (NativeLib)
//
// Both on plain ints, both assigned to int variables. Fifteen thousand uses of
// `1 << (` across the shipped scripts, so this is not a corner of the language.
//
// NOT CONFIRMED: >>, &, ^, ~. Grepping every .galaxy file Blizzard ships turns
// up no int use of any of them -- every hit is prose in a comment. They very
// probably work. This file does not bet on it, because the map cannot be
// compiled on the machine this was written on, and a save format is a bad place
// to find out. Where a shift-right or a mask is wanted, integer / and % do the
// same job on non-negative values and are not in question:
//
//   v >> n   ==   v / (1 << n)          v & (2^n - 1)   ==   v % (1 << n)
//
// There is also a real `bitmask` type with BitMaskAndBitMask, BitMaskOrBitMask,
// BitMaskXorBitMask, BitMaskInvert, BitMaskLeftShift and BitMaskCountOnBits, if
// a genuine bitset is ever wanted. It is a heap object rather than a value, so
// it suits flags on a unit far better than it suits an encoder.
//
//--------------------------------------------------------------------------------------------------
// The encoding: base 64, five payload bits per character.
//
// Each character carries five bits of the number plus one continuation bit, low
// group first, so small numbers cost one character and there is no length
// prefix to keep in step with the data.
//
// The alphabet avoids < > & " ', all of which have to be escaped inside a bank
// file, and every character in it is one byte. Decoding is StringFind against
// the alphabet, which returns a 1-based index and -1 for absent -- confirmed
// from shipped code doing StringSub(s, 1, found - 1) and testing found == -1.
//
// Negative numbers are not representable and are clamped to zero. Everything
// this would ever store -- levels, counts, boxes, flags, quest progress -- is a
// count, and a varint that handles signs costs a bit on every value to serve a
// case that does not occur.
//--------------------------------------------------------------------------------------------------

const string c_codecAlphabet =
    "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz-_";

// Five bits of payload, and the sixth marks "another character follows".
const int c_codecRadix = 32;
const int c_codecMore = 32;

// Ints are 32-bit and signed, so a field wider than this overflows into the
// sign bit and stops being a number.
const int c_codecMaxBits = 30;

// The read cursor, 1-based into the string being decoded.
int gv_codecAt;

string Codec_Char (int digit) {
    if (digit < 0 || digit >= 64) {
        return "0";
    }
    return StringSub(c_codecAlphabet, digit + 1, digit + 1);
}

int Codec_Digit (string ch) {
    int found;

    found = StringFind(c_codecAlphabet, ch, true);
    if (found < 1) {
        return -1;
    }
    return found - 1;
}

//--------------------------------------------------------------------------------------------------
// One number, as one or more characters.
//--------------------------------------------------------------------------------------------------
string Codec_Int (int value) {
    string out;
    int part;
    bool more;

    if (value < 0) {
        value = 0;
    }

    out = "";
    more = true;
    while (more) {
        part = value % c_codecRadix;
        value = value / c_codecRadix;
        more = value > 0;
        if (more) {
            part = part + c_codecMore;
        }
        out = out + Codec_Char(part);
    }
    return out;
}

//--------------------------------------------------------------------------------------------------
// Reading. The cursor is a global rather than a parameter because Galaxy has no
// output parameters, and threading a position through every call site is how
// decoders acquire off-by-one bugs.
//--------------------------------------------------------------------------------------------------
void Codec_Open () {
    gv_codecAt = 1;
}

bool Codec_AtEnd (string s) {
    return gv_codecAt > StringLength(s);
}

int Codec_Next (string s) {
    int value;
    int place;
    int digit;
    bool more;

    value = 0;
    place = 1;
    more = true;

    while (more && gv_codecAt <= StringLength(s)) {
        digit = Codec_Digit(StringSub(s, gv_codecAt, gv_codecAt));
        gv_codecAt = gv_codecAt + 1;
        if (digit < 0) {
            // Not one of ours. Stop rather than guess -- a corrupted save should
            // read as short, not as an enormous number.
            return value;
        }
        more = digit >= c_codecMore;
        if (more) {
            digit = digit - c_codecMore;
        }
        value = value + digit * place;
        place = place * c_codecRadix;
    }
    return value;
}

//--------------------------------------------------------------------------------------------------
// Several small fields inside one int.
//
// Fields come back in the reverse of the order they went in, which is what a
// stack does and is not worth hiding: the alternative is passing the total width
// to every read so it can index from the top, and that number is exactly the
// thing that drifts when a field is added.
//
// Uses << and | to write, / and % to read, so nothing here depends on an
// operator that has not been seen in shipped code.
//--------------------------------------------------------------------------------------------------
int Codec_Width (int bits) {
    if (bits < 1) {
        bits = 1;
    }
    if (bits > c_codecMaxBits) {
        bits = c_codecMaxBits;
    }
    return 1 << bits;
}

int Codec_Put (int packed, int value, int bits) {
    int width;

    width = Codec_Width(bits);
    if (value < 0) {
        value = 0;
    }
    return (packed << bits) | (value % width);
}

int Codec_Get (int packed, int bits) {
    return packed % Codec_Width(bits);
}

int Codec_Drop (int packed, int bits) {
    return packed / Codec_Width(bits);
}

//--------------------------------------------------------------------------------------------------
// Round trip, as a report rather than as a promise.
//
// Every number here is a boundary: zero, the last one-character value, the first
// two-character value, and something long enough to need five. If this prints
// anything but ok, the encoding is wrong and the save format must not adopt it.
//--------------------------------------------------------------------------------------------------
string Codec_SelfTest () {
    string blob;
    string bad;
    int probe;
    int packed;
    int i;
    int[8] want;

    want[0] = 0;
    want[1] = 1;
    want[2] = 31;
    want[3] = 32;
    want[4] = 1023;
    want[5] = 1024;
    want[6] = 100000;
    want[7] = 1073741823;

    blob = "";
    i = 0;
    while (i < 8) {
        blob = blob + Codec_Int(want[i]);
        i = i + 1;
    }

    bad = "";
    Codec_Open();
    i = 0;
    while (i < 8) {
        probe = Codec_Next(blob);
        if (probe != want[i]) {
            bad = bad + " [" + IntToString(want[i]) + "->" + IntToString(probe) + "]";
        }
        i = i + 1;
    }

    // Three fields in one int, read back off the stack in reverse.
    packed = Codec_Put(Codec_Put(Codec_Put(0, 4, 3), 700, 12), 1, 1);
    if (Codec_Get(packed, 1) != 1) {
        bad = bad + " [field1]";
    }
    packed = Codec_Drop(packed, 1);
    if (Codec_Get(packed, 12) != 700) {
        bad = bad + " [field700]";
    }
    packed = Codec_Drop(packed, 12);
    if (Codec_Get(packed, 3) != 4) {
        bad = bad + " [field4]";
    }

    if (bad != "") {
        return "codec FAILED:" + bad;
    }
    return "codec ok -- 8 ints in " + IntToString(StringLength(blob))
           + " chars (\"" + blob + "\"), field packing round-trips";
}

