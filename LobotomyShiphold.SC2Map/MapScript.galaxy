//--------------------------------------------------------------------------------------------------
// Every live Abno unit on the map, whichever variant and whoever owns it.
// Works for runtime-spawned units too, unlike anything keyed on placed ids.
//--------------------------------------------------------------------------------------------------
unitgroup ObjectsGen_ScanAbno () {
    unitgroup found;
    int i;

    found = UnitGroupEmpty();
    i = 0;
    while (i < c_typesAbnoCount) {
        UnitGroupAddUnitGroup(found, UnitGroup(gvg_typesAbno[i], c_playerAny,
                                               RegionEntireMap(), null, 0));
        i = i + 1;
    }
    return found;
}

//--------------------------------------------------------------------------------------------------
// Whether a unit is a Abno, whatever variant. False for an empty
// category, so code can be written ahead of the units existing.
//--------------------------------------------------------------------------------------------------
bool ObjectsGen_IsAbno (unit target) {
    int i;

    if (target == null) {
        return false;
    }
    i = 0;
    while (i < c_typesAbnoCount) {
        if (UnitGetType(target) == gvg_typesAbno[i]) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

