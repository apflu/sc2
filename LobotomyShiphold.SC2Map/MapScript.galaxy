//--------------------------------------------------------------------------------------------------
// The table index of a unit type, or -1. This is also what makes a unit an
// abnormality: having a row here, which means having a doc.
//--------------------------------------------------------------------------------------------------
int AbnoGen_IndexOfType (string unitType) {
    int i;

    i = 0;
    while (i < c_abnoCount) {
        if (gvg_abnoType[i] == unitType) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

int AbnoGen_IndexOf (unit which) {
    if (which == null) {
        return -1;
    }
    return AbnoGen_IndexOfType(UnitGetType(which));
}

bool AbnoGen_Is (unit which) {
    return AbnoGen_IndexOf(which) >= 0;
}

//--------------------------------------------------------------------------------------------------
// Every abnormality alive on the map, whoever owns it.
//--------------------------------------------------------------------------------------------------
unitgroup AbnoGen_Scan () {
    unitgroup found;
    int i;

    found = UnitGroupEmpty();
    i = 0;
    while (i < c_abnoCount) {
        UnitGroupAddUnitGroup(found, UnitGroup(gvg_abnoType[i], c_playerAny,
                                               RegionEntireMap(), null, 0));
        i = i + 1;
    }
    return found;
}

//--------------------------------------------------------------------------------------------------
// Success chance for one work type against one stat level (1..5). Level VI
// (EX) reads as V, because the source tables stop at V.
//--------------------------------------------------------------------------------------------------
int AbnoGen_Pref (int index, int work, int statLevel) {
    if (index < 0 || index >= c_abnoCount || work < 0 || work >= 4) {
        return 0;
    }
    if (statLevel < 1) {
        statLevel = 1;
    }
    if (statLevel > 5) {
        statLevel = 5;
    }
    return gvg_abnoPref[index * 20 + work * 5 + statLevel - 1];
}

//--------------------------------------------------------------------------------------------------
// Cumulative observation bonuses at an observation level (0 = unobserved).
//--------------------------------------------------------------------------------------------------
int AbnoGen_ObsSpeed (int index, int obs) {
    if (index < 0 || index >= c_abnoCount) {
        return 0;
    }
    if (obs < 0) {
        obs = 0;
    }
    if (obs > 4) {
        obs = 4;
    }
    return gvg_abnoObsSpeed[index * 5 + obs];
}

int AbnoGen_ObsSuccess (int index, int obs) {
    if (index < 0 || index >= c_abnoCount) {
        return 0;
    }
    if (obs < 0) {
        obs = 0;
    }
    if (obs > 4) {
        obs = 4;
    }
    return gvg_abnoObsSuccess[index * 5 + obs];
}

//--------------------------------------------------------------------------------------------------
// What the next observation section costs, in that abnormality's own
// PE-Boxes. Zero once everything is bought.
//--------------------------------------------------------------------------------------------------
int AbnoGen_ObsCost (int index, int obs) {
    if (index < 0 || index >= c_abnoCount || obs < 0 || obs >= 4) {
        return 0;
    }
    return gvg_abnoObsCost[index * 4 + obs];
}

//--------------------------------------------------------------------------------------------------
// What this abnormality is CALLED, for a player to read.
//--------------------------------------------------------------------------------------------------
text AbnoGen_NameText (int index) {
    if (index < 0 || index >= c_abnoCount) {
        return StringToText("");
    }
    return StringExternal(gvg_abnoNameKey[index]);
}

//--------------------------------------------------------------------------------------------------
// What section `sec` of this abnormality says -- one of the four
// encyclopedia entries, pushed onto a control panel button.
//--------------------------------------------------------------------------------------------------
text AbnoGen_LoreText (int index, int sec) {
    if (index < 0 || index >= c_abnoCount || sec < 0 || sec >= 4) {
        return StringToText("");
    }
    return StringExternal(gvg_abnoLoreKey[index * 4 + sec]);
}

//--------------------------------------------------------------------------------------------------
// What a missed box on this abnormality costs. Defaults to White so that
// an unknown index costs the mind rather than the body -- the cheaper way
// to be wrong.
//--------------------------------------------------------------------------------------------------
int AbnoGen_DmgType (int index) {
    if (index < 0 || index >= c_abnoCount) {
        return c_dmgWhite;
    }
    return gvg_abnoDmgType[index];
}

int AbnoGen_DmgRoll (int index) {
    if (index < 0 || index >= c_abnoCount) {
        return 0;
    }
    return RandomInt(gvg_abnoDmgMin[index], gvg_abnoDmgMax[index]);
}

string AbnoGen_DmgName (int type) {
    if (type == c_dmgRed) { return "Red"; }
    if (type == c_dmgWhite) { return "White"; }
    if (type == c_dmgBlack) { return "Black"; }
    if (type == c_dmgPale) { return "Pale"; }
    return "?";
}

//--------------------------------------------------------------------------------------------------
// The damage line as a player would read it, for tooltips and debug.
//--------------------------------------------------------------------------------------------------
string AbnoGen_DmgText (int index) {
    if (index < 0 || index >= c_abnoCount) {
        return "";
    }
    return AbnoGen_DmgName(gvg_abnoDmgType[index]) + " "
           + IntToString(gvg_abnoDmgMin[index]) + "-"
           + IntToString(gvg_abnoDmgMax[index]);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/04_alerts.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Alerts.
//
// The stock game has 321 of them in this map's dependency chain, and almost
// none of them are about anything that happens here. "Your forces are under
// attack" is a melee sentence; a shift in a containment facility is made of
// breaches, meltdowns, doors coming down and people breaking, and every one of
// those wants its own line.
//
// So this switches the stock set OFF and leaves the alert channel empty for
// ours. That is the point: an alert is worth something only because it is rare,
// and 321 inherited ones spend that budget on nothing.
//
// UISetAlertTypeVisible is Blizzard's own tool for this -- zzerus03 uses it to
// mute "AttackUnit_Zerg" for the stretch of the mission where the player is
// supposed to be losing units. It is per alert TYPE and per player group, which
// is exactly the granularity wanted; the alternative was overriding the root
// <CAlert default="1"> entry in data, which would silence future alerts too and
// cannot be tested from this machine.
//
// The id list is generated (03_alerts_gen.galaxy) from tools/stock_alerts.txt,
// which is harvested from the game data by tools/gen_alerts.py. Ids from mods
// this map does not depend on are left out: an alert that cannot fire is not
// worth naming, and naming it would be asking the engine about something that
// is not loaded.
//
// Numbered 04 so the channel is clear before anything can raise anything.
//--------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
// Stock alerts worth keeping.
//
// THIS IS THE LIST TO EDIT. Everything else is generated, so the only decision
// anybody makes about alerts lives in this one function, and it reads as the
// argument for each survivor rather than as an absence in a table of 321.
//
// Empty on purpose right now. Nothing stock has been shown to be worth more
// than the line it would take up, and adding one back is a single condition.
//--------------------------------------------------------------------------------------------------
bool Alerts_Keep (string alert) {
    return false;
}

//--------------------------------------------------------------------------------------------------
// Ours, so a rebuild does not have to remember which ones it silenced.
//
// Nothing in the generated table starts with Lob_ -- gen_alerts drops them --
// so this is belt and braces against somebody adding an id by hand.
//--------------------------------------------------------------------------------------------------
bool Alerts_IsOurs (string alert) {
    return StringLength(alert) >= 4 && StringSub(alert, 1, 4) == "Lob_";
}

void Alerts_Init () {
    int i;

    i = 0;
    while (i < c_stockAlertCount) {
        if (!Alerts_Keep(gvg_stockAlert[i]) && !Alerts_IsOurs(gvg_stockAlert[i])) {
            UISetAlertTypeVisible(PlayerGroupAll(), gvg_stockAlert[i], false);
        }
        i = i + 1;
    }
}

