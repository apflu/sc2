    int i;

    found = UnitGroupEmpty();
    i = 0;
    while (i < c_typesCoreCount) {
        UnitGroupAddUnitGroup(found, UnitGroup(gvg_typesCore[i], c_playerAny,
                                               RegionEntireMap(), null, 0));
        i = i + 1;
    }
    return found;
}

