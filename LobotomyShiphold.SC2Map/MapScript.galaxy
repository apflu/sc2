    gvg_typesCore[0] = "Lob_Core_Basic";
    gvg_typesCoreDown[0] = "Lob_CoreDown_Basic";
    gvg_typesCoreDown_Basic[0] = "Lob_CoreDown_Basic";
    gvg_typesCore_Basic[0] = "Lob_Core_Basic";
    gvg_typesDebris[0] = "Lob_Debris_Normal";
    gvg_typesDebris_Normal[0] = "Lob_Debris_Normal";
    gvg_typesDevice[0] = "Lob_Device_Basic";
    gvg_typesDeviceDown[0] = "Lob_DeviceDown_Basic";
    gvg_typesDeviceDown_Basic[0] = "Lob_DeviceDown_Basic";
    gvg_typesDevice_Basic[0] = "Lob_Device_Basic";
    gvg_typesEmp[0] = "Lob_Emp_Basic";
    gvg_typesEmp_Basic[0] = "Lob_Emp_Basic";
    gvg_typesHero[0] = "Lob_Hero_Agent";
    gvg_typesHero_Agent[0] = "Lob_Hero_Agent";
    gvg_typesMarker[0] = "Lob_Marker_Spawn";
    gvg_typesMarker_Spawn[0] = "Lob_Marker_Spawn";
    gvg_typesPile[0] = "Lob_Pile_Ore";
    gvg_typesPile_Ore[0] = "Lob_Pile_Ore";
    gvg_typesRecycler[0] = "Lob_Recycler_Basic";
    gvg_typesRecycler_Basic[0] = "Lob_Recycler_Basic";
    gvg_typesSCV[0] = "Lob_SCV_Miner";
    gvg_typesSCV[1] = "Lob_SCV_Unassigned";
    gvg_typesSCV[2] = "Lob_SCV_Worker";
    gvg_typesSCV_Miner[0] = "Lob_SCV_Miner";
    gvg_typesSCV_Unassigned[0] = "Lob_SCV_Unassigned";
