void InitMap () {
    libNtve_InitLib();
    Difficulty_Init();
    AlertsGen_Init();
    AbnoGen_Init();
    Alerts_Init();
    ObjectsGen_Init();
    Sector_Init();
    Registry_Init();
    Employee_Init();
    Departments_Init();
    Energy_Init();
    Containment_Init();
    Meltdown_Init();
    Work_Init();
    Hero_Init();
    Bank_Init();
    Devices_Init();
    Clearing_Init();
    Fortify_Init();
    Ordeals_Init();
    Damage_Init();
    Workers_Init();
    Economy_Init();
    Waves_Init();
    Quests_Init();
    Debug_Init();
}
