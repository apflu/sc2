    unitgroup found;
    int i;

    found = UnitGroupEmpty();
    i = 0;
    while (i < c_typesRecycler_BasicCount) {
        UnitGroupAddUnitGroup(found, UnitGroup(gvg_typesRecycler_Basic[i], c_playerAny,
                                               RegionEntireMap(), null, 0));
        i = i + 1;
    }
    return found;
}

//--------------------------------------------------------------------------------------------------
// Whether a unit is a Recycler_Basic, whatever variant. False for an empty
// category, so code can be written ahead of the units existing.
//--------------------------------------------------------------------------------------------------
bool ObjectsGen_IsRecycler_Basic (unit target) {
    int i;

    if (target == null) {
        return false;
    }
    i = 0;
    while (i < c_typesRecycler_BasicCount) {
        if (UnitGetType(target) == gvg_typesRecycler_Basic[i]) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

