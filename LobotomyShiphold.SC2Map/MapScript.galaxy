//--------------------------------------------------------------------------------------------------
// src/galaxy/00_config.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Shared constants.
//
// Lives in the lowest-numbered module because Galaxy needs a declaration before
// its use and modules are concatenated in filename order.
//--------------------------------------------------------------------------------------------------

// Slots, read out of the map's own MapInfo rather than remembered: the player
// records carry their race id in slot order, and they read
//
//     1-6  Terr          the six players
//     7    Zerg          the swarm
//     8    Abnormality   whatever is loose
//
// The zerg used to be slot 2, which is now a player, so anything still saying 2
// would have been spawning waves for a teammate.
//
// Slot 8 is its own race because a loose abnormality has to be hostile to the
// zerg as well as to everybody else -- design 5.1 makes releasing an easy one
// to meet a wave a real tactic, and that is an alliance setting rather than
// anything script can arrange.
const int c_zergPlayer = 7;
const int c_abnoPlayer = 8;

// Still single player for the parts of P0 that have not been made per-player
// yet: the character, the economy readout. Not a claim about the map.
const int c_p0Player = 1;

