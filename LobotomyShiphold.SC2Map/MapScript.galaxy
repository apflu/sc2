void InitMap () {
    libNtve_InitLib();
    AbnoGen_Init();
    ObjectsGen_Init();
    Sector_Init();
    Registry_Init();
    Employee_Init();
    Departments_Init();
    Containment_Init();
    Work_Init();
    Hero_Init();
    Devices_Init();
    Clearing_Init();
    Workers_Init();
    Economy_Init();
    Waves_Init();
    Debug_Init();
}
