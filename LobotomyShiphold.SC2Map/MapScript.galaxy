//--------------------------------------------------------------------------------------------------
// src/galaxy/06_risk.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Risk levels.
//
// The five Lobotomy risk grades are five stock unit attributes. Nothing is
// computed or stored: an abnormality's grade is one checkbox on its CUnit, and
// asking for it is a native call against the unit type.
//
//     Zayin  = Biological
//     Teth   = Light
//     HE     = Armored
//     WAW    = Psionic
//     Aleph  = User1        (the editor labels this slot "Map Object")
//
// The attribute names are renamed in the text editor, so the unit panel, the
// tooltip and the damage-bonus lines all read "HE" rather than "Armored"
// without a line of script. Information Team lv2 wants an overhead readout of
// exactly this, and Control Team lv2/lv3 gate cross-department work on "below
// HE" / "below Aleph"; both are Risk_Of and a comparison.
//
// The cost of the reuse is that these five attributes now mean only this.
// Anything of ours that is not an abnormality must carry none of them, or it
// reads as a grade it does not have -- our devices were Armored and our
// employees were Light + Biological, and both had to come off.
//
// And it is most of the budget. The attribute set is closed at thirteen and the
// engine will not take a fourteenth: Light, Armored, Biological, Mechanical,
// Robotic, Psionic, Massive, Structure, Hover, Heroic, Summoned, User1, MapBoss.
// There is no User2. Five are spent here, Mechanical and Structure are in use,
// and every one of the rest already means something to stock abilities and
// filters. So this is the last tag that goes in an attribute; anything else we
// need to say about a unit type has to find another home.
//
// An attribute is also a bare flag with no payload, so nothing that needs a
// value can live here either.
//
// An unrated unit is c_riskNone, which is not the same as "Unknown" in the
// Information Team sense. Unknown is about what a player has observed; this is
// about what the unit is.
//--------------------------------------------------------------------------------------------------

const int c_riskNone = -1;
const int c_riskZayin = 0;
const int c_riskTeth = 1;
const int c_riskHE = 2;
const int c_riskWAW = 3;
const int c_riskAleph = 4;
const int c_riskCount = 5;

//--------------------------------------------------------------------------------------------------
// The attribute a grade is stored in.
//--------------------------------------------------------------------------------------------------
int Risk_Attribute (int level) {
    if (level == c_riskZayin) { return c_unitAttributeBiological; }
    if (level == c_riskTeth) { return c_unitAttributeLight; }
    if (level == c_riskHE) { return c_unitAttributeArmored; }
    if (level == c_riskWAW) { return c_unitAttributePsionic; }
    if (level == c_riskAleph) { return c_unitAttributeUser1; }
    return c_unitAttributeNone;
}

string Risk_Name (int level) {
    if (level == c_riskZayin) { return "Zayin"; }
    if (level == c_riskTeth) { return "Teth"; }
    if (level == c_riskHE) { return "HE"; }
    if (level == c_riskWAW) { return "WAW"; }
    if (level == c_riskAleph) { return "Aleph"; }
    return "";
}

//--------------------------------------------------------------------------------------------------
// A unit type's grade, or c_riskNone.
//
// Searched downwards so that a unit mistakenly carrying two grades reads as the
// higher one. Being told something is more dangerous than it is fails safe;
// being told it is less does not.
//--------------------------------------------------------------------------------------------------
int Risk_OfType (string unitType) {
    int level;

    level = c_riskAleph;
    while (level >= c_riskZayin) {
        if (UnitTypeTestAttribute(unitType, Risk_Attribute(level))) {
            return level;
        }
        level = level - 1;
    }
    return c_riskNone;
}

int Risk_Of (unit which) {
    if (which == null) {
        return c_riskNone;
    }
    return Risk_OfType(UnitGetType(which));
}

//--------------------------------------------------------------------------------------------------
// The containment-permission test, in the form the department doc states it:
// "below HE" is Risk_AtMost(u, c_riskTeth).
//
// Unrated units never pass. A rule written about abnormalities should not
// quietly also apply to a crate.
//--------------------------------------------------------------------------------------------------
bool Risk_AtMost (unit which, int level) {
    int actual;

    actual = Risk_Of(which);
    return actual != c_riskNone && actual <= level;
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/07_buffs.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Conditional buffs.
//
// The one primitive behind every effect that has to be able to stop.
//
// SC2 upgrades do not unwind. The level counter can be decremented -- Blizzard
// does it for flag-only upgrades -- but the EffectArray data modifications an
// upgrade applies are not reverted by taking the level away, and nothing in the
// stock data relies on them being. So an upgrade is the right home for a
// permanent fact and the wrong home for anything conditional.
//
// That splits department effects in two, and the split is a placement decision
// rather than a label on the upgrade:
//
//   Never turns off  -> EffectArray on the CUpgrade. No script at all.
//   Can turn off     -> a CBehaviorBuff, applied and removed through here.
//
// Baseline 7.3 needs the second kind: while a player's inner layer is lost the
// effects that run on installations stop, and the pure numbers keep working.
// Anything that has to obey that rule is a behavior, and the upgrade beside it
// is only the record that it was bought.
//
// Applying and removing rather than leaving it on also means the buff icon on
// the unit is an honest readout of what is actually helping right now.
//--------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
// Brings one unit's buff into line with whether it should have it.
//--------------------------------------------------------------------------------------------------
void Buffs_Set (unit who, string behaviorId, bool wanted) {
    bool held;

    if (who == null || !UnitIsAlive(who)) {
        return;
    }

    held = UnitHasBehavior2(who, behaviorId);
    if (wanted && !held) {
        UnitBehaviorAdd(who, behaviorId, who, 1);
    }
    else if (!wanted && held) {
        UnitBehaviorRemove(who, behaviorId, 1);
    }
}

//--------------------------------------------------------------------------------------------------
// The same for a whole group, where every member gets the same answer.
//--------------------------------------------------------------------------------------------------
void Buffs_SetGroup (unitgroup who, string behaviorId, bool wanted) {
    int count;
    int i;

    count = UnitGroupCount(who, c_unitCountAlive);
    i = 1;
    while (i <= count) {
        Buffs_Set(UnitGroupUnit(who, i), behaviorId, wanted);
        i = i + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/08_downable.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Things that answer a killing blow by going offline instead of dying.
//
// Devices do it (baseline 4.5) and the rest hall core does it (baseline 3.2,
// losing the inner layer is reversible), and there will be more. The pattern is
// always the same: a fatal hit swaps the unit for its Down counterpart, and
// repairing that back to full swaps it in return.
//
// The type-name convention carries the pairing: Lob_<Thing>_<Variant> against
// Lob_<Thing>Down_<Variant>. State is the first segment rather than a suffix
// on the variant, which is what keeps ObjectsGen_Scan<Thing>() meaning "the
// ones that are working" without any filtering. See docs/dev/authoring-contract.md.
//
// Each system keeps its own trigger and calls in here, rather than this module
// dispatching. Dispatch would need a type table Galaxy cannot walk, and the
// glue per system is three lines.
//--------------------------------------------------------------------------------------------------

// Life a downed thing is born at. Not zero, and low enough that repairing it is
// a visible job rather than a formality.
const fixed c_downedLife = 1.0;

//--------------------------------------------------------------------------------------------------
// Swaps one type prefix for the other, keeping the variant segment.
//--------------------------------------------------------------------------------------------------
string Downable_Retype (string from, string fromPrefix, string toPrefix) {
    return toPrefix + StringSub(from, StringLength(fromPrefix) + 1, StringLength(from));
}

//--------------------------------------------------------------------------------------------------
// Replaces a unit with its counterpart in the other state, in place.
//--------------------------------------------------------------------------------------------------
void Downable_Morph (unit which, string toType, fixed life) {
    point where;
    fixed facing;
    int owner;

    where = UnitGetPosition(which);
    facing = UnitGetFacing(which);
    owner = UnitGetOwner(which);

    // Remove rather than kill: killing would fire the death handlers, and going
    // offline is not a death in any sense the rest of the code means. Removing
    // also frees the footprint before the replacement needs it, though placement
    // is ignored anyway for good measure.
    UnitRemove(which);

    UnitCreate(1, toType, c_unitCreateIgnorePlacement, owner, where, facing);
    UnitSetPropertyFixed(UnitLastCreated(), c_unitPropLife, life);
}

//--------------------------------------------------------------------------------------------------
// Takes the killing blow off a unit and puts its downed counterpart there.
//--------------------------------------------------------------------------------------------------
void Downable_TakeDown (unit victim, string upPrefix, string downPrefix) {
    // Clamp first so the unit cannot die between here and the morph.
    UnitSetPropertyFixed(victim, c_unitPropLife, c_downedLife);
    Downable_Morph(victim,
                   Downable_Retype(UnitGetType(victim), upPrefix, downPrefix),
                   c_downedLife);
}

//--------------------------------------------------------------------------------------------------
// Puts back anything in `down` that has been repaired to full.
//
// Counting down, not up: morphing removes the unit, and a unit group drops units
// that stop existing, so walking forwards would renumber the tail and skip every
// second one that finished repairing on the same tick.
//--------------------------------------------------------------------------------------------------
void Downable_RestoreRepaired (unitgroup down, string downPrefix, string upPrefix) {
    unit which;
    int count;
    int i;

    count = UnitGroupCount(down, c_unitCountAlive);
    i = count;
    while (i >= 1) {
        which = UnitGroupUnit(down, i);
        if (which != null && UnitGetPropertyFixed(which, c_unitPropLifePercent, true) >= 99.0) {
            Downable_Morph(which,
                           Downable_Retype(UnitGetType(which), downPrefix, upPrefix),
                           UnitGetPropertyFixed(which, c_unitPropLifeMax, true));
        }
        i = i - 1;
    }
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/09_sector.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Sectors and the inner layer.
//
// Baseline 3.2 splits every player's sector in two: an outer work face where
// being overrun is only a fight, and an inner core where the economy and the
// department passives live. That split is the structural reason section 1's
// no-punish principle holds -- a neighbour's mistake pushes zerg into your
// outer layer, but only your own failure to hold the inner layer touches what
// you are actually worth.
//
// Two separate things, deliberately not one:
//
//   The core is a unit, Lob_Core_Basic. It answers "is the inner layer still
//   held", it has an owner, and it is what department and fortification
//   upgrades will hang their command card off. Losing it is reversible per 3.2,
//   so it goes down exactly the way a device does, via 18_downable.galaxy.
//
//   The rest hall is a region, drawn in the editor. A rest hall is a room with
//   walls, and no arrangement of circles around a unit is that shape. It is
//   also not fixed: department upgrades are expected to change how far the
//   rest hall reaches, so what the script tests against is a region built at
//   runtime that starts as a copy of the drawn one and can be added to.
//
// Binding is by containment rather than by a name-to-player convention: the
// rest hall region a player owns is the one their core stands in. Renumbering
// players or renaming regions cannot desynchronise that.
//
// Numbered early on purpose. Galaxy needs a declaration before its use and the
// modules concatenate in filename order, so anything other systems query has to
// come before them, whatever order it was written in.
//--------------------------------------------------------------------------------------------------

const string c_coreUpPrefix = "Lob_Core_";
const string c_coreDownPrefix = "Lob_CoreDown_";

// Editor regions whose name starts with this are rest halls.
const string c_restHallRegionPrefix = "resthall";

// Used only when no rest hall region has been drawn yet, so that the system
// works before the editor side lands rather than being inert. A room-shaped
// region should replace it; this is a stand-in, not a fallback worth keeping.
const fixed c_restHallFallbackRadius = 12.0;

const fixed c_sectorPeriod = 1.0;

const string c_restHallBuff = "Lob_RestHall_Recovery";

// One composed rest hall per player slot. Built at init and mutated in place by
// Sector_RestHallExtend, so a department upgrade changes the region rather than
// changing any code that reads it.
region[16] gvg_restHall;

trigger gt_coreFatal;
trigger gt_sectorTick;

//--------------------------------------------------------------------------------------------------
// Whether this player still holds their inner layer.
//
// Asked of the world rather than of a flag, so there is nothing that can drift:
// a held core is a Lob_Core_ unit they own existing, and a lost one is a
// Lob_CoreDown_ unit standing in its place.
//--------------------------------------------------------------------------------------------------
bool Sector_InnerHeld (int player) {
    unitgroup cores;
    unit core;
    int count;
    int i;

    cores = ObjectsGen_ScanCore();
    count = UnitGroupCount(cores, c_unitCountAlive);

    i = 1;
    while (i <= count) {
        core = UnitGroupUnit(cores, i);
        if (core != null && UnitGetOwner(core) == player) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

//--------------------------------------------------------------------------------------------------
// A player's core, held or downed. Null if they have none placed at all.
//--------------------------------------------------------------------------------------------------
unit Sector_AnyCore (int player) {
    unitgroup cores;
    unit core;
    int count;
    int i;

    cores = ObjectsGen_ScanCore();
    UnitGroupAddUnitGroup(cores, ObjectsGen_ScanCoreDown());
    count = UnitGroupCount(cores, c_unitCountAlive);

    i = 1;
    while (i <= count) {
        core = UnitGroupUnit(cores, i);
        if (core != null && UnitGetOwner(core) == player) {
            return core;
        }
        i = i + 1;
    }
    return null;
}

//--------------------------------------------------------------------------------------------------
// Whose sector a point is in.
//
// Answered by the nearest core, held or downed. Sectors are rooms joined by
// corridors rather than tiles on a grid, so there is no region that covers "all
// of player 3's territory" to test against -- but every sector has exactly one
// core at its centre by construction, and nearest-core is the same spatial
// question asked in a way the map can actually answer.
//
// Returns 0 when no core is placed at all, and callers are expected to treat
// that as "nobody" rather than as player 1. A thing belonging to nobody should
// be visibly inert, not silently somebody's.
//--------------------------------------------------------------------------------------------------
int Sector_OwnerNear (point where) {
    unitgroup cores;
    unit core;
    int count;
    int i;
    int best;
    fixed bestDist;
    fixed d;

    cores = ObjectsGen_ScanCore();
    UnitGroupAddUnitGroup(cores, ObjectsGen_ScanCoreDown());
    count = UnitGroupCount(cores, c_unitCountAlive);

    best = 0;
    bestDist = 0.0;
    i = 1;
    while (i <= count) {
        core = UnitGroupUnit(cores, i);
        if (core != null && Slot_IsTablePlayer(UnitGetOwner(core))) {
            d = DistanceBetweenPoints(UnitGetPosition(core), where);
            if (best == 0 || d < bestDist) {
                best = UnitGetOwner(core);
                bestDist = d;
            }
        }
        i = i + 1;
    }
    return best;
}

//--------------------------------------------------------------------------------------------------
// Widens a player's rest hall. This is the hook department upgrades use; the
// region is mutated in place, so everything already testing against it follows
// with no further wiring.
//--------------------------------------------------------------------------------------------------
void Sector_RestHallExtend (int player, region extra) {
    if (player < 1 || player > 15) {
        return;
    }
    RegionAddRegion(gvg_restHall[player], extra);
}

//--------------------------------------------------------------------------------------------------
// Whether a unit is standing in its owner's rest hall, with that rest hall
// still held.
//
// A downed core does not shelter anybody: the room is still there, but the
// thing that made it a rest hall is not. That is the point of 3.2, and it is
// why this asks about the core as well as about the geometry.
//--------------------------------------------------------------------------------------------------
bool Sector_InRestHall (unit which) {
    int owner;

    if (which == null) {
        return false;
    }
    owner = UnitGetOwner(which);
    if (owner < 1 || owner > 15) {
        return false;
    }
    if (!Sector_InnerHeld(owner)) {
        return false;
    }
    return RegionContainsPoint(gvg_restHall[owner], UnitGetPosition(which));
}

//--------------------------------------------------------------------------------------------------
// The inner layer, for the greybox readout.
//--------------------------------------------------------------------------------------------------
string Sector_HeldText (int player) {
    if (Sector_InnerHeld(player)) {
        return "held";
    }
    return "LOST";
}

//--------------------------------------------------------------------------------------------------
// Intercepts the killing blow on a core. Same shape as the device handler.
//--------------------------------------------------------------------------------------------------
bool Sector_CoreFatal_Func (bool testConds, bool runActions) {
    unit victim;

    if (!runActions) {
        return true;
    }

    victim = EventUnit();
    if (!ObjectsGen_IsCore(victim)) {
        return true;
    }

    Downable_TakeDown(victim, c_coreUpPrefix, c_coreDownPrefix);
    UIDisplayMessage(
        PlayerGroupAll(),
        c_messageAreaSubtitle,
        StringToText("inner layer lost -- repair the core to get it back")
    );
    return true;
}

//--------------------------------------------------------------------------------------------------
// Restores repaired cores, and keeps rest hall recovery matched to who is
// actually standing in one.
//
// Applied and removed rather than left on, so the buff icon on the unit is an
// honest readout of whether the room is doing anything for them right now.
//--------------------------------------------------------------------------------------------------
bool Sector_Tick_Func (bool testConds, bool runActions) {
    unitgroup people;
    unit who;
    int count;
    int i;

    if (!runActions) {
        return true;
    }

    Downable_RestoreRepaired(ObjectsGen_ScanCoreDown(), c_coreDownPrefix, c_coreUpPrefix);

    // Everyone a rest hall is for. Employees were missing, which is the one
    // group the room exists for -- SCVs and the character were getting it and
    // the people whose SP it is supposed to restore were not.
    people = ObjectsGen_ScanHero();
    UnitGroupAddUnitGroup(people, ObjectsGen_ScanSCV());
    UnitGroupAddUnitGroup(people, ObjectsGen_ScanEmp());
    count = UnitGroupCount(people, c_unitCountAlive);

    i = 1;
    while (i <= count) {
        who = UnitGroupUnit(people, i);
        Buffs_Set(who, c_restHallBuff, Sector_InRestHall(who));
        i = i + 1;
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// Gives each player the drawn region their core stands in, composed into a
// region this module owns so upgrades can widen it later.
//--------------------------------------------------------------------------------------------------
void Sector_BuildRestHalls () {
    unit core;
    region drawn;
    int player;
    int i;
    bool matched;

    player = 1;
    while (player <= 15) {
        gvg_restHall[player] = RegionEmpty();
        core = Sector_AnyCore(player);

        if (core != null) {
            matched = false;
            i = 0;
            while (i < c_regionCount) {
                // Length checked first: a region whose name is shorter than
                // the prefix would otherwise be handed to StringSub with an end
                // index past its last character.
                if (StringLength(gvg_regionNames[i]) >= StringLength(c_restHallRegionPrefix)
                    && StringSub(gvg_regionNames[i], 1, StringLength(c_restHallRegionPrefix))
                       == c_restHallRegionPrefix) {
                    drawn = RegionFromId(gvg_regionIds[i]);
                    if (RegionContainsPoint(drawn, UnitGetPosition(core))) {
                        RegionAddRegion(gvg_restHall[player], drawn);
                        matched = true;
                    }
                }
                i = i + 1;
            }

            if (!matched) {
                RegionAddCircle(gvg_restHall[player], true,
                                UnitGetPosition(core), c_restHallFallbackRadius);
            }
        }
        player = player + 1;
    }
}

void Sector_Init () {
    Sector_BuildRestHalls();

    gt_coreFatal = TriggerCreate("Sector_CoreFatal_Func");
    TriggerAddEventUnitDamaged(gt_coreFatal, null, c_unitDamageTypeAny, c_unitDamageFatal, null);

    gt_sectorTick = TriggerCreate("Sector_Tick_Func");
    TriggerAddEventTimePeriodic(gt_sectorTick, c_sectorPeriod, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/10_registry.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Startup self-check.
//
// There is no registry object to maintain: the generated scan functions in
// 05_objects_gen.galaxy already answer "what is on the map", live, including
// for units spawned at runtime. This module only reports what they see once at
// startup, which is where authoring mistakes show up.
//
// Type counts come from a runtime scan; the group count comes from the build's
// snapshot of Objects. Printing them side by side is deliberate: a nonzero type
// count next to a zero group count means the build did not run after the last
// editor save, which is otherwise an invisible and very confusing state.
//--------------------------------------------------------------------------------------------------

// A function as well as a startup print, so the same check can be repeated on
// demand from the debug console. Startup is when authoring mistakes show up,
// but it is not the only time the answer is worth having -- and until the
// periodic economy readout was taken off the subtitle area, this one was
// usually overwritten before it could be read.
string Registry_ScanLine () {
    return "scan: hero=" + IntToString(UnitGroupCount(ObjectsGen_ScanHero(), c_unitCountAlive))
           + " emp=" + IntToString(UnitGroupCount(ObjectsGen_ScanEmp(), c_unitCountAlive))
           + " abno=" + IntToString(UnitGroupCount(AbnoGen_Scan(), c_unitCountAlive))
           + "/" + IntToString(c_abnoCount) + "known"
           + " debris=" + IntToString(UnitGroupCount(ObjectsGen_ScanDebris(), c_unitCountAlive))
           + " worker=" + IntToString(UnitGroupCount(ObjectsGen_ScanSCV_Worker(), c_unitCountAlive))
           + " miner=" + IntToString(UnitGroupCount(ObjectsGen_ScanSCV_Miner(), c_unitCountAlive))
           + " device=" + IntToString(UnitGroupCount(ObjectsGen_ScanDevice(), c_unitCountAlive))
           + " | group(debris)=" + IntToString(UnitGroupCount(ObjectsGen_Group("debris"), c_unitCountAlive));
}

void Registry_Init () {
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle,
                     StringToText(Registry_ScanLine()));
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/11_employee.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Employees.
//
// The half of the verb that carries a name. An abnormality on its own is a
// mine with a plot; what makes it an abnormality is that there is a specific
// person you decided to send, and a specific way you told them to work
// (docs/design/agents-and-abnormalities.md 2.1). This module owns that person.
// The cell and the work order are separate modules.
//
// Nothing here stores a stat, and nothing here draws one. Both halves are the
// engine's, and finding out which part of the engine took three tries:
//
//   A stat DISPLAYS as a CBehaviorAttribute. core's InfoPaneHero layout
//   reserves AttributeLabel1..5 down the right of the hero pane to draw
//   exactly these, named from Behavior/Name; MaxPoints caps it, and its
//   per-point Modification is where the stat's effect goes. War3's STR/AGI/INT
//   are this catalog.
//
//   A stat is STORED in that same behavior, through UnitGetAttributePoint and
//   UnitSetAttributePoint. Points are not the behavior's stack count, so
//   UnitBehaviorCount answers 0 no matter what -- but there is a native pair
//   for them, and it lives in natives_missing.galaxy rather than in
//   natives.galaxy, which is why an earlier version of this file routed the
//   number through four stackable carrier buffs instead. Those are gone.
//
//   Rank is one CBehaviorVeterancy. The hero pane's level readout is a sum over
//   every veterancy a unit carries, so a unit with exactly one veterancy shows
//   that veterancy's level and its progress bar -- and rank is itself a sum, so
//   the two agree by construction rather than by being kept in step.
//
// The first attempt made all four stats veterancies. It was not wrong about the
// XP natives -- they really do address a veterancy by name, and four curves on
// one unit really do work -- but four fresh stats then read as "level 4, 0/120"
// on the panel, because the panel was summing them. That aggregate is not an
// obstacle to route around; it is the panel doing its job, and the thing it
// wants to be handed is the rank.
//
// The second attempt read and wrote the attribute behavior with the BEHAVIOR
// natives. It silently did nothing -- the count answered 0 before and after
// every write. The third routed the number through a stackable carrier buff per
// stat, which worked; the fourth is this one, after UnitSetAttributePoint
// turned up in the natives file that natives.galaxy does not include.
//
// What is left for this file is two rules that have no engine-side home:
//
//   The stat thresholds. The same numbers appear on Lob_Rank in BehaviorData
//   -- MinVeterancyXP is an absolute total, not an increment -- so the two
//   tables are literally the same and must be edited together.
//
//   The sum rule. Employee rank is the SUM of the four stat levels, not the
//   minimum -- see Emp_Rank, where the reason is written down.
//
// SP lives here too, because SP is a vital of the same person and Prudence is
// what sets its ceiling -- one more per-point Modification, no script.
//
// SP is the Energy vital. Not a script number with a bar drawn next to it: the
// engine already has a second vital that the unit panel draws, that behaviors
// can modify, and that has max, current and regeneration. Employees cast
// nothing, so it was free, and taking it means the Welfare Team's white rounds
// are a heal effect rather than a special case.
//
// Permanent death needs no code. Nothing respawns an employee, and that is the
// whole of the death penalty; Central Command's replenishment is a separate
// system priced against it.
//--------------------------------------------------------------------------------------------------

const int c_statFortitude = 0;   // 勇气 -- life
const int c_statPrudence = 1;    // 谨慎 -- SP
const int c_statTemperance = 2;  // 自律 -- work speed
const int c_statJustice = 3;     // 正义 -- attack speed
const int c_statCount = 4;

// I II III IV V EX. EX is out of reach at the default cap and is meant to be.
const int c_statLevelCount = 6;

// I II III IV V. Rank stops at V; there is no rank EX.
const int c_rankCount = 5;

// The ceiling on one stat. 99 keeps EX (100) locked behind whatever ends up
// lifting it, which is the only reason the sixth level exists at all. The
// behavior's own MaxPoints is 100, so this is the binding constraint and the
// data side is only there to make EX representable.
const int c_statCapDefault = 99;

// The floor, and it is not decoration. Fortitude IS max life and Prudence IS
// max SP, one point for one, so a stat of zero is a unit with one hit point and
// no mind at all. The floor is what makes "the stat is the vital" safe to say.
//
// It is a floor rather than a starting value because Training Team can push a
// stat DOWN, and the two need the same answer: an employee can be made worse,
// and cannot be made into a corpse by paperwork.
//
// TUNING. Nothing states what a new employee is worth.
const int c_statMin = 20;

const string c_rankBehavior = "Lob_Rank";

const fixed c_empPeriod = 2.0;

const string c_panicBuff = "Lob_Panicked";

string[4] gvg_statBehavior;
string[4] gvg_statName;

// The base/bonus selector on the attribute point natives. Both calls pass the
// same value, so the stat round-trips whichever half of the split this picks;
// the panel shows the total either way. Worth one look in game only if a
// department upgrade ever needs to add points that Training Team cannot take
// back, which is exactly what the other half is for.
const bool c_attrBase = true;

// Absolute points at which each stat level starts.
int[6] gvg_statLevelMin;

// Sum of the four stat levels at which each rank starts. The same numbers are
// on Lob_Rank in BehaviorData.xml.
int[5] gvg_rankMin;

trigger gt_empTick;
trigger gt_empCreated;

string Emp_StatBehavior (int stat) {
    if (stat < 0 || stat >= c_statCount) {
        return "";
    }
    return gvg_statBehavior[stat];
}

string Emp_StatName (int stat) {
    if (stat < 0 || stat >= c_statCount) {
        return "";
    }
    return gvg_statName[stat];
}

//--------------------------------------------------------------------------------------------------
// One stat's value, 0 to the cap.
//--------------------------------------------------------------------------------------------------
int Emp_Stat (unit who, int stat) {
    if (who == null || stat < 0 || stat >= c_statCount) {
        return 0;
    }
    return UnitGetAttributePoint(who, gvg_statBehavior[stat], c_attrBase);
}

//--------------------------------------------------------------------------------------------------
// The ceiling on one stat for one employee.
//
// A function rather than the constant, because the thing that lifts it to 100
// is a department upgrade and this is where it will read it. Until that upgrade
// exists it is the constant, and callers do not have to change when it stops
// being one.
//--------------------------------------------------------------------------------------------------
int Emp_StatCap (unit who) {
    return c_statCapDefault;
}

//--------------------------------------------------------------------------------------------------
// Moves a stat, clamped into [0, cap].
//
// Takes a signed delta on purpose. Training Team's job is "练得更可控", which
// 2.4 spells out as being able to push a stat back down -- that is what turns a
// mistrained employee from ruined into a delay. A separate lowering function
// would be a second place for the clamp to be wrong.
//
// Diffed against what the unit already has rather than applied blind, so a
// caller can ask for an absolute value by passing the difference and get the
// same clamp either way.
//--------------------------------------------------------------------------------------------------
void Emp_StatAdd (unit who, int stat, int delta) {
    int have;
    int want;
    int cap;

    if (who == null || !UnitIsAlive(who) || stat < 0 || stat >= c_statCount) {
        return;
    }

    cap = Emp_StatCap(who);
    have = Emp_Stat(who, stat);
    want = have + delta;
    if (want < c_statMin) {
        want = c_statMin;
    }
    if (want > cap) {
        want = cap;
    }

    if (want != have) {
        UnitSetAttributePoint(who, gvg_statBehavior[stat], c_attrBase, want);
    }
}

void Emp_StatSet (unit who, int stat, int value) {
    Emp_StatAdd(who, stat, value - Emp_Stat(who, stat));
}

//--------------------------------------------------------------------------------------------------
// One stat's level, 1 (I) through 6 (EX).
//--------------------------------------------------------------------------------------------------
int Emp_StatLevel (unit who, int stat) {
    int value;
    int level;
    int i;

    value = Emp_Stat(who, stat);
    level = 1;
    i = 2;
    while (i <= c_statLevelCount) {
        if (value >= gvg_statLevelMin[i - 1]) {
            level = i;
        }
        i = i + 1;
    }
    return level;
}

//--------------------------------------------------------------------------------------------------
// The sum of the four stat levels: 4 at worst, 24 at all-EX. This is what rank
// is computed from and what the experience bar is fed.
//--------------------------------------------------------------------------------------------------
int Emp_LevelSum (unit who) {
    int sum;
    int i;

    sum = 0;
    i = 0;
    while (i < c_statCount) {
        sum = sum + Emp_StatLevel(who, i);
        i = i + 1;
    }
    return sum;
}

//--------------------------------------------------------------------------------------------------
// Employee rank, 1 (I) through 5 (V).
//
// The sum of the four stat levels, and this must not be changed to the minimum.
//
// V requires a sum of 16, and V+V+V+I is 5+5+5+1 = 16: a three-stat specialist
// with one stat left deliberately under 30 is still rank V. That is the whole
// point. A batch of abnormalities require a stat to be no HIGHER than some
// value (O-05-30, F-05-32, T-01-68, F-01-87, O-02-98), and Training Team's
// challenge asks for every employee at rank V. Under a minimum rule, finishing
// that challenge would leave the player with nobody able to work that batch --
// a department's final reward would quietly close a whole class of content.
// Under a sum rule the two do not collide, and "which three do I train" stays a
// real choice.
//
// See docs/design/agents-and-abnormalities.md 2.4.
//--------------------------------------------------------------------------------------------------
int Emp_Rank (unit who) {
    int sum;
    int rank;
    int i;

    sum = Emp_LevelSum(who);

    rank = 1;
    i = 2;
    while (i <= c_rankCount) {
        if (sum >= gvg_rankMin[i - 1]) {
            rank = i;
        }
        i = i + 1;
    }
    return rank;
}

//--------------------------------------------------------------------------------------------------
// Feeds the rank veterancy so the hero pane's level and experience bar read the
// rank and its progress.
//
// Writing the XP is the whole of it: the engine derives the level from the
// running total against Lob_Rank's absolute thresholds, which are the same
// numbers as gvg_rankMin. Both of those facts were measured rather than
// assumed. XP is a running total and not a per-level counter -- an employee
// left at 6 XP stayed at 6 across several promotions -- and levels are 1-based,
// which four fresh veterancies reading as "level 4" established.
//
// No level is written. Setting the XP and then correcting the level would be
// two sources for one number, and the panel disagreeing with Emp_Rank is
// exactly what the -emp readout prints so it can be seen.
//--------------------------------------------------------------------------------------------------
void Emp_SyncRank (unit who) {
    if (who == null || !UnitIsAlive(who)) {
        return;
    }
    UnitXPSetCurrentXP(who, c_rankBehavior, IntToFixed(Emp_LevelSum(who)));
}

//--------------------------------------------------------------------------------------------------
// Brings a new employee up to the floor, and fills them up.
//
// On the creation event rather than on the tick, because between creation and
// this the unit has one hit point: the base LifeMax is 1 so that instant is
// survivable, and Fortitude supplies everything above it.
//
// Filling afterwards is not optional either. Raising a vital's maximum does not
// raise what is currently in it, so an employee seeded but not filled would
// stand there at 1 of 21 life.
//--------------------------------------------------------------------------------------------------
void Emp_Seed (unit who) {
    int stat;

    if (who == null || !UnitIsAlive(who)) {
        return;
    }

    stat = 0;
    while (stat < c_statCount) {
        if (Emp_Stat(who, stat) < c_statMin) {
            UnitSetAttributePoint(who, gvg_statBehavior[stat], c_attrBase, c_statMin);
        }
        stat = stat + 1;
    }

    UnitSetPropertyFixed(who, c_unitPropLife,
                         UnitGetPropertyFixed(who, c_unitPropLifeMax, true));
    UnitSetPropertyFixed(who, c_unitPropEnergy,
                         UnitGetPropertyFixed(who, c_unitPropEnergyMax, true));
    Emp_SyncRank(who);
}

bool Emp_Created_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    if (ObjectsGen_IsEmp(EventUnit())) {
        Emp_Seed(EventUnit());
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// SP.
//
// White damage is damage to the mind. It has no relationship to the health bar,
// which is the point: a work chosen badly costs nothing you can see until the
// person breaks, and that delay is what makes the choice feel like a judgement
// rather than a trade.
//
// Panic is a behavior applied at zero and removed above it, so the state and
// its consequences are one object -- the same arrangement as Lob_Contained. What
// panic actually does is authored in that behavior's Modification and is empty
// for now: the design says it happens (2.4, and Training Team lv2 has an
// upgrade for not panicking at the sight of an HE), but not what it looks like.
//--------------------------------------------------------------------------------------------------
int Emp_SP (unit who) {
    if (who == null) {
        return 0;
    }
    return FixedToInt(UnitGetPropertyFixed(who, c_unitPropEnergy, true));
}

int Emp_SPMax (unit who) {
    if (who == null) {
        return 0;
    }
    return FixedToInt(UnitGetPropertyFixed(who, c_unitPropEnergyMax, true));
}

bool Emp_IsPanicked (unit who) {
    return who != null && UnitHasBehavior2(who, c_panicBuff);
}

//--------------------------------------------------------------------------------------------------
// Moves SP, clamped into [0, max]. Signed, so healing and white damage are the
// same call and the clamp has one home.
//--------------------------------------------------------------------------------------------------
void SP_Add (unit who, int delta) {
    int value;
    int cap;

    if (who == null || !UnitIsAlive(who)) {
        return;
    }

    cap = Emp_SPMax(who);
    value = Emp_SP(who) + delta;
    if (value < 0) {
        value = 0;
    }
    if (value > cap) {
        value = cap;
    }
    UnitSetPropertyFixed(who, c_unitPropEnergy, IntToFixed(value));
    Buffs_Set(who, c_panicBuff, value <= 0 && cap > 0);
}

void SP_Damage (unit who, int amount) {
    SP_Add(who, -amount);
}

void SP_Restore (unit who, int amount) {
    SP_Add(who, amount);
}

//--------------------------------------------------------------------------------------------------
// Damage to the body, which for an employee is permanent.
//
// Set rather than dealt. Work damage has no source, no weapon and no direction,
// and it is not supposed to be reduced by armour or reflected by anything --
// routing it through the combat system would attach all three. Zero kills
// outright, because 2.6 has employee death as a real loss and there is no
// downed state for a person.
//--------------------------------------------------------------------------------------------------
void Emp_LifeDamage (unit who, fixed amount) {
    fixed life;

    if (who == null || !UnitIsAlive(who) || amount <= 0.0) {
        return;
    }

    life = UnitGetPropertyFixed(who, c_unitPropLife, true) - amount;
    if (life <= 0.0) {
        UnitKill(who);
        return;
    }
    UnitSetPropertyFixed(who, c_unitPropLife, life);
}

//--------------------------------------------------------------------------------------------------
// How much of a given kind of work damage this employee actually takes, as a
// percent. 100 is unarmoured.
//
// THIS IS WHERE E.G.O ARMOUR LANDS, and it is a seam rather than a system: a
// suit resists some kinds and leaves you MORE open to others, so the number is
// deliberately a percent that may exceed 100 rather than a reduction that
// cannot. One function so that adding equipment later is filling this in, not
// finding every place damage is applied.
//
// It is not a behavior Modification, and that is worth writing down because the
// engine looks like it already has this. It does, almost:
//
//     <DamageTakenFraction index="Melee" value="3"/>
//
// -- real, native, and 3 proves that going ABOVE one is supported. But its index
// is a closed set of damage KINDS (Melee, Ranged, Splash, Ability, Basic) that
// real weapons already speak, so a suit that resisted "Red" by claiming one of
// them would also resist zerg. Red/White/Black/Pale need a channel of their own,
// and which one is a question for whoever builds E.G.O -- not something to guess
// at now, which is how this project ended up inventing a User2 attribute once.
//--------------------------------------------------------------------------------------------------
int Emp_DamageScale (unit who, int type) {
    return 100;
}

//--------------------------------------------------------------------------------------------------
// A missed box, paid in whatever coin that abnormality charges.
//
// The type is the abnormality's, not the work's: the same badly chosen work
// breaks the employee at one door and kills them at another, and that difference
// is most of what distinguishes one abnormality from another at the moment a
// player decides who to send. White alone would have made every wrong answer
// cost the same thing.
//
// Pale is a percentage of maximum life rather than a flat amount, so it is
// exactly as dangerous to a veteran as to a new hire. Since Fortitude IS maximum
// life, a flat amount would already have scaled the wrong way -- growing an
// employee would make them immune -- and Pale is the mechanic that says no.
//
// Black charges the full amount to both, which is why it is worse than its
// numbers look.
//--------------------------------------------------------------------------------------------------
void Emp_WorkDamage (unit who, int type, int amount) {
    if (who == null || !UnitIsAlive(who) || amount <= 0) {
        return;
    }

    // Scaled once, before the split, so a suit that halves Black halves both
    // halves of it and a suit that halves Pale halves the percentage. Applying
    // it inside each branch would be four chances to get that wrong.
    amount = amount * Emp_DamageScale(who, type) / 100;
    if (amount <= 0) {
        return;
    }

    if (type == c_dmgWhite) {
        SP_Damage(who, amount);
    }
    else if (type == c_dmgRed) {
        Emp_LifeDamage(who, IntToFixed(amount));
    }
    else if (type == c_dmgBlack) {
        Emp_LifeDamage(who, IntToFixed(amount));
        SP_Damage(who, amount);
    }
    else if (type == c_dmgPale) {
        Emp_LifeDamage(who,
                       UnitGetPropertyFixed(who, c_unitPropLifeMax, true)
                       * IntToFixed(amount) / 100.0);
    }
}

//--------------------------------------------------------------------------------------------------
// One player's employees.
//
// A scan, not a roster. The units on the map are the roster, so there is no
// list that can drift out of step with who is actually alive -- which is the
// list that matters when the penalty for a mistake is that somebody is gone.
//--------------------------------------------------------------------------------------------------
unitgroup Emp_Of (int player) {
    unitgroup all;
    unitgroup mine;
    unit who;
    int count;
    int i;

    mine = UnitGroupEmpty();
    all = ObjectsGen_ScanEmp();
    count = UnitGroupCount(all, c_unitCountAlive);

    i = 1;
    while (i <= count) {
        who = UnitGroupUnit(all, i);
        if (who != null && UnitGetOwner(who) == player) {
            UnitGroupAdd(mine, who);
        }
        i = i + 1;
    }
    return mine;
}

int Emp_CountOf (int player) {
    return UnitGroupCount(Emp_Of(player), c_unitCountAlive);
}

//--------------------------------------------------------------------------------------------------
// How many of a player's employees are at least this rank.
//
// Training Team's first two tasks are counts of exactly this shape, and its
// challenge is "all of them at V", so the quest layer asks here rather than
// walking employees itself.
//--------------------------------------------------------------------------------------------------
int Emp_CountAtRank (int player, int rank) {
    unitgroup mine;
    unit who;
    int total;
    int count;
    int i;

    mine = Emp_Of(player);
    count = UnitGroupCount(mine, c_unitCountAlive);
    total = 0;

    i = 1;
    while (i <= count) {
        who = UnitGroupUnit(mine, i);
        if (who != null && Emp_Rank(who) >= rank) {
            total = total + 1;
        }
        i = i + 1;
    }
    return total;
}

//--------------------------------------------------------------------------------------------------
// Keeps every employee's rank readout matched to their stats.
//
// A tick rather than a hook on the work result, because a stat can also move
// from a department upgrade, from Training Team pushing it down, and from the
// Training Team core suppression lowering it as the meltdown level rises. One
// place that reconciles beats four places that each remember to.
//
// The stats themselves need nothing here: their points are their display.
//--------------------------------------------------------------------------------------------------
bool Emp_Tick_Func (bool testConds, bool runActions) {
    unitgroup all;
    int count;
    int i;

    if (!runActions) {
        return true;
    }

    all = ObjectsGen_ScanEmp();
    count = UnitGroupCount(all, c_unitCountAlive);

    i = 1;
    while (i <= count) {
        Emp_SyncRank(UnitGroupUnit(all, i));
        // Zero on purpose, so an employee whose Prudence just went up does not
        // become panicked by having a ceiling raised out from under a full bar.
        SP_Add(UnitGroupUnit(all, i), 0);
        i = i + 1;
    }
    return true;
}

void Emp_SeedAll () {
    unitgroup all;
    int count;
    int i;

    all = ObjectsGen_ScanEmp();
    count = UnitGroupCount(all, c_unitCountAlive);
    i = 1;
    while (i <= count) {
        Emp_Seed(UnitGroupUnit(all, i));
        i = i + 1;
    }
}

void Employee_Init () {
    gvg_statBehavior[c_statFortitude] = "Lob_Attr_Fortitude";
    gvg_statBehavior[c_statPrudence] = "Lob_Attr_Prudence";
    gvg_statBehavior[c_statTemperance] = "Lob_Attr_Temperance";
    gvg_statBehavior[c_statJustice] = "Lob_Attr_Justice";

    gvg_statName[c_statFortitude] = "Fortitude";
    gvg_statName[c_statPrudence] = "Prudence";
    gvg_statName[c_statTemperance] = "Temperance";
    gvg_statName[c_statJustice] = "Justice";

    // I II III IV V EX
    gvg_statLevelMin[0] = 0;
    gvg_statLevelMin[1] = 30;
    gvg_statLevelMin[2] = 45;
    gvg_statLevelMin[3] = 65;
    gvg_statLevelMin[4] = 85;
    gvg_statLevelMin[5] = 100;

    // I II III IV V, against the sum of the four stat levels. The floor is 4
    // (four stats at I), so rank I covers 4 and 5.
    gvg_rankMin[0] = 0;
    gvg_rankMin[1] = 6;
    gvg_rankMin[2] = 9;
    gvg_rankMin[3] = 12;
    gvg_rankMin[4] = 16;

    Emp_SeedAll();

    gt_empCreated = TriggerCreate("Emp_Created_Func");
    TriggerAddEventUnitCreated(gt_empCreated, null, null, null);

    gt_empTick = TriggerCreate("Emp_Tick_Func");
    TriggerAddEventTimePeriodic(gt_empTick, c_empPeriod, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/12_departments.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Departments.
//
// Upgrades are real CUpgrade entries authored in the data editor, one per
// level, named
//
//     <Sephirot>_Upg<line>_<level>[_Ally]
//
// so Malkuth_Upg2_1 and Malkuth_Upg2_1_Ally are the owner's and the allies'
// version of the same step. That is not a formatting choice; it decides how
// much code there is. Because each level is its own upgrade, most effects are
// EffectArray rows in data -- "Unit,Lob_Hero_Agent,Speed", "Weapon,X,Range" --
// and need no script at all. And because the ally version is a separate
// upgrade rather than a discount applied to the owner's, it can do something
// genuinely different instead of merely less.
//
// So this module names no upgrade and holds no per-upgrade code. It knows the
// shape of the name, which the build reads out of UpgradeData.xml, and it
// implements the rules that are true of every line:
//
//   Ally propagation. Completing a step that has an _Ally twin grants that twin
//   to everybody else. One rule, driven off the table, covering every upgrade
//   the doc describes as "对自身和所有盟友都有效".
//
//   Levels are cumulative by holding, not by counting. A line's level is the
//   highest numbered step the player actually holds, so a step granted out of
//   order still reads correctly.
//
// Suspension while the inner layer is lost (baseline 7.3) needs no marker on
// the upgrade, because it is decided by where the effect is put rather than by
// what the upgrade is labelled. SC2 upgrades do not unwind: the level counter
// can be decremented, but the EffectArray modifications are not taken back. So
// an effect that must be able to stop is a CBehaviorBuff driven through
// 07_buffs.galaxy, and the upgrade next to it is only the record that it was
// bought. An effect that never stops can be EffectArray and needs no script.
//
// That also makes the upgrade cheap to consult, which is the point of using
// them: a trigger asks Dept_Holds and gets an answer without bookkeeping, and
// the research goes through the stock alert and tech tree UI for free.
//--------------------------------------------------------------------------------------------------

const int c_deptNone = -1;
const int c_deptMalkuth = 0;
const int c_deptYesod = 1;
const int c_deptNetzach = 2;
const int c_deptHod = 3;
const int c_deptTiphereth = 4;
const int c_deptChesed = 5;
const int c_deptGeburah = 6;
const int c_deptHokma = 7;
const int c_deptBinah = 8;
const int c_deptCount = 9;

// The four upper departments are contiguous and start at Malkuth, which is what
// lets the placeholder deal round-robin without a table.
const int c_deptAsiyahCount = 4;

// Sephirot tiers, as the doc groups them.
const int c_tierAsiyah = 0;
const int c_tierBriah = 1;
const int c_tierAtziluth = 2;

// Keyed by the Sephirot name, because that is what the upgrade ids are keyed by.
string[9] gvg_deptKey;
string[9] gvg_deptName;
int[9] gvg_deptTier;

int[16] gvg_deptOf;

trigger gt_upgradeChanged;

int Dept_Of (int player) {
    if (player < 1 || player > 15) {
        return c_deptNone;
    }
    return gvg_deptOf[player];
}

void Dept_SetOf (int player, int dept) {
    if (player < 1 || player > 15) {
        return;
    }
    gvg_deptOf[player] = dept;
}

string Dept_NameOf (int player) {
    int dept;

    dept = Dept_Of(player);
    if (dept < 0 || dept >= c_deptCount) {
        return "none";
    }
    return gvg_deptName[dept];
}

//--------------------------------------------------------------------------------------------------
// How many distinct departments are in play.
//
// Baseline 7.1 allows duplicates but wants at least three distinct ones in a
// game. Nothing enforces it yet because there is no selection screen to enforce
// it at; this is the question that screen will ask.
//--------------------------------------------------------------------------------------------------
int Dept_DistinctCount () {
    int player;
    int earlier;
    int total;
    bool duplicate;

    total = 0;
    player = 1;
    while (player <= 15) {
        if (gvg_deptOf[player] >= 0) {
            duplicate = false;
            earlier = 1;
            while (earlier < player) {
                if (gvg_deptOf[earlier] == gvg_deptOf[player]) {
                    duplicate = true;
                }
                earlier = earlier + 1;
            }
            if (!duplicate) {
                total = total + 1;
            }
        }
        player = player + 1;
    }
    return total;
}

//--------------------------------------------------------------------------------------------------
// Whether a player holds a particular step.
//--------------------------------------------------------------------------------------------------
bool Dept_Holds (int player, string upgradeId) {
    return TechTreeUpgradeCount(player, upgradeId, c_techCountCompleteOnly) > 0;
}

//--------------------------------------------------------------------------------------------------
// The level a player has reached on a line, owner's version.
//
// The highest step held rather than a count of steps held, so a step granted
// out of order -- which Central Command's substitution rules will do -- still
// reads as the level it is.
//--------------------------------------------------------------------------------------------------
int Dept_LineLevel (int player, string line) {
    int best;
    int i;

    best = 0;
    i = 0;
    while (i < c_deptUpgradeCount) {
        if (gvg_deptUpgradeLine[i] == line
            && !gvg_deptUpgradeIsAlly[i]
            && gvg_deptUpgradeLevel[i] > best
            && Dept_Holds(player, gvg_deptUpgradeId[i])) {
            best = gvg_deptUpgradeLevel[i];
        }
        i = i + 1;
    }
    return best;
}

//--------------------------------------------------------------------------------------------------
// The level a player has on a line by way of somebody else's generosity.
//--------------------------------------------------------------------------------------------------
int Dept_LineLevelFromAlly (int player, string line) {
    int best;
    int i;

    best = 0;
    i = 0;
    while (i < c_deptUpgradeCount) {
        if (gvg_deptUpgradeLine[i] == line
            && gvg_deptUpgradeIsAlly[i]
            && gvg_deptUpgradeLevel[i] > best
            && Dept_Holds(player, gvg_deptUpgradeId[i])) {
            best = gvg_deptUpgradeLevel[i];
        }
        i = i + 1;
    }
    return best;
}

//--------------------------------------------------------------------------------------------------
// Grants a step, which is how anything other than a research button hands one
// out. Ally propagation happens off the resulting event, not here, so it works
// the same whoever did the granting.
//--------------------------------------------------------------------------------------------------
void Dept_Grant (int player, string upgradeId) {
    TechTreeUpgradeAddLevel(player, upgradeId, 1);
}

//--------------------------------------------------------------------------------------------------
// Ally propagation.
//
// When somebody finishes a step that has an _Ally twin, everybody else gets the
// twin. Reading the twin's name from the generated table rather than building
// it by string concatenation means an upgrade whose ally version was never
// authored simply propagates nothing, instead of granting an id that does not
// exist.
//
// Only positive deltas propagate. A level going down is either an undo or the
// suspension rule arriving later, and neither should hand allies anything.
//--------------------------------------------------------------------------------------------------
bool Dept_UpgradeChanged_Func (bool testConds, bool runActions) {
    string changed;
    string ally;
    int owner;
    int other;
    int i;

    if (!runActions) {
        return true;
    }
    if (EventUpgradeLevelDelta() <= 0) {
        return true;
    }

    changed = EventUpgradeName();
    owner = EventPlayer();

    ally = "";
    i = 0;
    while (i < c_deptUpgradeCount) {
        if (gvg_deptUpgradeId[i] == changed) {
            ally = gvg_deptUpgradeAlly[i];
        }
        i = i + 1;
    }
    if (ally == "") {
        return true;
    }

    other = 1;
    while (other <= 15) {
        if (other != owner && gvg_deptOf[other] != c_deptNone
            && !Dept_Holds(other, ally)) {
            TechTreeUpgradeAddLevel(other, ally, 1);
        }
        other = other + 1;
    }
    return true;
}

void Departments_Init () {
    int player;
    int dealt;

    gvg_deptKey[c_deptMalkuth] = "Malkuth";
    gvg_deptKey[c_deptYesod] = "Yesod";
    gvg_deptKey[c_deptNetzach] = "Netzach";
    gvg_deptKey[c_deptHod] = "Hod";
    gvg_deptKey[c_deptTiphereth] = "Tiphereth";
    gvg_deptKey[c_deptChesed] = "Chesed";
    gvg_deptKey[c_deptGeburah] = "Geburah";
    gvg_deptKey[c_deptHokma] = "Hokma";
    gvg_deptKey[c_deptBinah] = "Binah";

    gvg_deptName[c_deptMalkuth] = "Control";
    gvg_deptName[c_deptYesod] = "Information";
    gvg_deptName[c_deptNetzach] = "Safety";
    gvg_deptName[c_deptHod] = "Training";
    gvg_deptName[c_deptTiphereth] = "Central Command";
    gvg_deptName[c_deptChesed] = "Welfare";
    gvg_deptName[c_deptGeburah] = "Disciplinary";
    gvg_deptName[c_deptHokma] = "Record";
    gvg_deptName[c_deptBinah] = "Extraction";

    gvg_deptTier[c_deptMalkuth] = c_tierAsiyah;
    gvg_deptTier[c_deptYesod] = c_tierAsiyah;
    gvg_deptTier[c_deptNetzach] = c_tierAsiyah;
    gvg_deptTier[c_deptHod] = c_tierAsiyah;
    gvg_deptTier[c_deptTiphereth] = c_tierBriah;
    gvg_deptTier[c_deptChesed] = c_tierBriah;
    gvg_deptTier[c_deptGeburah] = c_tierBriah;
    gvg_deptTier[c_deptHokma] = c_tierAtziluth;
    gvg_deptTier[c_deptBinah] = c_tierAtziluth;

    player = 1;
    while (player <= 15) {
        gvg_deptOf[player] = c_deptNone;
        player = player + 1;
    }

    // PLACEHOLDER until there is a selection screen. Baseline 7.1 has each
    // player choosing, with repeats allowed but at least three distinct
    // departments in a game; dealing the four Asiyah ones round-robin satisfies
    // that for any table of three or more and needs nothing from the lobby.
    //
    // It used to hand Malkuth to player 1 and nothing to anybody else, which
    // made Dept_Of a working test for "is this player 1" and a broken one for
    // everything it is actually asked. Ally upgrade propagation walks the table
    // by department, and the victory loop used to as well.
    dealt = 0;
    player = 1;
    while (player <= 15) {
        if (Slot_IsTablePlayer(player)) {
            Dept_SetOf(player, c_deptMalkuth + dealt % c_deptAsiyahCount);
            dealt = dealt + 1;
        }
        player = player + 1;
    }

    gt_upgradeChanged = TriggerCreate("Dept_UpgradeChanged_Func");
    player = 1;
    while (player <= 15) {
        TriggerAddEventUpgradeLevelChanged(gt_upgradeChanged, player);
        player = player + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/12_energy.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// The energy pool, and how the game ends.
//
// Lived in 14_work until the meltdown clock needed to take energy away, and
// 13_meltdown sorts before 14_work because Work_Finish has to call into it.
// Moving the pool out was the right fix rather than the convenient one: work is
// one thing that fills the pool and meltdown is one thing that empties it, and
// neither of them owns it.
//
// Every box a work produces pays twice, into two places that never mix: the
// player's own stock for that one abnormality's encyclopedia (13_containment),
// and the same amount again into this. So studying abnormalities and winning the
// game are the same activity, and neither is bought at the other's expense.
//
// This is not a shared wallet and does not violate the baseline's first
// principle. Nothing is ever SPENT out of it, and no player's rate of filling it
// depends on another player's. It is a scoreboard the table fills together, and
// a shared win condition is explicitly allowed -- what the principle forbids is
// a teammate's mistake reaching your income or your character.
//
// Meltdown taking from it is the one subtraction, and it is a subtraction from
// the scoreboard rather than from anybody's income: nobody's rate changes, the
// table is simply further from the door than it was.
//
// Submitting is a decision rather than an automatic end, because the threshold
// being reached does not mean this is the moment -- there may be an abnormality
// loose, or one more work worth finishing.
//--------------------------------------------------------------------------------------------------

int gv_energy;
int gv_energyGoal;
bool gv_energySubmitted;

void Energy_Add (int amount) {
    gv_energy = gv_energy + amount;
    if (gv_energy < 0) {
        gv_energy = 0;
    }
}

//--------------------------------------------------------------------------------------------------
// Takes a percentage rather than an amount, so a penalty means the same thing
// early and late. A flat number would be a game-ending disaster at minute two
// and a rounding error at minute forty.
//--------------------------------------------------------------------------------------------------
int Energy_Drain (int percent) {
    int lost;

    if (percent <= 0 || gv_energy <= 0) {
        return 0;
    }
    lost = gv_energy * percent / 100;
    if (lost < 1) {
        lost = 1;
    }
    if (lost > gv_energy) {
        lost = gv_energy;
    }
    gv_energy = gv_energy - lost;
    return lost;
}

bool Energy_CanSubmit () {
    return gv_energy >= gv_energyGoal && !gv_energySubmitted;
}

void Energy_Submit (int player) {
    int other;

    if (!Energy_CanSubmit()) {
        return;
    }
    gv_energySubmitted = true;

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle,
                     StringToText("energy delivered -- the ship makes it out"));

    other = 1;
    while (other <= 15) {
        if (Slot_IsTablePlayer(other)) {
            GameOver(other, c_gameOverVictory, true, true);
        }
        other = other + 1;
    }
}

// TUNING, and the one number here that is invented. What a Normal table has to
// bring in; every other difficulty is a percentage of it.
const int c_energyGoalBase = 200;

//--------------------------------------------------------------------------------------------------
// Recomputes the target from the table's mean difficulty.
//
// Scaled by the MEAN, not by any one player's. This is what makes a personal
// difficulty setting honest against a shared objective: without it a table that
// all picked Casual would face weakened opposition on the way to an unchanged
// target, which is a discount rather than a smaller game.
//
// A function rather than a line in Init because difficulty can move. In a real
// game it does not -- it comes off the lobby and is read once -- but the debug
// console sets it directly, and a target that ignored that would make the
// command a no-op for the half of its job that matters. So the formula lives
// here, once, and whoever changes difficulty calls this.
//--------------------------------------------------------------------------------------------------
void Energy_Retarget () {
    gv_energyGoal = Diff_GoalFrom(c_energyGoalBase);
}

void Energy_Init () {
    gv_energy = 0;
    gv_energySubmitted = false;
    Energy_Retarget();
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/13_containment.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Containment.
//
// The other half of the verb. 11_employee.galaxy owns the person you send; this
// owns the thing you send them to. Structure is from docs/usr/containment.md.
//
// The abnormality is a unit that exists from the start and never stops
// existing. Contained is a state it is in, not a state of the world:
//
//     Lob_Abno_<X>     the abnormality. Carries its risk grade, its Qliphoth
//                      counter, and while contained, Lob_Contained.
//     Lob_Door_Basic   the cell's only entrance, and the thing with durability
//     Lob_DoorDown_*   the door, dropped
//
// The door is generic and the abnormality is not, which is the whole reason
// this is affordable: thirty abnormalities is thirty units, not a hundred and
// twenty. A door belongs to the abnormality whose cell it stands at, which is a
// spatial fact and is answered spatially -- nearest door to that abnormality's
// home. Nothing is named after anything.
//
// The first version of this module had it backwards: it made the CELL the
// downable thing and spawned the abnormality on breach. Both halves were wrong.
// Durability belongs to the door, and an abnormality that is created at the
// moment it escapes cannot be worked on, cannot be observed, and cannot have a
// counter -- which is most of what an abnormality is for.
//
// Four states, and only the first is quiet:
//
//     Contained   invulnerable and inert, behind a raised door
//     Escaping    it has decided to leave and is attacking its own door.
//                 Repair cannot prevent this, only delay it, which is what
//                 Lob_DoorStrain is for.
//     Loose       door down, invulnerability gone, it is a combat problem
//     Returning   suppressed, on its way back to the cell
//
// Returning rather than dying is not a nicety. Design 5 forbids a breach ever
// costing a player their slot, and docs/usr/containment.md spells out the
// return: teleported home after a delay, restored to its initial state, counter
// back to default, door instantly full and raised. So a suppressed abnormality
// is never killed; the fatal blow is intercepted the way a device's is.
//
// What this module does NOT decide, because it is not decided:
//
//   Which abnormalities escape at counter zero and what the rest do instead.
//   The doc says most do something bad and escaping is the worst of them, and
//   that some carry no counter at all. That is per-abnormality authoring.
//
//   The Qliphoth default per abnormality. It is a per-type NUMBER, and this
//   project has no channel for one yet -- the same gap as residual management
//   difficulty in docs/dev/authoring-contract.md. Everything runs off
//   c_qliphothDefault until that is settled, which is a placeholder and is
//   marked as one.
//
//   What suppression pays out, what work does, and the meltdown clock.
//--------------------------------------------------------------------------------------------------

// The door types, named outright because the gate is a copy of a Blizzard
// destructible gate and does not carry the Lob_ prefix the generated tables key
// on. Renaming it Lob_Door_Horizontal in the editor would make this table go
// away; until then, adding a door means adding a line here.
//
// A destructible gate is not the Lob_Device_/Lob_DeviceDown_ pair this module
// first assumed. It has its own lowered state and its own revive, which is
// closer to "大门降下 / 升起" than a type swap ever was -- so alive is raised,
// dead is dropped, and no morph is involved.
const int c_doorTypeCount = 1;
string[1] gvg_doorType;

// The control panel, and the four encyclopedia buttons on it. Named outright
// for the same reason the door is: the panel was copied from a Blizzard
// destructible and carries no Lob_ prefix.
const string c_panelType = "ContainGateControl";
const int c_obsAbilCount = 4;
string[4] gvg_obsAbil;

const string c_containedBuff = "Lob_Contained";
const string c_qliphothBuff = "Lob_Qliphoth";
const string c_doorStrainBuff = "Lob_DoorStrain";

const int c_cellContained = 0;
const int c_cellEscaping = 1;
const int c_cellLoose = 2;
const int c_cellReturning = 3;

const int c_cellMax = 32;

// How far from an abnormality's home its door may stand.
const fixed c_cellRadius = 12.0;


// Seconds between suppression and the return home.
const fixed c_returnDelay = 8.0;

// Seconds of pressure on a door per stack of strain. One stack is a small
// amount of life regeneration removed, so the door bleeds faster the longer the
// abnormality has been working on it -- which is what makes repair a delay
// rather than an answer, per docs/usr/containment.md. Grade multiplies the
// rate, so an Aleph chews through a door it cannot be held against.
const fixed c_strainPeriod = 2.0;

const fixed c_contPeriod = 1.0;

int gv_cellCount;
unit[32] gvg_cellAbno;
point[32] gvg_cellHome;
int[32] gvg_cellState;
fixed[32] gvg_cellReturnAt;
fixed[32] gvg_cellStrainAt;

trigger gt_cellFatal;
trigger gt_cellTick;
trigger gt_cellObserve;

//--------------------------------------------------------------------------------------------------
// Registry.
//
// Built once from the abnormalities standing on the map, because an abnormality
// has a home and the home is where it was placed. A cell chosen at runtime will
// need a spawn point of its own; that belongs with the selection screen, which
// does not exist, so nothing here pretends to know where an empty cell is.
//--------------------------------------------------------------------------------------------------
int Cont_SlotOf (unit abno) {
    int i;

    if (abno == null) {
        return -1;
    }
    i = 0;
    while (i < gv_cellCount) {
        if (gvg_cellAbno[i] == abno) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

int Cont_State (unit abno) {
    int slot;

    slot = Cont_SlotOf(abno);
    if (slot < 0) {
        return c_cellContained;
    }
    return gvg_cellState[slot];
}

bool Cont_IsLoose (unit abno) {
    int state;

    state = Cont_State(abno);
    return state == c_cellLoose || state == c_cellEscaping;
}

//--------------------------------------------------------------------------------------------------
// The door of a cell: nearest door to that abnormality's home, raised or
// dropped. Null while no door has been placed, which leaves an abnormality
// contained by nothing but its own behavior -- inert, but visibly wrong.
//--------------------------------------------------------------------------------------------------
bool Cont_IsDoor (unit which) {
    int i;

    if (which == null) {
        return false;
    }
    i = 0;
    while (i < c_doorTypeCount) {
        if (UnitGetType(which) == gvg_doorType[i]) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

unitgroup Cont_AllDoors () {
    unitgroup found;
    int i;

    found = UnitGroupEmpty();
    i = 0;
    while (i < c_doorTypeCount) {
        UnitGroupAddUnitGroup(found, UnitGroup(gvg_doorType[i], c_playerAny,
                                               RegionEntireMap(), null, 0));
        i = i + 1;
    }
    return found;
}

unit Cont_DoorAt (point home) {
    unit door;

    door = UnitGroupClosestToPoint(Cont_AllDoors(), home);
    if (door == null) {
        return null;
    }
    if (DistanceBetweenPoints(UnitGetPosition(door), home) > c_cellRadius) {
        return null;
    }
    return door;
}

unit Cont_DoorOf (unit abno) {
    int slot;

    slot = Cont_SlotOf(abno);
    if (slot < 0) {
        return null;
    }
    return Cont_DoorAt(gvg_cellHome[slot]);
}

bool Cont_DoorIsUp (unit abno) {
    unit door;

    door = Cont_DoorOf(abno);
    return door != null && UnitIsAlive(door);
}

//--------------------------------------------------------------------------------------------------
// The control panel of a cell: nearest one to that abnormality's home.
//--------------------------------------------------------------------------------------------------
unit Cont_PanelAt (point home) {
    unit panel;

    panel = UnitGroupClosestToPoint(
        UnitGroup(c_panelType, c_playerAny, RegionEntireMap(), null, 0), home);
    if (panel == null) {
        return null;
    }
    if (DistanceBetweenPoints(UnitGetPosition(panel), home) > c_cellRadius) {
        return null;
    }
    return panel;
}

//--------------------------------------------------------------------------------------------------
// The encyclopedia: what a player has extracted from an abnormality, and what
// they have spent it on.
//
// Both halves are per player AND per abnormality, and they must never pool.
// Design 8.1 has PE-Boxes buying that one abnormality's observation and nothing
// else, which is why there is no total anywhere here: an index that would let
// one abnormality's boxes reach another simply does not exist.
//
// Observation level is a count of purchased sections, not four separate
// achievements -- the source reads "(1 Section Unlocked)" through "(All Details
// Unlocked)". Each section has its own price in that abnormality's own doc.
//
// Nothing is persisted yet. Design 8.4 has this in a bank read at init, and it
// is the single most important thing in the bank; until then a game starts
// knowing nothing, which is also what a first game looks like.
//--------------------------------------------------------------------------------------------------
const int c_obsMax = 4;

// Flattened player * c_abnoCount + abnormality. Sized for 16 players against 64
// abnormalities; c_abnoCount is generated, so passing 64 documents means these
// have to grow with it.
int[1024] gvg_obsBoxes;
int[1024] gvg_obsLevel;

int Cont_BoxIndex (int player, int abnoIndex) {
    if (player < 1 || player > 15 || abnoIndex < 0 || abnoIndex >= c_abnoCount) {
        return -1;
    }
    return player * c_abnoCount + abnoIndex;
}

int Cont_BoxesOf (int player, int abnoIndex) {
    int i;

    i = Cont_BoxIndex(player, abnoIndex);
    if (i < 0) {
        return 0;
    }
    return gvg_obsBoxes[i];
}

void Cont_AddBoxes (int player, int abnoIndex, int amount) {
    int i;

    i = Cont_BoxIndex(player, abnoIndex);
    if (i < 0) {
        return;
    }
    gvg_obsBoxes[i] = gvg_obsBoxes[i] + amount;
}

//--------------------------------------------------------------------------------------------------
// How far a player has observed an abnormality, 0 (unseen) to 4 (fully known).
//
// Takes a unit rather than a player because every caller has one: the employee
// working, the character standing at a panel. Whose knowledge applies is the
// owner's, and asking it that way keeps the cross-department rule expressible --
// Control Team lv2 turns on exactly the question "whose observation counts".
//--------------------------------------------------------------------------------------------------
int Cont_ObservationOfPlayer (int player, int abnoIndex) {
    int i;

    i = Cont_BoxIndex(player, abnoIndex);
    if (i < 0) {
        return 0;
    }
    return gvg_obsLevel[i];
}

int Cont_ObservationOf (unit who, int abnoIndex) {
    if (who == null) {
        return 0;
    }
    return Cont_ObservationOfPlayer(UnitGetOwner(who), abnoIndex);
}

//--------------------------------------------------------------------------------------------------
// Buys the next section. Returns false if it is already fully known or the
// boxes are not there.
//--------------------------------------------------------------------------------------------------
bool Cont_Observe (int player, int abnoIndex) {
    int i;
    int level;
    int cost;

    i = Cont_BoxIndex(player, abnoIndex);
    if (i < 0) {
        return false;
    }

    level = gvg_obsLevel[i];
    if (level >= c_obsMax) {
        return false;
    }

    cost = AbnoGen_ObsCost(abnoIndex, level);
    if (gvg_obsBoxes[i] < cost) {
        return false;
    }

    gvg_obsBoxes[i] = gvg_obsBoxes[i] - cost;
    gvg_obsLevel[i] = level + 1;
    return true;
}

//--------------------------------------------------------------------------------------------------
// Brings one panel's four buttons into line with what its owner knows.
//
// A section not yet bought is an ability you can press. A bought one is
// disabled, which is what "becomes passive" is in engine terms -- it keeps its
// place and its text and stops being a thing you do. Either way the tooltip is
// pushed per unit INSTANCE with UnitSetInfoButtonTooltip, which is why four
// generic abilities can serve every abnormality and why the lore never has to
// leave the document it is written in.
//
// Pushed to everyone rather than to the owner alone: a panel is a thing in a
// room, and what it says about an abnormality is the same fact whoever reads
// it. Whose PE-Boxes buy the next section is a separate question and is asked
// when the button is pressed.
//--------------------------------------------------------------------------------------------------
void Cont_SyncPanel (int slot) {
    unit panel;
    int index;
    int level;
    int sec;
    int cost;

    panel = Cont_PanelAt(gvg_cellHome[slot]);
    if (panel == null) {
        return;
    }

    index = AbnoGen_IndexOf(gvg_cellAbno[slot]);
    level = Cont_ObservationOfPlayer(UnitGetOwner(panel), index);

    sec = 0;
    while (sec < c_obsAbilCount) {
        if (sec < level) {
            UnitAbilityEnable(panel, gvg_obsAbil[sec], false);
            UnitSetInfoButtonTooltip(panel, gvg_obsAbil[sec],
                                     StringToText(AbnoGen_Lore(index, sec)));
        }
        else {
            UnitAbilityEnable(panel, gvg_obsAbil[sec], sec == level);
            cost = AbnoGen_ObsCost(index, sec);
            UnitSetInfoButtonTooltip(
                panel, gvg_obsAbil[sec],
                StringToText("Unobserved. " + IntToString(cost) + " PE-Boxes."
                             + "<n/>You have " + IntToString(
                                 Cont_BoxesOf(UnitGetOwner(panel), index)) + "."));
        }
        sec = sec + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// A press on one of the four buttons.
//
// Which section it is comes from which ability fired, and which abnormality
// from which panel it fired on -- so the same four abilities work everywhere
// and nothing is keyed by name.
//--------------------------------------------------------------------------------------------------
bool Cont_Observe_Func (bool testConds, bool runActions) {
    unit panel;
    int slot;

    if (!runActions) {
        return true;
    }

    panel = EventUnit();
    slot = 0;
    while (slot < gv_cellCount) {
        if (Cont_PanelAt(gvg_cellHome[slot]) == panel) {
            Cont_Observe(UnitGetOwner(panel), AbnoGen_IndexOf(gvg_cellAbno[slot]));
            Cont_SyncPanel(slot);
            return true;
        }
        slot = slot + 1;
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// The Qliphoth counter, as the stack count of a behavior.
//
// Same trick as employee stats, and for the same reason: a stack count is a
// number the engine already stores, already caps, and already draws on the
// unit with the count on the icon. Nothing here keeps a parallel copy.
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// The counter this abnormality starts and returns to, from its own doc.
//
// Zero for one that has none at all: "Qliphoth counter X" is not a counter of
// zero, it is the absence of a counter, and an absent counter can never run
// out. Nothing else has to know the difference, because a counter that is never
// decremented never reaches zero anyway.
//--------------------------------------------------------------------------------------------------
int Cont_CounterDefault (unit abno) {
    int index;

    index = AbnoGen_IndexOf(abno);
    if (index < 0 || gvg_abnoCounter[index] < 0) {
        return 0;
    }
    return gvg_abnoCounter[index];
}

int Cont_Counter (unit abno) {
    if (abno == null) {
        return 0;
    }
    return UnitBehaviorCount(abno, c_qliphothBuff);
}

void Cont_SetCounter (unit abno, int value) {
    int have;

    if (abno == null || !UnitIsAlive(abno)) {
        return;
    }
    if (value < 0) {
        value = 0;
    }

    have = Cont_Counter(abno);
    if (value > have) {
        UnitBehaviorAdd(abno, c_qliphothBuff, abno, value - have);
    }
    else if (value < have) {
        UnitBehaviorRemove(abno, c_qliphothBuff, have - value);
    }
}

//--------------------------------------------------------------------------------------------------
// Contained is a behavior, so the state and its consequences are the same
// object. Invulnerable, uncommandable, passive and unable to attack all come
// from one Modification in data, which is what "在收容单元中的异想体是无敌的，
// 且不会做任何事情" asks for, without a line of script per consequence.
//--------------------------------------------------------------------------------------------------
void Cont_SetContained (unit abno, bool contained) {
    Buffs_Set(abno, c_containedBuff, contained);
}

//--------------------------------------------------------------------------------------------------
// Formally out: the door is down and the invulnerability goes with it.
//
// Nothing is ordered. Some abnormalities walk to the rest hall, some never move
// at all, and a blanket attack-move would be inventing content that belongs to
// each of them.
//--------------------------------------------------------------------------------------------------
void Cont_GoLoose (unit abno) {
    int slot;

    slot = Cont_SlotOf(abno);
    if (slot < 0 || gvg_cellState[slot] == c_cellLoose) {
        return;
    }

    gvg_cellState[slot] = c_cellLoose;
    Cont_SetContained(abno, false);
    Cont_SetCounter(abno, 0);

    UIDisplayMessage(
        PlayerGroupAll(), c_messageAreaSubtitle,
        StringToText(Risk_Name(Risk_Of(abno)) + " containment breach"));
}

//--------------------------------------------------------------------------------------------------
// It has decided to leave.
//
// If the door is still standing it attacks the door -- its own door, from the
// inside -- and the door starts accumulating strain. If the door is already
// down it is simply out. Both paths end at Loose; the difference is how long
// the rest of the table has.
//
// An abnormality that does not escape never reaches here. For those, a dropped
// door means only that they cannot be worked on, which needs no code because
// the work order will ask Cont_DoorIsUp.
//--------------------------------------------------------------------------------------------------
void Cont_BeginEscape (unit abno) {
    int slot;
    unit door;

    slot = Cont_SlotOf(abno);
    if (slot < 0 || gvg_cellState[slot] != c_cellContained) {
        return;
    }

    door = Cont_DoorAt(gvg_cellHome[slot]);
    if (door != null && UnitIsAlive(door)) {
        gvg_cellState[slot] = c_cellEscaping;
        gvg_cellStrainAt[slot] = GameGetMissionTime() + c_strainPeriod;

        // Uncontained enough to act, but it is still inside a standing door and
        // nothing can reach it, so the invulnerability stays until the door is
        // actually down. That matches the doc: the unit is formally escaped
        // only once the door drops.
        UnitIssueOrder(abno, OrderTargetingUnit(AbilityCommand("attack", 0), door),
                       c_orderQueueReplace);
        UIDisplayMessage(
            PlayerGroupAll(), c_messageAreaSubtitle,
            StringToText(Risk_Name(Risk_Of(abno)) + " is working on its door"));
        return;
    }

    Cont_GoLoose(abno);
}

//--------------------------------------------------------------------------------------------------
// Drops a door, and zeroes the counter of whatever it was holding.
//
// "被从外部破坏时，大门将会降下，并将其 Qliphoth Counter 设为 0" -- the same
// thing happens whether the zerg did it or the occupant did, so both paths come
// through here. What happens next is the abnormality's business, not the door's.
//--------------------------------------------------------------------------------------------------
void Cont_DropDoor (unit door) {
    point where;
    int slot;

    if (door == null || !UnitIsAlive(door)) {
        return;
    }
    where = UnitGetPosition(door);
    UnitKill(door);

    slot = 0;
    while (slot < gv_cellCount) {
        if (DistanceBetweenPoints(gvg_cellHome[slot], where) <= c_cellRadius) {
            Cont_SetCounter(gvg_cellAbno[slot], 0);
            if (gvg_cellState[slot] == c_cellEscaping) {
                Cont_GoLoose(gvg_cellAbno[slot]);
            }
        }
        slot = slot + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// Suppression: defeated, not killed.
//
// The fatal blow is intercepted the way a device's is, and what follows is the
// doc's return -- home after a delay, initial state, counter back to default,
// door instantly whole and raised. An abnormality is never removed from the
// game, so a breach can cost employees, time and the table's attention, but
// never a slot.
//--------------------------------------------------------------------------------------------------
void Cont_Suppress (unit abno) {
    int slot;

    slot = Cont_SlotOf(abno);
    if (slot < 0 || gvg_cellState[slot] == c_cellReturning) {
        return;
    }

    gvg_cellState[slot] = c_cellReturning;
    gvg_cellReturnAt[slot] = GameGetMissionTime() + c_returnDelay;

    // Contained again immediately, so nothing keeps hitting it during the walk
    // back and it stops acting the moment it is beaten.
    UnitSetPropertyFixed(abno, c_unitPropLife,
                         UnitGetPropertyFixed(abno, c_unitPropLifeMax, true));
    Cont_SetContained(abno, true);

    UIDisplayMessage(
        PlayerGroupAll(), c_messageAreaSubtitle,
        StringToText(Risk_Name(Risk_Of(abno)) + " suppressed"));
}

void Cont_Return (int slot) {
    unit abno;
    unit door;

    abno = gvg_cellAbno[slot];
    gvg_cellState[slot] = c_cellContained;

    UnitSetPosition(abno, gvg_cellHome[slot], false);
    Cont_SetContained(abno, true);
    Cont_SetCounter(abno, Cont_CounterDefault(abno));

    // The door comes back whole and raised, which is not the same as being
    // repaired: the doc restores it outright on suppression.
    // Whole and raised, which is not the same as repaired: the doc restores it
    // outright on suppression. A dropped gate is a dead unit, so this is a
    // revive rather than a heal; UnitRevive puts the same unit back rather than
    // making a second one, which matters because the cell is found by proximity
    // and two doors at one home would be ambiguous.
    door = Cont_DoorAt(gvg_cellHome[slot]);
    if (door != null && !UnitIsAlive(door)) {
        UnitRevive(door);
    }
    if (door != null) {
        UnitSetPropertyFixed(door, c_unitPropLife,
                             UnitGetPropertyFixed(door, c_unitPropLifeMax, true));
        UnitBehaviorRemove(door, c_doorStrainBuff,
                           UnitBehaviorCount(door, c_doorStrainBuff));
    }
}

//--------------------------------------------------------------------------------------------------
// A fatal blow on a door drops it; a fatal blow on a loose abnormality
// suppresses it. Same interception, two meanings.
//--------------------------------------------------------------------------------------------------
bool Cont_Fatal_Func (bool testConds, bool runActions) {
    unit victim;

    if (!runActions) {
        return true;
    }

    victim = EventUnit();
    if (Cont_IsDoor(victim)) {
        Cont_DropDoor(victim);
        return true;
    }
    if (AbnoGen_Is(victim) && Cont_IsLoose(victim)) {
        Cont_Suppress(victim);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// Strain, and the return timer.
//
// Strain is a stack per period on the door of a cell whose occupant is trying
// to get out, scaled by grade. The doc requires that repair be a delay rather
// than an answer, and stacking regeneration loss is what makes that true
// without an SCV's repair rate having to be balanced against every grade
// separately: eventually the strain outruns any fixed repair rate, and the
// higher the grade the sooner.
//--------------------------------------------------------------------------------------------------
bool Cont_Tick_Func (bool testConds, bool runActions) {
    unit door;
    fixed now;
    int slot;
    int grade;

    if (!runActions) {
        return true;
    }

    now = GameGetMissionTime();

    slot = 0;
    while (slot < gv_cellCount) {
        if (gvg_cellState[slot] == c_cellEscaping && now >= gvg_cellStrainAt[slot]) {
            door = Cont_DoorAt(gvg_cellHome[slot]);
            if (door == null || !UnitIsAlive(door)) {
                Cont_GoLoose(gvg_cellAbno[slot]);
            }
            else {
                grade = Risk_Of(gvg_cellAbno[slot]);
                if (grade < 0) {
                    grade = 0;
                }
                UnitBehaviorAdd(door, c_doorStrainBuff, gvg_cellAbno[slot], grade + 1);
                gvg_cellStrainAt[slot] = now + c_strainPeriod;
            }
        }
        else if (gvg_cellState[slot] == c_cellReturning && now >= gvg_cellReturnAt[slot]) {
            Cont_Return(slot);
        }
        Cont_SyncPanel(slot);
        slot = slot + 1;
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// Everything on the map that is an abnormality, contained where it stands.
//--------------------------------------------------------------------------------------------------
void Cont_BuildRegistry () {
    unitgroup all;
    unit abno;
    int count;
    int i;

    gv_cellCount = 0;

    all = AbnoGen_Scan();
    count = UnitGroupCount(all, c_unitCountAlive);

    i = 1;
    while (i <= count && gv_cellCount < c_cellMax) {
        abno = UnitGroupUnit(all, i);
        if (abno != null) {
            gvg_cellAbno[gv_cellCount] = abno;
            gvg_cellHome[gv_cellCount] = UnitGetPosition(abno);
            gvg_cellState[gv_cellCount] = c_cellContained;
            Cont_SetContained(abno, true);
            Cont_SetCounter(abno, Cont_CounterDefault(abno));
            gv_cellCount = gv_cellCount + 1;
        }
        i = i + 1;
    }
}

void Containment_Init () {
    int i;

    gvg_doorType[0] = "ContainGateHorizontal";

    gvg_obsAbil[0] = "Lob_Obs_1";
    gvg_obsAbil[1] = "Lob_Obs_2";
    gvg_obsAbil[2] = "Lob_Obs_3";
    gvg_obsAbil[3] = "Lob_Obs_4";

    Cont_BuildRegistry();

    gt_cellObserve = TriggerCreate("Cont_Observe_Func");
    i = 0;
    while (i < c_obsAbilCount) {
        TriggerAddEventUnitAbility(gt_cellObserve, null,
                                   AbilityCommand(gvg_obsAbil[i], 0),
                                   c_unitAbilStageExecute, true);
        i = i + 1;
    }

    gt_cellFatal = TriggerCreate("Cont_Fatal_Func");
    TriggerAddEventUnitDamaged(gt_cellFatal, null, c_unitDamageTypeAny, c_unitDamageFatal, null);

    gt_cellTick = TriggerCreate("Cont_Tick_Func");
    TriggerAddEventTimePeriodic(gt_cellTick, c_contPeriod, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/13_meltdown.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Meltdown.
//
// The metronome. 13_containment owns the cell and 14_work owns the verb, and
// neither of them has any reason to happen at a particular moment -- a table
// that simply never presses Work is never in any danger. This is what makes
// standing still cost something.
//
// Numbered 13 rather than 15 because 14_work has to call into it, and Galaxy
// needs a declaration before its use. It sorts after 13_containment on the
// module name alone ("containment" < "meltdown"), which is load-bearing;
// check_forward_refs in tools/build_galaxy.py is what catches it if that ever
// stops being true.
//
//--------------------------------------------------------------------------------------------------
// The whole rule:
//
//     a cell is named  ->  60 seconds  ->  if no work has BEGUN on it, its
//                                          Qliphoth counter is set to 0 and the
//                                          table loses a share of the pool
//
// Begun, not finished. The countdown answers to somebody being sent, not to the
// work going well: a work started at second 55 would otherwise be a wasted trip,
// and the decision a meltdown is asking about is "who do I send and to which
// one", which is over the moment the employee walks. A work that then fails has
// already cost that employee their SP; charging the meltdown for it as well
// would be the same mistake twice.
//
// Set to zero, not decremented. A meltdown spends the counter outright, which is
// why ignoring one is a decision and not a slow leak. What an abnormality DOES
// at zero stays where it already was: per abnormality, in its own document, and
// not decided here. For one that can escape, zero is the escape.
//
//--------------------------------------------------------------------------------------------------
// A cell that was already busy when it got named does not start counting.
//
// Its countdown is held until that work ends -- finished, or interrupted by the
// gate coming down, or by the employee dying or breaking. Only then do the 60
// seconds begin.
//
// This is not a courtesy, it is the same rule read carefully. The countdown is
// answered by a work BEGINNING, and a work already in flight cannot begin
// again: the employee is inside and there is nothing the player can press. Left
// alone, a cell named one second into a fourteen-second work would spend most of
// its window in a state where the correct play is impossible. Holding it means
// the window is always a window -- sixty seconds in which sending somebody is
// actually a thing you can do.
//
// Note what it does NOT do: the work in flight does not itself answer the
// meltdown. It started before anybody was named, so it was never a response to
// one. When it ends the clock starts, and somebody still has to go.
//
//--------------------------------------------------------------------------------------------------
// The level is global, the named cells are per player.
//
// This split is the baseline's first principle in one place. The level is a
// shared clock, so everybody is in the same act of the same evening -- and a
// shared TEMPO is not a shared punishment. But a round names cells inside each
// player's OWN sector, and a missed one zeroes that cell's own counter.
//
// So a neighbour who ignores their meltdown breaches their own abnormality, and
// what reaches you is a fight -- the one negative transfer the baseline allows.
// Nothing about your income, your stats or your success rates moves because of
// what they did.
//
// The energy drain is the one shared cost, and it is deliberate. Energy is a
// scoreboard nobody spends from, so draining it moves the table further from the
// door without touching any player's rate of getting there. That is the
// difference between a shared win condition, which the baseline allows, and a
// shared wallet, which it forbids.
//
//--------------------------------------------------------------------------------------------------
// What this does NOT decide:
//
//   What happens at counter zero. Same hole as in 13_containment, and it is
//   per-abnormality authoring rather than a rule. This module's job ends at
//   setting the number.
//
//   What a miss costs an abnormality that has no counter at all. "Qliphoth
//   counter X" is the absence of a counter, not a counter at zero, so there is
//   nothing to spend. Those cells are still named and still cost energy; only
//   the counter half is skipped, and it says so.
//
//   Which abnormalities are tools and therefore never named -- Training Team's
//   rabbit is "不计入融毁计数". That is a per-type flag with no channel yet, the
//   same gap as residual management difficulty. Melt_CanBeNamed is where it
//   lands when there is one.
//
//   Anything the level does besides name more cells. Training Team's core
//   suppression lowers stats with it and Welfare Team's ammunition refills on
//   it; both belong to systems that do not exist. Melt_Level is the read.
//--------------------------------------------------------------------------------------------------

// How long a named cell has, once its countdown is actually running.
const fixed c_meltWindow = 60.0;

// How often a new round names cells. The same number, so that under no holds at
// all a round runs straight into the next.
const fixed c_meltPeriod = 60.0;

// TUNING, all three. Nobody has designed a meltdown curve; these are stand-ins
// picked to make the mechanic visible in a test, not balance.
//
// A player is named one more cell every this many levels.
const int c_meltLevelsPerTarget = 3;

// And never more than this many outstanding at once, however long the game runs.
// Counted against cells still pending, not against cells named this round, so a
// held cell occupies a slot rather than adding to the pile.
const int c_meltTargetsMax = 4;

// Share of the energy pool lost per unattended cell, as a percent. A percent
// rather than an amount so that the same miss means the same thing at minute two
// and at minute forty.
const int c_meltEnergyPenaltyPct = 10;

// Level 0 is before the first round: nothing is named.
int gv_meltLevel;

// When the next round names cells.
fixed gv_meltNextAt;

// Per cell, indexed exactly as 13_containment indexes its cells. Sized to
// c_cellMax, which Galaxy will not let be written as anything but a literal.
bool[32] gvg_meltFlag;

// Held: named while a work was already running, and not counting down until
// that work ends.
bool[32] gvg_meltHeld;

// When this cell resolves. Meaningless while held.
fixed[32] gvg_meltDeadline;

// How many works are running on this cell. A count rather than a flag because
// nothing stops two employees being sent to the same door.
int[32] gvg_meltBusy;

// Named cells this player answered, and named cells this player let expire.
//
// Cells, not rounds. Control Team's quest 3 is "妥善处理3轮融毁" and reads
// rounds, but a held cell can outlive several rounds, so "which round did this
// belong to" is a question with a real answer and no cheap one. It is left to
// the quest system, which does not exist; counting cells is the honest thing to
// expose in the meantime and is not a stand-in that will silently be mistaken
// for the other.
int[16] gvg_meltAnswered;
int[16] gvg_meltMissed;

trigger gt_meltTick;

int Melt_Level () {
    return gv_meltLevel;
}

int Melt_AnsweredBy (int player) {
    if (player < 1 || player > 15) {
        return 0;
    }
    return gvg_meltAnswered[player];
}

int Melt_MissedBy (int player) {
    if (player < 1 || player > 15) {
        return 0;
    }
    return gvg_meltMissed[player];
}

fixed Melt_SecondsToRound () {
    fixed left;

    left = gv_meltNextAt - GameGetMissionTime();
    if (left < 0.0) {
        return 0.0;
    }
    return left;
}

bool Melt_IsFlagged (int slot) {
    if (slot < 0 || slot >= gv_cellCount) {
        return false;
    }
    return gvg_meltFlag[slot];
}

bool Melt_IsHeld (int slot) {
    if (slot < 0 || slot >= gv_cellCount) {
        return false;
    }
    return gvg_meltFlag[slot] && gvg_meltHeld[slot];
}

fixed Melt_SecondsLeft (int slot) {
    fixed left;

    if (slot < 0 || slot >= gv_cellCount || !gvg_meltFlag[slot] || gvg_meltHeld[slot]) {
        return 0.0;
    }
    left = gvg_meltDeadline[slot] - GameGetMissionTime();
    if (left < 0.0) {
        return 0.0;
    }
    return left;
}

int Melt_Targets () {
    int n;

    n = 1 + gv_meltLevel / c_meltLevelsPerTarget;
    if (n > c_meltTargetsMax) {
        n = c_meltTargetsMax;
    }
    return n;
}

//--------------------------------------------------------------------------------------------------
// Whose cell this is.
//
// The abnormality itself is no help: every abnormality belongs to the
// abnormality slot, because a loose one has to be hostile to the swarm as well
// as to everybody else. So ownership is spatial, the way the door and the panel
// already are -- the control panel standing at that cell belongs to somebody,
// and 13_containment already treats its owner as the person whose encyclopedia
// the panel shows.
//
// Falls back to Sector_OwnerNear, so a cell whose panel has not been placed yet
// is still somebody's rather than nobody's. Returns 0 when the map has neither,
// and a cell owned by nobody is skipped rather than handed to player 1.
//--------------------------------------------------------------------------------------------------
int Melt_OwnerOf (int slot) {
    unit panel;

    panel = Cont_PanelAt(gvg_cellHome[slot]);
    if (panel != null && Slot_IsTablePlayer(UnitGetOwner(panel))) {
        return UnitGetOwner(panel);
    }
    return Sector_OwnerNear(gvg_cellHome[slot]);
}

//--------------------------------------------------------------------------------------------------
// Whether a meltdown may name this abnormality at all.
//
// Training Team's tool abnormality may not: docs/usr/department.md gives it no
// PE-Boxes, no resources and no meltdown count, which together are what make it
// safe to grind an employee to level II on. There is no channel for "this is a
// tool" yet, so this is the hook and not the rule.
//--------------------------------------------------------------------------------------------------
bool Melt_CanBeNamed (int index) {
    if (index < 0) {
        return false;
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// Nobody went. The counter is spent and the table pays.
//--------------------------------------------------------------------------------------------------
void Melt_Miss (int slot) {
    unit abno;
    int owner;
    int lost;

    abno = gvg_cellAbno[slot];
    owner = Melt_OwnerOf(slot);

    gvg_meltFlag[slot] = false;
    gvg_meltHeld[slot] = false;

    if (owner >= 1 && owner <= 15) {
        gvg_meltMissed[owner] = gvg_meltMissed[owner] + 1;
    }

    // Set to zero rather than decremented: a meltdown spends the counter, it
    // does not chip at it. An abnormality with no counter has nothing here to
    // spend, and what any of them does at zero is its own business.
    if (Cont_CounterDefault(abno) > 0) {
        Cont_SetCounter(abno, 0);
    }
    lost = Energy_Drain(c_meltEnergyPenaltyPct);

    UIDisplayMessage(
        PlayerGroupAll(), c_messageAreaSubtitle,
        StringToText(gvg_abnoName[AbnoGen_IndexOf(abno)]
                     + " went unattended -- Qliphoth 0, "
                     + IntToString(lost) + " energy lost"));
}

//--------------------------------------------------------------------------------------------------
// Names the cells for a round.
//
// Per player, and only among the cells that could actually be worked: one
// already loose, or behind a dropped door, is a problem the player is having
// rather than one to hand them. Cells still pending from an earlier round count
// against the target, so a held cell holds a place in the queue instead of
// letting the pile grow behind it.
//
// Selection walks from a random offset so that a player with more cells than
// targets does not get the same ones every round.
//--------------------------------------------------------------------------------------------------
void Melt_NameFor (int player) {
    unit abno;
    int want;
    int have;
    int step;
    int slot;
    int start;

    if (gv_cellCount <= 0) {
        return;
    }

    want = Melt_Targets();

    have = 0;
    slot = 0;
    while (slot < gv_cellCount) {
        if (gvg_meltFlag[slot] && Melt_OwnerOf(slot) == player) {
            have = have + 1;
        }
        slot = slot + 1;
    }

    start = RandomInt(0, gv_cellCount - 1);
    step = 0;
    while (step < gv_cellCount && have < want) {
        slot = (start + step) % gv_cellCount;
        abno = gvg_cellAbno[slot];
        if (!gvg_meltFlag[slot]
            && Melt_OwnerOf(slot) == player
            && Melt_CanBeNamed(AbnoGen_IndexOf(abno))
            && gvg_cellState[slot] == c_cellContained
            && Cont_DoorIsUp(abno)) {

            gvg_meltFlag[slot] = true;
            have = have + 1;

            // Already busy: hold it. The employee inside cannot begin again, so
            // the window would not be a window.
            if (gvg_meltBusy[slot] > 0) {
                gvg_meltHeld[slot] = true;
                UIDisplayMessage(
                    PlayerGroupSingle(player), c_messageAreaSubtitle,
                    StringToText("MELTDOWN: " + gvg_abnoName[AbnoGen_IndexOf(abno)]
                                 + " -- held until the work in progress ends"));
            }
            else {
                gvg_meltHeld[slot] = false;
                gvg_meltDeadline[slot] = GameGetMissionTime() + c_meltWindow;
                UIDisplayMessage(
                    PlayerGroupSingle(player), c_messageAreaSubtitle,
                    StringToText("MELTDOWN: " + gvg_abnoName[AbnoGen_IndexOf(abno)]
                                 + " -- send somebody within "
                                 + IntToString(FixedToInt(c_meltWindow)) + "s"));
            }
        }
        step = step + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// A new round: the level rises and more cells are named.
//--------------------------------------------------------------------------------------------------
void Melt_Advance () {
    int player;

    gv_meltLevel = gv_meltLevel + 1;
    gv_meltNextAt = GameGetMissionTime() + c_meltPeriod;

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle,
                     StringToText("meltdown level " + IntToString(gv_meltLevel)));

    player = 1;
    while (player <= 15) {
        if (Slot_IsTablePlayer(player)) {
            Melt_NameFor(player);
        }
        player = player + 1;
    }
}

bool Melt_Tick_Func (bool testConds, bool runActions) {
    fixed now;
    int slot;

    if (!runActions) {
        return true;
    }

    now = GameGetMissionTime();

    slot = 0;
    while (slot < gv_cellCount) {
        if (gvg_meltFlag[slot]) {
            if (gvg_meltHeld[slot]) {
                // The work that was in flight has ended, however it ended. The
                // window opens now.
                if (gvg_meltBusy[slot] <= 0) {
                    gvg_meltHeld[slot] = false;
                    gvg_meltDeadline[slot] = now + c_meltWindow;
                    UIDisplayMessage(
                        PlayerGroupSingle(Melt_OwnerOf(slot)), c_messageAreaSubtitle,
                        StringToText(gvg_abnoName[AbnoGen_IndexOf(gvg_cellAbno[slot])]
                                     + " is free -- "
                                     + IntToString(FixedToInt(c_meltWindow))
                                     + "s to send somebody"));
                }
            }
            else if (now >= gvg_meltDeadline[slot]) {
                Melt_Miss(slot);
            }
        }
        slot = slot + 1;
    }

    if (now >= gv_meltNextAt) {
        Melt_Advance();
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// A work started. Called from Work_Begin, which is why this module sorts first.
//
// Any work beginning after the naming answers it, whoever sent the employee.
// Which player gets the credit is decided here by who owns the CELL -- so a
// neighbour walking over to cover for you is help, and Control Team lv2's
// cross-department work is help by design rather than by an exception written
// here.
//
// A work that was already running when the cell was named does not reach this,
// because it began before there was anything to answer.
//--------------------------------------------------------------------------------------------------
void Melt_NoteWorkBegin (unit abno) {
    int slot;
    int owner;

    slot = Cont_SlotOf(abno);
    if (slot < 0) {
        return;
    }

    gvg_meltBusy[slot] = gvg_meltBusy[slot] + 1;

    if (!gvg_meltFlag[slot]) {
        return;
    }

    gvg_meltFlag[slot] = false;
    gvg_meltHeld[slot] = false;

    owner = Melt_OwnerOf(slot);
    if (owner >= 1 && owner <= 15) {
        gvg_meltAnswered[owner] = gvg_meltAnswered[owner] + 1;
        UIDisplayMessage(
            PlayerGroupSingle(owner), c_messageAreaSubtitle,
            StringToText(gvg_abnoName[AbnoGen_IndexOf(abno)] + " -- meltdown answered"));
    }
}

//--------------------------------------------------------------------------------------------------
// A work left the table, however it left: finished, or interrupted by the gate
// coming down, or by the employee dying or breaking.
//
// One exit for all of them, because a held cell does not care which one it was.
// Called from Work_Drop, which every work goes through.
//--------------------------------------------------------------------------------------------------
void Melt_NoteWorkEnd (unit abno) {
    int slot;

    slot = Cont_SlotOf(abno);
    if (slot < 0) {
        return;
    }
    gvg_meltBusy[slot] = gvg_meltBusy[slot] - 1;
    if (gvg_meltBusy[slot] < 0) {
        gvg_meltBusy[slot] = 0;
    }
}

void Meltdown_Init () {
    int i;

    gv_meltLevel = 0;
    gv_meltNextAt = c_meltPeriod;

    i = 0;
    while (i < 32) {
        gvg_meltFlag[i] = false;
        gvg_meltHeld[i] = false;
        gvg_meltDeadline[i] = 0.0;
        gvg_meltBusy[i] = 0;
        i = i + 1;
    }

    i = 1;
    while (i <= 15) {
        gvg_meltAnswered[i] = 0;
        gvg_meltMissed[i] = 0;
        i = i + 1;
    }

    gt_meltTick = TriggerCreate("Melt_Tick_Func");
    TriggerAddEventTimePeriodic(gt_meltTick, 1.0, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/14_work.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Work.
//
// The verb itself. 11_employee.galaxy owns the person, 13_containment.galaxy
// owns the thing, and this is "send that one to do that to it" -- which
// design 2.1 identifies as the whole reason employees exist. Without it an
// abnormality is a mine with a plot.
//
// The numbers are not here. Every one of them comes from the abnormality's own
// doc through 04_abno_gen.galaxy: how fast boxes come, how many there are,
// which box counts read as Good or Normal, and the success chance for each of
// the four works against each stat level. Adding an abnormality is writing a
// document.
//
// One roll per box, not one roll per work. O-03-03 attempts ten boxes at a
// chance that depends on the work chosen and the employee's level in the stat
// that work uses, and the number that land is the result. That is why a
// specialist is not merely likelier to succeed -- they produce more, and the
// grade is a consequence of the amount rather than a separate roll.
//
// The stat each work leans on:
//
//     Instinct   -> Fortitude    Insight    -> Prudence
//     Attachment -> Temperance   Repression -> Justice
//
// What a missed box costs comes from the doc too, and it is not one thing. Red
// is the body, White is the mind, Black is both in full, and Pale is a
// percentage of maximum life. So the question a player answers at the door is
// not only "which work" but "who can afford to be wrong here" -- and since
// Fortitude IS maximum life, Pale is the one that a strong employee cannot
// simply outgrow.
//

// Both formulas are from docs/usr/mechanism.md and neither is invented:
//
//     speed   = base * (1 + (observation + Temperance) / 100)
//     success = preference + (observation + Temperance)/5, capped at 95,
//               then penalties
//
// Temperance is in both, which is the thing worth noticing about it: a point is
// +1% work speed and +0.2% success at the same time. It is the only stat that
// pays twice, and the only one whose VALUE matters rather than only the
// threshold its level crosses -- everywhere else 30 and 44 of a stat are the
// same number.
//
// Work success moves in whole percents per five points, so four points of bonus
// is worth exactly nothing; the integer divide is the mechanic, not a rounding
// artefact.
//
// The 95% cap is applied before penalties rather than after, which is why there
// is always at least a 5% chance of failing and why penalties are so much worse
// than the same number of bonus points is good.
//--------------------------------------------------------------------------------------------------

const int c_workInstinct = 0;
const int c_workInsight = 1;
const int c_workAttachment = 2;
const int c_workRepression = 3;
const int c_workCount = 4;

const int c_resultBad = 0;
const int c_resultNormal = 1;
const int c_resultGood = 2;

// TUNING, and the only invented number in this file. Stat gained per completed
// work, by result. Design 2.2 requires that work be the thing that grows an
// employee; how fast is a curve nobody has designed yet, and this is a
// deliberately flat stand-in rather than a guess dressed up as a formula.
const int c_workGainBad = 1;
const int c_workGainNormal = 2;
const int c_workGainGood = 3;

const fixed c_workTick = 0.25;

// Work success is counted in points and paid out in whole percents.
const int c_workSuccessPerPercent = 5;

// The cap is applied before penalties, so it is a ceiling on bonuses rather
// than on the final number.
const int c_workSuccessCap = 95;

const int c_workMax = 32;

string[4] gvg_workName;

// The stat each work leans on.
int[4] gvg_workStat;

// One row per work in progress.
int gv_workCount;
unit[32] gvg_workEmp;
unit[32] gvg_workAbno;
int[32] gvg_workType;
int[32] gvg_workBoxes;
int[32] gvg_workDone;
fixed[32] gvg_workNextBox;

// What a player's next work order will be. A placeholder for the order UI:
// there is nowhere to choose a work from yet, so it is chosen once and applies
// until changed.
int[16] gvg_workDefault;

// Cooldown per cell, keyed the same way 13_containment keys its cells.
fixed[32] gvg_workReadyAt;

const string c_workAbil = "Interact";

trigger gt_workTick;
trigger gt_workCast;

string Work_Name (int work) {
    if (work < 0 || work >= c_workCount) {
        return "";
    }
    return gvg_workName[work];
}

int Work_Stat (int work) {
    if (work < 0 || work >= c_workCount) {
        return c_statFortitude;
    }
    return gvg_workStat[work];
}

int Work_DefaultOf (int player) {
    if (player < 1 || player > 15) {
        return c_workInstinct;
    }
    return gvg_workDefault[player];
}

void Work_SetDefault (int player, int work) {
    if (player < 1 || player > 15 || work < 0 || work >= c_workCount) {
        return;
    }
    gvg_workDefault[player] = work;
}

//--------------------------------------------------------------------------------------------------
// Seconds per box attempt.
//
// speed = base * (1 + (observation + Temperance) / 100), and the time for a
// whole work is boxes/speed.
//--------------------------------------------------------------------------------------------------
fixed Work_BoxInterval (unit emp, int index) {
    fixed speed;

    speed = gvg_abnoBoxSpeed[index]
            * (1.0 + IntToFixed(AbnoGen_ObsSpeed(index, Cont_ObservationOf(emp, index))
                                + Emp_Stat(emp, c_statTemperance)) / 100.0);
    if (speed <= 0.0) {
        return 1.0;
    }
    return 1.0 / speed;
}

//--------------------------------------------------------------------------------------------------
// Percent chance for one box.
//
// Bonuses first, then the cap, then penalties. There are no penalties yet, but
// the order is the mechanic rather than an implementation detail: capping
// before them is what makes a penalty permanently lower the best case, and what
// guarantees the 5% failure that no amount of preparation removes.
//--------------------------------------------------------------------------------------------------
int Work_SuccessChance (unit emp, int index, int work) {
    int chance;
    int points;

    // Temperance counts as work-success points one for one, the same as an
    // observation bonus does: a point of either is +0.2%, and five of either is
    // the +1% the counter actually moves in.
    points = AbnoGen_ObsSuccess(index, Cont_ObservationOf(emp, index))
             + Emp_Stat(emp, c_statTemperance);

    chance = AbnoGen_Pref(index, work, Emp_StatLevel(emp, Work_Stat(work)))
             + points / c_workSuccessPerPercent;

    if (chance > c_workSuccessCap) {
        chance = c_workSuccessCap;
    }
    return chance;
}

//--------------------------------------------------------------------------------------------------
// Whether this employee can start work on this abnormality right now.
//--------------------------------------------------------------------------------------------------
int Work_SlotOfEmp (unit emp) {
    int i;

    i = 0;
    while (i < gv_workCount) {
        if (gvg_workEmp[i] == emp) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

bool Work_IsBusy (unit emp) {
    return Work_SlotOfEmp(emp) >= 0;
}

//--------------------------------------------------------------------------------------------------
// Starts one.
//
// The employee is not moved into the cell and nothing is teleported: per
// docs/usr/containment.md nobody can enter, and standing at the door doing
// nothing visible is the placeholder that document asks for.
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Why this employee cannot work this abnormality, or "" if they can.
//
// A reason rather than a bare false. A player who presses a button and gets
// nothing has hit the same bug as a developer who cannot tell which check
// refused, and one string fixes both.
//--------------------------------------------------------------------------------------------------
string Work_Refusal (unit abno, unit emp) {
    int cell;

    if (emp == null || !UnitIsAlive(emp)) {
        return "no employee";
    }
    if (Work_IsBusy(emp)) {
        return "already working";
    }
    if (gv_workCount >= c_workMax) {
        return "too many works at once";
    }
    if (abno == null) {
        return "no abnormality at that door";
    }
    if (AbnoGen_IndexOf(abno) < 0) {
        return "that unit has no abnormality document";
    }

    cell = Cont_SlotOf(abno);
    if (cell < 0) {
        return "that abnormality is not in the cell registry";
    }
    // A dropped door is exactly and only this: you cannot work on it. That is
    // the whole consequence for an abnormality that does not escape.
    if (!Cont_DoorIsUp(abno)) {
        return "the door is down";
    }
    if (Cont_State(abno) != c_cellContained) {
        return "it is not in its cell";
    }
    if (GameGetMissionTime() < gvg_workReadyAt[cell]) {
        return "still on work cooldown";
    }
    return "";
}

bool Work_Begin (unit abno, unit emp, int work) {
    int cell;
    int index;

    if (Work_Refusal(abno, emp) != "") {
        return false;
    }
    index = AbnoGen_IndexOf(abno);
    cell = Cont_SlotOf(abno);

    gvg_workEmp[gv_workCount] = emp;
    gvg_workAbno[gv_workCount] = abno;
    gvg_workType[gv_workCount] = work;
    gvg_workBoxes[gv_workCount] = 0;
    gvg_workDone[gv_workCount] = 0;
    gvg_workNextBox[gv_workCount] = GameGetMissionTime() + Work_BoxInterval(emp, index);
    gv_workCount = gv_workCount + 1;

    // The meltdown clock answers to this, not to Work_Finish. Somebody has been
    // sent, which is the decision a meltdown was asking about.
    Melt_NoteWorkBegin(abno);

    // Order, not OrderTargetingPoint: stop takes no target, and handing it one
    // is a trigger error rather than a no-op.
    UnitIssueOrder(emp, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
    return true;
}

//--------------------------------------------------------------------------------------------------
// Drops row `slot`, keeping the rows dense by moving the last one into the gap.
//
// Every work leaves through here, finished or interrupted, which is why the
// meltdown clock is told about it here and nowhere else -- a held cell does not
// care which of the two it was.
//--------------------------------------------------------------------------------------------------
void Work_Drop (int slot) {
    int last;

    Melt_NoteWorkEnd(gvg_workAbno[slot]);

    last = gv_workCount - 1;
    gvg_workEmp[slot] = gvg_workEmp[last];
    gvg_workAbno[slot] = gvg_workAbno[last];
    gvg_workType[slot] = gvg_workType[last];
    gvg_workBoxes[slot] = gvg_workBoxes[last];
    gvg_workDone[slot] = gvg_workDone[last];
    gvg_workNextBox[slot] = gvg_workNextBox[last];
    gv_workCount = last;
}

string Work_ResultName (int result) {
    if (result == c_resultGood) {
        return "Good";
    }
    if (result == c_resultNormal) {
        return "Normal";
    }
    return "Bad";
}

//--------------------------------------------------------------------------------------------------
// Pays out and clears the row.
//
// The result is the box count read against the doc's own ranges, so an
// abnormality that is generous about what counts as Good says so in its own
// file rather than here.
//--------------------------------------------------------------------------------------------------
void Work_Finish (int slot) {
    unit emp;
    unit abno;
    int index;
    int cell;
    int boxes;
    int result;
    int gain;
    int owner;

    emp = gvg_workEmp[slot];
    abno = gvg_workAbno[slot];
    index = AbnoGen_IndexOf(abno);
    cell = Cont_SlotOf(abno);
    boxes = gvg_workBoxes[slot];
    owner = UnitGetOwner(emp);

    result = c_resultBad;
    if (boxes >= gvg_abnoGoodMin[index]) {
        result = c_resultGood;
    }
    else if (boxes >= gvg_abnoNormalMin[index]) {
        result = c_resultNormal;
    }

    gain = c_workGainBad;
    if (result == c_resultGood) {
        gain = c_workGainGood;
    }
    else if (result == c_resultNormal) {
        gain = c_workGainNormal;
    }
    Emp_StatAdd(emp, Work_Stat(gvg_workType[slot]), gain);

    // Boxes pay twice, into two things that never mix: this player's stock for
    // this abnormality's encyclopedia, and the table's shared energy.
    Cont_AddBoxes(owner, index, boxes);
    Energy_Add(boxes);

    if (cell >= 0) {
        gvg_workReadyAt[cell] = GameGetMissionTime() + gvg_abnoCooldown[index];
    }

    UIDisplayMessage(
        PlayerGroupSingle(owner), c_messageAreaSubtitle,
        StringToText(gvg_abnoName[index] + ": " + Work_Name(gvg_workType[slot])
                     + " -- " + IntToString(boxes) + " boxes, "
                     + Work_ResultName(result)
                     + "  (+" + IntToString(gain) + " " + Emp_StatName(Work_Stat(gvg_workType[slot]))
                     + ")"));

    Work_Drop(slot);
}

//--------------------------------------------------------------------------------------------------
// One box attempt.
//
// The preference behind it is indexed by the employee's LEVEL in the matching
// stat, straight out of the abnormality's doc. Level, not value: the source
// tables are I to V, which is why an employee with 30 Prudence and one with 44
// are the same to an abnormality, and why the thresholds are worth caring about.
//--------------------------------------------------------------------------------------------------
void Work_RollBox (int slot) {
    unit emp;
    int index;

    emp = gvg_workEmp[slot];
    index = AbnoGen_IndexOf(gvg_workAbno[slot]);

    gvg_workDone[slot] = gvg_workDone[slot] + 1;
    if (RandomInt(1, 100) <= Work_SuccessChance(emp, index, gvg_workType[slot])) {
        gvg_workBoxes[slot] = gvg_workBoxes[slot] + 1;
    }
    else {
        // Whatever this abnormality charges, which is not always the mind. Its
        // own doc says which and how much, so a missed box on one thing is a bad
        // afternoon and on another it is a funeral.
        Emp_WorkDamage(emp, AbnoGen_DmgType(index), AbnoGen_DmgRoll(index));
    }

    gvg_workNextBox[slot] = GameGetMissionTime() + Work_BoxInterval(emp, index);
}

//--------------------------------------------------------------------------------------------------
// The work ability, cast and finished.
//
// The ability is Interact: an Effect-Target that does nothing and takes a
// second, aimed at a containment door. The engine draws the cast bar, the
// TargetFilters and the validator decide what can be aimed at, and this hears
// the cast complete.
//
// The first version read the employee's order queue and inferred intent from an
// order pointed at a door. It worked, and it was wrong in three ways at once:
// every move order near a cell became ambiguous, there was no cast bar to show,
// and there was no way to refuse a target. Right-click will come back later
// through SmartCast on this same ability, without any of this changing.
//
// Complete rather than Execute, so walking away during the cast really does
// cancel it -- which is the point of the cast having a length at all.
//--------------------------------------------------------------------------------------------------
bool Work_Cast_Func (bool testConds, bool runActions) {
    unit emp;
    unit door;
    unit abno;
    int slot;
    int owner;
    string why;

    if (!runActions) {
        return true;
    }

    emp = EventUnit();
    // EventUnitTargetUnit, not EventUnitAbilityOtherUnit. They sit two lines
    // apart in the natives file under the same heading, and the second one is
    // for abilities that involve a third party rather than for the thing you
    // clicked: it came back null here, so every cast landed on "that is not a
    // containment door".
    door = EventUnitTargetUnit();
    owner = UnitGetOwner(emp);

    // Registered on every stage and filtered here rather than on Complete
    // alone. A prepare-time cast walks -3, 0..5, -6, and knowing that took a
    // trace through every stage; keeping the registration broad means the next
    // question of that shape needs one line rather than a rebuild.
    if (EventUnitAbilityStage() != c_unitAbilStageComplete) {
        return true;
    }

    if (!ObjectsGen_IsEmp(emp)) {
        return true;
    }
    if (!Cont_IsDoor(door)) {
        UIDisplayMessage(PlayerGroupSingle(owner), c_messageAreaSubtitle,
                         StringToText("work: not a containment door ("
                                      + UnitGetType(door) + ")"));
        return true;
    }

    slot = 0;
    while (slot < gv_cellCount) {
        if (Cont_DoorAt(gvg_cellHome[slot]) == door) {
            abno = gvg_cellAbno[slot];
            why = Work_Refusal(abno, emp);
            if (why != "") {
                UIDisplayMessage(PlayerGroupSingle(owner), c_messageAreaSubtitle,
                                 StringToText("work: " + why));
                return true;
            }
            Work_Begin(abno, emp, Work_DefaultOf(owner));
            UIDisplayMessage(
                PlayerGroupSingle(owner), c_messageAreaSubtitle,
                StringToText(gvg_abnoName[AbnoGen_IndexOf(abno)] + ": "
                             + Work_Name(Work_DefaultOf(owner)) + " started"));
            return true;
        }
        slot = slot + 1;
    }

    UIDisplayMessage(PlayerGroupSingle(owner), c_messageAreaSubtitle,
                     StringToText("work: no cell is registered at that door"));
    return true;
}

bool Work_Tick_Func (bool testConds, bool runActions) {
    fixed now;
    int index;
    int slot;

    if (!runActions) {
        return true;
    }

    now = GameGetMissionTime();

    // Backwards: finishing a row moves the last row into its place.
    slot = gv_workCount - 1;
    while (slot >= 0) {
        if (gvg_workEmp[slot] == null || !UnitIsAlive(gvg_workEmp[slot])
            || Emp_IsPanicked(gvg_workEmp[slot])
            || Cont_State(gvg_workAbno[slot]) != c_cellContained
            || !Cont_DoorIsUp(gvg_workAbno[slot])) {
            // Interrupted. The employee died or broke, the thing they were
            // working on got out, or the gate came down around it. Every one of
            // them ends the work where it stands and pays nothing.
            //
            // Panic is here rather than only in Work_Refusal because an employee
            // can break DURING a work -- a missed box is White damage, so a bad
            // enough work breaks the person doing it, and somebody who has
            // stopped functioning has stopped working.
            Work_Drop(slot);
        }
        else if (now >= gvg_workNextBox[slot]) {
            Work_RollBox(slot);
            index = AbnoGen_IndexOf(gvg_workAbno[slot]);
            if (gvg_workDone[slot] >= gvg_abnoMaxBox[index]) {
                Work_Finish(slot);
            }
        }
        slot = slot - 1;
    }

    return true;
}

void Work_Init () {
    int player;

    gvg_workName[c_workInstinct] = "Instinct";
    gvg_workName[c_workInsight] = "Insight";
    gvg_workName[c_workAttachment] = "Attachment";
    gvg_workName[c_workRepression] = "Repression";

    gvg_workStat[c_workInstinct] = c_statFortitude;
    gvg_workStat[c_workInsight] = c_statPrudence;
    gvg_workStat[c_workAttachment] = c_statTemperance;
    gvg_workStat[c_workRepression] = c_statJustice;

    gv_workCount = 0;

    player = 1;
    while (player <= 15) {
        gvg_workDefault[player] = c_workInstinct;
        player = player + 1;
    }

    gt_workTick = TriggerCreate("Work_Tick_Func");
    TriggerAddEventTimePeriodic(gt_workTick, c_workTick, c_timeGame);

    gt_workCast = TriggerCreate("Work_Cast_Func");
    TriggerAddEventUnitAbility(gt_workCast, null, AbilityCommand(c_workAbil, 0),
                               c_unitAbilStageAll, true);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/15_hero.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// The player characters.
//
// P0's whole proposition is that clearing, fighting and repairing all want the
// same pair of hands. That only means anything if the hands exist, so this
// module owns the one unit each player actually drives: handing it over at
// start, and putting it back after it dies.
//
// Death costs time and nothing else, per the design baseline -- no resources
// lost, no lasting penalty on the character. The cost is the walk back plus
// whatever fell apart in the meantime, and that is a real cost precisely because
// the other two jobs do not pause while the player is dead.
//
// The character's type is read from the generated table rather than named here,
// so renaming the unit in the editor does not need a code change. If no Hero
// unit has been authored yet the module simply does nothing.
//
//--------------------------------------------------------------------------------------------------
// One per player, and it used to be one full stop.
//
// The old version kept a single gv_hero, took the FIRST hero unit on the map
// whoever owned it, and respawned it for player 1. On a six-player map that is
// five orphans: characters that belong to somebody, die once, and never come
// back, while player 1 quietly acquires a second body at their own home.
//
// Nothing about that was a shortcut worth keeping past the point where a second
// player existed, and build-order.md says so outright: new modules are written
// per player, and the ones carrying this debt get fixed when something touches
// them. Meltdown, energy and containment are all per player now, and they cannot
// be exercised at all through a single-player character layer.
//
// Respawn is a tick rather than a timer per player. TriggerAddEventTimer would
// need EventTimer() compared against sixteen handles to find out whose it was,
// which is more machinery than a loop that already has to exist -- and every
// other clock in this project (containment, meltdown, sector) is a tick.
//--------------------------------------------------------------------------------------------------

const fixed c_heroRespawnDelay = 15.0;
const fixed c_heroTick = 1.0;

unit[16] gvg_hero;
point[16] gvg_heroHome;
fixed[16] gvg_heroBackAt;
bool[16] gvg_heroHas;

trigger gt_heroDied;
trigger gt_heroTick;

unit Hero_Of (int player) {
    if (player < 1 || player > 15) {
        return null;
    }
    return gvg_hero[player];
}

point Hero_HomeOf (int player) {
    if (player < 1 || player > 15) {
        return Point(0.0, 0.0);
    }
    return gvg_heroHome[player];
}

//--------------------------------------------------------------------------------------------------
// Creates one player's character at their own home point.
//--------------------------------------------------------------------------------------------------
void Hero_Spawn (int player) {
    if (c_typesHeroCount == 0 || !gvg_heroHas[player]) {
        return;
    }

    // Ignoring placement is not optional. The home point may well be full of
    // zerglings at exactly the moment the character is due back, and "the player
    // does not respawn" is not a cost the design ever asked for.
    UnitCreate(1, gvg_typesHero[0], c_unitCreateIgnorePlacement,
               player, gvg_heroHome[player], 270.0);
    gvg_hero[player] = UnitLastCreated();
    UnitSelect(gvg_hero[player], player, true);
    CameraPan(player, gvg_heroHome[player], 0.0, -1.0, 10.0, true);
}

//--------------------------------------------------------------------------------------------------
// Any unit death, filtered down to a character. Same shape as the debris death
// handler in 25_clearing.galaxy, and for the same reason: it covers a character
// spawned at runtime, which after the first respawn is every character there
// will ever be.
//
// Whose it was comes off the unit rather than being looked up, which is the
// whole reason a per-player version costs nothing here.
//--------------------------------------------------------------------------------------------------
bool Hero_Died_Func (bool testConds, bool runActions) {
    unit who;
    int player;

    if (!runActions) {
        return true;
    }

    who = EventUnit();
    if (!ObjectsGen_IsHero(who)) {
        return true;
    }

    player = UnitGetOwner(who);
    if (player < 1 || player > 15) {
        return true;
    }

    gvg_hero[player] = null;
    gvg_heroBackAt[player] = GameGetMissionTime() + c_heroRespawnDelay;

    // To that player, because six characters dying over twenty minutes is six
    // messages everybody else cannot act on. A teammate being down matters, but
    // it belongs to whatever eventually draws a roster, not to the subtitle line
    // that meltdown and containment are both already using.
    UIDisplayMessage(
        PlayerGroupSingle(player), c_messageAreaSubtitle,
        StringToText("agent down -- back in "
                     + IntToString(FixedToInt(c_heroRespawnDelay)) + "s"));
    return true;
}

bool Hero_Tick_Func (bool testConds, bool runActions) {
    fixed now;
    int player;

    if (!runActions) {
        return true;
    }

    now = GameGetMissionTime();
    player = 1;
    while (player <= 15) {
        if (gvg_heroHas[player]
            && (gvg_hero[player] == null || !UnitIsAlive(gvg_hero[player]))
            && now >= gvg_heroBackAt[player]) {
            Hero_Spawn(player);
        }
        player = player + 1;
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// Claims every character standing on the map for whoever owns it.
//
// Where the character was placed is where it comes back. Deliberately not a
// separate marker: a respawn point that can drift away from the start point is a
// bug waiting to happen, and nothing here would move it.
//
// A player who is at the table but has no character placed falls back to their
// core, so adding a sixth player to the map does not silently mean a sixth
// player with no hands. A player with neither is left alone -- there is nowhere
// to put them, and inventing a spot would drop somebody into the map at a
// position nobody chose.
//--------------------------------------------------------------------------------------------------
void Hero_Claim () {
    unitgroup heroes;
    unit who;
    unit core;
    int count;
    int i;
    int player;

    heroes = ObjectsGen_ScanHero();
    count = UnitGroupCount(heroes, c_unitCountAlive);

    i = 1;
    while (i <= count) {
        who = UnitGroupUnit(heroes, i);
        if (who != null) {
            player = UnitGetOwner(who);
            if (player >= 1 && player <= 15 && !gvg_heroHas[player]) {
                gvg_hero[player] = who;
                gvg_heroHome[player] = UnitGetPosition(who);
                gvg_heroHas[player] = true;
                UnitSelect(who, player, true);
                CameraPan(player, gvg_heroHome[player], 0.0, -1.0, 10.0, true);
            }
        }
        i = i + 1;
    }

    player = 1;
    while (player <= 15) {
        if (!gvg_heroHas[player] && Slot_IsTablePlayer(player)) {
            core = Sector_AnyCore(player);
            if (core != null) {
                gvg_heroHome[player] = UnitGetPosition(core);
                gvg_heroHas[player] = true;
                gvg_heroBackAt[player] = 0.0;
            }
        }
        player = player + 1;
    }
}

void Hero_Init () {
    int player;

    player = 1;
    while (player <= 15) {
        gvg_hero[player] = null;
        gvg_heroHas[player] = false;
        gvg_heroBackAt[player] = 0.0;
        player = player + 1;
    }

    Hero_Claim();

    gt_heroTick = TriggerCreate("Hero_Tick_Func");
    TriggerAddEventTimePeriodic(gt_heroTick, c_heroTick, c_timeGame);

    gt_heroDied = TriggerCreate("Hero_Died_Func");
    TriggerAddEventUnitDied(gt_heroDied, null);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/20_devices.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Resource devices.
//
// Devices hold up the power grid while intact, and lethal damage disables them
// instead of destroying them, per the design baseline.
//
// Both halves of that live in data rather than here:
//
//   Power is the engine's supply meter. An online device carries Food, so the
//   engine counts it into supplies-made by itself, per owning player, which is
//   exactly the independent grid the baseline asks for and costs nothing. The
//   readout is free and turns red on its own. Nothing in this file writes it.
//
//   Disablement is a unit type. A device that takes a killing blow is replaced
//   by Lob_DeviceDown_Basic, which carries no Food and so leaves the grid the
//   moment it appears, and which is Invulnerable -- and Invulnerable happens to
//   mean exactly the two things wanted here, because the zergling weapon's
//   target filters exclude it while the Repair ability's filters do not. So
//   nothing keeps chewing on a device that is already down, and an SCV or the
//   player can still work on it.
//
// This module is therefore only the two morphs and a count for the readout.
// There is no "is it disabled" flag, no health threshold standing in for one,
// and no supply bookkeeping -- asking which units exist answers all of it.
//--------------------------------------------------------------------------------------------------

const fixed c_devicePeriod = 1.0;

// Type-name prefixes. A device and its downed form differ only in this segment,
// so one is derived from the other rather than tabulated; adding a variant
// means authoring the pair in the editor and nothing here.
const string c_deviceUpPrefix = "Lob_Device_";
const string c_deviceDownPrefix = "Lob_DeviceDown_";

// Devices online on the last tick, and devices in total. Only the greybox
// readout needs these; the grid itself is the engine's business.
int gv_devicesOnline;
int gv_devicesTotal;

trigger gt_deviceFatal;
trigger gt_deviceTick;

//--------------------------------------------------------------------------------------------------
// Devices worth sending a worker to: anything down, plus anything still online
// but chipped. Down comes first because a downed device is off the grid, while
// a chipped one is still paying out.
//--------------------------------------------------------------------------------------------------
unitgroup Devices_Damaged () {
    unitgroup found;
    unitgroup online;
    unit device;
    int count;
    int i;

    found = ObjectsGen_ScanDeviceDown();

    online = ObjectsGen_ScanDevice();
    count = UnitGroupCount(online, c_unitCountAlive);
    i = 1;
    while (i <= count) {
        device = UnitGroupUnit(online, i);
        if (device != null && UnitGetPropertyFixed(device, c_unitPropLifePercent, true) < 99.0) {
            UnitGroupAdd(found, device);
        }
        i = i + 1;
    }
    return found;
}

//--------------------------------------------------------------------------------------------------
// Intercepts the killing blow and puts the downed device in its place.
//--------------------------------------------------------------------------------------------------
bool Devices_Fatal_Func (bool testConds, bool runActions) {
    unit victim;

    if (!runActions) {
        return true;
    }

    victim = EventUnit();
    if (!ObjectsGen_IsDevice(victim)) {
        return true;
    }

    Downable_TakeDown(victim, c_deviceUpPrefix, c_deviceDownPrefix);
    return true;
}

//--------------------------------------------------------------------------------------------------
// Brings repaired devices back onto the grid, and counts for the readout.
//--------------------------------------------------------------------------------------------------
bool Devices_Tick_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }

    Downable_RestoreRepaired(ObjectsGen_ScanDeviceDown(),
                             c_deviceDownPrefix, c_deviceUpPrefix);

    gv_devicesOnline = UnitGroupCount(ObjectsGen_ScanDevice(), c_unitCountAlive);
    gv_devicesTotal = gv_devicesOnline
                      + UnitGroupCount(ObjectsGen_ScanDeviceDown(), c_unitCountAlive);
    return true;
}

void Devices_Init () {
    gv_devicesOnline = 0;
    gv_devicesTotal = 0;

    gt_deviceFatal = TriggerCreate("Devices_Fatal_Func");
    TriggerAddEventUnitDamaged(gt_deviceFatal, null, c_unitDamageTypeAny, c_unitDamageFatal, null);

    gt_deviceTick = TriggerCreate("Devices_Tick_Func");
    TriggerAddEventTimePeriodic(gt_deviceTick, c_devicePeriod, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/25_clearing.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Debris clearing.
//
// Clearing is modelled as damage, not as a custom progress bar: debris is a
// destructible with a large health pool, and both the player and the workers
// clear it by attacking it. That buys the health bar as progress feedback for
// free, and makes the "player clears far faster than a worker" curve a pure
// weapon-damage question that lives in data where it can be tuned, rather than
// in two hand-written rate constants here.
//
// Worker assignment lives in 30_workers.galaxy; this module only owns what
// clearing pays out.
//--------------------------------------------------------------------------------------------------

// Credit banked into the ore pile when a piece of debris is finished off.
//
// The pile is a real harvestable node, so this is the only place the number
// exists: from here on the engine owns it, and turning it into spendable
// resources is miners walking to it and carrying it back. Nothing converts it
// on their behalf.
// Sized against how long the pile then takes to drain, not against how much a
// piece of debris "should" be worth. At 25 the two starting miners ate a whole
// debris in five seconds, so the pile was empty essentially always -- which
// makes miner headcount irrelevant and quietly guts the separate miner upgrade
// line in baseline section 5.2. At 120 a debris is about 24 seconds of mining
// against about 30 seconds of a player clearing it, so the pile backs up as
// soon as the workers help, and more miners start being worth something.
const int c_oreCreditPerDebris = 120;

int gv_debrisCleared;

trigger gt_debrisDied;

//--------------------------------------------------------------------------------------------------
// Any unit death, filtered down to debris. Cheaper and far less bookkeeping
// than registering a death event per placed object, and it covers debris
// spawned at runtime for free -- which is where debris is headed.
//--------------------------------------------------------------------------------------------------
bool Clearing_DebrisDied_Func (bool testConds, bool runActions) {
    unit pile;

    if (!runActions) {
        return true;
    }
    if (!ObjectsGen_IsDebris(EventUnit())) {
        return true;
    }

    // Nearest pile, not "the" pile. With one sector that is the same thing;
    // with several it is the only reading that does not quietly pay a sector
    // for work done on the far side of the ship.
    pile = UnitGroupClosestToPoint(ObjectsGen_ScanPile(), UnitGetPosition(EventUnit()));
    if (pile != null) {
        UnitSetPropertyInt(pile, c_unitPropResources,
                           UnitGetPropertyInt(pile, c_unitPropResources, true)
                           + c_oreCreditPerDebris);
    }
    gv_debrisCleared = gv_debrisCleared + 1;
    return true;
}

void Clearing_Init () {
    gv_debrisCleared = 0;

    gt_debrisDied = TriggerCreate("Clearing_DebrisDied_Func");
    TriggerAddEventUnitDied(gt_debrisDied, null);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/30_workers.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Worker assignment.
//
// Workers pick their own job, repair before clearing. That ordering is the NPC
// side of the same tension P0 is testing on the player: a damaged device pulls
// a worker off the debris it was chewing on, so losing devices costs clearing
// throughput as well as power.
//
// Only idle workers get an order. Reissuing every tick would reset the attack
// of a worker already mid-swing and nothing would ever finish.
//
// The work-order marking UI is deliberately not in P0 -- see
// docs/design/p0-scope.md. Until then this stands in for it.
//--------------------------------------------------------------------------------------------------

const fixed c_workerAssignPeriod = 1.0;

trigger gt_workerAssign;

bool Workers_Assign_Func (bool testConds, bool runActions) {
    unitgroup workers;
    unitgroup damaged;
    unitgroup debris;
    unit worker;
    unit target;
    point where;
    int count;
    int i;

    if (!runActions) {
        return true;
    }

    workers = ObjectsGen_ScanSCV_Worker();
    count = UnitGroupCount(workers, c_unitCountAlive);
    if (count == 0) {
        return true;
    }

    damaged = Devices_Damaged();
    debris = ObjectsGen_ScanDebris();

    i = 1;
    while (i <= count) {
        worker = UnitGroupUnit(workers, i);
        if (worker != null && UnitIsAlive(worker) && UnitOrderCount(worker) == 0) {
            where = UnitGetPosition(worker);

            target = UnitGroupClosestToPoint(damaged, where);
            if (target != null) {
                UnitIssueOrder(
                    worker,
                    OrderTargetingUnit(AbilityCommand("Repair", 0), target),
                    c_orderQueueReplace
                );
            }
            else {
                target = UnitGroupClosestToPoint(debris, where);
                if (target != null) {
                    UnitIssueOrder(
                        worker,
                        OrderTargetingUnit(AbilityCommand("attack", 0), target),
                        c_orderQueueReplace
                    );
                }
            }
        }
        i = i + 1;
    }
    return true;
}

void Workers_Init () {
    gt_workerAssign = TriggerCreate("Workers_Assign_Func");
    TriggerAddEventTimePeriodic(gt_workerAssign, c_workerAssignPeriod, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/40_economy.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// The second stage of the resource chain: ore pile -> spendable resources.
//
// There is no conversion step here any more, because there is nothing to
// convert. The pile is a harvestable node and the recycler is a drop-off, so
// miners walk over, carry, and walk back, and the engine credits the player.
// That was the point of the change: the old version moved numbers from a script
// variable into the player's account while the miners stood there, which is a
// claim about work that never happened.
//
// What is left is dispatch -- pointing idle miners at the pile -- and the
// greybox readout. Throughput is tuned on the pile's own CBehaviorResource:
// HarvestTime against HarvestAmount. (IdealHarvesterCount is display only and
// changes no yield.) Those get designed directly.
// Where the pile sits is a spatial question and should stay one; deriving the
// rate from the walk would tie two decisions together that want to move apart.
//
// Fully automatic and independent of power, per the design baseline. The player
// never touches this; their only job is to keep the pile stocked, which is what
// makes clearing feel like it feeds something rather than paying out directly.
//--------------------------------------------------------------------------------------------------

const fixed c_minerAssignPeriod = 2.0;

trigger gt_minerAssign;

//--------------------------------------------------------------------------------------------------
// How much is sitting in the pile, across every pile there is.
//--------------------------------------------------------------------------------------------------
int Economy_PileContents () {
    unitgroup piles;
    unit pile;
    int total;
    int count;
    int i;

    piles = ObjectsGen_ScanPile();
    count = UnitGroupCount(piles, c_unitCountAlive);
    total = 0;

    i = 1;
    while (i <= count) {
        pile = UnitGroupUnit(piles, i);
        if (pile != null) {
            total = total + UnitGetPropertyInt(pile, c_unitPropResources, true);
        }
        i = i + 1;
    }
    return total;
}

//--------------------------------------------------------------------------------------------------
// Idle miners get sent to the nearest stocked pile. Only idle ones: a miner
// already hauling has a multi-step order queue that reissuing would reset, and
// it would never finish a trip.
//
// Skipping empty piles matters more than it looks. Without the check, miners
// ordered onto a dry pile go idle on arrival and get reordered every couple of
// seconds, which reads as a bug rather than as an economy waiting on the player.
//--------------------------------------------------------------------------------------------------
bool Economy_MinerAssign_Func (bool testConds, bool runActions) {
    unitgroup miners;
    unit miner;
    unit pile;
    int count;
    int i;

    if (!runActions) {
        return true;
    }

    miners = ObjectsGen_ScanSCV_Miner();
    count = UnitGroupCount(miners, c_unitCountAlive);

    i = 1;
    while (i <= count) {
        miner = UnitGroupUnit(miners, i);
        if (miner != null && UnitIsAlive(miner) && UnitOrderCount(miner) == 0) {
            pile = UnitGroupClosestToPoint(ObjectsGen_ScanPile(), UnitGetPosition(miner));
            if (pile != null && UnitGetPropertyInt(pile, c_unitPropResources, true) > 0) {
                UnitIssueOrder(
                    miner,
                    OrderTargetingUnit(AbilityCommand("SCVHarvest", 0), pile),
                    c_orderQueueReplace
                );
            }
        }
        i = i + 1;
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// Greybox readout, on request.
//
// It used to print itself into the subtitle area every five seconds, back when
// nothing else could report and the question P0 was asking -- does the loop
// really pull in three directions at once -- could only be answered by watching
// the numbers move. It answered it. What is left is a screen that cannot show
// anything else, including the one-shot startup scan and every message a real
// mechanic will want to send.
//
// So the line stays and the timer goes: 90_debug.galaxy prints this on -status.
// Nothing is lost, because a number you can ask for at any moment is strictly
// more than the same number arriving whether or not you wanted it.
//
// Anything ownable is counted for the asking player, and anything genuinely
// shared says so on the line. That distinction is not cosmetic: the whole
// baseline turns on which numbers are yours and which are the table's, and a
// readout that quietly showed six players' SCVs as "workers" would be teaching
// the opposite of the rule the design is built on.
//--------------------------------------------------------------------------------------------------
int Economy_CountOwned (unitgroup group, int player) {
    unit who;
    int count;
    int mine;
    int i;

    count = UnitGroupCount(group, c_unitCountAlive);
    mine = 0;
    i = 1;
    while (i <= count) {
        who = UnitGroupUnit(group, i);
        if (who != null && UnitGetOwner(who) == player) {
            mine = mine + 1;
        }
        i = i + 1;
    }
    return mine;
}

string Economy_StatusLine (int player) {
    return "debris left=" + IntToString(UnitGroupCount(ObjectsGen_ScanDebris(), c_unitCountAlive))
           + " (map)  cleared=" + IntToString(gv_debrisCleared)
           + "  pile=" + IntToString(Economy_PileContents())
           + "  power=" + IntToString(PlayerGetPropertyInt(player, c_playerPropSuppliesUsed))
           + "/" + IntToString(PlayerGetPropertyInt(player, c_playerPropSuppliesMade))
           + " (" + IntToString(gv_devicesOnline) + "/" + IntToString(gv_devicesTotal)
           + " devices online, map)"
           + "  dept=" + Dept_NameOf(player)
           + "  diff=" + Diff_NameOf(player)
           + "  inner=" + Sector_HeldText(player)
           + "  workers=" + IntToString(Economy_CountOwned(ObjectsGen_ScanSCV_Worker(), player))
           + "  miners=" + IntToString(Economy_CountOwned(ObjectsGen_ScanSCV_Miner(), player))
           + "  emp=" + IntToString(Economy_CountOwned(ObjectsGen_ScanEmp(), player))
           + "  melt=" + IntToString(Melt_Level())
           + "  energy=" + IntToString(gv_energy) + "/" + IntToString(gv_energyGoal)
           + " (table)";
}

void Economy_Init () {
    gt_minerAssign = TriggerCreate("Economy_MinerAssign_Func");
    TriggerAddEventTimePeriodic(gt_minerAssign, c_minerAssignPeriod, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/50_waves.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Zerg waves.
//
// One wave per spawn marker on a fixed interval, walking in on attack-move.
//
// Waves aim at the nearest device rather than at the player, so that "leave the
// fight to go repair" and "leave the repair to go fight" are the same decision
// seen from two sides. Falling back to the nearest worker keeps them walking
// somewhere meaningful before any device is placed.
//
//--------------------------------------------------------------------------------------------------
// Personal waves, sized by the difficulty of whoever's sector they open into.
//
// Baseline 2 asks for personal waves so that a weak player cannot drag a strong
// one down and a strong one is not punished for developing. It said "scaled by
// that player's own development", and development is not a real quantity -- it
// would have to be invented out of some weighted count of devices and upgrades,
// and it would mean the better you play the harder it gets.
//
// A per-player difficulty setting is the answer instead, and 01_difficulty
// argues why it is better rather than merely easier. What is left here is the
// arithmetic: a marker belongs to the sector it stands in, that sector belongs
// to a player, and that player's setting sizes the wave that comes through it.
//
// A marker that belongs to nobody -- no core placed anywhere near it -- still
// spawns, at Normal. Silence would be worse: an unowned spawn point is a hole
// in the map that nothing would ever come out of, and that is invisible until
// somebody wonders why one corridor is peaceful.
//
// The per-wave ramp stays a placeholder. The baseline defers the strength curve
// until the mechanics it would be balancing against exist, and difficulty
// multiplies whatever that curve turns out to be rather than replacing it.
//--------------------------------------------------------------------------------------------------

const fixed c_waveInterval = 45.0;
const int c_waveBaseSize = 3;
const string c_waveUnitType = "Zergling";

int gv_waveNumber;

trigger gt_wave;

//--------------------------------------------------------------------------------------------------
// Whose wave this is. The marker's own owner first, so the editor can override
// the geometry by simply assigning it; otherwise the sector it stands in.
//--------------------------------------------------------------------------------------------------
int Waves_OwnerOf (unit marker) {
    if (marker == null) {
        return 0;
    }
    if (Slot_IsTablePlayer(UnitGetOwner(marker))) {
        return UnitGetOwner(marker);
    }
    return Sector_OwnerNear(UnitGetPosition(marker));
}

int Waves_SizeFor (int player) {
    int size;
    int pct;

    pct = gvg_diffWavePct[c_diffNormal];
    if (player >= 1 && player <= 15) {
        pct = Diff_WavePct(player);
    }

    size = (c_waveBaseSize + gv_waveNumber) * pct / 100;
    if (size < 1) {
        size = 1;
    }
    return size;
}

//--------------------------------------------------------------------------------------------------
// What a wave spawning at `from` should walk towards.
//--------------------------------------------------------------------------------------------------
point Waves_TargetFrom (point from) {
    unit target;

    target = UnitGroupClosestToPoint(ObjectsGen_ScanDevice(), from);
    if (target == null) {
        target = UnitGroupClosestToPoint(ObjectsGen_ScanSCV(), from);
    }
    if (target == null) {
        return from;
    }
    return UnitGetPosition(target);
}

bool Waves_Spawn_Func (bool testConds, bool runActions) {
    unitgroup markers;
    unitgroup spawned;
    unit marker;
    point where;
    int markerCount;
    int owner;
    int i;

    if (!runActions) {
        return true;
    }

    markers = ObjectsGen_ScanMarker_Spawn();
    markerCount = UnitGroupCount(markers, c_unitCountAlive);
    if (markerCount == 0) {
        return true;
    }

    gv_waveNumber = gv_waveNumber + 1;

    i = 1;
    while (i <= markerCount) {
        marker = UnitGroupUnit(markers, i);
        where = UnitGetPosition(marker);
        owner = Waves_OwnerOf(marker);

        spawned = UnitCreate(
            Waves_SizeFor(owner),
            c_waveUnitType,
            c_unitCreateIgnorePlacement,
            c_zergPlayer,
            where,
            270.0
        );
        UnitGroupIssueOrder(
            spawned,
            OrderTargetingPoint(AbilityCommand("attack", 0), Waves_TargetFrom(where)),
            c_orderQueueReplace
        );

        // Told to the player whose sector it opens into, with their own number.
        // "wave 7 incoming" to everybody said nothing about who was about to be
        // busy, which on a map of scattered sectors is the only part that
        // matters.
        if (owner >= 1 && owner <= 15) {
            UIDisplayMessage(
                PlayerGroupSingle(owner), c_messageAreaSubtitle,
                StringToText("wave " + IntToString(gv_waveNumber) + " -- "
                             + IntToString(Waves_SizeFor(owner)) + " incoming ("
                             + Diff_NameOf(owner) + ")"));
        }
        i = i + 1;
    }
    return true;
}

void Waves_Init () {
    gv_waveNumber = 0;

    gt_wave = TriggerCreate("Waves_Spawn_Func");
    TriggerAddEventTimePeriodic(gt_wave, c_waveInterval, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/90_debug.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Chat commands.
//
// A test harness, not a feature. Everything here exists so that a mechanic can
// be driven by hand in a running game before the system that will drive it for
// real is written -- the alternative is testing employee stats only through a
// work order that does not exist yet, which would mean the first time either
// one runs is also the first time both run.
//
// Numbered last so it can call into anything.
//
// One trigger, one event per player, matching "-" loosely; every command is
// then parsed out of the message text. Registering an event per command would
// mean touching Init every time a command is added, and this file will collect
// commands for as long as there are unfinished systems.
//
// Deliberately not gated behind a flag. It only reaches things a player already
// owns, the map is not shipped from this branch, and a debug console that has
// to be switched on is a debug console nobody switches on. When that stops
// being true the gate goes in Debug_Init and nowhere else.
//--------------------------------------------------------------------------------------------------

const string c_debugPrefix = "-";

trigger gt_debugChat;

// The debug area, which is what it is for and which has room. Chat does not:
// -emp and -cont are several lines each and they push the actual conversation
// out of a window that is small to begin with.
//
// This went to chat for a while on a suspicion that the debug area was behind
// "TextError: 无法找到字体样式[]", because some DEBUG-tagged styles in core's
// FontStyles are marked requiredtoload. That suspicion is dead: the error was
// an unescaped <s> in the old chat help text, and the debug area never had
// anything to do with it.
void Debug_Say (int player, string line) {
    UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaDebug, StringToText(line));
}

//--------------------------------------------------------------------------------------------------
// Which stat a word means. -1 for "all", -2 for "not a stat".
//--------------------------------------------------------------------------------------------------
const int c_debugStatAll = -1;
const int c_debugStatBad = -2;

int Debug_StatFromWord (string word) {
    if (StringEqual(word, "fort", false) || StringEqual(word, "f", false)) {
        return c_statFortitude;
    }
    if (StringEqual(word, "prud", false) || StringEqual(word, "p", false)) {
        return c_statPrudence;
    }
    if (StringEqual(word, "temp", false) || StringEqual(word, "t", false)) {
        return c_statTemperance;
    }
    if (StringEqual(word, "just", false) || StringEqual(word, "j", false)) {
        return c_statJustice;
    }
    if (StringEqual(word, "all", false) || StringEqual(word, "a", false)) {
        return c_debugStatAll;
    }
    return c_debugStatBad;
}

//--------------------------------------------------------------------------------------------------
// StringToInt raises a trigger error on an empty string rather than returning
// zero, and StringWord returns an empty string for a word that was not typed.
// So every optional argument has to come through here; -stat with no value and
// -emp spawn with no count both hit it.
//--------------------------------------------------------------------------------------------------
int Debug_Int (string word, int fallback) {
    if (word == "") {
        return fallback;
    }
    return StringToInt(word);
}

string Debug_RankName (int rank) {
    if (rank == 1) { return "I"; }
    if (rank == 2) { return "II"; }
    if (rank == 3) { return "III"; }
    if (rank == 4) { return "IV"; }
    if (rank == 5) { return "V"; }
    return "?";
}

string Debug_StatLevelName (int level) {
    if (level == 6) { return "EX"; }
    return Debug_RankName(level);
}

//--------------------------------------------------------------------------------------------------
// The employees in a player's current selection.
//
// Selection rather than a name or an index, because the point of the exercise
// is to look at one specific unit's panel while changing it. Falling back to
// every employee the player owns when nothing employee-ish is selected keeps
// "-stat all 90" useful for setting up a scenario.
//--------------------------------------------------------------------------------------------------
unitgroup Debug_TargetEmployees (int player) {
    unitgroup selected;
    unitgroup found;
    unit who;
    int count;
    int i;

    found = UnitGroupEmpty();
    selected = UnitGroupSelected(player);
    count = UnitGroupCount(selected, c_unitCountAlive);

    i = 1;
    while (i <= count) {
        who = UnitGroupUnit(selected, i);
        if (who != null && ObjectsGen_IsEmp(who)) {
            UnitGroupAdd(found, who);
        }
        i = i + 1;
    }

    if (UnitGroupCount(found, c_unitCountAlive) == 0) {
        found = Emp_Of(player);
    }
    return found;
}

//--------------------------------------------------------------------------------------------------
// Where a debug spawn goes: at the player's character, else at their core, else
// wherever they are looking.
//--------------------------------------------------------------------------------------------------
point Debug_SpawnPoint (int player) {
    unit hero;
    unit core;

    hero = Hero_Of(player);
    if (hero != null && UnitIsAlive(hero)) {
        return UnitGetPosition(hero);
    }
    core = Sector_AnyCore(player);
    if (core != null) {
        return UnitGetPosition(core);
    }
    return CameraGetTarget(player);
}

//--------------------------------------------------------------------------------------------------
// -emp
//
// One line per employee: the four raw values, the four levels they land on,
// their sum, and the rank that sum buys. Printed together on purpose -- the
// thing worth checking is that the derivation agrees with the panel, and that
// only shows up when every step of it is on screen at once.
//--------------------------------------------------------------------------------------------------
void Debug_ReportEmployees (int player) {
    unitgroup mine;
    unit who;
    int count;
    int i;
    int stat;
    int sum;
    string line;

    mine = Debug_TargetEmployees(player);
    count = UnitGroupCount(mine, c_unitCountAlive);

    if (count == 0) {
        Debug_Say(player, "emp: none (spawn some with -emp spawn 3)");
        return;
    }

    i = 1;
    while (i <= count) {
        who = UnitGroupUnit(mine, i);
        line = "emp " + IntToString(i) + ":";
        sum = 0;

        stat = 0;
        while (stat < c_statCount) {
            line = line + " " + StringSub(Emp_StatName(stat), 1, 4)
                   + "=" + IntToString(Emp_Stat(who, stat))
                   + "(" + Debug_StatLevelName(Emp_StatLevel(who, stat)) + ")";
            sum = sum + Emp_StatLevel(who, stat);
            stat = stat + 1;
        }

        line = line + "  sum=" + IntToString(sum)
               + " rank=" + Debug_RankName(Emp_Rank(who))
               + " panel=" + IntToString(UnitXPGetCurrentLevel(who, c_rankBehavior))
               + " sp=" + IntToString(Emp_SP(who)) + "/" + IntToString(Emp_SPMax(who));
        if (Emp_IsPanicked(who)) {
            line = line + " PANICKED";
        }
        Debug_Say(player, line);
        i = i + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// -cont
//
// One line per abnormality: grade, state, Qliphoth counter, and what its door
// is doing. The state and the door are printed together because the pairing is
// the whole mechanic -- an abnormality that has decided to leave and a door
// that is still standing is the only situation where anybody has time to react.
//--------------------------------------------------------------------------------------------------
string Debug_CellStateName (int state) {
    if (state == c_cellContained) { return "contained"; }
    if (state == c_cellEscaping) { return "ESCAPING (on its door)"; }
    if (state == c_cellLoose) { return "LOOSE"; }
    if (state == c_cellReturning) { return "returning"; }
    return "?";
}

void Debug_ReportCells (int player) {
    unit abno;
    unit door;
    string line;
    int slot;

    if (gv_cellCount == 0) {
        Debug_Say(player, "cont: no abnormality placed ("
                          + IntToString(c_abnoCount) + " have docs)");
        return;
    }

    slot = 0;
    while (slot < gv_cellCount) {
        abno = gvg_cellAbno[slot];
        door = Cont_DoorAt(gvg_cellHome[slot]);

        line = "cell " + IntToString(slot) + " " + gvg_abnoName[AbnoGen_IndexOf(abno)]
               + " [" + Risk_Name(Risk_Of(abno)) + "]"
               + " " + Debug_CellStateName(gvg_cellState[slot])
               + " qlip=" + IntToString(Cont_Counter(abno))
               + " obs=" + IntToString(Cont_ObservationOfPlayer(player, AbnoGen_IndexOf(abno)))
               + "/4 box=" + IntToString(Cont_BoxesOf(player, AbnoGen_IndexOf(abno)))
               + "(next " + IntToString(AbnoGen_ObsCost(AbnoGen_IndexOf(abno),
                     Cont_ObservationOfPlayer(player, AbnoGen_IndexOf(abno)))) + ")";

        if (door == null) {
            line = line + " door=none";
        }
        else if (UnitIsAlive(door)) {
            line = line + " door=up "
                   + IntToString(FixedToInt(
                         UnitGetPropertyFixed(door, c_unitPropLifePercent, true)))
                   + "% strain=" + IntToString(UnitBehaviorCount(door, c_doorStrainBuff));
        }
        else {
            line = line + " door=DOWN";
        }

        if (Melt_IsHeld(slot)) {
            line = line + " melt=HELD";
        }
        else if (Melt_IsFlagged(slot)) {
            line = line + " melt=NAMED " + IntToString(FixedToInt(Melt_SecondsLeft(slot))) + "s";
        }

        Debug_Say(player, line);
        slot = slot + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// -diff [easy|normal|hard|brutal]
//
// Stands in for the lobby dropdown. Prints the whole table, because the point of
// per-player difficulty is that the settings differ, and a readout that only
// showed yours would make that impossible to check.
//--------------------------------------------------------------------------------------------------
void Debug_Difficulty (int player, string word) {
    int level;
    int other;

    level = Diff_FromWord(word);
    if (word != "" && level < 0) {
        Debug_Say(player, "diff: want casual, normal, hard or brutal");
        return;
    }
    if (level >= 0) {
        Diff_SetOf(player, level);
        // Immediately. A debug command exists to put the game into a state so
        // it can be looked at, and one that changed a setting while leaving
        // everything derived from it at the old value would be testing a
        // situation that cannot occur in a real game.
        Energy_Retarget();
    }

    // The mean, and what hangs off it. Printed first because it is the thing
    // that changed when somebody typed this, and it is not visible from any one
    // player's row.
    Debug_Say(player, "table = " + Diff_GlobalName()
                      + "  ordeal cap " + Diff_OrdealName(Diff_OrdealCap())
                      + "  energy " + IntToString(gv_energy)
                      + "/" + IntToString(gv_energyGoal));

    other = 1;
    while (other <= 15) {
        if (Slot_IsTablePlayer(other)) {
            Debug_Say(player, "diff p" + IntToString(other) + " = "
                              + Diff_NameOf(other)
                              + " (waves " + IntToString(Diff_WavePct(other)) + "%"
                              + ", next " + IntToString(Waves_SizeFor(other)) + ")"
                              + "  dept=" + Dept_NameOf(other));
        }
        other = other + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// -melt [now]
//
// The clock, and a way to make it fire without waiting out the countdown.
//
// Prints the owner of every cell as well, because ownership is spatial -- panel
// first, nearest core second -- and a cell that silently belongs to nobody is
// a cell that is never named, which looks exactly like a broken meltdown.
//--------------------------------------------------------------------------------------------------
void Debug_Meltdown (int player, string word) {
    int slot;
    int owner;
    string line;

    if (StringEqual(word, "now", false)) {
        Melt_Advance();
    }

    Debug_Say(player, "meltdown level " + IntToString(Melt_Level())
                      + "  next round in " + IntToString(FixedToInt(Melt_SecondsToRound())) + "s"
                      + "  up to " + IntToString(Melt_Targets()) + " outstanding per player"
                      + "  answered=" + IntToString(Melt_AnsweredBy(player))
                      + " missed=" + IntToString(Melt_MissedBy(player)));

    slot = 0;
    while (slot < gv_cellCount) {
        owner = Melt_OwnerOf(slot);
        line = "  cell " + IntToString(slot) + " "
               + gvg_abnoName[AbnoGen_IndexOf(gvg_cellAbno[slot])] + " owner=";
        if (owner == 0) {
            line = line + "NOBODY (no panel, no core)";
        }
        else {
            line = line + IntToString(owner);
        }
        if (Melt_IsHeld(slot)) {
            line = line + " HELD (a work is still running)";
        }
        else if (Melt_IsFlagged(slot)) {
            line = line + " NAMED " + IntToString(FixedToInt(Melt_SecondsLeft(slot))) + "s left";
        }
        Debug_Say(player, line);
        slot = slot + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// -breach [slot]
//
// Drives the decision the meltdown clock will drive later: the abnormality
// decides to leave. It still has to get through its own door, which is the part
// worth watching.
//--------------------------------------------------------------------------------------------------
void Debug_Breach (int player, string slotWord) {
    int slot;

    if (gv_cellCount == 0) {
        Debug_Say(player, "breach: nothing to let out");
        return;
    }

    slot = Debug_Int(slotWord, 0);
    if (slot < 0 || slot >= gv_cellCount) {
        Debug_Say(player, "breach: slot 0.." + IntToString(gv_cellCount - 1));
        return;
    }

    Cont_BeginEscape(gvg_cellAbno[slot]);
    Debug_ReportCells(player);
}

//--------------------------------------------------------------------------------------------------
// -obs <slot>
//
// Buys the next section of that abnormality's encyclopedia with the boxes this
// player took out of it. Stands in for the panel's buttons, which cannot exist
// as a generic unit -- see the module note in 13_containment.
//--------------------------------------------------------------------------------------------------
void Debug_Observe (int player, string word) {
    int slot;
    int index;

    slot = Debug_Int(word, -1);
    if (slot < 0 || slot >= gv_cellCount) {
        Debug_Say(player, "obs: want a slot 0.." + IntToString(gv_cellCount - 1));
        return;
    }

    index = AbnoGen_IndexOf(gvg_cellAbno[slot]);
    if (!Cont_Observe(player, index)) {
        Debug_Say(player, "obs: not enough boxes, or nothing left to learn");
    }
    Debug_ReportCells(player);
}

//--------------------------------------------------------------------------------------------------
// -sp <n>
//
// Signed, so -sp -30 is how panic gets tested without waiting for thirty failed
// boxes.
//--------------------------------------------------------------------------------------------------
void Debug_SP (int player, string word) {
    unitgroup mine;
    int count;
    int i;

    mine = Debug_TargetEmployees(player);
    count = UnitGroupCount(mine, c_unitCountAlive);
    i = 1;
    while (i <= count) {
        SP_Add(UnitGroupUnit(mine, i), Debug_Int(word, 0));
        i = i + 1;
    }
    Debug_ReportEmployees(player);
}

//--------------------------------------------------------------------------------------------------
// -work <inst|insi|atta|repr>
//
// Sets what the next employee sent to a door will do. Sending is the game's own
// right-click; there is no order UI yet and this stands in for the part of it
// that chooses.
//--------------------------------------------------------------------------------------------------
int Debug_WorkFromWord (string word) {
    if (StringEqual(word, "inst", false) || StringEqual(word, "i", false)) {
        return c_workInstinct;
    }
    if (StringEqual(word, "insi", false) || StringEqual(word, "n", false)) {
        return c_workInsight;
    }
    if (StringEqual(word, "atta", false) || StringEqual(word, "a", false)) {
        return c_workAttachment;
    }
    if (StringEqual(word, "repr", false) || StringEqual(word, "r", false)) {
        return c_workRepression;
    }
    return -1;
}

void Debug_Work (int player, string word) {
    unit abno;
    int work;
    int slot;
    string line;

    work = Debug_WorkFromWord(word);
    if (work >= 0) {
        Work_SetDefault(player, work);
    }

    Debug_Say(player, "work: sending an employee to a door does "
                      + Work_Name(Work_DefaultOf(player))
                      + " (inst|insi|atta|repr)");

    // The odds for that work against each abnormality, at this player's
    // employees' current level in the matching stat. This is the whole reason
    // to choose one work over another, so it should not need a wiki open.
    slot = 0;
    while (slot < gv_cellCount) {
        abno = gvg_cellAbno[slot];
        // The cost of being wrong belongs next to the odds of being wrong. On
        // one abnormality a missed box is a bad afternoon; on another it is a
        // funeral, and that is not visible from a percentage.
        line = "  " + gvg_abnoName[AbnoGen_IndexOf(abno)]
               + " [miss: " + AbnoGen_DmgText(AbnoGen_IndexOf(abno)) + "]:";
        work = 0;
        while (work < c_workCount) {
            line = line + " " + StringSub(Work_Name(work), 1, 4) + "=";
            if (UnitGroupCount(Emp_Of(player), c_unitCountAlive) > 0) {
                line = line + IntToString(AbnoGen_Pref(
                    AbnoGen_IndexOf(abno), work,
                    Emp_StatLevel(UnitGroupUnit(Emp_Of(player), 1), Work_Stat(work))))
                    + "%";
            }
            else {
                line = line + IntToString(AbnoGen_Pref(AbnoGen_IndexOf(abno), work, 1))
                       + "%@I";
            }
            work = work + 1;
        }
        Debug_Say(player, line);
        slot = slot + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// -energy
//--------------------------------------------------------------------------------------------------
void Debug_Energy (int player, string word) {
    if (StringEqual(word, "submit", false)) {
        if (Energy_CanSubmit()) {
            Energy_Submit(player);
        }
        else {
            Debug_Say(player, "energy: not enough yet");
        }
        return;
    }
    if (word != "") {
        Energy_Add(Debug_Int(word, 0));
    }
    // Galaxy has no conditional expression, so this is two statements.
    if (Energy_CanSubmit()) {
        Debug_Say(player, "energy " + IntToString(gv_energy) + "/"
                          + IntToString(gv_energyGoal) + "  -- -energy submit to end it");
        return;
    }
    Debug_Say(player, "energy " + IntToString(gv_energy) + "/" + IntToString(gv_energyGoal));
}

//--------------------------------------------------------------------------------------------------
// -qlip <slot> <n>
//
// The counter without the thing that moves it, since the thing that moves it is
// the meltdown clock and work results, neither of which exists.
//--------------------------------------------------------------------------------------------------
void Debug_SetCounter (int player, string slotWord, string valueWord) {
    int slot;

    slot = Debug_Int(slotWord, -1);
    if (slot < 0 || slot >= gv_cellCount) {
        Debug_Say(player, "qlip: want a slot 0.." + IntToString(gv_cellCount - 1));
        return;
    }

    Cont_SetCounter(gvg_cellAbno[slot], Debug_Int(valueWord, 0));
    Debug_ReportCells(player);
}

//--------------------------------------------------------------------------------------------------
// -emp spawn [n]
//--------------------------------------------------------------------------------------------------
void Debug_SpawnEmployees (int player, int howMany) {
    if (c_typesEmpCount == 0) {
        Debug_Say(player, "emp: no Lob_Emp_* unit type is authored");
        return;
    }
    if (howMany < 1) {
        howMany = 1;
    }

    UnitCreate(howMany, gvg_typesEmp[0], c_unitCreateIgnorePlacement,
               player, Debug_SpawnPoint(player), 270.0);
    Debug_Say(player, "emp: spawned " + IntToString(howMany) + " " + gvg_typesEmp[0]);
}

//--------------------------------------------------------------------------------------------------
// -stat <fort|prud|temp|just|all> <value>
//
// A leading + or - on the value makes it relative, which is the only way to
// exercise Emp_StatAdd's signed path -- the one Training Team's "push a stat
// back down" will use.
//--------------------------------------------------------------------------------------------------
void Debug_SetStat (int player, string whichWord, string valueWord) {
    unitgroup mine;
    unit who;
    int which;
    int value;
    int count;
    int i;
    int stat;
    bool relative;
    string firstChar;

    which = Debug_StatFromWord(whichWord);
    if (which == c_debugStatBad) {
        Debug_Say(player, "stat: want fort|prud|temp|just|all");
        return;
    }
    if (valueWord == "") {
        Debug_Say(player, "stat: want a value, or +n / -n to move it");
        return;
    }

    firstChar = StringSub(valueWord, 1, 1);
    relative = firstChar == "+" || firstChar == "-";
    if (firstChar == "+") {
        // StringToInt does not have to know what a leading + means.
        valueWord = StringSub(valueWord, 2, StringLength(valueWord));
    }
    value = Debug_Int(valueWord, 0);

    mine = Debug_TargetEmployees(player);
    count = UnitGroupCount(mine, c_unitCountAlive);

    i = 1;
    while (i <= count) {
        who = UnitGroupUnit(mine, i);
        stat = 0;
        while (stat < c_statCount) {
            if (which == c_debugStatAll || which == stat) {
                if (relative) {
                    Emp_StatAdd(who, stat, value);
                }
                else {
                    Emp_StatSet(who, stat, value);
                }
            }
            stat = stat + 1;
        }
        Emp_SyncRank(who);
        i = i + 1;
    }

    Debug_ReportEmployees(player);
}

//--------------------------------------------------------------------------------------------------
// The command reference, in the help panel rather than in chat.
//
// Placeholders are written NAME and VALUE rather than <name> and <value>, and
// that is not a style preference. SC2 parses < > in displayed text as markup:
// <s> is the font style tag, and a style tag with no val asks for the style
// named "", which is where "TextError: 无法找到字体样式[]" came from. The old
// chat help printed "-stat <s> <v>", so that error fired every time somebody
// typed -help. Any angle bracket in text that reaches a player has to be
// escaped or avoided.
//
// It used to print itself into the chat window, and it had quietly stopped
// being a reference: the list outgrew the panel, so it scrolled its own top
// off, and a list you can only read the bottom of is worse than no list. The
// help panel is paged, scrollable and already bound to F12, and it is where a
// player looks for "what can I do".
//
// The descriptions say what the mechanic is rather than only what the syntax
// is, because there is room for that here and it is what somebody reading this
// actually wants. Half of these commands stand in for a system that does not
// exist yet, and which one is which is worth knowing.
//
// Added once at init, to everybody. Nothing removes them; the panel is not a
// place state lives.
//--------------------------------------------------------------------------------------------------
void Debug_Tip (string title, string body, string icon) {
    HelpPanelAddTip(PlayerGroupAll(), StringToText(title), StringToText(body),
                    StringToText(""), icon);
}

void Debug_BuildHelp () {
    Debug_Tip(
        "Debug console",
        "Type these into chat. Everything here is a test harness: it drives a "
        + "mechanic by hand so it can be watched before the system that will "
        + "drive it for real exists.<n/><n/>"
        + "Nothing here reaches anything a player does not already own.",
        "Assets\\Textures\\btn-ability-terran-battlefieldawareness.dds");

    Debug_Tip(
        "Employees",
        "<c val=\"ffff8a\">-emp</c>  the selected employees: four stats, the level "
        + "each lands on, their sum, the rank that sum buys, and SP.<n/>"
        + "<c val=\"ffff8a\">-emp spawn [n]</c>  spawn n at your character.<n/>"
        + "<c val=\"ffff8a\">-stat NAME VALUE</c>  set a stat. s is fort, prud, temp, just or all.<n/>"
        + "<c val=\"ffff8a\">-stat NAME +5</c>  move it instead of setting it; negatives work.<n/>"
        + "<c val=\"ffff8a\">-sp N</c>  move SP. -sp -30 is how panic gets tested.<n/><n/>"
        + "Rank is the SUM of the four stat levels, not the lowest, so a "
        + "three-stat specialist with one stat left deliberately low is still "
        + "rank V. Abnormalities that require a stat to stay BELOW some value "
        + "depend on that.",
        "Assets\\Textures\\btn-upgrade-terran-infantryarmorlevel1.dds");

    Debug_Tip(
        "Containment",
        "<c val=\"ffff8a\">-cont</c>  every cell: grade, state, Qliphoth counter, "
        + "observation, and what its door is doing.<n/>"
        + "<c val=\"ffff8a\">-breach [slot]</c>  that abnormality decides to leave. It "
        + "still has to get through its own door, which is the part worth watching.<n/>"
        + "<c val=\"ffff8a\">-qlip SLOT N</c>  set a Qliphoth counter.<n/>"
        + "<c val=\"ffff8a\">-obs SLOT</c>  buy the next encyclopedia section with the "
        + "PE-Boxes taken out of that abnormality.<n/><n/>"
        + "Suppression is defeat, not death: a beaten abnormality goes home, its "
        + "counter resets and its door comes back whole. A breach costs "
        + "employees, time and everybody's attention, and never a slot.",
        "Assets\\Textures\\btn-ability-terran-holdfire.dds");

    Debug_Tip(
        "Work",
        "Select an employee, press Work, click a containment door. One second of "
        + "casting, then the boxes start.<n/><n/>"
        + "<c val=\"ffff8a\">-work TYPE</c>  what the next one will do: inst, insi, atta "
        + "or repr. Prints each abnormality's odds for all four at your "
        + "employees' current levels, so the choice needs no wiki.<n/><n/>"
        + "One roll per box. The chance is keyed to the LEVEL of the stat that "
        + "work uses, so 30 and 44 of a stat are the same to an abnormality.<n/><n/>"
        + "What a missed box costs is the abnormality's own, printed next to its "
        + "odds. <c val=\"ffff8a\">White</c> is the mind and shows nowhere until "
        + "the person breaks. <c val=\"ffff8a\">Red</c> is the body. "
        + "<c val=\"ffff8a\">Black</c> is both, in full. "
        + "<c val=\"ffff8a\">Pale</c> is a percentage of maximum life -- and "
        + "since Fortitude IS maximum life, it is the one an employee cannot "
        + "outgrow. Employees do not go down; they die.",
        "Assets\\Textures\\btn-upgrade-terran-infantryweaponslevel1.dds");

    Debug_Tip(
        "Meltdown",
        "<c val=\"ffff8a\">-melt</c>  the clock, and who owns each cell.<n/>"
        + "<c val=\"ffff8a\">-melt now</c>  start the next round immediately.<n/><n/>"
        + "Every 60 seconds a meltdown names cells in each player's own sector, "
        + "and a named cell has 60 seconds for a work to BEGIN on it. Begin, not "
        + "finish: what it asks is that somebody was sent. A cell that is missed "
        + "has its Qliphoth counter set to zero, not reduced, and the table "
        + "loses a share of the energy pool.<n/><n/>"
        + "A cell that was already busy when it got named is HELD -- it does not "
        + "start counting until that work ends, however it ends. The employee "
        + "inside cannot be sent again, so the window would not be a window. The "
        + "work in flight does not answer the meltdown either; when it ends, "
        + "somebody still has to go.<n/><n/>"
        + "The clock is shared but the named cells are yours. A neighbour who "
        + "ignores theirs breaches their own abnormality, and what reaches you "
        + "is a fight -- never a cut to your income or your employees.",
        "Assets\\Textures\\btn-ability-terran-nuclearstrike.dds");

    Debug_Tip(
        "Energy, and how this ends",
        "<c val=\"ffff8a\">-energy</c>  the meter.  <c val=\"ffff8a\">-energy N</c>  add to it.  "
        + "<c val=\"ffff8a\">-energy submit</c>  end the game.<n/><n/>"
        + "Every box pays twice: once into your own stock for that one "
        + "abnormality's encyclopedia, and the same amount again into a pool the "
        + "whole table shares. Filling the pool is the win condition, so studying "
        + "abnormalities and winning are the same activity.<n/><n/>"
        + "Nothing is ever spent out of the pool and nobody's rate depends on "
        + "anybody else's. It is a scoreboard, not a wallet.",
        "Assets\\Textures\\btn-ability-terran-stimpack-color.dds");

    Debug_Tip(
        "Difficulty",
        "<c val=\"ffff8a\">-diff</c>  the whole table's settings.<n/>"
        + "<c val=\"ffff8a\">-diff casual|normal|hard|brutal</c>  set yours.<n/><n/>"
        + "Difficulty is PER PLAYER and sizes only your own waves, so a novice "
        + "can sit in a lobby of veterans on Casual and still be learning the "
        + "same game. It is not a handicap anybody else pays for -- fewer zerg "
        + "spawn in that sector, so fewer leak out of it into yours.<n/><n/>"
        + "Two things are shared and read the table's MEAN difficulty instead: "
        + "the energy target, and the worst Ordeal that can be dealt (Dawn, "
        + "Noon, Dusk, Midnight -- one per difficulty). The mean and not the "
        + "highest, so one player on Brutal cannot pull five others into "
        + "Midnight.<n/><n/>"
        + "Scaling the target is what keeps a personal setting honest against a "
        + "shared objective: Casual is a genuinely smaller game, not a discount "
        + "on a fixed one.<n/><n/>"
        + "This stands in for a lobby dropdown that does not exist yet; it reads "
        + "a per-player game attribute and answers Normal until one is created.",
        "Assets\\Textures\\btn-ability-terran-scannersweep.dds");

    Debug_Tip(
        "The world",
        "<c val=\"ffff8a\">-status</c>  debris, ore, power, devices, sector, energy.<n/>"
        + "<c val=\"ffff8a\">-scan</c>  what the generated object tables can actually see.<n/><n/>"
        + "If -scan shows a type count above zero next to a group count of zero, "
        + "the build did not run after the last editor save.",
        "Assets\\Textures\\btn-ability-terran-battlefieldawareness.dds");
}

void Debug_Help (int player) {
    Debug_Say(player, "the command list is in the help panel -- press F12");
}

bool Debug_Chat_Func (bool testConds, bool runActions) {
    string message;
    string command;
    int player;

    if (!runActions) {
        return true;
    }

    player = EventPlayer();
    message = EventChatMessage(false);

    // The event matches loosely, so a message that merely contains a hyphen
    // gets here too. A command has to start with one.
    if (StringSub(message, 1, 1) != c_debugPrefix) {
        return true;
    }

    command = StringWord(message, 1);

    if (StringEqual(command, "-help", false)) {
        Debug_Help(player);
    }
    else if (StringEqual(command, "-emp", false)) {
        if (StringEqual(StringWord(message, 2), "spawn", false)) {
            Debug_SpawnEmployees(player, Debug_Int(StringWord(message, 3), 1));
        }
        else {
            Debug_ReportEmployees(player);
        }
    }
    else if (StringEqual(command, "-stat", false)) {
        Debug_SetStat(player, StringWord(message, 2), StringWord(message, 3));
    }
    else if (StringEqual(command, "-rank", false)) {
        Emp_Tick_Func(false, true);
        Debug_ReportEmployees(player);
    }
    else if (StringEqual(command, "-status", false)) {
        Debug_Say(player, Economy_StatusLine(player));
    }
    else if (StringEqual(command, "-scan", false)) {
        Debug_Say(player, Registry_ScanLine());
    }
    else if (StringEqual(command, "-cont", false)) {
        Debug_ReportCells(player);
    }
    else if (StringEqual(command, "-breach", false)) {
        Debug_Breach(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-obs", false)) {
        Debug_Observe(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-sp", false)) {
        Debug_SP(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-work", false)) {
        Debug_Work(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-energy", false)) {
        Debug_Energy(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-diff", false)) {
        Debug_Difficulty(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-melt", false)) {
        Debug_Meltdown(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-qlip", false)) {
        Debug_SetCounter(player, StringWord(message, 2), StringWord(message, 3));
    }
    return true;
}

void Debug_Init () {
    int player;

    Debug_BuildHelp();

    gt_debugChat = TriggerCreate("Debug_Chat_Func");
    player = 1;
    while (player <= 15) {
        TriggerAddEventChatMessage(gt_debugChat, player, c_debugPrefix, false);
        player = player + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// Map Initialization
//--------------------------------------------------------------------------------------------------
void InitMap () {
    libNtve_InitLib();
    Difficulty_Init();
    AbnoGen_Init();
    ObjectsGen_Init();
    Sector_Init();
    Registry_Init();
    Employee_Init();
    Departments_Init();
    Energy_Init();
    Containment_Init();
    Meltdown_Init();
    Work_Init();
    Hero_Init();
    Devices_Init();
    Clearing_Init();
    Workers_Init();
    Economy_Init();
    Waves_Init();
    Debug_Init();
}
