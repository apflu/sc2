//--------------------------------------------------------------------------------------------------
// src/galaxy/06_risk.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Risk levels.
//
// The five Lobotomy risk grades are five stock unit attributes. Nothing is
// computed or stored: an abnormality's grade is one checkbox on its CUnit, and
// asking for it is a native call against the unit type.
//
//     Zayin  = Biological
//     Teth   = Light
//     HE     = Armored
//     WAW    = Psionic
//     Aleph  = User1        (the editor labels this slot "Map Object")
//
// The attribute names are renamed in the text editor, so the unit panel, the
// tooltip and the damage-bonus lines all read "HE" rather than "Armored"
// without a line of script. Information Team lv2 wants an overhead readout of
// exactly this, and Control Team lv2/lv3 gate cross-department work on "below
// HE" / "below Aleph"; both are Risk_Of and a comparison.
//
// The cost of the reuse is that these five attributes now mean only this.
// Anything of ours that is not an abnormality must carry none of them, or it
// reads as a grade it does not have -- our devices were Armored and our
// employees were Light + Biological, and both had to come off.
//
// And it is most of the budget. The attribute set is closed at thirteen and the
// engine will not take a fourteenth: Light, Armored, Biological, Mechanical,
// Robotic, Psionic, Massive, Structure, Hover, Heroic, Summoned, User1, MapBoss.
// There is no User2. Five are spent here, Mechanical and Structure are in use,
// and every one of the rest already means something to stock abilities and
// filters. So this is the last tag that goes in an attribute; anything else we
// need to say about a unit type has to find another home.
//
// An attribute is also a bare flag with no payload, so nothing that needs a
// value can live here either.
//
// An unrated unit is c_riskNone, which is not the same as "Unknown" in the
// Information Team sense. Unknown is about what a player has observed; this is
// about what the unit is.
//--------------------------------------------------------------------------------------------------

const int c_riskNone = -1;
const int c_riskZayin = 0;
const int c_riskTeth = 1;
const int c_riskHE = 2;
const int c_riskWAW = 3;
const int c_riskAleph = 4;
const int c_riskCount = 5;

//--------------------------------------------------------------------------------------------------
// The attribute a grade is stored in.
//--------------------------------------------------------------------------------------------------
int Risk_Attribute (int level) {
    if (level == c_riskZayin) { return c_unitAttributeBiological; }
    if (level == c_riskTeth) { return c_unitAttributeLight; }
    if (level == c_riskHE) { return c_unitAttributeArmored; }
    if (level == c_riskWAW) { return c_unitAttributePsionic; }
    if (level == c_riskAleph) { return c_unitAttributeUser1; }
    return c_unitAttributeNone;
}

string Risk_Name (int level) {
    if (level == c_riskZayin) { return "Zayin"; }
    if (level == c_riskTeth) { return "Teth"; }
    if (level == c_riskHE) { return "HE"; }
    if (level == c_riskWAW) { return "WAW"; }
    if (level == c_riskAleph) { return "Aleph"; }
    return "";
}

//--------------------------------------------------------------------------------------------------
// The same five for a PLAYER to read.
//
// Keyed rather than returned as English even though the five are transliterated
// Hebrew letters and most translations keep them: the grade also appears as a
// renamed unit attribute in the text editor, and a message that spelt it out
// itself could drift from the panel that shows it. One name, one place.
//--------------------------------------------------------------------------------------------------
text Risk_NameText (int level) {
    if (level == c_riskZayin) { return Msg("Lob/Risk/Zayin"); }
    if (level == c_riskTeth) { return Msg("Lob/Risk/Teth"); }
    if (level == c_riskHE) { return Msg("Lob/Risk/HE"); }
    if (level == c_riskWAW) { return Msg("Lob/Risk/WAW"); }
    if (level == c_riskAleph) { return Msg("Lob/Risk/Aleph"); }
    return StringToText("");
}

//--------------------------------------------------------------------------------------------------
// A unit type's grade, or c_riskNone.
//
// Searched downwards so that a unit mistakenly carrying two grades reads as the
// higher one. Being told something is more dangerous than it is fails safe;
// being told it is less does not.
//--------------------------------------------------------------------------------------------------
int Risk_OfType (string unitType) {
    int level;

    level = c_riskAleph;
    while (level >= c_riskZayin) {
        if (UnitTypeTestAttribute(unitType, Risk_Attribute(level))) {
            return level;
        }
        level = level - 1;
    }
    return c_riskNone;
}

int Risk_Of (unit which) {
    if (which == null) {
        return c_riskNone;
    }
    return Risk_OfType(UnitGetType(which));
}

//--------------------------------------------------------------------------------------------------
// The containment-permission test, in the form the department doc states it:
// "below HE" is Risk_AtMost(u, c_riskTeth).
//
// Unrated units never pass. A rule written about abnormalities should not
// quietly also apply to a crate.
//--------------------------------------------------------------------------------------------------
bool Risk_AtMost (unit which, int level) {
    int actual;

    actual = Risk_Of(which);
    return actual != c_riskNone && actual <= level;
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/07_buffs.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Conditional buffs.
//
// The one primitive behind every effect that has to be able to stop.
//
// SC2 upgrades do not unwind. The level counter can be decremented -- Blizzard
// does it for flag-only upgrades -- but the EffectArray data modifications an
// upgrade applies are not reverted by taking the level away, and nothing in the
// stock data relies on them being. So an upgrade is the right home for a
// permanent fact and the wrong home for anything conditional.
//
// That splits department effects in two, and the split is a placement decision
// rather than a label on the upgrade:
//
//   Never turns off  -> EffectArray on the CUpgrade. No script at all.
//   Can turn off     -> a CBehaviorBuff, applied and removed through here.
//
// Baseline 7.3 needs the second kind: while a player's inner layer is lost the
// effects that run on installations stop, and the pure numbers keep working.
// Anything that has to obey that rule is a behavior, and the upgrade beside it
// is only the record that it was bought.
//
// Applying and removing rather than leaving it on also means the buff icon on
// the unit is an honest readout of what is actually helping right now.
//--------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
// Brings one unit's buff into line with whether it should have it.
//--------------------------------------------------------------------------------------------------
void Buffs_Set (unit who, string behaviorId, bool wanted) {
    bool held;

    if (who == null || !UnitIsAlive(who)) {
        return;
    }

    held = UnitHasBehavior2(who, behaviorId);
    if (wanted && !held) {
        UnitBehaviorAdd(who, behaviorId, who, 1);
    }
    else if (!wanted && held) {
        UnitBehaviorRemove(who, behaviorId, 1);
    }
}

//--------------------------------------------------------------------------------------------------
// The same for a whole group, where every member gets the same answer.
//--------------------------------------------------------------------------------------------------
void Buffs_SetGroup (unitgroup who, string behaviorId, bool wanted) {
    int count;
    int i;

    count = UnitGroupCount(who, c_unitCountAlive);
    i = 1;
    while (i <= count) {
        Buffs_Set(UnitGroupUnit(who, i), behaviorId, wanted);
        i = i + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/08_downable.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Things that answer a killing blow by going offline instead of dying.
//
// Devices do it (baseline 4.5) and the rest hall core does it (baseline 3.2,
// losing the inner layer is reversible), and there will be more. The pattern is
// always the same: a fatal hit swaps the unit for its Down counterpart, and
// repairing that back to full swaps it in return.
//
// The type-name convention carries the pairing: Lob_<Thing>_<Variant> against
// Lob_<Thing>Down_<Variant>. State is the first segment rather than a suffix
// on the variant, which is what keeps ObjectsGen_Scan<Thing>() meaning "the
// ones that are working" without any filtering. See docs/dev/authoring-contract.md.
//
// Each system keeps its own trigger and calls in here, rather than this module
// dispatching. Dispatch would need a type table Galaxy cannot walk, and the
// glue per system is three lines.
//--------------------------------------------------------------------------------------------------

// Life a downed thing is born at. Not zero, and low enough that repairing it is
// a visible job rather than a formality.
const fixed c_downedLife = 1.0;

//--------------------------------------------------------------------------------------------------
// Swaps one type prefix for the other, keeping the variant segment.
//--------------------------------------------------------------------------------------------------
string Downable_Retype (string from, string fromPrefix, string toPrefix) {
    return toPrefix + StringSub(from, StringLength(fromPrefix) + 1, StringLength(from));
}

//--------------------------------------------------------------------------------------------------
// Replaces a unit with its counterpart in the other state, in place.
//--------------------------------------------------------------------------------------------------
void Downable_Morph (unit which, string toType, fixed life) {
    point where;
    fixed facing;
    int owner;

    where = UnitGetPosition(which);
    facing = UnitGetFacing(which);
    owner = UnitGetOwner(which);

    // Remove rather than kill: killing would fire the death handlers, and going
    // offline is not a death in any sense the rest of the code means. Removing
    // also frees the footprint before the replacement needs it, though placement
    // is ignored anyway for good measure.
    UnitRemove(which);

    UnitCreate(1, toType, c_unitCreateIgnorePlacement, owner, where, facing);
    UnitSetPropertyFixed(UnitLastCreated(), c_unitPropLife, life);
}

//--------------------------------------------------------------------------------------------------
// Takes the killing blow off a unit and puts its downed counterpart there.
//--------------------------------------------------------------------------------------------------
void Downable_TakeDown (unit victim, string upPrefix, string downPrefix) {
    // Clamp first so the unit cannot die between here and the morph.
    UnitSetPropertyFixed(victim, c_unitPropLife, c_downedLife);
    Downable_Morph(victim,
                   Downable_Retype(UnitGetType(victim), upPrefix, downPrefix),
                   c_downedLife);
}

//--------------------------------------------------------------------------------------------------
// Puts back anything in `down` that has been repaired to full.
//
// Counting down, not up: morphing removes the unit, and a unit group drops units
// that stop existing, so walking forwards would renumber the tail and skip every
// second one that finished repairing on the same tick.
//--------------------------------------------------------------------------------------------------
void Downable_RestoreRepaired (unitgroup down, string downPrefix, string upPrefix) {
    unit which;
    int count;
    int i;

    count = UnitGroupCount(down, c_unitCountAlive);
    i = count;
    while (i >= 1) {
        which = UnitGroupUnit(down, i);
        if (which != null && UnitGetPropertyFixed(which, c_unitPropLifePercent, true) >= 99.0) {
            Downable_Morph(which,
                           Downable_Retype(UnitGetType(which), downPrefix, upPrefix),
                           UnitGetPropertyFixed(which, c_unitPropLifeMax, true));
        }
        i = i - 1;
    }
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/09_sector.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Sectors and the inner layer.
//
// Baseline 3.2 splits every player's sector in two: an outer work face where
// being overrun is only a fight, and an inner core where the economy and the
// department passives live. That split is the structural reason section 1's
// no-punish principle holds -- a neighbour's mistake pushes zerg into your
// outer layer, but only your own failure to hold the inner layer touches what
// you are actually worth.
//
// Two separate things, deliberately not one:
//
//   The core is a unit, Lob_Core_Basic. It answers "is the inner layer still
//   held", it has an owner, and it is what department and fortification
//   upgrades will hang their command card off. Losing it is reversible per 3.2,
//   so it goes down exactly the way a device does, via 18_downable.galaxy.
//
//   The rest hall is a region, drawn in the editor. A rest hall is a room with
//   walls, and no arrangement of circles around a unit is that shape. It is
//   also not fixed: department upgrades are expected to change how far the
//   rest hall reaches, so what the script tests against is a region built at
//   runtime that starts as a copy of the drawn one and can be added to.
//
// Binding is by containment rather than by a name-to-player convention: the
// rest hall region a player owns is the one their core stands in. Renumbering
// players or renaming regions cannot desynchronise that.
//
// Numbered early on purpose. Galaxy needs a declaration before its use and the
// modules concatenate in filename order, so anything other systems query has to
// come before them, whatever order it was written in.
//--------------------------------------------------------------------------------------------------

const string c_coreUpPrefix = "Lob_Core_";
const string c_coreDownPrefix = "Lob_CoreDown_";

// Editor regions whose name starts with this are rest halls.
const string c_restHallRegionPrefix = "resthall";

// Used only when no rest hall region has been drawn yet, so that the system
// works before the editor side lands rather than being inert. A room-shaped
// region should replace it; this is a stand-in, not a fallback worth keeping.
const fixed c_restHallFallbackRadius = 12.0;

const fixed c_sectorPeriod = 1.0;

const string c_restHallBuff = "Lob_RestHall_Recovery";

// One composed rest hall per player slot. Built at init and mutated in place by
// Sector_RestHallExtend, so a department upgrade changes the region rather than
// changing any code that reads it.
region[16] gvg_restHall;

trigger gt_coreFatal;
trigger gt_sectorTick;

//--------------------------------------------------------------------------------------------------
// Whether this player still holds their inner layer.
//
// Asked of the world rather than of a flag, so there is nothing that can drift:
// a held core is a Lob_Core_ unit they own existing, and a lost one is a
// Lob_CoreDown_ unit standing in its place.
//--------------------------------------------------------------------------------------------------
bool Sector_InnerHeld (int player) {
    unitgroup cores;
    unit core;
    int count;
    int i;

    cores = ObjectsGen_ScanCore();
    count = UnitGroupCount(cores, c_unitCountAlive);

    i = 1;
    while (i <= count) {
        core = UnitGroupUnit(cores, i);
        if (core != null && UnitGetOwner(core) == player) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

//--------------------------------------------------------------------------------------------------
// A player's core, held or downed. Null if they have none placed at all.
//--------------------------------------------------------------------------------------------------
unit Sector_AnyCore (int player) {
    unitgroup cores;
    unit core;
    int count;
    int i;

    cores = ObjectsGen_ScanCore();
    UnitGroupAddUnitGroup(cores, ObjectsGen_ScanCoreDown());
    count = UnitGroupCount(cores, c_unitCountAlive);

    i = 1;
    while (i <= count) {
        core = UnitGroupUnit(cores, i);
        if (core != null && UnitGetOwner(core) == player) {
            return core;
        }
        i = i + 1;
    }
    return null;
}

//--------------------------------------------------------------------------------------------------
// Whose sector a point is in.
//
// Answered by the nearest core, held or downed. Sectors are rooms joined by
// corridors rather than tiles on a grid, so there is no region that covers "all
// of player 3's territory" to test against -- but every sector has exactly one
// core at its centre by construction, and nearest-core is the same spatial
// question asked in a way the map can actually answer.
//
// Returns 0 when no core is placed at all, and callers are expected to treat
// that as "nobody" rather than as player 1. A thing belonging to nobody should
// be visibly inert, not silently somebody's.
//--------------------------------------------------------------------------------------------------
int Sector_OwnerNear (point where) {
    unitgroup cores;
    unit core;
    int count;
    int i;
    int best;
    fixed bestDist;
    fixed d;

    cores = ObjectsGen_ScanCore();
    UnitGroupAddUnitGroup(cores, ObjectsGen_ScanCoreDown());
    count = UnitGroupCount(cores, c_unitCountAlive);

    best = 0;
    bestDist = 0.0;
    i = 1;
    while (i <= count) {
        core = UnitGroupUnit(cores, i);
        if (core != null && Slot_IsTablePlayer(UnitGetOwner(core))) {
            d = DistanceBetweenPoints(UnitGetPosition(core), where);
            if (best == 0 || d < bestDist) {
                best = UnitGetOwner(core);
                bestDist = d;
            }
        }
        i = i + 1;
    }
    return best;
}

//--------------------------------------------------------------------------------------------------
// Widens a player's rest hall. This is the hook department upgrades use; the
// region is mutated in place, so everything already testing against it follows
// with no further wiring.
//--------------------------------------------------------------------------------------------------
void Sector_RestHallExtend (int player, region extra) {
    if (player < 1 || player > 15) {
        return;
    }
    RegionAddRegion(gvg_restHall[player], extra);
}

//--------------------------------------------------------------------------------------------------
// Whether a unit is standing in its owner's rest hall, with that rest hall
// still held.
//
// A downed core does not shelter anybody: the room is still there, but the
// thing that made it a rest hall is not. That is the point of 3.2, and it is
// why this asks about the core as well as about the geometry.
//--------------------------------------------------------------------------------------------------
bool Sector_InRestHall (unit which) {
    int owner;

    if (which == null) {
        return false;
    }
    owner = UnitGetOwner(which);
    if (owner < 1 || owner > 15) {
        return false;
    }
    if (!Sector_InnerHeld(owner)) {
        return false;
    }
    return RegionContainsPoint(gvg_restHall[owner], UnitGetPosition(which));
}

//--------------------------------------------------------------------------------------------------
// The inner layer, for the greybox readout.
//--------------------------------------------------------------------------------------------------
string Sector_HeldText (int player) {
    if (Sector_InnerHeld(player)) {
        return "held";
    }
    return "LOST";
}

//--------------------------------------------------------------------------------------------------
// Intercepts the killing blow on a core. Same shape as the device handler.
//--------------------------------------------------------------------------------------------------
bool Sector_CoreFatal_Func (bool testConds, bool runActions) {
    unit victim;

    if (!runActions) {
        return true;
    }

    victim = EventUnit();
    if (!ObjectsGen_IsCore(victim)) {
        return true;
    }

    Downable_TakeDown(victim, c_coreUpPrefix, c_coreDownPrefix);
    UIDisplayMessage(
        PlayerGroupAll(),
        c_messageAreaSubtitle,
        Msg("Lob/Msg/InnerLayerLost")
    );
    return true;
}

//--------------------------------------------------------------------------------------------------
// Restores repaired cores, and keeps rest hall recovery matched to who is
// actually standing in one.
//
// Applied and removed rather than left on, so the buff icon on the unit is an
// honest readout of whether the room is doing anything for them right now.
//--------------------------------------------------------------------------------------------------
bool Sector_Tick_Func (bool testConds, bool runActions) {
    unitgroup people;
    unit who;
    int count;
    int i;

    if (!runActions) {
        return true;
    }

    Downable_RestoreRepaired(ObjectsGen_ScanCoreDown(), c_coreDownPrefix, c_coreUpPrefix);

    // Everyone a rest hall is for. Employees were missing, which is the one
    // group the room exists for -- SCVs and the character were getting it and
    // the people whose SP it is supposed to restore were not.
    people = ObjectsGen_ScanHero();
    UnitGroupAddUnitGroup(people, ObjectsGen_ScanSCV());
    UnitGroupAddUnitGroup(people, ObjectsGen_ScanEmp());
    count = UnitGroupCount(people, c_unitCountAlive);

    i = 1;
    while (i <= count) {
        who = UnitGroupUnit(people, i);
        Buffs_Set(who, c_restHallBuff, Sector_InRestHall(who));
        i = i + 1;
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// Gives each player the drawn region their core stands in, composed into a
// region this module owns so upgrades can widen it later.
//--------------------------------------------------------------------------------------------------
void Sector_BuildRestHalls () {
    unit core;
    region drawn;
    int player;
    int i;
    bool matched;

    player = 1;
    while (player <= 15) {
        gvg_restHall[player] = RegionEmpty();
        core = Sector_AnyCore(player);

        if (core != null) {
            matched = false;
            i = 0;
            while (i < c_regionCount) {
                // Length checked first: a region whose name is shorter than
                // the prefix would otherwise be handed to StringSub with an end
                // index past its last character.
                if (StringLength(gvg_regionNames[i]) >= StringLength(c_restHallRegionPrefix)
                    && StringSub(gvg_regionNames[i], 1, StringLength(c_restHallRegionPrefix))
                       == c_restHallRegionPrefix) {
                    drawn = RegionFromId(gvg_regionIds[i]);
                    if (RegionContainsPoint(drawn, UnitGetPosition(core))) {
                        RegionAddRegion(gvg_restHall[player], drawn);
                        matched = true;
                    }
                }
                i = i + 1;
            }

            if (!matched) {
                RegionAddCircle(gvg_restHall[player], true,
                                UnitGetPosition(core), c_restHallFallbackRadius);
            }
        }
        player = player + 1;
    }
}

void Sector_Init () {
    Sector_BuildRestHalls();

    gt_coreFatal = TriggerCreate("Sector_CoreFatal_Func");
    TriggerAddEventUnitDamaged(gt_coreFatal, null, c_unitDamageTypeAny, c_unitDamageFatal, null);

    gt_sectorTick = TriggerCreate("Sector_Tick_Func");
    TriggerAddEventTimePeriodic(gt_sectorTick, c_sectorPeriod, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/10_registry.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Startup self-check.
//
// There is no registry object to maintain: the generated scan functions in
// 05_objects_gen.galaxy already answer "what is on the map", live, including
// for units spawned at runtime. This module only reports what they see once at
// startup, which is where authoring mistakes show up.
//
// Type counts come from a runtime scan; the group count comes from the build's
// snapshot of Objects. Printing them side by side is deliberate: a nonzero type
// count next to a zero group count means the build did not run after the last
// editor save, which is otherwise an invisible and very confusing state.
//--------------------------------------------------------------------------------------------------

// A function as well as a startup print, so the same check can be repeated on
// demand from the debug console. Startup is when authoring mistakes show up,
// but it is not the only time the answer is worth having -- and until the
// periodic economy readout was taken off the subtitle area, this one was
// usually overwritten before it could be read.
string Registry_ScanLine () {
    return "scan: hero=" + IntToString(UnitGroupCount(ObjectsGen_ScanHero(), c_unitCountAlive))
           + " emp=" + IntToString(UnitGroupCount(ObjectsGen_ScanEmp(), c_unitCountAlive))
           + " abno=" + IntToString(UnitGroupCount(AbnoGen_Scan(), c_unitCountAlive))
           + "/" + IntToString(c_abnoCount) + "known"
           + " debris=" + IntToString(UnitGroupCount(ObjectsGen_ScanDebris(), c_unitCountAlive))
           + " worker=" + IntToString(UnitGroupCount(ObjectsGen_ScanSCV_Worker(), c_unitCountAlive))
           + " miner=" + IntToString(UnitGroupCount(ObjectsGen_ScanSCV_Miner(), c_unitCountAlive))
           + " device=" + IntToString(UnitGroupCount(ObjectsGen_ScanDevice(), c_unitCountAlive))
           + " | group(debris)=" + IntToString(UnitGroupCount(ObjectsGen_Group("debris"), c_unitCountAlive));
}

void Registry_Init () {
    // The debug area, not the subtitle. This is developer text and it was
    // landing on every player's screen at map start; the answer to developer
    // text a player can see is to take it off their screen, not to translate
    // it. -scan prints the same line on demand.
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug,
                     StringToText(Registry_ScanLine()));
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/11_employee.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Employees.
//
// The half of the verb that carries a name. An abnormality on its own is a
// mine with a plot; what makes it an abnormality is that there is a specific
// person you decided to send, and a specific way you told them to work
// (docs/design/agents-and-abnormalities.md 2.1). This module owns that person.
// The cell and the work order are separate modules.
//
// Nothing here stores a stat, and nothing here draws one. Both halves are the
// engine's, and finding out which part of the engine took three tries:
//
//   A stat DISPLAYS as a CBehaviorAttribute. core's InfoPaneHero layout
//   reserves AttributeLabel1..5 down the right of the hero pane to draw
//   exactly these, named from Behavior/Name; MaxPoints caps it, and its
//   per-point Modification is where the stat's effect goes. War3's STR/AGI/INT
//   are this catalog.
//
//   A stat is STORED in that same behavior, through UnitGetAttributePoint and
//   UnitSetAttributePoint. Points are not the behavior's stack count, so
//   UnitBehaviorCount answers 0 no matter what -- but there is a native pair
//   for them, and it lives in natives_missing.galaxy rather than in
//   natives.galaxy, which is why an earlier version of this file routed the
//   number through four stackable carrier buffs instead. Those are gone.
//
//   Rank is one CBehaviorVeterancy. The hero pane's level readout is a sum over
//   every veterancy a unit carries, so a unit with exactly one veterancy shows
//   that veterancy's level and its progress bar -- and rank is itself a sum, so
//   the two agree by construction rather than by being kept in step.
//
// The first attempt made all four stats veterancies. It was not wrong about the
// XP natives -- they really do address a veterancy by name, and four curves on
// one unit really do work -- but four fresh stats then read as "level 4, 0/120"
// on the panel, because the panel was summing them. That aggregate is not an
// obstacle to route around; it is the panel doing its job, and the thing it
// wants to be handed is the rank.
//
// The second attempt read and wrote the attribute behavior with the BEHAVIOR
// natives. It silently did nothing -- the count answered 0 before and after
// every write. The third routed the number through a stackable carrier buff per
// stat, which worked; the fourth is this one, after UnitSetAttributePoint
// turned up in the natives file that natives.galaxy does not include.
//
// What is left for this file is two rules that have no engine-side home:
//
//   The stat thresholds. The same numbers appear on Lob_Rank in BehaviorData
//   -- MinVeterancyXP is an absolute total, not an increment -- so the two
//   tables are literally the same and must be edited together.
//
//   The sum rule. Employee rank is the SUM of the four stat levels, not the
//   minimum -- see Emp_Rank, where the reason is written down.
//
// SP lives here too, because SP is a vital of the same person and Prudence is
// what sets its ceiling -- one more per-point Modification, no script.
//
// SP is the Energy vital. Not a script number with a bar drawn next to it: the
// engine already has a second vital that the unit panel draws, that behaviors
// can modify, and that has max, current and regeneration. Employees cast
// nothing, so it was free, and taking it means the Welfare Team's white rounds
// are a heal effect rather than a special case.
//
// Permanent death needs no code. Nothing respawns an employee, and that is the
// whole of the death penalty; Central Command's replenishment is a separate
// system priced against it.
//--------------------------------------------------------------------------------------------------

const int c_statFortitude = 0;   // 勇气 -- life
const int c_statPrudence = 1;    // 谨慎 -- SP
const int c_statTemperance = 2;  // 自律 -- work speed
const int c_statJustice = 3;     // 正义 -- attack speed
const int c_statCount = 4;

// I II III IV V EX. EX is out of reach at the default cap and is meant to be.
const int c_statLevelCount = 6;

// I II III IV V. Rank stops at V; there is no rank EX.
const int c_rankCount = 5;

// The ceiling on one stat. 99 keeps EX (100) locked behind whatever ends up
// lifting it, which is the only reason the sixth level exists at all. The
// behavior's own MaxPoints is 100, so this is the binding constraint and the
// data side is only there to make EX representable.
const int c_statCapDefault = 99;

// The floor, and it is not decoration. Fortitude IS max life and Prudence IS
// max SP, one point for one, so a stat of zero is a unit with one hit point and
// no mind at all. The floor is what makes "the stat is the vital" safe to say.
//
// It is a floor rather than a starting value because Training Team can push a
// stat DOWN, and the two need the same answer: an employee can be made worse,
// and cannot be made into a corpse by paperwork.
//
// TUNING. Nothing states what a new employee is worth.
const int c_statMin = 20;

const string c_rankBehavior = "Lob_Rank";

const fixed c_empPeriod = 2.0;

// Breaking down is one state with two sets of consequences, so it is two
// behaviors rather than one with a compromise in it. An employee freezes where
// they stand; the player keeps every input and loses their E.G.O and some speed.
const string c_panicBuff = "Lob_Panicked";
const string c_panicBuffHero = "Lob_Panicked_Hero";

string[4] gvg_statBehavior;
string[4] gvg_statName;

// The base/bonus selector on the attribute point natives. Both calls pass the
// same value, so the stat round-trips whichever half of the split this picks;
// the panel shows the total either way. Worth one look in game only if a
// department upgrade ever needs to add points that Training Team cannot take
// back, which is exactly what the other half is for.
const bool c_attrBase = true;

// Absolute points at which each stat level starts.
int[6] gvg_statLevelMin;

// Sum of the four stat levels at which each rank starts. The same numbers are
// on Lob_Rank in BehaviorData.xml.
int[5] gvg_rankMin;

trigger gt_empTick;
trigger gt_empCreated;

string Emp_StatBehavior (int stat) {
    if (stat < 0 || stat >= c_statCount) {
        return "";
    }
    return gvg_statBehavior[stat];
}

string Emp_StatName (int stat) {
    if (stat < 0 || stat >= c_statCount) {
        return "";
    }
    return gvg_statName[stat];
}

//--------------------------------------------------------------------------------------------------
// One stat's value, 0 to the cap.
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// The stat's name for a PLAYER to read.
//
// Not a Lob/ key of its own: it reuses Behavior/Name/Lob_Attr_Fortitude, which
// the data editor already wrote and the unit panel already shows. A message
// that spelt the name out itself would be a second copy free to drift from the
// panel it is describing.
//--------------------------------------------------------------------------------------------------
text Emp_StatNameText (int stat) {
    return StringExternal("Behavior/Name/" + Emp_StatBehavior(stat));
}

int Emp_Stat (unit who, int stat) {
    if (who == null || stat < 0 || stat >= c_statCount) {
        return 0;
    }
    return UnitGetAttributePoint(who, gvg_statBehavior[stat], c_attrBase);
}

//--------------------------------------------------------------------------------------------------
// The ceiling on one stat for one employee.
//
// A function rather than the constant, because the thing that lifts it to 100
// is a department upgrade and this is where it will read it. Until that upgrade
// exists it is the constant, and callers do not have to change when it stops
// being one.
//--------------------------------------------------------------------------------------------------
int Emp_StatCap (unit who) {
    return c_statCapDefault;
}

//--------------------------------------------------------------------------------------------------
// Moves a stat, clamped into [0, cap].
//
// Takes a signed delta on purpose. Training Team's job is "练得更可控", which
// 2.4 spells out as being able to push a stat back down -- that is what turns a
// mistrained employee from ruined into a delay. A separate lowering function
// would be a second place for the clamp to be wrong.
//
// Diffed against what the unit already has rather than applied blind, so a
// caller can ask for an absolute value by passing the difference and get the
// same clamp either way.
//--------------------------------------------------------------------------------------------------
void Emp_StatAdd (unit who, int stat, int delta) {
    int have;
    int want;
    int cap;

    if (who == null || !UnitIsAlive(who) || stat < 0 || stat >= c_statCount) {
        return;
    }

    cap = Emp_StatCap(who);
    have = Emp_Stat(who, stat);
    want = have + delta;
    if (want < c_statMin) {
        want = c_statMin;
    }
    if (want > cap) {
        want = cap;
    }

    if (want != have) {
        UnitSetAttributePoint(who, gvg_statBehavior[stat], c_attrBase, want);
    }
}

void Emp_StatSet (unit who, int stat, int value) {
    Emp_StatAdd(who, stat, value - Emp_Stat(who, stat));
}

//--------------------------------------------------------------------------------------------------
// One stat's level, 1 (I) through 6 (EX).
//--------------------------------------------------------------------------------------------------
int Emp_StatLevel (unit who, int stat) {
    int value;
    int level;
    int i;

    value = Emp_Stat(who, stat);
    level = 1;
    i = 2;
    while (i <= c_statLevelCount) {
        if (value >= gvg_statLevelMin[i - 1]) {
            level = i;
        }
        i = i + 1;
    }
    return level;
}

//--------------------------------------------------------------------------------------------------
// The sum of the four stat levels: 4 at worst, 24 at all-EX. This is what rank
// is computed from and what the experience bar is fed.
//--------------------------------------------------------------------------------------------------
int Emp_LevelSum (unit who) {
    int sum;
    int i;

    sum = 0;
    i = 0;
    while (i < c_statCount) {
        sum = sum + Emp_StatLevel(who, i);
        i = i + 1;
    }
    return sum;
}

//--------------------------------------------------------------------------------------------------
// Employee rank, 1 (I) through 5 (V).
//
// The sum of the four stat levels, and this must not be changed to the minimum.
//
// V requires a sum of 16, and V+V+V+I is 5+5+5+1 = 16: a three-stat specialist
// with one stat left deliberately under 30 is still rank V. That is the whole
// point. A batch of abnormalities require a stat to be no HIGHER than some
// value (O-05-30, F-05-32, T-01-68, F-01-87, O-02-98), and Training Team's
// challenge asks for every employee at rank V. Under a minimum rule, finishing
// that challenge would leave the player with nobody able to work that batch --
// a department's final reward would quietly close a whole class of content.
// Under a sum rule the two do not collide, and "which three do I train" stays a
// real choice.
//
// See docs/design/agents-and-abnormalities.md 2.4.
//--------------------------------------------------------------------------------------------------
int Emp_Rank (unit who) {
    int sum;
    int rank;
    int i;

    sum = Emp_LevelSum(who);

    rank = 1;
    i = 2;
    while (i <= c_rankCount) {
        if (sum >= gvg_rankMin[i - 1]) {
            rank = i;
        }
        i = i + 1;
    }
    return rank;
}

//--------------------------------------------------------------------------------------------------
// Feeds the rank veterancy so the hero pane's level and experience bar read the
// rank and its progress.
//
// Writing the XP is the whole of it: the engine derives the level from the
// running total against Lob_Rank's absolute thresholds, which are the same
// numbers as gvg_rankMin. Both of those facts were measured rather than
// assumed. XP is a running total and not a per-level counter -- an employee
// left at 6 XP stayed at 6 across several promotions -- and levels are 1-based,
// which four fresh veterancies reading as "level 4" established.
//
// No level is written. Setting the XP and then correcting the level would be
// two sources for one number, and the panel disagreeing with Emp_Rank is
// exactly what the -emp readout prints so it can be seen.
//--------------------------------------------------------------------------------------------------
void Emp_SyncRank (unit who) {
    if (who == null || !UnitIsAlive(who)) {
        return;
    }
    UnitXPSetCurrentXP(who, c_rankBehavior, IntToFixed(Emp_LevelSum(who)));
}

//--------------------------------------------------------------------------------------------------
// Brings a new employee up to the floor, and fills them up.
//
// On the creation event rather than on the tick, because between creation and
// this the unit has one hit point: the base LifeMax is 1 so that instant is
// survivable, and Fortitude supplies everything above it.
//
// Filling afterwards is not optional either. Raising a vital's maximum does not
// raise what is currently in it, so an employee seeded but not filled would
// stand there at 1 of 21 life.
//--------------------------------------------------------------------------------------------------
void Emp_Seed (unit who) {
    int stat;

    if (who == null || !UnitIsAlive(who)) {
        return;
    }

    stat = 0;
    while (stat < c_statCount) {
        if (Emp_Stat(who, stat) < c_statMin) {
            UnitSetAttributePoint(who, gvg_statBehavior[stat], c_attrBase, c_statMin);
        }
        stat = stat + 1;
    }

    UnitSetPropertyFixed(who, c_unitPropLife,
                         UnitGetPropertyFixed(who, c_unitPropLifeMax, true));
    UnitSetPropertyFixed(who, c_unitPropEnergy,
                         UnitGetPropertyFixed(who, c_unitPropEnergyMax, true));
    Emp_SyncRank(who);
}

bool Emp_Created_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    if (ObjectsGen_IsEmp(EventUnit())) {
        Emp_Seed(EventUnit());
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// SP.
//
// White damage is damage to the mind. It has no relationship to the health bar,
// which is the point: a work chosen badly costs nothing you can see until the
// person breaks, and that delay is what makes the choice feel like a judgement
// rather than a trade.
//
// Panic is a behavior applied at zero and removed above it, so the state is one
// object anything can test -- the same arrangement as Lob_Contained. Its
// Modification is empty and stays empty: baseline 8's three consequences for a
// broken NPC are strike, flee and refuse orders, and all three are behaviour
// rather than statistics. Work_Tick drops the job, Work_Refusal turns away the
// next one, Emp_Flee walks them home. None of that is a number a buff can hold.
//--------------------------------------------------------------------------------------------------
int Emp_SP (unit who) {
    if (who == null) {
        return 0;
    }
    return FixedToInt(UnitGetPropertyFixed(who, c_unitPropEnergy, true));
}

int Emp_SPMax (unit who) {
    if (who == null) {
        return 0;
    }
    return FixedToInt(UnitGetPropertyFixed(who, c_unitPropEnergyMax, true));
}

string Emp_PanicBuff (unit who) {
    if (ObjectsGen_IsHero(who)) {
        return c_panicBuffHero;
    }
    return c_panicBuff;
}

bool Emp_IsPanicked (unit who) {
    return who != null && UnitHasBehavior2(who, Emp_PanicBuff(who));
}

//--------------------------------------------------------------------------------------------------
// Moves SP, clamped into [0, max]. Signed, so healing and white damage are the
// same call and the clamp has one home.
//--------------------------------------------------------------------------------------------------
void SP_Add (unit who, int delta) {
    int value;
    int cap;

    if (who == null || !UnitIsAlive(who)) {
        return;
    }

    cap = Emp_SPMax(who);
    value = Emp_SP(who) + delta;
    if (value < 0) {
        value = 0;
    }
    if (value > cap) {
        value = cap;
    }
    UnitSetPropertyFixed(who, c_unitPropEnergy, IntToFixed(value));

    // Panic LATCHES. It closes at zero and only opens again at FULL, which is
    // not symmetry for its own sake: the way back up is somebody spending a
    // White E.G.O on you, and a threshold anywhere below the top would let one
    // point of incidental regen put a broken person straight back to work.
    //
    // The asymmetry is also what makes recovery a decision. "Shoot them until
    // the bar is full" is an amount of someone's attention; "shoot them once"
    // would not be.
    if (cap > 0) {
        if (value <= 0 && !Emp_IsPanicked(who)) {
            Buffs_Set(who, Emp_PanicBuff(who), true);
            // Employees stop where they are. The behavior refuses new move
            // orders but does not put down one already being carried out, and a
            // person who breaks mid-walk should not keep walking.
            //
            // Not done to the player: taking an order away from somebody who is
            // holding the mouse is the one thing baseline 8 rules out.
            if (!ObjectsGen_IsHero(who)) {
                UnitIssueOrder(who, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
            }
        }
        else if (value >= cap) {
            Buffs_Set(who, Emp_PanicBuff(who), false);
        }
    }
}

void SP_Damage (unit who, int amount) {
    SP_Add(who, -amount);
}

void SP_Restore (unit who, int amount) {
    SP_Add(who, amount);
}

//--------------------------------------------------------------------------------------------------
// Damage to the body, which for an employee is permanent.
//
// Set rather than dealt. Work damage has no source, no weapon and no direction,
// and it is not supposed to be reduced by armour or reflected by anything --
// routing it through the combat system would attach all three. Zero kills
// outright, because 2.6 has employee death as a real loss and there is no
// downed state for a person.
//--------------------------------------------------------------------------------------------------
void Emp_LifeDamage (unit who, fixed amount) {
    fixed life;

    if (who == null || !UnitIsAlive(who) || amount <= 0.0) {
        return;
    }

    life = UnitGetPropertyFixed(who, c_unitPropLife, true) - amount;
    if (life <= 0.0) {
        UnitKill(who);
        return;
    }
    UnitSetPropertyFixed(who, c_unitPropLife, life);
}

//--------------------------------------------------------------------------------------------------
// Where a hit came from. Not the same axis as Red/White/Black/Pale: the type is
// what it costs, the source is what happened, and the two vary independently --
// a door and a clown can both charge White.
//--------------------------------------------------------------------------------------------------
const int c_dmgFromWork = 0;
const int c_dmgFromCombat = 1;

//--------------------------------------------------------------------------------------------------
// How much of a given kind of damage this employee actually takes, as a
// percent. 100 is unarmoured.
//
// THIS IS WHERE E.G.O ARMOUR LANDS, and it is a seam rather than a system: a
// suit resists some kinds and leaves you MORE open to others, so the number is
// deliberately a percent that may exceed 100 rather than a reduction that
// cannot. One function so that adding equipment later is filling this in, not
// finding every place damage is applied.
//
// It is not a behavior Modification, and that is worth writing down because the
// engine looks like it already has this. It does, almost:
//
//     <DamageTakenFraction index="Melee" value="3"/>
//
// -- real, native, and 3 proves that going ABOVE one is supported. Its index is a
// closed set of damage KINDS, and the objection used to be that a suit resisting
// "Red" by claiming one of them would also resist zerg.
//
// THAT OBJECTION HAS SINCE BEEN CHECKED AND IT DOES NOT HOLD. The set is exactly
// Melee / Ranged / Spell / Splash -- four, against our four -- and the overlap
// with real weapons is only a problem in a map that contains weapons we did not
// write. See docs/dev/damage-channel.md: Kind is very likely the channel, and if
// it is, this function is replaced by DamageTakenFraction rather than filled in.
// Left as a percent until that is decided, because the shape it becomes depends
// on the decision and guessing is how this project once invented a User2
// attribute.
//--------------------------------------------------------------------------------------------------
int Emp_DamageScale (unit who, int type, int source) {
    return 100;
}

//--------------------------------------------------------------------------------------------------
// Where a number becomes something the player can see. Inert on purpose.
//
// THIS IS THE HOOK THE INFORMATION TEAM'S DAMAGE DISPLAY GOES ON.
//
// SP is unit Energy -- Prudence supplies it through VitalMaxArray -- so there IS
// a bar and the engine does draw it. What there is not is a NUMBER, a colour, or
// any hint of which of the four types just charged you; and a blue bar under a
// health bar is a thing most players have been trained by every other RTS to
// read as mana. An employee who took 14 White at a door and an employee who took
// nothing look nearly alike until the moment one of them freezes.
//
// A cost the player cannot attribute is a cost they cannot learn from, and
// learning which abnormality charges what is the whole game.
//
// Called once per hit with the SCALED amount -- once even for Black, whose
// halves are an implementation detail the player should never have to
// reassemble.
//
// It gets the source as well as the type, because the two answer different
// questions and the display will want both: "White 12" says what it cost, and
// "at a door" versus "from that thing over there" says what to do differently
// next time. A number with no origin is a number you can only react to.
//
// Nothing here yet, and that is the point: every path that hurts a person
// already calls it, so switching the display on is filling this function in
// rather than finding the eleven places damage happens.
//--------------------------------------------------------------------------------------------------
void Emp_DamageShown (unit who, int type, int amount, int source) {
}

//--------------------------------------------------------------------------------------------------
// Red / White / Black / Pale, applied. The shared half of two different events.
//
// This is arithmetic and nothing else: it does not know why it was called and
// must not start caring, because the moment it does, the two callers below stop
// being able to diverge. It is private in intent -- work and combat are the
// doors, this is the room behind both.
//
// Pale is a percentage of maximum life rather than a flat amount, so it is
// exactly as dangerous to a veteran as to a new hire. Since Fortitude IS maximum
// life, a flat amount would already have scaled the wrong way -- growing an
// employee would make them immune -- and Pale is the mechanic that says no.
//
// Black charges half to each, so the printed number is what the hit costs in
// total and a player can do the arithmetic where they are standing.
//--------------------------------------------------------------------------------------------------
void Emp_ApplyDamage (unit who, int type, int amount, int source) {
    if (who == null || !UnitIsAlive(who) || amount <= 0) {
        return;
    }

    // Scaled once, before the split, so a suit that halves Black halves both
    // halves of it and a suit that halves Pale halves the percentage. Applying
    // it inside each branch would be four chances to get that wrong.
    amount = amount * Emp_DamageScale(who, type, source) / 100;
    if (amount <= 0) {
        return;
    }

    Emp_DamageShown(who, type, amount, source);

    if (type == c_dmgWhite) {
        SP_Damage(who, amount);
    }
    else if (type == c_dmgRed) {
        Emp_LifeDamage(who, IntToFixed(amount));
    }
    else if (type == c_dmgBlack) {
        // HALF to each, not the full amount twice. The printed number is what
        // the hit costs in total, so a player reading "Black 6" can work out
        // three and three without knowing anything about how it is applied --
        // and that arithmetic being doable in your head at the door is the
        // whole reason to state it this way.
        //
        // Life takes the exact half because it is a fixed; SP is integral and
        // rounds down, which errs toward the resource that is harder to get back.
        Emp_LifeDamage(who, IntToFixed(amount) / 2.0);
        SP_Damage(who, amount / 2);
    }
    else if (type == c_dmgPale) {
        Emp_LifeDamage(who,
                       UnitGetPropertyFixed(who, c_unitPropLifeMax, true)
                       * IntToFixed(amount) / 100.0);
    }
}

//--------------------------------------------------------------------------------------------------
// A missed box, paid in whatever coin that abnormality charges.
//
// The type is the abnormality's, not the work's: the same badly chosen work
// breaks the employee at one door and kills them at another, and that difference
// is most of what distinguishes one abnormality from another at the moment a
// player decides who to send. White alone would have made every wrong answer
// cost the same thing.
//
// This is what happens INSIDE a cell, to somebody who volunteered, as the price
// of a box. Nothing hit them. That is not a flavour note -- it is the reason
// this is a separate function from the one below, and see that one for the rest
// of the argument.
//--------------------------------------------------------------------------------------------------
void Emp_WorkDamage (unit who, int type, int amount) {
    Emp_ApplyDamage(who, type, amount, c_dmgFromWork);
}

//--------------------------------------------------------------------------------------------------
// Something hostile hit them: a breaching abnormality, an Ordeal, whatever the
// swarm turns out to be.
//
// SPLIT FROM WORK DAMAGE ON PURPOSE, and the two arrive at the same arithmetic
// today only by coincidence. They are different events and they are going to
// want different things:
//
//   E.G.O resistance almost certainly does not apply equally to both -- a suit
//   is armour, and a missed box is not something armour is between you and.
//   Emp_DamageScale takes the source for exactly this.
//
//   The Information Team's readout wants to tell them apart. "Your Malkuth crew
//   is bleeding White at the doors" and "something is killing your Malkuth crew"
//   are different problems with different answers, and a display that adds them
//   together tells you neither.
//
//   Work damage is a price the player CHOSE by sending somebody. Combat damage
//   is not. Anything that ever wants to reward or forgive one of those has to be
//   able to name it.
//
// Naming the wide one after the narrow one would have made all of that
// impossible to see: every future reader of Emp_WorkDamage would have had to
// discover that it also meant "a clown exploded".
//--------------------------------------------------------------------------------------------------
void Emp_CombatDamage (unit who, int type, int amount) {
    Emp_ApplyDamage(who, type, amount, c_dmgFromCombat);
}

//--------------------------------------------------------------------------------------------------
// One player's employees.
//
// A scan, not a roster. The units on the map are the roster, so there is no
// list that can drift out of step with who is actually alive -- which is the
// list that matters when the penalty for a mistake is that somebody is gone.
//--------------------------------------------------------------------------------------------------
unitgroup Emp_Of (int player) {
    unitgroup all;
    unitgroup mine;
    unit who;
    int count;
    int i;

    mine = UnitGroupEmpty();
    all = ObjectsGen_ScanEmp();
    count = UnitGroupCount(all, c_unitCountAlive);

    i = 1;
    while (i <= count) {
        who = UnitGroupUnit(all, i);
        if (who != null && UnitGetOwner(who) == player) {
            UnitGroupAdd(mine, who);
        }
        i = i + 1;
    }
    return mine;
}

int Emp_CountOf (int player) {
    return UnitGroupCount(Emp_Of(player), c_unitCountAlive);
}

//--------------------------------------------------------------------------------------------------
// How many of a player's employees are at least this rank.
//
// Training Team's first two tasks are counts of exactly this shape, and its
// challenge is "all of them at V", so the quest layer asks here rather than
// walking employees itself.
//--------------------------------------------------------------------------------------------------
int Emp_CountAtRank (int player, int rank) {
    unitgroup mine;
    unit who;
    int total;
    int count;
    int i;

    mine = Emp_Of(player);
    count = UnitGroupCount(mine, c_unitCountAlive);
    total = 0;

    i = 1;
    while (i <= count) {
        who = UnitGroupUnit(mine, i);
        if (who != null && Emp_Rank(who) >= rank) {
            total = total + 1;
        }
        i = i + 1;
    }
    return total;
}

//--------------------------------------------------------------------------------------------------
// Keeps every employee's rank readout matched to their stats.
//
// A tick rather than a hook on the work result, because a stat can also move
// from a department upgrade, from Training Team pushing it down, and from the
// Training Team core suppression lowering it as the meltdown level rises. One
// place that reconciles beats four places that each remember to.
//
// The stats themselves need nothing here: their points are their display.
//--------------------------------------------------------------------------------------------------
bool Emp_Tick_Func (bool testConds, bool runActions) {
    unitgroup all;
    int count;
    int i;

    if (!runActions) {
        return true;
    }

    all = ObjectsGen_ScanEmp();
    count = UnitGroupCount(all, c_unitCountAlive);

    i = 1;
    while (i <= count) {
        Emp_SyncRank(UnitGroupUnit(all, i));
        // Zero on purpose, so an employee whose Prudence just went up does not
        // become panicked by having a ceiling raised out from under a full bar.
        SP_Add(UnitGroupUnit(all, i), 0);
        i = i + 1;
    }

    // Player characters have SP too and nothing else reconciles it. Their bar
    // moves by regeneration and by whatever ends up spending it, neither of
    // which goes through SP_Add -- so without this pass the latch would only
    // ever be looked at on the frame something called into this module.
    all = ObjectsGen_ScanHero();
    count = UnitGroupCount(all, c_unitCountAlive);
    i = 1;
    while (i <= count) {
        SP_Add(UnitGroupUnit(all, i), 0);
        i = i + 1;
    }
    return true;
}

void Emp_SeedAll () {
    unitgroup all;
    int count;
    int i;

    all = ObjectsGen_ScanEmp();
    count = UnitGroupCount(all, c_unitCountAlive);
    i = 1;
    while (i <= count) {
        Emp_Seed(UnitGroupUnit(all, i));
        i = i + 1;
    }
}

void Employee_Init () {
    gvg_statBehavior[c_statFortitude] = "Lob_Attr_Fortitude";
    gvg_statBehavior[c_statPrudence] = "Lob_Attr_Prudence";
    gvg_statBehavior[c_statTemperance] = "Lob_Attr_Temperance";
    gvg_statBehavior[c_statJustice] = "Lob_Attr_Justice";

    gvg_statName[c_statFortitude] = "Fortitude";
    gvg_statName[c_statPrudence] = "Prudence";
    gvg_statName[c_statTemperance] = "Temperance";
    gvg_statName[c_statJustice] = "Justice";

    // I II III IV V EX
    gvg_statLevelMin[0] = 0;
    gvg_statLevelMin[1] = 30;
    gvg_statLevelMin[2] = 45;
    gvg_statLevelMin[3] = 65;
    gvg_statLevelMin[4] = 85;
    gvg_statLevelMin[5] = 100;

    // I II III IV V, against the sum of the four stat levels. The floor is 4
    // (four stats at I), so rank I covers 4 and 5.
    gvg_rankMin[0] = 0;
    gvg_rankMin[1] = 6;
    gvg_rankMin[2] = 9;
    gvg_rankMin[3] = 12;
    gvg_rankMin[4] = 16;

    Emp_SeedAll();

    gt_empCreated = TriggerCreate("Emp_Created_Func");
    TriggerAddEventUnitCreated(gt_empCreated, null, null, null);

    gt_empTick = TriggerCreate("Emp_Tick_Func");
    TriggerAddEventTimePeriodic(gt_empTick, c_empPeriod, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/12_departments.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Departments.
//
// Upgrades are real CUpgrade entries authored in the data editor, one per
// level, named
//
//     <Sephirot>_Upg<line>_<level>[_Ally]
//
// so Malkuth_Upg2_1 and Malkuth_Upg2_1_Ally are the owner's and the allies'
// version of the same step. That is not a formatting choice; it decides how
// much code there is. Because each level is its own upgrade, most effects are
// EffectArray rows in data -- "Unit,Lob_Hero_Agent,Speed", "Weapon,X,Range" --
// and need no script at all. And because the ally version is a separate
// upgrade rather than a discount applied to the owner's, it can do something
// genuinely different instead of merely less.
//
// So this module names no upgrade and holds no per-upgrade code. It knows the
// shape of the name, which the build reads out of UpgradeData.xml, and it
// implements the rules that are true of every line:
//
//   Ally propagation. Completing a step that has an _Ally twin grants that twin
//   to everybody else. One rule, driven off the table, covering every upgrade
//   the doc describes as "对自身和所有盟友都有效".
//
//   Levels are cumulative by holding, not by counting. A line's level is the
//   highest numbered step the player actually holds, so a step granted out of
//   order still reads correctly.
//
// Suspension while the inner layer is lost (baseline 7.3) needs no marker on
// the upgrade, because it is decided by where the effect is put rather than by
// what the upgrade is labelled. SC2 upgrades do not unwind: the level counter
// can be decremented, but the EffectArray modifications are not taken back. So
// an effect that must be able to stop is a CBehaviorBuff driven through
// 07_buffs.galaxy, and the upgrade next to it is only the record that it was
// bought. An effect that never stops can be EffectArray and needs no script.
//
// That also makes the upgrade cheap to consult, which is the point of using
// them: a trigger asks Dept_Holds and gets an answer without bookkeeping, and
// the research goes through the stock alert and tech tree UI for free.
//--------------------------------------------------------------------------------------------------

const int c_deptNone = -1;
const int c_deptMalkuth = 0;
const int c_deptYesod = 1;
const int c_deptNetzach = 2;
const int c_deptHod = 3;
const int c_deptTiphereth = 4;
const int c_deptChesed = 5;
const int c_deptGeburah = 6;
const int c_deptHokma = 7;
const int c_deptBinah = 8;
const int c_deptCount = 9;

// The four upper departments are contiguous and start at Malkuth, which is what
// lets the placeholder deal round-robin without a table.
const int c_deptAsiyahCount = 4;

// Sephirot tiers, as the doc groups them.
const int c_tierAsiyah = 0;
const int c_tierBriah = 1;
const int c_tierAtziluth = 2;

// Keyed by the Sephirot name, because that is what the upgrade ids are keyed by.
string[9] gvg_deptKey;
int[9] gvg_deptTier;

// The English name, for DEBUG output only. Anything a player can see goes
// through gvg_deptNameKey and src/strings/enUS.txt instead; a localised string
// cannot be turned back into a Galaxy string (there is no TextToString), so the
// developer-facing readouts keep a plain one rather than every debug line
// having to be assembled as text.
string[9] gvg_deptName;

// The string key for the same thing, for anything a player reads.
string[9] gvg_deptNameKey;

int[16] gvg_deptOf;

trigger gt_upgradeChanged;

int Dept_Of (int player) {
    if (player < 1 || player > 15) {
        return c_deptNone;
    }
    return gvg_deptOf[player];
}

void Dept_SetOf (int player, int dept) {
    if (player < 1 || player > 15) {
        return;
    }
    gvg_deptOf[player] = dept;
}

string Dept_NameOf (int player) {
    int dept;

    dept = Dept_Of(player);
    if (dept < 0 || dept >= c_deptCount) {
        return "none";
    }
    return gvg_deptName[dept];
}

//--------------------------------------------------------------------------------------------------
// How many distinct departments are in play.
//
// Baseline 7.1 allows duplicates but wants at least three distinct ones in a
// game. Nothing enforces it yet because there is no selection screen to enforce
// it at; this is the question that screen will ask.
//--------------------------------------------------------------------------------------------------
int Dept_DistinctCount () {
    int player;
    int earlier;
    int total;
    bool duplicate;

    total = 0;
    player = 1;
    while (player <= 15) {
        if (gvg_deptOf[player] >= 0) {
            duplicate = false;
            earlier = 1;
            while (earlier < player) {
                if (gvg_deptOf[earlier] == gvg_deptOf[player]) {
                    duplicate = true;
                }
                earlier = earlier + 1;
            }
            if (!duplicate) {
                total = total + 1;
            }
        }
        player = player + 1;
    }
    return total;
}

//--------------------------------------------------------------------------------------------------
// Whether a player holds a particular step.
//--------------------------------------------------------------------------------------------------
bool Dept_Holds (int player, string upgradeId) {
    return TechTreeUpgradeCount(player, upgradeId, c_techCountCompleteOnly) > 0;
}

//--------------------------------------------------------------------------------------------------
// The level a player has reached on a line, owner's version.
//
// The highest step held rather than a count of steps held, so a step granted
// out of order -- which Central Command's substitution rules will do -- still
// reads as the level it is.
//--------------------------------------------------------------------------------------------------
int Dept_LineLevel (int player, string line) {
    int best;
    int i;

    best = 0;
    i = 0;
    while (i < c_deptUpgradeCount) {
        if (gvg_deptUpgradeLine[i] == line
            && !gvg_deptUpgradeIsAlly[i]
            && gvg_deptUpgradeLevel[i] > best
            && Dept_Holds(player, gvg_deptUpgradeId[i])) {
            best = gvg_deptUpgradeLevel[i];
        }
        i = i + 1;
    }
    return best;
}

//--------------------------------------------------------------------------------------------------
// The level a player has on a line by way of somebody else's generosity.
//--------------------------------------------------------------------------------------------------
int Dept_LineLevelFromAlly (int player, string line) {
    int best;
    int i;

    best = 0;
    i = 0;
    while (i < c_deptUpgradeCount) {
        if (gvg_deptUpgradeLine[i] == line
            && gvg_deptUpgradeIsAlly[i]
            && gvg_deptUpgradeLevel[i] > best
            && Dept_Holds(player, gvg_deptUpgradeId[i])) {
            best = gvg_deptUpgradeLevel[i];
        }
        i = i + 1;
    }
    return best;
}

//--------------------------------------------------------------------------------------------------
// The level of the player's WEAKEST line in their own department.
//
// Information Team 3 is "将本部门所有升级提高至2级", and "all of them at 2" is
// the minimum reading 2. A maximum or a sum would both let three lines at 4 and
// one at 0 pass, which is the opposite of what the task asks for.
//
// Lines are found by prefix, because the upgrade id already carries the
// department: Malkuth_Upg2_1 has line Malkuth_Upg2. Nothing else has to be
// authored to make this work, and a department whose upgrades have not been
// built yet has no lines and reads 0 -- not yet, rather than already done.
//
// Ally-granted steps do not count. The task is about this player's own
// department reaching a level, and a neighbour's generosity is neither.
//--------------------------------------------------------------------------------------------------
int Dept_LowestLineLevel (int player) {
    string prefix;
    int dept;
    int level;
    int lowest;
    int seen;
    int i;

    dept = Dept_Of(player);
    if (dept < 0 || dept >= c_deptCount) {
        return 0;
    }
    prefix = gvg_deptKey[dept] + "_Upg";

    lowest = 0;
    seen = 0;
    i = 0;
    while (i < c_deptUpgradeCount) {
        if (!gvg_deptUpgradeIsAlly[i]
            && StringSub(gvg_deptUpgradeLine[i], 1, StringLength(prefix)) == prefix) {
            level = Dept_LineLevel(player, gvg_deptUpgradeLine[i]);
            if (seen == 0 || level < lowest) {
                lowest = level;
            }
            seen = seen + 1;
        }
        i = i + 1;
    }

    if (seen == 0) {
        return 0;
    }
    return lowest;
}

//--------------------------------------------------------------------------------------------------
// Grants a step, which is how anything other than a research button hands one
// out. Ally propagation happens off the resulting event, not here, so it works
// the same whoever did the granting.
//--------------------------------------------------------------------------------------------------
void Dept_Grant (int player, string upgradeId) {
    TechTreeUpgradeAddLevel(player, upgradeId, 1);
}

//--------------------------------------------------------------------------------------------------
// Ally propagation.
//
// When somebody finishes a step that has an _Ally twin, everybody else gets the
// twin. Reading the twin's name from the generated table rather than building
// it by string concatenation means an upgrade whose ally version was never
// authored simply propagates nothing, instead of granting an id that does not
// exist.
//
// Only positive deltas propagate. A level going down is either an undo or the
// suspension rule arriving later, and neither should hand allies anything.
//--------------------------------------------------------------------------------------------------
bool Dept_UpgradeChanged_Func (bool testConds, bool runActions) {
    string changed;
    string ally;
    int owner;
    int other;
    int i;

    if (!runActions) {
        return true;
    }
    if (EventUpgradeLevelDelta() <= 0) {
        return true;
    }

    changed = EventUpgradeName();
    owner = EventPlayer();

    ally = "";
    i = 0;
    while (i < c_deptUpgradeCount) {
        if (gvg_deptUpgradeId[i] == changed) {
            ally = gvg_deptUpgradeAlly[i];
        }
        i = i + 1;
    }
    if (ally == "") {
        return true;
    }

    other = 1;
    while (other <= 15) {
        if (other != owner && gvg_deptOf[other] != c_deptNone
            && !Dept_Holds(other, ally)) {
            TechTreeUpgradeAddLevel(other, ally, 1);
        }
        other = other + 1;
    }
    return true;
}

void Departments_Init () {
    int player;
    int dealt;

    gvg_deptKey[c_deptMalkuth] = "Malkuth";
    gvg_deptKey[c_deptYesod] = "Yesod";
    gvg_deptKey[c_deptNetzach] = "Netzach";
    gvg_deptKey[c_deptHod] = "Hod";
    gvg_deptKey[c_deptTiphereth] = "Tiphereth";
    gvg_deptKey[c_deptChesed] = "Chesed";
    gvg_deptKey[c_deptGeburah] = "Geburah";
    gvg_deptKey[c_deptHokma] = "Hokma";
    gvg_deptKey[c_deptBinah] = "Binah";

    gvg_deptName[c_deptMalkuth] = "Control";
    gvg_deptName[c_deptYesod] = "Information";
    gvg_deptName[c_deptNetzach] = "Safety";
    gvg_deptName[c_deptHod] = "Training";
    gvg_deptName[c_deptTiphereth] = "Central Command";
    gvg_deptName[c_deptChesed] = "Welfare";
    gvg_deptName[c_deptGeburah] = "Disciplinary";
    gvg_deptName[c_deptHokma] = "Record";
    gvg_deptName[c_deptBinah] = "Extraction";

    // Built from the Sephirot key rather than written out nine more times, so a
    // department cannot end up with a name key that does not match its id.
    player = 0;
    while (player < c_deptCount) {
        gvg_deptNameKey[player] = "Lob/Dept/Name/" + gvg_deptKey[player];
        player = player + 1;
    }

    gvg_deptTier[c_deptMalkuth] = c_tierAsiyah;
    gvg_deptTier[c_deptYesod] = c_tierAsiyah;
    gvg_deptTier[c_deptNetzach] = c_tierAsiyah;
    gvg_deptTier[c_deptHod] = c_tierAsiyah;
    gvg_deptTier[c_deptTiphereth] = c_tierBriah;
    gvg_deptTier[c_deptChesed] = c_tierBriah;
    gvg_deptTier[c_deptGeburah] = c_tierBriah;
    gvg_deptTier[c_deptHokma] = c_tierAtziluth;
    gvg_deptTier[c_deptBinah] = c_tierAtziluth;

    player = 1;
    while (player <= 15) {
        gvg_deptOf[player] = c_deptNone;
        player = player + 1;
    }

    // PLACEHOLDER until there is a selection screen. Baseline 7.1 has each
    // player choosing, with repeats allowed but at least three distinct
    // departments in a game; dealing the four Asiyah ones round-robin satisfies
    // that for any table of three or more and needs nothing from the lobby.
    //
    // It used to hand Malkuth to player 1 and nothing to anybody else, which
    // made Dept_Of a working test for "is this player 1" and a broken one for
    // everything it is actually asked. Ally upgrade propagation walks the table
    // by department, and the victory loop used to as well.
    dealt = 0;
    player = 1;
    while (player <= 15) {
        if (Slot_IsTablePlayer(player)) {
            Dept_SetOf(player, c_deptMalkuth + dealt % c_deptAsiyahCount);
            dealt = dealt + 1;
        }
        player = player + 1;
    }

    gt_upgradeChanged = TriggerCreate("Dept_UpgradeChanged_Func");
    player = 1;
    while (player <= 15) {
        TriggerAddEventUpgradeLevelChanged(gt_upgradeChanged, player);
        player = player + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/12_energy.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// The energy pool, and how the game ends.
//
// Lived in 14_work until the meltdown clock needed to take energy away, and
// 13_meltdown sorts before 14_work because Work_Finish has to call into it.
// Moving the pool out was the right fix rather than the convenient one: work is
// one thing that fills the pool and meltdown is one thing that empties it, and
// neither of them owns it.
//
// Every box a work produces pays twice, into two places that never mix: the
// player's own stock for that one abnormality's encyclopedia (13_containment),
// and the same amount again into this. So studying abnormalities and winning the
// game are the same activity, and neither is bought at the other's expense.
//
// This is not a shared wallet and does not violate the baseline's first
// principle. Nothing is ever SPENT out of it, and no player's rate of filling it
// depends on another player's. It is a scoreboard the table fills together, and
// a shared win condition is explicitly allowed -- what the principle forbids is
// a teammate's mistake reaching your income or your character.
//
// Meltdown taking from it is the one subtraction, and it is a subtraction from
// the scoreboard rather than from anybody's income: nobody's rate changes, the
// table is simply further from the door than it was.
//
// Submitting is a decision rather than an automatic end, because the threshold
// being reached does not mean this is the moment -- there may be an abnormality
// loose, or one more work worth finishing.
//--------------------------------------------------------------------------------------------------

int gv_energy;
int gv_energyGoal;
bool gv_energySubmitted;

//--------------------------------------------------------------------------------------------------
// The one BONUS objective, and the reason that word means something here.
//
// The engine's two sections are labelled "Main Objectives" and "Bonus
// Objectives", and the split this map puts on them is not challenge versus
// ordinary -- it is PERMANENT versus THIS EVENING. A department task is main
// because finishing it changes every game after this one. Tonight's energy
// target is bonus because when the ship leaves, it is spent.
//
// Which is the Lobotomy reading of its own premise, and worth stating because
// it looks upside down: the session is the disposable part. Surviving the night
// is not the achievement, it is the price of having a record at all.
//
// Every path that moves the pool ends up in Energy_Add, Energy_Drain,
// Energy_Retarget or Energy_Submit, so refreshing from those four is
// exhaustive and there is no tick.
//--------------------------------------------------------------------------------------------------
int gv_energyObj;

void Energy_Refresh () {
    if (gv_energyObj == c_invalidObjectiveId) {
        return;
    }
    ObjectiveSetName(gv_energyObj,
                     StringExternal("Lob/Objective/Energy/Name")
                     + StringToText(" <s val=\"" + c_questProgressStyle + "\">("
                                    + IntToString(gv_energy) + "/"
                                    + IntToString(gv_energyGoal) + ")</s>"));
}

void Energy_Add (int amount) {
    gv_energy = gv_energy + amount;
    if (gv_energy < 0) {
        gv_energy = 0;
    }
    Energy_Refresh();
}

//--------------------------------------------------------------------------------------------------
// Takes a percentage rather than an amount, so a penalty means the same thing
// early and late. A flat number would be a game-ending disaster at minute two
// and a rounding error at minute forty.
//--------------------------------------------------------------------------------------------------
int Energy_Drain (int percent) {
    int lost;

    if (percent <= 0 || gv_energy <= 0) {
        return 0;
    }
    lost = gv_energy * percent / 100;
    if (lost < 1) {
        lost = 1;
    }
    if (lost > gv_energy) {
        lost = gv_energy;
    }
    gv_energy = gv_energy - lost;
    Energy_Refresh();
    return lost;
}

bool Energy_CanSubmit () {
    return gv_energy >= gv_energyGoal && !gv_energySubmitted;
}

void Energy_Submit (int player) {
    int other;

    if (!Energy_CanSubmit()) {
        return;
    }
    gv_energySubmitted = true;
    if (gv_energyObj != c_invalidObjectiveId) {
        ObjectiveSetState(gv_energyObj, c_objectiveStateCompleted);
    }

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle,
                     Msg("Lob/Msg/EnergyDelivered"));

    other = 1;
    while (other <= 15) {
        if (Slot_IsTablePlayer(other)) {
            GameOver(other, c_gameOverVictory, true, true);
        }
        other = other + 1;
    }
}

// TUNING, and the one number here that is invented. What a Normal table has to
// bring in; every other difficulty is a percentage of it.
const int c_energyGoalBase = 200;

//--------------------------------------------------------------------------------------------------
// Recomputes the target from the table's mean difficulty.
//
// Scaled by the MEAN, not by any one player's. This is what makes a personal
// difficulty setting honest against a shared objective: without it a table that
// all picked Casual would face weakened opposition on the way to an unchanged
// target, which is a discount rather than a smaller game.
//
// A function rather than a line in Init because difficulty can move. In a real
// game it does not -- it comes off the lobby and is read once -- but the debug
// console sets it directly, and a target that ignored that would make the
// command a no-op for the half of its job that matters. So the formula lives
// here, once, and whoever changes difficulty calls this.
//--------------------------------------------------------------------------------------------------
void Energy_Retarget () {
    gv_energyGoal = Diff_GoalFrom(c_energyGoalBase);
    Energy_Refresh();
}

void Energy_Init () {
    gv_energy = 0;
    gv_energySubmitted = false;
    gv_energyObj = c_invalidObjectiveId;

    // Created before the target is computed, so the first Refresh has something
    // to write to. Not per player: the pool is one number for the table, and
    // the panel should say so by being the same line in front of everybody.
    gv_energyObj = ObjectiveCreate(
        StringExternal("Lob/Objective/Energy/Name"),
        StringExternal("Lob/Objective/Energy/Desc"),
        c_objectiveStateActive,
        false);

    Energy_Retarget();
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/13_containment.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Containment.
//
// The other half of the verb. 11_employee.galaxy owns the person you send; this
// owns the thing you send them to. Structure is from docs/usr/containment.md.
//
// The abnormality is a unit that exists from the start and never stops
// existing. Contained is a state it is in, not a state of the world:
//
//     Lob_Abno_<X>     the abnormality. Carries its risk grade, its Qliphoth
//                      counter, and while contained, Lob_Contained.
//     Lob_Door_Basic   the cell's only entrance, and the thing with durability
//     Lob_DoorDown_*   the door, dropped
//
// The door is generic and the abnormality is not, which is the whole reason
// this is affordable: thirty abnormalities is thirty units, not a hundred and
// twenty. A door belongs to the abnormality whose cell it stands at, which is a
// spatial fact and is answered spatially -- nearest door to that abnormality's
// home. Nothing is named after anything.
//
// The first version of this module had it backwards: it made the CELL the
// downable thing and spawned the abnormality on breach. Both halves were wrong.
// Durability belongs to the door, and an abnormality that is created at the
// moment it escapes cannot be worked on, cannot be observed, and cannot have a
// counter -- which is most of what an abnormality is for.
//
// Four states, and only the first is quiet:
//
//     Contained   invulnerable and inert, behind a raised door
//     Escaping    it has decided to leave and is attacking its own door.
//                 Repair cannot prevent this, only delay it, which is what
//                 Lob_DoorStrain is for.
//     Loose       door down, invulnerability gone, it is a combat problem
//     Returning   suppressed, on its way back to the cell
//
// Returning rather than dying is not a nicety. Design 5 forbids a breach ever
// costing a player their slot, and docs/usr/containment.md spells out the
// return: teleported home after a delay, restored to its initial state, counter
// back to default, door instantly full and raised. So a suppressed abnormality
// is never killed; the fatal blow is intercepted the way a device's is.
//
// What this module does NOT decide, because it is not decided:
//
//   Which abnormalities escape at counter zero and what the rest do instead.
//   The doc says most do something bad and escaping is the worst of them, and
//   that some carry no counter at all. That is per-abnormality authoring.
//
//   The Qliphoth default per abnormality. It is a per-type NUMBER, and this
//   project has no channel for one yet -- the same gap as residual management
//   difficulty in docs/dev/authoring-contract.md. Everything runs off
//   c_qliphothDefault until that is settled, which is a placeholder and is
//   marked as one.
//
//   What suppression pays out, what work does, and the meltdown clock.
//--------------------------------------------------------------------------------------------------

// The door types, named outright because the gate is a copy of a Blizzard
// destructible gate and does not carry the Lob_ prefix the generated tables key
// on. Renaming it Lob_Door_Horizontal in the editor would make this table go
// away; until then, adding a door means adding a line here.
//
// A destructible gate is not the Lob_Device_/Lob_DeviceDown_ pair this module
// first assumed. It has its own lowered state and its own revive, which is
// closer to "大门降下 / 升起" than a type swap ever was -- so alive is raised,
// dead is dropped, and no morph is involved.
const int c_doorTypeCount = 1;
string[1] gvg_doorType;

// The control panel, and the four encyclopedia buttons on it. Named outright
// for the same reason the door is: the panel was copied from a Blizzard
// destructible and carries no Lob_ prefix.
const string c_panelType = "ContainGateControl";
const int c_obsAbilCount = 4;
string[4] gvg_obsAbil;

const string c_containedBuff = "Lob_Contained";
const string c_qliphothBuff = "Lob_Qliphoth";
const string c_doorStrainBuff = "Lob_DoorStrain";

const int c_cellContained = 0;
const int c_cellEscaping = 1;
const int c_cellLoose = 2;
const int c_cellReturning = 3;

const int c_cellMax = 32;

// How far from an abnormality's home its door may stand.
const fixed c_cellRadius = 12.0;


// Seconds between suppression and the return home.
const fixed c_returnDelay = 8.0;

// Seconds of pressure on a door per stack of strain. One stack is a small
// amount of life regeneration removed, so the door bleeds faster the longer the
// abnormality has been working on it -- which is what makes repair a delay
// rather than an answer, per docs/usr/containment.md. Grade multiplies the
// rate, so an Aleph chews through a door it cannot be held against.
const fixed c_strainPeriod = 2.0;

const fixed c_contPeriod = 1.0;

int gv_cellCount;
unit[32] gvg_cellAbno;
point[32] gvg_cellHome;
int[32] gvg_cellState;
fixed[32] gvg_cellReturnAt;
fixed[32] gvg_cellStrainAt;

trigger gt_cellFatal;
trigger gt_cellTick;
trigger gt_cellObserve;

//--------------------------------------------------------------------------------------------------
// Registry.
//
// Built once from the abnormalities standing on the map, because an abnormality
// has a home and the home is where it was placed. A cell chosen at runtime will
// need a spawn point of its own; that belongs with the selection screen, which
// does not exist, so nothing here pretends to know where an empty cell is.
//--------------------------------------------------------------------------------------------------
int Cont_SlotOf (unit abno) {
    int i;

    if (abno == null) {
        return -1;
    }
    i = 0;
    while (i < gv_cellCount) {
        if (gvg_cellAbno[i] == abno) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

int Cont_State (unit abno) {
    int slot;

    slot = Cont_SlotOf(abno);
    if (slot < 0) {
        return c_cellContained;
    }
    return gvg_cellState[slot];
}

bool Cont_IsLoose (unit abno) {
    int state;

    state = Cont_State(abno);
    return state == c_cellLoose || state == c_cellEscaping;
}

//--------------------------------------------------------------------------------------------------
// The door of a cell: nearest door to that abnormality's home, raised or
// dropped. Null while no door has been placed, which leaves an abnormality
// contained by nothing but its own behavior -- inert, but visibly wrong.
//--------------------------------------------------------------------------------------------------
bool Cont_IsDoor (unit which) {
    int i;

    if (which == null) {
        return false;
    }
    i = 0;
    while (i < c_doorTypeCount) {
        if (UnitGetType(which) == gvg_doorType[i]) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

unitgroup Cont_AllDoors () {
    unitgroup found;
    int i;

    found = UnitGroupEmpty();
    i = 0;
    while (i < c_doorTypeCount) {
        UnitGroupAddUnitGroup(found, UnitGroup(gvg_doorType[i], c_playerAny,
                                               RegionEntireMap(), null, 0));
        i = i + 1;
    }
    return found;
}

unit Cont_DoorAt (point home) {
    unit door;

    door = UnitGroupClosestToPoint(Cont_AllDoors(), home);
    if (door == null) {
        return null;
    }
    if (DistanceBetweenPoints(UnitGetPosition(door), home) > c_cellRadius) {
        return null;
    }
    return door;
}

unit Cont_DoorOf (unit abno) {
    int slot;

    slot = Cont_SlotOf(abno);
    if (slot < 0) {
        return null;
    }
    return Cont_DoorAt(gvg_cellHome[slot]);
}

bool Cont_DoorIsUp (unit abno) {
    unit door;

    door = Cont_DoorOf(abno);
    return door != null && UnitIsAlive(door);
}

//--------------------------------------------------------------------------------------------------
// The control panel of a cell: nearest one to that abnormality's home.
//--------------------------------------------------------------------------------------------------
unit Cont_PanelAt (point home) {
    unit panel;

    panel = UnitGroupClosestToPoint(
        UnitGroup(c_panelType, c_playerAny, RegionEntireMap(), null, 0), home);
    if (panel == null) {
        return null;
    }
    if (DistanceBetweenPoints(UnitGetPosition(panel), home) > c_cellRadius) {
        return null;
    }
    return panel;
}

//--------------------------------------------------------------------------------------------------
// Whose cell this is.
//
// The abnormality itself is no help: every abnormality belongs to the
// abnormality slot, because a loose one has to be hostile to the swarm as well
// as to everybody else. So ownership is spatial, the way the door and the panel
// already are -- the control panel standing at that cell belongs to somebody,
// and this module already treats its owner as the person whose encyclopedia the
// panel shows.
//
// Falls back to Sector_OwnerNear, so a cell whose panel has not been placed yet
// is still somebody's rather than nobody's. Returns 0 when the map has neither,
// and a cell owned by nobody is skipped rather than handed to player 1.
//
// This lives here rather than in the meltdown, which is where it was written,
// because the meltdown was only the first thing to ask. Quests ask too, and one
// fact answered in two places is one fact that can disagree with itself.
//--------------------------------------------------------------------------------------------------
int Cont_OwnerOf (int slot) {
    unit panel;

    if (slot < 0 || slot >= gv_cellCount) {
        return 0;
    }

    panel = Cont_PanelAt(gvg_cellHome[slot]);
    if (panel != null && Slot_IsTablePlayer(UnitGetOwner(panel))) {
        return UnitGetOwner(panel);
    }
    return Sector_OwnerNear(gvg_cellHome[slot]);
}

//--------------------------------------------------------------------------------------------------
// The encyclopedia: what a player has extracted from an abnormality, and what
// they have spent it on.
//
// Both halves are per player AND per abnormality, and they must never pool.
// Design 8.1 has PE-Boxes buying that one abnormality's observation and nothing
// else, which is why there is no total anywhere here: an index that would let
// one abnormality's boxes reach another simply does not exist.
//
// Observation level is a count of purchased sections, not four separate
// achievements -- the source reads "(1 Section Unlocked)" through "(All Details
// Unlocked)". Each section has its own price in that abnormality's own doc.
//
// Nothing is persisted yet. Design 8.4 has this in a bank read at init, and it
// is the single most important thing in the bank; until then a game starts
// knowing nothing, which is also what a first game looks like.
//--------------------------------------------------------------------------------------------------
const int c_obsMax = 4;

// Flattened player * c_abnoCount + abnormality. Sized for 16 players against 64
// abnormalities; c_abnoCount is generated, so passing 64 documents means these
// have to grow with it.
int[1024] gvg_obsBoxes;
int[1024] gvg_obsLevel;

int Cont_BoxIndex (int player, int abnoIndex) {
    if (player < 1 || player > 15 || abnoIndex < 0 || abnoIndex >= c_abnoCount) {
        return -1;
    }
    return player * c_abnoCount + abnoIndex;
}

int Cont_BoxesOf (int player, int abnoIndex) {
    int i;

    i = Cont_BoxIndex(player, abnoIndex);
    if (i < 0) {
        return 0;
    }
    return gvg_obsBoxes[i];
}

void Cont_AddBoxes (int player, int abnoIndex, int amount) {
    int i;

    i = Cont_BoxIndex(player, abnoIndex);
    if (i < 0) {
        return;
    }
    gvg_obsBoxes[i] = gvg_obsBoxes[i] + amount;
}

//--------------------------------------------------------------------------------------------------
// How far a player has observed an abnormality, 0 (unseen) to 4 (fully known).
//
// Takes a unit rather than a player because every caller has one: the employee
// working, the character standing at a panel. Whose knowledge applies is the
// owner's, and asking it that way keeps the cross-department rule expressible --
// Control Team lv2 turns on exactly the question "whose observation counts".
//--------------------------------------------------------------------------------------------------
int Cont_ObservationOfPlayer (int player, int abnoIndex) {
    int i;

    i = Cont_BoxIndex(player, abnoIndex);
    if (i < 0) {
        return 0;
    }
    return gvg_obsLevel[i];
}

int Cont_ObservationOf (unit who, int abnoIndex) {
    if (who == null) {
        return 0;
    }
    return Cont_ObservationOfPlayer(UnitGetOwner(who), abnoIndex);
}

//--------------------------------------------------------------------------------------------------
// Buys the next section. Returns false if it is already fully known or the
// boxes are not there.
//--------------------------------------------------------------------------------------------------
bool Cont_Observe (int player, int abnoIndex) {
    int i;
    int level;
    int cost;

    i = Cont_BoxIndex(player, abnoIndex);
    if (i < 0) {
        return false;
    }

    level = gvg_obsLevel[i];
    if (level >= c_obsMax) {
        return false;
    }

    cost = AbnoGen_ObsCost(abnoIndex, level);
    if (gvg_obsBoxes[i] < cost) {
        return false;
    }

    gvg_obsBoxes[i] = gvg_obsBoxes[i] - cost;
    gvg_obsLevel[i] = level + 1;
    return true;
}

//--------------------------------------------------------------------------------------------------
// Brings one panel's four buttons into line with what its owner knows.
//
// A section not yet bought is an ability you can press. A bought one is
// disabled, which is what "becomes passive" is in engine terms -- it keeps its
// place and its text and stops being a thing you do. Either way the tooltip is
// pushed per unit INSTANCE with UnitSetInfoButtonTooltip, which is why four
// generic abilities can serve every abnormality and why the lore never has to
// leave the document it is written in.
//
// Pushed to everyone rather than to the owner alone: a panel is a thing in a
// room, and what it says about an abnormality is the same fact whoever reads
// it. Whose PE-Boxes buy the next section is a separate question and is asked
// when the button is pressed.
//--------------------------------------------------------------------------------------------------
void Cont_SyncPanel (int slot) {
    unit panel;
    int index;
    int level;
    int sec;
    int cost;

    panel = Cont_PanelAt(gvg_cellHome[slot]);
    if (panel == null) {
        return;
    }

    index = AbnoGen_IndexOf(gvg_cellAbno[slot]);
    level = Cont_ObservationOfPlayer(UnitGetOwner(panel), index);

    sec = 0;
    while (sec < c_obsAbilCount) {
        if (sec < level) {
            UnitAbilityEnable(panel, gvg_obsAbil[sec], false);
            UnitSetInfoButtonTooltip(panel, gvg_obsAbil[sec],
                                     AbnoGen_LoreText(index, sec));
        }
        else {
            UnitAbilityEnable(panel, gvg_obsAbil[sec], sec == level);
            cost = AbnoGen_ObsCost(index, sec);
            UnitSetInfoButtonTooltip(
                panel, gvg_obsAbil[sec],
                Msg2("Lob/Abno/Unobserved",
                     "%COST%", MsgInt(cost),
                     "%HELD%", MsgInt(Cont_BoxesOf(UnitGetOwner(panel), index))));
        }
        sec = sec + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// A press on one of the four buttons.
//
// Which section it is comes from which ability fired, and which abnormality
// from which panel it fired on -- so the same four abilities work everywhere
// and nothing is keyed by name.
//--------------------------------------------------------------------------------------------------
bool Cont_Observe_Func (bool testConds, bool runActions) {
    unit panel;
    int slot;

    if (!runActions) {
        return true;
    }

    panel = EventUnit();
    slot = 0;
    while (slot < gv_cellCount) {
        if (Cont_PanelAt(gvg_cellHome[slot]) == panel) {
            Cont_Observe(UnitGetOwner(panel), AbnoGen_IndexOf(gvg_cellAbno[slot]));
            Cont_SyncPanel(slot);
            return true;
        }
        slot = slot + 1;
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// The Qliphoth counter, as the stack count of a behavior.
//
// Same trick as employee stats, and for the same reason: a stack count is a
// number the engine already stores, already caps, and already draws on the
// unit with the count on the icon. Nothing here keeps a parallel copy.
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// The counter this abnormality starts and returns to, from its own doc.
//
// Zero for one that has none at all: "Qliphoth counter X" is not a counter of
// zero, it is the absence of a counter, and an absent counter can never run
// out. Nothing else has to know the difference, because a counter that is never
// decremented never reaches zero anyway.
//--------------------------------------------------------------------------------------------------
int Cont_CounterDefault (unit abno) {
    int index;

    index = AbnoGen_IndexOf(abno);
    if (index < 0 || gvg_abnoCounter[index] < 0) {
        return 0;
    }
    return gvg_abnoCounter[index];
}

int Cont_Counter (unit abno) {
    if (abno == null) {
        return 0;
    }
    return UnitBehaviorCount(abno, c_qliphothBuff);
}

void Cont_SetCounter (unit abno, int value) {
    int have;

    if (abno == null || !UnitIsAlive(abno)) {
        return;
    }
    if (value < 0) {
        value = 0;
    }

    have = Cont_Counter(abno);
    if (value > have) {
        UnitBehaviorAdd(abno, c_qliphothBuff, abno, value - have);
    }
    else if (value < have) {
        UnitBehaviorRemove(abno, c_qliphothBuff, have - value);
    }
}

//--------------------------------------------------------------------------------------------------
// Contained is a behavior, so the state and its consequences are the same
// object. Invulnerable, uncommandable, passive and unable to attack all come
// from one Modification in data, which is what "在收容单元中的异想体是无敌的，
// 且不会做任何事情" asks for, without a line of script per consequence.
//--------------------------------------------------------------------------------------------------
void Cont_SetContained (unit abno, bool contained) {
    Buffs_Set(abno, c_containedBuff, contained);
}

//--------------------------------------------------------------------------------------------------
// Formally out: the door is down and the invulnerability goes with it.
//
// Nothing is ordered. Some abnormalities walk to the rest hall, some never move
// at all, and a blanket attack-move would be inventing content that belongs to
// each of them.
//--------------------------------------------------------------------------------------------------
void Cont_GoLoose (unit abno) {
    int slot;

    slot = Cont_SlotOf(abno);
    if (slot < 0 || gvg_cellState[slot] == c_cellLoose) {
        return;
    }

    gvg_cellState[slot] = c_cellLoose;
    Cont_SetContained(abno, false);
    Cont_SetCounter(abno, 0);

    UIDisplayMessage(
        PlayerGroupAll(), c_messageAreaSubtitle,
        Msg1("Lob/Msg/Breach", "%RISK%", Risk_NameText(Risk_Of(abno))));
}

//--------------------------------------------------------------------------------------------------
// It has decided to leave.
//
// If the door is still standing it attacks the door -- its own door, from the
// inside -- and the door starts accumulating strain. If the door is already
// down it is simply out. Both paths end at Loose; the difference is how long
// the rest of the table has.
//
// An abnormality that does not escape never reaches here. For those, a dropped
// door means only that they cannot be worked on, which needs no code because
// the work order will ask Cont_DoorIsUp.
//--------------------------------------------------------------------------------------------------
void Cont_BeginEscape (unit abno) {
    int slot;
    unit door;

    slot = Cont_SlotOf(abno);
    if (slot < 0 || gvg_cellState[slot] != c_cellContained) {
        return;
    }

    door = Cont_DoorAt(gvg_cellHome[slot]);
    if (door != null && UnitIsAlive(door)) {
        gvg_cellState[slot] = c_cellEscaping;
        gvg_cellStrainAt[slot] = GameGetMissionTime() + c_strainPeriod;

        // Uncontained enough to act, but it is still inside a standing door and
        // nothing can reach it, so the invulnerability stays until the door is
        // actually down. That matches the doc: the unit is formally escaped
        // only once the door drops.
        UnitIssueOrder(abno, OrderTargetingUnit(AbilityCommand("attack", 0), door),
                       c_orderQueueReplace);
        UIDisplayMessage(
            PlayerGroupAll(), c_messageAreaSubtitle,
            Msg1("Lob/Msg/DoorStrain", "%RISK%", Risk_NameText(Risk_Of(abno))));
        return;
    }

    Cont_GoLoose(abno);
}

//--------------------------------------------------------------------------------------------------
// Drops a door, and zeroes the counter of whatever it was holding.
//
// "被从外部破坏时，大门将会降下，并将其 Qliphoth Counter 设为 0" -- the same
// thing happens whether the zerg did it or the occupant did, so both paths come
// through here. What happens next is the abnormality's business, not the door's.
//--------------------------------------------------------------------------------------------------
void Cont_DropDoor (unit door) {
    point where;
    int slot;

    if (door == null || !UnitIsAlive(door)) {
        return;
    }
    where = UnitGetPosition(door);
    UnitKill(door);

    slot = 0;
    while (slot < gv_cellCount) {
        if (DistanceBetweenPoints(gvg_cellHome[slot], where) <= c_cellRadius) {
            Cont_SetCounter(gvg_cellAbno[slot], 0);
            if (gvg_cellState[slot] == c_cellEscaping) {
                Cont_GoLoose(gvg_cellAbno[slot]);
            }
        }
        slot = slot + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// The suppression ledger.
//
// One flag per abnormality, for the whole table rather than per player, because
// Training Team 3 says so in as many words: "队友的进度也计算在内". So there is
// nothing to attribute and nobody to argue with about who landed the last hit.
//
// It is a ledger and not a counter because the quest asks for DISTINCT
// abnormalities. The same one beaten back four times is one entry, which is the
// difference between "you have seen four of these things" and "you have farmed
// one of them", and the quest is asking the first question.
//
// Sized to 64 rather than c_abnoCount because array sizes have to be literals
// and c_abnoCount is generated. Same reasoning as the bank's tables.
//--------------------------------------------------------------------------------------------------
bool[64] gvg_contSuppressed;

int Cont_SuppressedDistinct () {
    int total;
    int i;

    total = 0;
    i = 0;
    while (i < c_abnoCount) {
        if (gvg_contSuppressed[i]) {
            total = total + 1;
        }
        i = i + 1;
    }
    return total;
}

//--------------------------------------------------------------------------------------------------
// Cells of this player's that are working right now: contained, with the door
// standing. Control Team 1 asks for one of these.
//
// "Working" is the state a cell is in when it can be worked, not when somebody
// is working it. A cell nobody has got round to yet still counts; a cell whose
// occupant is loose or whose gate is down does not.
//--------------------------------------------------------------------------------------------------
int Cont_WorkingOf (int player) {
    int total;
    int slot;

    total = 0;
    slot = 0;
    while (slot < gv_cellCount) {
        if (gvg_cellState[slot] == c_cellContained
            && Cont_OwnerOf(slot) == player
            && Cont_DoorIsUp(gvg_cellAbno[slot])) {
            total = total + 1;
        }
        slot = slot + 1;
    }
    return total;
}

//--------------------------------------------------------------------------------------------------
// Suppression: defeated, not killed.
//
// The fatal blow is intercepted the way a device's is, and what follows is the
// doc's return -- home after a delay, initial state, counter back to default,
// door instantly whole and raised. An abnormality is never removed from the
// game, so a breach can cost employees, time and the table's attention, but
// never a slot.
//--------------------------------------------------------------------------------------------------
void Cont_Suppress (unit abno) {
    int slot;
    int index;

    slot = Cont_SlotOf(abno);
    if (slot < 0 || gvg_cellState[slot] == c_cellReturning) {
        return;
    }

    // Marked here rather than on the death event, because the early return
    // above is what makes a suppression happen once. A breach beaten down by
    // three people at the same instant is one entry in the ledger.
    index = AbnoGen_IndexOf(abno);
    if (index >= 0 && index < c_abnoCount) {
        gvg_contSuppressed[index] = true;
    }

    gvg_cellState[slot] = c_cellReturning;
    gvg_cellReturnAt[slot] = GameGetMissionTime() + c_returnDelay;

    // Contained again immediately, so nothing keeps hitting it during the walk
    // back and it stops acting the moment it is beaten.
    UnitSetPropertyFixed(abno, c_unitPropLife,
                         UnitGetPropertyFixed(abno, c_unitPropLifeMax, true));
    Cont_SetContained(abno, true);

    UIDisplayMessage(
        PlayerGroupAll(), c_messageAreaSubtitle,
        Msg1("Lob/Msg/Suppressed", "%RISK%", Risk_NameText(Risk_Of(abno))));
}

void Cont_Return (int slot) {
    unit abno;
    unit door;

    abno = gvg_cellAbno[slot];
    gvg_cellState[slot] = c_cellContained;

    UnitSetPosition(abno, gvg_cellHome[slot], false);
    Cont_SetContained(abno, true);
    Cont_SetCounter(abno, Cont_CounterDefault(abno));

    // The door comes back whole and raised, which is not the same as being
    // repaired: the doc restores it outright on suppression.
    // Whole and raised, which is not the same as repaired: the doc restores it
    // outright on suppression. A dropped gate is a dead unit, so this is a
    // revive rather than a heal; UnitRevive puts the same unit back rather than
    // making a second one, which matters because the cell is found by proximity
    // and two doors at one home would be ambiguous.
    door = Cont_DoorAt(gvg_cellHome[slot]);
    if (door != null && !UnitIsAlive(door)) {
        UnitRevive(door);
    }
    if (door != null) {
        UnitSetPropertyFixed(door, c_unitPropLife,
                             UnitGetPropertyFixed(door, c_unitPropLifeMax, true));
        UnitBehaviorRemove(door, c_doorStrainBuff,
                           UnitBehaviorCount(door, c_doorStrainBuff));
    }
}

//--------------------------------------------------------------------------------------------------
// A fatal blow on a door drops it; a fatal blow on a loose abnormality
// suppresses it. Same interception, two meanings.
//--------------------------------------------------------------------------------------------------
bool Cont_Fatal_Func (bool testConds, bool runActions) {
    unit victim;

    if (!runActions) {
        return true;
    }

    victim = EventUnit();
    if (Cont_IsDoor(victim)) {
        Cont_DropDoor(victim);
        return true;
    }
    if (AbnoGen_Is(victim) && Cont_IsLoose(victim)) {
        Cont_Suppress(victim);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// Strain, and the return timer.
//
// Strain is a stack per period on the door of a cell whose occupant is trying
// to get out, scaled by grade. The doc requires that repair be a delay rather
// than an answer, and stacking regeneration loss is what makes that true
// without an SCV's repair rate having to be balanced against every grade
// separately: eventually the strain outruns any fixed repair rate, and the
// higher the grade the sooner.
//--------------------------------------------------------------------------------------------------
bool Cont_Tick_Func (bool testConds, bool runActions) {
    unit door;
    fixed now;
    int slot;
    int grade;

    if (!runActions) {
        return true;
    }

    now = GameGetMissionTime();

    slot = 0;
    while (slot < gv_cellCount) {
        if (gvg_cellState[slot] == c_cellEscaping && now >= gvg_cellStrainAt[slot]) {
            door = Cont_DoorAt(gvg_cellHome[slot]);
            if (door == null || !UnitIsAlive(door)) {
                Cont_GoLoose(gvg_cellAbno[slot]);
            }
            else {
                grade = Risk_Of(gvg_cellAbno[slot]);
                if (grade < 0) {
                    grade = 0;
                }
                UnitBehaviorAdd(door, c_doorStrainBuff, gvg_cellAbno[slot], grade + 1);
                gvg_cellStrainAt[slot] = now + c_strainPeriod;
            }
        }
        else if (gvg_cellState[slot] == c_cellReturning && now >= gvg_cellReturnAt[slot]) {
            Cont_Return(slot);
        }
        Cont_SyncPanel(slot);
        slot = slot + 1;
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// Everything on the map that is an abnormality, contained where it stands.
//--------------------------------------------------------------------------------------------------
void Cont_BuildRegistry () {
    unitgroup all;
    unit abno;
    int count;
    int i;

    gv_cellCount = 0;

    all = AbnoGen_Scan();
    count = UnitGroupCount(all, c_unitCountAlive);

    i = 1;
    while (i <= count && gv_cellCount < c_cellMax) {
        abno = UnitGroupUnit(all, i);
        if (abno != null) {
            gvg_cellAbno[gv_cellCount] = abno;
            gvg_cellHome[gv_cellCount] = UnitGetPosition(abno);
            gvg_cellState[gv_cellCount] = c_cellContained;
            Cont_SetContained(abno, true);
            Cont_SetCounter(abno, Cont_CounterDefault(abno));
            gv_cellCount = gv_cellCount + 1;
        }
        i = i + 1;
    }
}

void Containment_Init () {
    int i;

    gvg_doorType[0] = "ContainGateHorizontal";

    gvg_obsAbil[0] = "Lob_Obs_1";
    gvg_obsAbil[1] = "Lob_Obs_2";
    gvg_obsAbil[2] = "Lob_Obs_3";
    gvg_obsAbil[3] = "Lob_Obs_4";

    Cont_BuildRegistry();

    gt_cellObserve = TriggerCreate("Cont_Observe_Func");
    i = 0;
    while (i < c_obsAbilCount) {
        TriggerAddEventUnitAbility(gt_cellObserve, null,
                                   AbilityCommand(gvg_obsAbil[i], 0),
                                   c_unitAbilStageExecute, true);
        i = i + 1;
    }

    gt_cellFatal = TriggerCreate("Cont_Fatal_Func");
    TriggerAddEventUnitDamaged(gt_cellFatal, null, c_unitDamageTypeAny, c_unitDamageFatal, null);

    gt_cellTick = TriggerCreate("Cont_Tick_Func");
    TriggerAddEventTimePeriodic(gt_cellTick, c_contPeriod, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/13_meltdown.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Meltdown.
//
// The metronome. 13_containment owns the cell and 14_work owns the verb, and
// neither of them has any reason to happen at a particular moment -- a table
// that simply never presses Work is never in any danger. This is what makes
// standing still cost something.
//
// Numbered 13 rather than 15 because 14_work has to call into it, and Galaxy
// needs a declaration before its use. It sorts after 13_containment on the
// module name alone ("containment" < "meltdown"), which is load-bearing;
// check_forward_refs in tools/build_galaxy.py is what catches it if that ever
// stops being true.
//
//--------------------------------------------------------------------------------------------------
// The whole rule:
//
//     a cell is named  ->  60 seconds  ->  if no work has BEGUN on it, its
//                                          Qliphoth counter is set to 0 and the
//                                          table loses a share of the pool
//
// Begun, not finished. The countdown answers to somebody being sent, not to the
// work going well: a work started at second 55 would otherwise be a wasted trip,
// and the decision a meltdown is asking about is "who do I send and to which
// one", which is over the moment the employee walks. A work that then fails has
// already cost that employee their SP; charging the meltdown for it as well
// would be the same mistake twice.
//
// Set to zero, not decremented. A meltdown spends the counter outright, which is
// why ignoring one is a decision and not a slow leak. What an abnormality DOES
// at zero stays where it already was: per abnormality, in its own document, and
// not decided here. For one that can escape, zero is the escape.
//
//--------------------------------------------------------------------------------------------------
// A cell that was already busy when it got named does not start counting.
//
// Its countdown is held until that work ends -- finished, or interrupted by the
// gate coming down, or by the employee dying or breaking. Only then do the 60
// seconds begin.
//
// This is not a courtesy, it is the same rule read carefully. The countdown is
// answered by a work BEGINNING, and a work already in flight cannot begin
// again: the employee is inside and there is nothing the player can press. Left
// alone, a cell named one second into a fourteen-second work would spend most of
// its window in a state where the correct play is impossible. Holding it means
// the window is always a window -- sixty seconds in which sending somebody is
// actually a thing you can do.
//
// Note what it does NOT do: the work in flight does not itself answer the
// meltdown. It started before anybody was named, so it was never a response to
// one. When it ends the clock starts, and somebody still has to go.
//
//--------------------------------------------------------------------------------------------------
// The level is global, the named cells are per player.
//
// This split is the baseline's first principle in one place. The level is a
// shared clock, so everybody is in the same act of the same evening -- and a
// shared TEMPO is not a shared punishment. But a round names cells inside each
// player's OWN sector, and a missed one zeroes that cell's own counter.
//
// So a neighbour who ignores their meltdown breaches their own abnormality, and
// what reaches you is a fight -- the one negative transfer the baseline allows.
// Nothing about your income, your stats or your success rates moves because of
// what they did.
//
// The energy drain is the one shared cost, and it is deliberate. Energy is a
// scoreboard nobody spends from, so draining it moves the table further from the
// door without touching any player's rate of getting there. That is the
// difference between a shared win condition, which the baseline allows, and a
// shared wallet, which it forbids.
//
//--------------------------------------------------------------------------------------------------
// What this does NOT decide:
//
//   What happens at counter zero. Same hole as in 13_containment, and it is
//   per-abnormality authoring rather than a rule. This module's job ends at
//   setting the number.
//
//   What a miss costs an abnormality that has no counter at all. "Qliphoth
//   counter X" is the absence of a counter, not a counter at zero, so there is
//   nothing to spend. Those cells are still named and still cost energy; only
//   the counter half is skipped, and it says so.
//
//   Which abnormalities are tools and therefore never named -- Training Team's
//   rabbit is "不计入融毁计数". That is a per-type flag with no channel yet, the
//   same gap as residual management difficulty. Melt_CanBeNamed is where it
//   lands when there is one.
//
//   Anything the level does besides name more cells. Training Team's core
//   suppression lowers stats with it and Welfare Team's ammunition refills on
//   it; both belong to systems that do not exist. Melt_Level is the read.
//--------------------------------------------------------------------------------------------------

// How long a named cell has, once its countdown is actually running.
const fixed c_meltWindow = 60.0;

// How often a new round names cells. The same number, so that under no holds at
// all a round runs straight into the next.
const fixed c_meltPeriod = 60.0;

// TUNING, all three. Nobody has designed a meltdown curve; these are stand-ins
// picked to make the mechanic visible in a test, not balance.
//
// A player is named one more cell every this many levels.
const int c_meltLevelsPerTarget = 3;

// And never more than this many outstanding at once, however long the game runs.
// Counted against cells still pending, not against cells named this round, so a
// held cell occupies a slot rather than adding to the pile.
const int c_meltTargetsMax = 4;

// Share of the energy pool lost per unattended cell, as a percent. A percent
// rather than an amount so that the same miss means the same thing at minute two
// and at minute forty.
const int c_meltEnergyPenaltyPct = 10;

// Level 0 is before the first round: nothing is named.
int gv_meltLevel;

// When the next round names cells.
fixed gv_meltNextAt;

// Per cell, indexed exactly as 13_containment indexes its cells. Sized to
// c_cellMax, which Galaxy will not let be written as anything but a literal.
bool[32] gvg_meltFlag;

// Held: named while a work was already running, and not counting down until
// that work ends.
bool[32] gvg_meltHeld;

// When this cell resolves. Meaningless while held.
fixed[32] gvg_meltDeadline;

// How many works are running on this cell. A count rather than a flag because
// nothing stops two employees being sent to the same door.
int[32] gvg_meltBusy;

// Named cells this player answered, and named cells this player let expire.
//
// Cells, not rounds. Control Team's quest 3 is "妥善处理3轮融毁" and reads
// rounds, and a held cell can outlive several rounds, so the two do not follow
// from each other. Both are kept: cells are the readout, rounds are the quest.
int[16] gvg_meltAnswered;
int[16] gvg_meltMissed;

// Rounds this player got completely right, and the values the two counters
// above held when the last round was scored. A snapshot rather than a
// per-round tally, because what makes a round clean is the DELTA across it,
// and every cell that resolves does so by moving exactly one of these.
int[16] gvg_meltClean;
int[16] gvg_meltAnsweredAt;
int[16] gvg_meltMissedAt;

trigger gt_meltTick;

int Melt_Level () {
    return gv_meltLevel;
}

int Melt_AnsweredBy (int player) {
    if (player < 1 || player > 15) {
        return 0;
    }
    return gvg_meltAnswered[player];
}

int Melt_MissedBy (int player) {
    if (player < 1 || player > 15) {
        return 0;
    }
    return gvg_meltMissed[player];
}

fixed Melt_SecondsToRound () {
    fixed left;

    left = gv_meltNextAt - GameGetMissionTime();
    if (left < 0.0) {
        return 0.0;
    }
    return left;
}

bool Melt_IsFlagged (int slot) {
    if (slot < 0 || slot >= gv_cellCount) {
        return false;
    }
    return gvg_meltFlag[slot];
}

bool Melt_IsHeld (int slot) {
    if (slot < 0 || slot >= gv_cellCount) {
        return false;
    }
    return gvg_meltFlag[slot] && gvg_meltHeld[slot];
}

fixed Melt_SecondsLeft (int slot) {
    fixed left;

    if (slot < 0 || slot >= gv_cellCount || !gvg_meltFlag[slot] || gvg_meltHeld[slot]) {
        return 0.0;
    }
    left = gvg_meltDeadline[slot] - GameGetMissionTime();
    if (left < 0.0) {
        return 0.0;
    }
    return left;
}

int Melt_Targets () {
    int n;

    n = 1 + gv_meltLevel / c_meltLevelsPerTarget;
    if (n > c_meltTargetsMax) {
        n = c_meltTargetsMax;
    }
    return n;
}

//--------------------------------------------------------------------------------------------------
// Rounds this player got completely right.
//
// Control Team 3 counts ROUNDS, not cells, and answering four cells in one
// round is not the same achievement as answering one in each of four. So the
// counter cannot be derived from gvg_meltAnswered, and it is kept here.
//
// A round counts when the player was named at least one cell and let none of
// them lapse. Being named nothing is not an achievement, and neither is a round
// where three went well and the fourth went to zero.
//
// Evaluated at the top of the next round by comparing against a snapshot, which
// is what makes a cell held over the boundary land on the round it was actually
// answered in rather than the round it was named in.
//--------------------------------------------------------------------------------------------------
int Melt_CleanRoundsBy (int player) {
    if (player < 1 || player > 15) {
        return 0;
    }
    return gvg_meltClean[player];
}

void Melt_ScoreRound () {
    int player;

    player = 1;
    while (player <= 15) {
        if (gvg_meltAnswered[player] > gvg_meltAnsweredAt[player]
            && gvg_meltMissed[player] == gvg_meltMissedAt[player]) {
            gvg_meltClean[player] = gvg_meltClean[player] + 1;
        }
        gvg_meltAnsweredAt[player] = gvg_meltAnswered[player];
        gvg_meltMissedAt[player] = gvg_meltMissed[player];
        player = player + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// Whether a meltdown may name this abnormality at all.
//
// Training Team's tool abnormality may not: docs/usr/department.md gives it no
// PE-Boxes, no resources and no meltdown count, which together are what make it
// safe to grind an employee to level II on. There is no channel for "this is a
// tool" yet, so this is the hook and not the rule.
//--------------------------------------------------------------------------------------------------
bool Melt_CanBeNamed (int index) {
    if (index < 0) {
        return false;
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// Nobody went. The counter is spent and the table pays.
//--------------------------------------------------------------------------------------------------
void Melt_Miss (int slot) {
    unit abno;
    int owner;
    int lost;

    abno = gvg_cellAbno[slot];
    owner = Cont_OwnerOf(slot);

    gvg_meltFlag[slot] = false;
    gvg_meltHeld[slot] = false;

    if (owner >= 1 && owner <= 15) {
        gvg_meltMissed[owner] = gvg_meltMissed[owner] + 1;
    }

    // Set to zero rather than decremented: a meltdown spends the counter, it
    // does not chip at it. An abnormality with no counter has nothing here to
    // spend, and what any of them does at zero is its own business.
    if (Cont_CounterDefault(abno) > 0) {
        Cont_SetCounter(abno, 0);
    }
    lost = Energy_Drain(c_meltEnergyPenaltyPct);

    UIDisplayMessage(
        PlayerGroupAll(), c_messageAreaSubtitle,
        Msg2("Lob/Msg/MeltMissed",
             "%ABNORMALITY%", AbnoGen_NameText(AbnoGen_IndexOf(abno)),
             "%AMOUNT%", MsgInt(lost)));
}

//--------------------------------------------------------------------------------------------------
// Names the cells for a round.
//
// Per player, and only among the cells that could actually be worked: one
// already loose, or behind a dropped door, is a problem the player is having
// rather than one to hand them. Cells still pending from an earlier round count
// against the target, so a held cell holds a place in the queue instead of
// letting the pile grow behind it.
//
// Selection walks from a random offset so that a player with more cells than
// targets does not get the same ones every round.
//--------------------------------------------------------------------------------------------------
void Melt_NameFor (int player) {
    unit abno;
    int want;
    int have;
    int step;
    int slot;
    int start;

    if (gv_cellCount <= 0) {
        return;
    }

    want = Melt_Targets();

    have = 0;
    slot = 0;
    while (slot < gv_cellCount) {
        if (gvg_meltFlag[slot] && Cont_OwnerOf(slot) == player) {
            have = have + 1;
        }
        slot = slot + 1;
    }

    start = RandomInt(0, gv_cellCount - 1);
    step = 0;
    while (step < gv_cellCount && have < want) {
        slot = (start + step) % gv_cellCount;
        abno = gvg_cellAbno[slot];
        if (!gvg_meltFlag[slot]
            && Cont_OwnerOf(slot) == player
            && Melt_CanBeNamed(AbnoGen_IndexOf(abno))
            && gvg_cellState[slot] == c_cellContained
            && Cont_DoorIsUp(abno)) {

            gvg_meltFlag[slot] = true;
            have = have + 1;

            // Already busy: hold it. The employee inside cannot begin again, so
            // the window would not be a window.
            if (gvg_meltBusy[slot] > 0) {
                gvg_meltHeld[slot] = true;
                UIDisplayMessage(
                    PlayerGroupSingle(player), c_messageAreaSubtitle,
                    Msg1("Lob/Msg/MeltHeld", "%ABNORMALITY%",
                         AbnoGen_NameText(AbnoGen_IndexOf(abno))));
            }
            else {
                gvg_meltHeld[slot] = false;
                gvg_meltDeadline[slot] = GameGetMissionTime() + c_meltWindow;
                UIDisplayMessage(
                    PlayerGroupSingle(player), c_messageAreaSubtitle,
                    Msg2("Lob/Msg/MeltNamed",
                         "%ABNORMALITY%", AbnoGen_NameText(AbnoGen_IndexOf(abno)),
                         "%SECONDS%", MsgInt(FixedToInt(c_meltWindow))));
            }
        }
        step = step + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// A new round: the level rises and more cells are named.
//--------------------------------------------------------------------------------------------------
void Melt_Advance () {
    int player;

    // The round that is ending is scored before the next one names anything,
    // so a cell named now cannot land in the tally of the round before it.
    // Level 0 is scored too and always comes out empty, which is correct: no
    // cells were named, so nobody handled a round.
    Melt_ScoreRound();

    gv_meltLevel = gv_meltLevel + 1;
    gv_meltNextAt = GameGetMissionTime() + c_meltPeriod;

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle,
                     Msg1("Lob/Msg/MeltLevel", "%LEVEL%", MsgInt(gv_meltLevel)));

    player = 1;
    while (player <= 15) {
        if (Slot_IsTablePlayer(player)) {
            Melt_NameFor(player);
        }
        player = player + 1;
    }
}

bool Melt_Tick_Func (bool testConds, bool runActions) {
    fixed now;
    int slot;

    if (!runActions) {
        return true;
    }

    now = GameGetMissionTime();

    slot = 0;
    while (slot < gv_cellCount) {
        if (gvg_meltFlag[slot]) {
            if (gvg_meltHeld[slot]) {
                // The work that was in flight has ended, however it ended. The
                // window opens now.
                if (gvg_meltBusy[slot] <= 0) {
                    gvg_meltHeld[slot] = false;
                    gvg_meltDeadline[slot] = now + c_meltWindow;
                    UIDisplayMessage(
                        PlayerGroupSingle(Cont_OwnerOf(slot)), c_messageAreaSubtitle,
                        Msg2("Lob/Msg/MeltFreed",
                             "%ABNORMALITY%",
                             AbnoGen_NameText(AbnoGen_IndexOf(gvg_cellAbno[slot])),
                             "%SECONDS%", MsgInt(FixedToInt(c_meltWindow))));
                }
            }
            else if (now >= gvg_meltDeadline[slot]) {
                Melt_Miss(slot);
            }
        }
        slot = slot + 1;
    }

    if (now >= gv_meltNextAt) {
        Melt_Advance();
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// A work started. Called from Work_Begin, which is why this module sorts first.
//
// Any work beginning after the naming answers it, whoever sent the employee.
// Which player gets the credit is decided here by who owns the CELL -- so a
// neighbour walking over to cover for you is help, and Control Team lv2's
// cross-department work is help by design rather than by an exception written
// here.
//
// A work that was already running when the cell was named does not reach this,
// because it began before there was anything to answer.
//--------------------------------------------------------------------------------------------------
void Melt_NoteWorkBegin (unit abno) {
    int slot;
    int owner;

    slot = Cont_SlotOf(abno);
    if (slot < 0) {
        return;
    }

    gvg_meltBusy[slot] = gvg_meltBusy[slot] + 1;

    if (!gvg_meltFlag[slot]) {
        return;
    }

    gvg_meltFlag[slot] = false;
    gvg_meltHeld[slot] = false;

    owner = Cont_OwnerOf(slot);
    if (owner >= 1 && owner <= 15) {
        gvg_meltAnswered[owner] = gvg_meltAnswered[owner] + 1;
        UIDisplayMessage(
            PlayerGroupSingle(owner), c_messageAreaSubtitle,
            Msg1("Lob/Msg/MeltAnswered", "%ABNORMALITY%",
                 AbnoGen_NameText(AbnoGen_IndexOf(abno))));
    }
}

//--------------------------------------------------------------------------------------------------
// A work left the table, however it left: finished, or interrupted by the gate
// coming down, or by the employee dying or breaking.
//
// One exit for all of them, because a held cell does not care which one it was.
// Called from Work_Drop, which every work goes through.
//--------------------------------------------------------------------------------------------------
void Melt_NoteWorkEnd (unit abno) {
    int slot;

    slot = Cont_SlotOf(abno);
    if (slot < 0) {
        return;
    }
    gvg_meltBusy[slot] = gvg_meltBusy[slot] - 1;
    if (gvg_meltBusy[slot] < 0) {
        gvg_meltBusy[slot] = 0;
    }
}

void Meltdown_Init () {
    int i;

    gv_meltLevel = 0;
    gv_meltNextAt = c_meltPeriod;

    i = 0;
    while (i < 32) {
        gvg_meltFlag[i] = false;
        gvg_meltHeld[i] = false;
        gvg_meltDeadline[i] = 0.0;
        gvg_meltBusy[i] = 0;
        i = i + 1;
    }

    i = 1;
    while (i <= 15) {
        gvg_meltAnswered[i] = 0;
        gvg_meltMissed[i] = 0;
        gvg_meltClean[i] = 0;
        gvg_meltAnsweredAt[i] = 0;
        gvg_meltMissedAt[i] = 0;
        i = i + 1;
    }

    gt_meltTick = TriggerCreate("Melt_Tick_Func");
    TriggerAddEventTimePeriodic(gt_meltTick, 1.0, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/14_work.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Work.
//
// The verb itself. 11_employee.galaxy owns the person, 13_containment.galaxy
// owns the thing, and this is "send that one to do that to it" -- which
// design 2.1 identifies as the whole reason employees exist. Without it an
// abnormality is a mine with a plot.
//
// The numbers are not here. Every one of them comes from the abnormality's own
// doc through 04_abno_gen.galaxy: how fast boxes come, how many there are,
// which box counts read as Good or Normal, and the success chance for each of
// the four works against each stat level. Adding an abnormality is writing a
// document.
//
// One roll per box, not one roll per work. O-03-03 attempts ten boxes at a
// chance that depends on the work chosen and the employee's level in the stat
// that work uses, and the number that land is the result. That is why a
// specialist is not merely likelier to succeed -- they produce more, and the
// grade is a consequence of the amount rather than a separate roll.
//
// The stat each work leans on:
//
//     Instinct   -> Fortitude    Insight    -> Prudence
//     Attachment -> Temperance   Repression -> Justice
//
// What a missed box costs comes from the doc too, and it is not one thing. Red
// is the body, White is the mind, Black is half to each, and Pale is a
// percentage of maximum life. So the question a player answers at the door is
// not only "which work" but "who can afford to be wrong here" -- and since
// Fortitude IS maximum life, Pale is the one that a strong employee cannot
// simply outgrow.
//

// Both formulas are from docs/usr/mechanism.md and neither is invented:
//
//     speed   = base * (1 + (observation + Temperance) / 100)
//     success = preference + (observation + Temperance)/5, capped at 95,
//               then penalties
//
// Temperance is in both, which is the thing worth noticing about it: a point is
// +1% work speed and +0.2% success at the same time. It is the only stat that
// pays twice, and the only one whose VALUE matters rather than only the
// threshold its level crosses -- everywhere else 30 and 44 of a stat are the
// same number.
//
// Work success moves in whole percents per five points, so four points of bonus
// is worth exactly nothing; the integer divide is the mechanic, not a rounding
// artefact.
//
// The 95% cap is applied before penalties rather than after, which is why there
// is always at least a 5% chance of failing and why penalties are so much worse
// than the same number of bonus points is good.
//--------------------------------------------------------------------------------------------------

const int c_workInstinct = 0;
const int c_workInsight = 1;
const int c_workAttachment = 2;
const int c_workRepression = 3;
const int c_workCount = 4;

const int c_resultBad = 0;
const int c_resultNormal = 1;
const int c_resultGood = 2;

// TUNING, and the only invented number in this file. Stat gained per completed
// work, by result. Design 2.2 requires that work be the thing that grows an
// employee; how fast is a curve nobody has designed yet, and this is a
// deliberately flat stand-in rather than a guess dressed up as a formula.
const int c_workGainBad = 1;
const int c_workGainNormal = 2;
const int c_workGainGood = 3;

const fixed c_workTick = 0.25;

// Work success is counted in points and paid out in whole percents.
const int c_workSuccessPerPercent = 5;

// The cap is applied before penalties, so it is a ceiling on bonuses rather
// than on the final number.
const int c_workSuccessCap = 95;

const int c_workMax = 32;

string[4] gvg_workName;

// The stat each work leans on.
int[4] gvg_workStat;

// One row per work in progress.
int gv_workCount;
unit[32] gvg_workEmp;
unit[32] gvg_workAbno;
int[32] gvg_workType;
int[32] gvg_workBoxes;
int[32] gvg_workDone;
fixed[32] gvg_workNextBox;

// What a player's next work order will be. A placeholder for the order UI:
// there is nowhere to choose a work from yet, so it is chosen once and applies
// until changed.
int[16] gvg_workDefault;

// Cooldown per cell, keyed the same way 13_containment keys its cells.
fixed[32] gvg_workReadyAt;

// Works this player has seen through to a result, and how many of those came
// out Good. Information Team 1 counts the first, Control Team 2 the second.
//
// Counted here rather than derived by the quest layer because a finished work
// leaves nothing behind to derive from -- the row is dropped and the boxes go
// into two pools that other things also pay into. An event that erases its own
// evidence has to be counted where it happens.
//
// Credited to the employee's owner, not to the cell's, because the quest is
// about work the player did. Covering a neighbour's cell counts for the
// neighbour in the meltdown, which is about the cell being handled, and for you
// here, which is about you having handled it. Both readings are the right one
// for their own question.
int[16] gvg_workFinished;
int[16] gvg_workGood;

const string c_workAbil = "Interact";

trigger gt_workTick;
trigger gt_workCast;

int Work_FinishedBy (int player) {
    if (player < 1 || player > 15) {
        return 0;
    }
    return gvg_workFinished[player];
}

int Work_GoodBy (int player) {
    if (player < 1 || player > 15) {
        return 0;
    }
    return gvg_workGood[player];
}

string Work_Name (int work) {
    if (work < 0 || work >= c_workCount) {
        return "";
    }
    return gvg_workName[work];
}

int Work_Stat (int work) {
    if (work < 0 || work >= c_workCount) {
        return c_statFortitude;
    }
    return gvg_workStat[work];
}

int Work_DefaultOf (int player) {
    if (player < 1 || player > 15) {
        return c_workInstinct;
    }
    return gvg_workDefault[player];
}

void Work_SetDefault (int player, int work) {
    if (player < 1 || player > 15 || work < 0 || work >= c_workCount) {
        return;
    }
    gvg_workDefault[player] = work;
}

//--------------------------------------------------------------------------------------------------
// Seconds per box attempt.
//
// speed = base * (1 + (observation + Temperance) / 100), and the time for a
// whole work is boxes/speed.
//--------------------------------------------------------------------------------------------------
fixed Work_BoxInterval (unit emp, int index) {
    fixed speed;

    speed = gvg_abnoBoxSpeed[index]
            * (1.0 + IntToFixed(AbnoGen_ObsSpeed(index, Cont_ObservationOf(emp, index))
                                + Emp_Stat(emp, c_statTemperance)) / 100.0);
    if (speed <= 0.0) {
        return 1.0;
    }
    return 1.0 / speed;
}

//--------------------------------------------------------------------------------------------------
// Percent chance for one box.
//
// Bonuses first, then the cap, then penalties. There are no penalties yet, but
// the order is the mechanic rather than an implementation detail: capping
// before them is what makes a penalty permanently lower the best case, and what
// guarantees the 5% failure that no amount of preparation removes.
//--------------------------------------------------------------------------------------------------
int Work_SuccessChance (unit emp, int index, int work) {
    int chance;
    int points;

    // Temperance counts as work-success points one for one, the same as an
    // observation bonus does: a point of either is +0.2%, and five of either is
    // the +1% the counter actually moves in.
    points = AbnoGen_ObsSuccess(index, Cont_ObservationOf(emp, index))
             + Emp_Stat(emp, c_statTemperance);

    chance = AbnoGen_Pref(index, work, Emp_StatLevel(emp, Work_Stat(work)))
             + points / c_workSuccessPerPercent;

    if (chance > c_workSuccessCap) {
        chance = c_workSuccessCap;
    }
    return chance;
}

//--------------------------------------------------------------------------------------------------
// Whether this employee can start work on this abnormality right now.
//--------------------------------------------------------------------------------------------------
int Work_SlotOfEmp (unit emp) {
    int i;

    i = 0;
    while (i < gv_workCount) {
        if (gvg_workEmp[i] == emp) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

bool Work_IsBusy (unit emp) {
    return Work_SlotOfEmp(emp) >= 0;
}

//--------------------------------------------------------------------------------------------------
// Starts one.
//
// The employee is not moved into the cell and nothing is teleported: per
// docs/usr/containment.md nobody can enter, and standing at the door doing
// nothing visible is the placeholder that document asks for.
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Why this employee cannot work this abnormality, or "" if they can.
//
// A reason rather than a bare false. A player who presses a button and gets
// nothing has hit the same bug as a developer who cannot tell which check
// refused, and one string fixes both.
//--------------------------------------------------------------------------------------------------
string Work_Refusal (unit abno, unit emp) {
    int cell;

    if (emp == null || !UnitIsAlive(emp)) {
        return "Lob/Work/Refusal/NoEmployee";
    }
    if (Work_IsBusy(emp)) {
        return "Lob/Work/Refusal/Busy";
    }
    // Baseline 8's "refuse orders". Work_Tick already drops the work of anybody
    // who breaks mid-job, so without this the command was accepted and then
    // silently undone a tick later -- which reads as the button not working.
    if (Emp_IsPanicked(emp)) {
        return "Lob/Work/Refusal/Panicked";
    }
    if (gv_workCount >= c_workMax) {
        return "Lob/Work/Refusal/TooMany";
    }
    if (abno == null) {
        return "Lob/Work/Refusal/NoAbnormality";
    }
    if (AbnoGen_IndexOf(abno) < 0) {
        return "Lob/Work/Refusal/NoDocument";
    }

    cell = Cont_SlotOf(abno);
    if (cell < 0) {
        return "Lob/Work/Refusal/NotRegistered";
    }
    // A dropped door is exactly and only this: you cannot work on it. That is
    // the whole consequence for an abnormality that does not escape.
    if (!Cont_DoorIsUp(abno)) {
        return "Lob/Work/Refusal/DoorDown";
    }
    if (Cont_State(abno) != c_cellContained) {
        return "Lob/Work/Refusal/NotInCell";
    }
    if (GameGetMissionTime() < gvg_workReadyAt[cell]) {
        return "Lob/Work/Refusal/Cooldown";
    }
    return "";
}

bool Work_Begin (unit abno, unit emp, int work) {
    int cell;
    int index;

    if (Work_Refusal(abno, emp) != "") {
        return false;
    }
    index = AbnoGen_IndexOf(abno);
    cell = Cont_SlotOf(abno);

    gvg_workEmp[gv_workCount] = emp;
    gvg_workAbno[gv_workCount] = abno;
    gvg_workType[gv_workCount] = work;
    gvg_workBoxes[gv_workCount] = 0;
    gvg_workDone[gv_workCount] = 0;
    gvg_workNextBox[gv_workCount] = GameGetMissionTime() + Work_BoxInterval(emp, index);
    gv_workCount = gv_workCount + 1;

    // The meltdown clock answers to this, not to Work_Finish. Somebody has been
    // sent, which is the decision a meltdown was asking about.
    Melt_NoteWorkBegin(abno);

    // Order, not OrderTargetingPoint: stop takes no target, and handing it one
    // is a trigger error rather than a no-op.
    UnitIssueOrder(emp, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
    return true;
}

//--------------------------------------------------------------------------------------------------
// Drops row `slot`, keeping the rows dense by moving the last one into the gap.
//
// Every work leaves through here, finished or interrupted, which is why the
// meltdown clock is told about it here and nowhere else -- a held cell does not
// care which of the two it was.
//--------------------------------------------------------------------------------------------------
void Work_Drop (int slot) {
    int last;

    Melt_NoteWorkEnd(gvg_workAbno[slot]);

    last = gv_workCount - 1;
    gvg_workEmp[slot] = gvg_workEmp[last];
    gvg_workAbno[slot] = gvg_workAbno[last];
    gvg_workType[slot] = gvg_workType[last];
    gvg_workBoxes[slot] = gvg_workBoxes[last];
    gvg_workDone[slot] = gvg_workDone[last];
    gvg_workNextBox[slot] = gvg_workNextBox[last];
    gv_workCount = last;
}

text Work_NameText (int work) {
    if (work == c_workInsight) { return Msg("Lob/Work/Name/Insight"); }
    if (work == c_workAttachment) { return Msg("Lob/Work/Name/Attachment"); }
    if (work == c_workRepression) { return Msg("Lob/Work/Name/Repression"); }
    return Msg("Lob/Work/Name/Instinct");
}

text Work_ResultText (int result) {
    if (result == c_resultGood) { return Msg("Lob/Work/Result/Good"); }
    if (result == c_resultNormal) { return Msg("Lob/Work/Result/Normal"); }
    return Msg("Lob/Work/Result/Bad");
}

string Work_ResultName (int result) {
    if (result == c_resultGood) {
        return "Good";
    }
    if (result == c_resultNormal) {
        return "Normal";
    }
    return "Bad";
}

//--------------------------------------------------------------------------------------------------
// Pays out and clears the row.
//
// The result is the box count read against the doc's own ranges, so an
// abnormality that is generous about what counts as Good says so in its own
// file rather than here.
//--------------------------------------------------------------------------------------------------
void Work_Finish (int slot) {
    unit emp;
    unit abno;
    int index;
    int cell;
    int boxes;
    int result;
    int gain;
    int owner;

    emp = gvg_workEmp[slot];
    abno = gvg_workAbno[slot];
    index = AbnoGen_IndexOf(abno);
    cell = Cont_SlotOf(abno);
    boxes = gvg_workBoxes[slot];
    owner = UnitGetOwner(emp);

    result = c_resultBad;
    if (boxes >= gvg_abnoGoodMin[index]) {
        result = c_resultGood;
    }
    else if (boxes >= gvg_abnoNormalMin[index]) {
        result = c_resultNormal;
    }

    gain = c_workGainBad;
    if (result == c_resultGood) {
        gain = c_workGainGood;
    }
    else if (result == c_resultNormal) {
        gain = c_workGainNormal;
    }
    Emp_StatAdd(emp, Work_Stat(gvg_workType[slot]), gain);

    if (owner >= 1 && owner <= 15) {
        gvg_workFinished[owner] = gvg_workFinished[owner] + 1;
        if (result == c_resultGood) {
            gvg_workGood[owner] = gvg_workGood[owner] + 1;
        }
    }

    // Boxes pay twice, into two things that never mix: this player's stock for
    // this abnormality's encyclopedia, and the table's shared energy.
    Cont_AddBoxes(owner, index, boxes);
    Energy_Add(boxes);

    if (cell >= 0) {
        gvg_workReadyAt[cell] = GameGetMissionTime() + gvg_abnoCooldown[index];
    }

    UIDisplayMessage(
        PlayerGroupSingle(owner), c_messageAreaSubtitle,
        TextReplaceWord(
            TextReplaceWord(
                Msg3("Lob/Msg/WorkResult",
                     "%ABNORMALITY%", AbnoGen_NameText(index),
                     "%WORK%", Work_NameText(gvg_workType[slot]),
                     "%BOXES%", MsgInt(boxes)),
                StringToText("%RESULT%"), Work_ResultText(result),
                c_stringReplaceAll, c_stringCase),
            StringToText("%STAT%"),
            StringToText(IntToString(gain) + " ")
            + Emp_StatNameText(Work_Stat(gvg_workType[slot])),
            c_stringReplaceAll, c_stringCase));

    Work_Drop(slot);
}

//--------------------------------------------------------------------------------------------------
// One box attempt.
//
// The preference behind it is indexed by the employee's LEVEL in the matching
// stat, straight out of the abnormality's doc. Level, not value: the source
// tables are I to V, which is why an employee with 30 Prudence and one with 44
// are the same to an abnormality, and why the thresholds are worth caring about.
//--------------------------------------------------------------------------------------------------
void Work_RollBox (int slot) {
    unit emp;
    int index;

    emp = gvg_workEmp[slot];
    index = AbnoGen_IndexOf(gvg_workAbno[slot]);

    gvg_workDone[slot] = gvg_workDone[slot] + 1;
    if (RandomInt(1, 100) <= Work_SuccessChance(emp, index, gvg_workType[slot])) {
        gvg_workBoxes[slot] = gvg_workBoxes[slot] + 1;
    }
    else {
        // Whatever this abnormality charges, which is not always the mind. Its
        // own doc says which and how much, so a missed box on one thing is a bad
        // afternoon and on another it is a funeral.
        Emp_WorkDamage(emp, AbnoGen_DmgType(index), AbnoGen_DmgRoll(index));
    }

    gvg_workNextBox[slot] = GameGetMissionTime() + Work_BoxInterval(emp, index);
}

//--------------------------------------------------------------------------------------------------
// The work ability, cast and finished.
//
// The ability is Interact: an Effect-Target that does nothing and takes a
// second, aimed at a containment door. The engine draws the cast bar, the
// TargetFilters and the validator decide what can be aimed at, and this hears
// the cast complete.
//
// The first version read the employee's order queue and inferred intent from an
// order pointed at a door. It worked, and it was wrong in three ways at once:
// every move order near a cell became ambiguous, there was no cast bar to show,
// and there was no way to refuse a target. Right-click will come back later
// through SmartCast on this same ability, without any of this changing.
//
// Complete rather than Execute, so walking away during the cast really does
// cancel it -- which is the point of the cast having a length at all.
//--------------------------------------------------------------------------------------------------
bool Work_Cast_Func (bool testConds, bool runActions) {
    unit emp;
    unit door;
    unit abno;
    int slot;
    int owner;
    string why;

    if (!runActions) {
        return true;
    }

    emp = EventUnit();
    // EventUnitTargetUnit, not EventUnitAbilityOtherUnit. They sit two lines
    // apart in the natives file under the same heading, and the second one is
    // for abilities that involve a third party rather than for the thing you
    // clicked: it came back null here, so every cast landed on "that is not a
    // containment door".
    door = EventUnitTargetUnit();
    owner = UnitGetOwner(emp);

    // Registered on every stage and filtered here rather than on Complete
    // alone. A prepare-time cast walks -3, 0..5, -6, and knowing that took a
    // trace through every stage; keeping the registration broad means the next
    // question of that shape needs one line rather than a rebuild.
    if (EventUnitAbilityStage() != c_unitAbilStageComplete) {
        return true;
    }

    if (!ObjectsGen_IsEmp(emp)) {
        return true;
    }
    if (!Cont_IsDoor(door)) {
        UIDisplayMessage(PlayerGroupSingle(owner), c_messageAreaSubtitle,
                         Msg1("Lob/Work/NotADoor", "%UNIT%",
                              StringToText(UnitGetType(door))));
        return true;
    }

    slot = 0;
    while (slot < gv_cellCount) {
        if (Cont_DoorAt(gvg_cellHome[slot]) == door) {
            abno = gvg_cellAbno[slot];
            why = Work_Refusal(abno, emp);
            if (why != "") {
                UIDisplayMessage(PlayerGroupSingle(owner), c_messageAreaSubtitle,
                                 Msg1("Lob/Work/Refused", "%REASON%", Msg(why)));
                return true;
            }
            Work_Begin(abno, emp, Work_DefaultOf(owner));
            UIDisplayMessage(
                PlayerGroupSingle(owner), c_messageAreaSubtitle,
                Msg2("Lob/Msg/WorkBegin",
                     "%ABNORMALITY%", AbnoGen_NameText(AbnoGen_IndexOf(abno)),
                     "%WORK%", Work_NameText(Work_DefaultOf(owner))));
            return true;
        }
        slot = slot + 1;
    }

    UIDisplayMessage(PlayerGroupSingle(owner), c_messageAreaSubtitle,
                     Msg("Lob/Work/NoCell"));
    return true;
}

bool Work_Tick_Func (bool testConds, bool runActions) {
    fixed now;
    int index;
    int slot;

    if (!runActions) {
        return true;
    }

    now = GameGetMissionTime();

    // Backwards: finishing a row moves the last row into its place.
    slot = gv_workCount - 1;
    while (slot >= 0) {
        if (gvg_workEmp[slot] == null || !UnitIsAlive(gvg_workEmp[slot])
            || Emp_IsPanicked(gvg_workEmp[slot])
            || Cont_State(gvg_workAbno[slot]) != c_cellContained
            || !Cont_DoorIsUp(gvg_workAbno[slot])) {
            // Interrupted. The employee died or broke, the thing they were
            // working on got out, or the gate came down around it. Every one of
            // them ends the work where it stands and pays nothing.
            //
            // Panic is here rather than only in Work_Refusal because an employee
            // can break DURING a work -- a missed box is White damage, so a bad
            // enough work breaks the person doing it, and somebody who has
            // stopped functioning has stopped working.
            Work_Drop(slot);
        }
        else if (now >= gvg_workNextBox[slot]) {
            Work_RollBox(slot);
            index = AbnoGen_IndexOf(gvg_workAbno[slot]);
            if (gvg_workDone[slot] >= gvg_abnoMaxBox[index]) {
                Work_Finish(slot);
            }
        }
        slot = slot - 1;
    }

    return true;
}

void Work_Init () {
    int player;

    gvg_workName[c_workInstinct] = "Instinct";
    gvg_workName[c_workInsight] = "Insight";
    gvg_workName[c_workAttachment] = "Attachment";
    gvg_workName[c_workRepression] = "Repression";

    gvg_workStat[c_workInstinct] = c_statFortitude;
    gvg_workStat[c_workInsight] = c_statPrudence;
    gvg_workStat[c_workAttachment] = c_statTemperance;
    gvg_workStat[c_workRepression] = c_statJustice;

    gv_workCount = 0;

    player = 1;
    while (player <= 15) {
        gvg_workDefault[player] = c_workInstinct;
        gvg_workFinished[player] = 0;
        gvg_workGood[player] = 0;
        player = player + 1;
    }

    gt_workTick = TriggerCreate("Work_Tick_Func");
    TriggerAddEventTimePeriodic(gt_workTick, c_workTick, c_timeGame);

    gt_workCast = TriggerCreate("Work_Cast_Func");
    TriggerAddEventUnitAbility(gt_workCast, null, AbilityCommand(c_workAbil, 0),
                               c_unitAbilStageAll, true);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/15_hero.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// The player characters.
//
// P0's whole proposition is that clearing, fighting and repairing all want the
// same pair of hands. That only means anything if the hands exist, so this
// module owns the one unit each player actually drives: handing it over at
// start, and putting it back after it dies.
//
// Death costs time and nothing else, per the design baseline -- no resources
// lost, no lasting penalty on the character. The cost is the walk back plus
// whatever fell apart in the meantime, and that is a real cost precisely because
// the other two jobs do not pause while the player is dead.
//
// The character's type is read from the generated table rather than named here,
// so renaming the unit in the editor does not need a code change. If no Hero
// unit has been authored yet the module simply does nothing.
//
//--------------------------------------------------------------------------------------------------
// One per player, and it used to be one full stop.
//
// The old version kept a single gv_hero, took the FIRST hero unit on the map
// whoever owned it, and respawned it for player 1. On a six-player map that is
// five orphans: characters that belong to somebody, die once, and never come
// back, while player 1 quietly acquires a second body at their own home.
//
// Nothing about that was a shortcut worth keeping past the point where a second
// player existed, and build-order.md says so outright: new modules are written
// per player, and the ones carrying this debt get fixed when something touches
// them. Meltdown, energy and containment are all per player now, and they cannot
// be exercised at all through a single-player character layer.
//
// Respawn is a tick rather than a timer per player. TriggerAddEventTimer would
// need EventTimer() compared against sixteen handles to find out whose it was,
// which is more machinery than a loop that already has to exist -- and every
// other clock in this project (containment, meltdown, sector) is a tick.
//--------------------------------------------------------------------------------------------------

const fixed c_heroRespawnDelay = 15.0;
const fixed c_heroTick = 1.0;

unit[16] gvg_hero;
point[16] gvg_heroHome;
fixed[16] gvg_heroBackAt;
bool[16] gvg_heroHas;

trigger gt_heroDied;
trigger gt_heroTick;

unit Hero_Of (int player) {
    if (player < 1 || player > 15) {
        return null;
    }
    return gvg_hero[player];
}

point Hero_HomeOf (int player) {
    if (player < 1 || player > 15) {
        return Point(0.0, 0.0);
    }
    return gvg_heroHome[player];
}

//--------------------------------------------------------------------------------------------------
// Creates one player's character at their own home point.
//--------------------------------------------------------------------------------------------------
void Hero_Spawn (int player) {
    if (c_typesHeroCount == 0 || !gvg_heroHas[player]) {
        return;
    }

    // Ignoring placement is not optional. The home point may well be full of
    // zerglings at exactly the moment the character is due back, and "the player
    // does not respawn" is not a cost the design ever asked for.
    UnitCreate(1, gvg_typesHero[0], c_unitCreateIgnorePlacement,
               player, gvg_heroHome[player], 270.0);
    gvg_hero[player] = UnitLastCreated();
    UnitSelect(gvg_hero[player], player, true);
    CameraPan(player, gvg_heroHome[player], 0.0, -1.0, 10.0, true);
}

//--------------------------------------------------------------------------------------------------
// Any unit death, filtered down to a character. Same shape as the debris death
// handler in 25_clearing.galaxy, and for the same reason: it covers a character
// spawned at runtime, which after the first respawn is every character there
// will ever be.
//
// Whose it was comes off the unit rather than being looked up, which is the
// whole reason a per-player version costs nothing here.
//--------------------------------------------------------------------------------------------------
bool Hero_Died_Func (bool testConds, bool runActions) {
    unit who;
    int player;

    if (!runActions) {
        return true;
    }

    who = EventUnit();
    if (!ObjectsGen_IsHero(who)) {
        return true;
    }

    player = UnitGetOwner(who);
    if (player < 1 || player > 15) {
        return true;
    }

    gvg_hero[player] = null;
    gvg_heroBackAt[player] = GameGetMissionTime() + c_heroRespawnDelay;

    // To that player, because six characters dying over twenty minutes is six
    // messages everybody else cannot act on. A teammate being down matters, but
    // it belongs to whatever eventually draws a roster, not to the subtitle line
    // that meltdown and containment are both already using.
    UIDisplayMessage(
        PlayerGroupSingle(player), c_messageAreaSubtitle,
        Msg1("Lob/Msg/AgentDown", "%SECONDS%",
             MsgInt(FixedToInt(c_heroRespawnDelay))));
    return true;
}

bool Hero_Tick_Func (bool testConds, bool runActions) {
    fixed now;
    int player;

    if (!runActions) {
        return true;
    }

    now = GameGetMissionTime();
    player = 1;
    while (player <= 15) {
        if (gvg_heroHas[player]
            && (gvg_hero[player] == null || !UnitIsAlive(gvg_hero[player]))
            && now >= gvg_heroBackAt[player]) {
            Hero_Spawn(player);
        }
        player = player + 1;
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// Claims every character standing on the map for whoever owns it.
//
// Where the character was placed is where it comes back. Deliberately not a
// separate marker: a respawn point that can drift away from the start point is a
// bug waiting to happen, and nothing here would move it.
//
// A player who is at the table but has no character placed falls back to their
// core, so adding a sixth player to the map does not silently mean a sixth
// player with no hands. A player with neither is left alone -- there is nowhere
// to put them, and inventing a spot would drop somebody into the map at a
// position nobody chose.
//--------------------------------------------------------------------------------------------------
void Hero_Claim () {
    unitgroup heroes;
    unit who;
    unit core;
    int count;
    int i;
    int player;

    heroes = ObjectsGen_ScanHero();
    count = UnitGroupCount(heroes, c_unitCountAlive);

    i = 1;
    while (i <= count) {
        who = UnitGroupUnit(heroes, i);
        if (who != null) {
            player = UnitGetOwner(who);
            if (player >= 1 && player <= 15 && !gvg_heroHas[player]) {
                gvg_hero[player] = who;
                gvg_heroHome[player] = UnitGetPosition(who);
                gvg_heroHas[player] = true;
                UnitSelect(who, player, true);
                CameraPan(player, gvg_heroHome[player], 0.0, -1.0, 10.0, true);
            }
        }
        i = i + 1;
    }

    player = 1;
    while (player <= 15) {
        if (!gvg_heroHas[player] && Slot_IsTablePlayer(player)) {
            core = Sector_AnyCore(player);
            if (core != null) {
                gvg_heroHome[player] = UnitGetPosition(core);
                gvg_heroHas[player] = true;
                gvg_heroBackAt[player] = 0.0;
            }
        }
        player = player + 1;
    }
}

void Hero_Init () {
    int player;

    player = 1;
    while (player <= 15) {
        gvg_hero[player] = null;
        gvg_heroHas[player] = false;
        gvg_heroBackAt[player] = 0.0;
        player = player + 1;
    }

    Hero_Claim();

    gt_heroTick = TriggerCreate("Hero_Tick_Func");
    TriggerAddEventTimePeriodic(gt_heroTick, c_heroTick, c_timeGame);

    gt_heroDied = TriggerCreate("Hero_Died_Func");
    TriggerAddEventUnitDied(gt_heroDied, null);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/16_bank.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// The save file.
//
// Design 8.1 is the whole specification and it is one sentence: store unlocks,
// never numbers. The model is Risk of Rain 2 rather than Deep Rock -- what
// carries between games is the variety of what can show up, not how strong
// anybody is.
//
// So this saves the encyclopedia and nothing else, because the encyclopedia is
// the only thing on the persist list that exists yet:
//
//     observation level   how much of an abnormality a player has bought
//     PE-Boxes            what they have left to buy the next section with
//
// Both are per player AND per abnormality, and a bank is already per player, so
// the abnormality's own type id is the key and there is no player dimension
// inside the file at all.
//
// PE-Boxes are saved on purpose and it was asked for outright -- boxes count
// toward the save and buy that one abnormality's encyclopedia. They are not the
// kind of number 8.1 forbids: they buy knowledge, they never enter a combat
// calculation, and they cannot be moved to a different abnormality because the
// storage has no index that would let them.
//
// Not saved, because none of it exists: the abnormality unlock pool, quest
// progress, core suppression progress, department unlocks, titles, records.
// Each gets its own section when it arrives; nothing here has to change shape
// for them.
//
// Never saved, whatever happens: employee stats, upgrade levels, resources,
// energy. Design 8.2 gives three reasons and the first is the strongest -- a
// persisted number makes character strength a function of hours played rather
// than of skill, which is the highest design principle with the sign flipped.
//
//--------------------------------------------------------------------------------------------------
// The multiplayer part, which is the only hard part.
//
// A bank is a local file. Galaxy runs in lockstep on every machine, so reading
// a file that differs between machines and branching on it is a desync, not a
// bug you find later.
//
// The engine's answer is that a loaded bank is SYNCHRONIZED, and BankWait is the
// barrier that says the sync has landed. That is not deduced -- Blizzard's own
// campaign code does exactly this, and names the trigger it does it in
// "ArchivesBankLoadSyncComplete":
//
//     BankLoad(name, player)      then, in a trigger:  BankWait(bank)
//
// BankPreload looks like it belongs here and does not. It carries no FlagNative
// in NativeLib.TriggerLib and both its parameters are ParamFlagPreload, which
// makes it a compile-time declaration the editor collects rather than a function
// hand-written Galaxy can call.
//
// BankWait blocks, so it runs in its own trigger started with TriggerExecute's
// wait-for-it flag off. Init does not stall behind six file loads.
//
//--------------------------------------------------------------------------------------------------
// Two rules that stop this from eating somebody's save file:
//
//   Nothing is written until everything is read. An autosave that fired during
//   the load window would write a fresh empty table over a real save, and the
//   player who lost forty games of encyclopedia would have no way to tell what
//   happened. gv_bankLoaded gates every write.
//
//   Saving is driven by a comparison, not by a call. The modules that change
//   observation (13_containment buys a section, 14_work adds boxes) both sort
//   BEFORE this one and cannot call into it, and threading a dirty flag
//   backwards through the module order to fix that would be worse than the
//   thing it fixes. So this holds a snapshot of what it last wrote and saves
//   when the live tables stop matching it -- which is the same behaviour with
//   nobody having to remember to announce anything.
//
// The signature is on and nothing is gated on it. Design 8.2.3: the key is in
// the map script and can be extracted, and that is the strongest argument for
// storing only unlocks rather than a reason to fight. Editing a flag unlocks
// something you would have unlocked anyway; editing a number would ruin four
// other people's game, and there are no numbers here to edit.
//--------------------------------------------------------------------------------------------------

const string c_bankName = "LobotomyShiphold";
const string c_bankSecLevel = "observation";
const string c_bankSecBoxes = "boxes";

const fixed c_bankPeriod = 5.0;

bank[16] gvg_bank;
bool gv_bankLoaded;

// What was last written, in the same flattened layout 13_containment uses for
// the live tables.
int[1024] gvg_bankSavedLevel;
int[1024] gvg_bankSavedBoxes;

trigger gt_bankReady;
trigger gt_bankTick;

//--------------------------------------------------------------------------------------------------
// Reads one player's file into the live tables.
//--------------------------------------------------------------------------------------------------
void Bank_ReadPlayer (int player) {
    bank b;
    string key;
    int index;
    int i;

    b = gvg_bank[player];
    if (b == null) {
        return;
    }

    index = 0;
    while (index < c_abnoCount) {
        key = gvg_abnoType[index];
        i = Cont_BoxIndex(player, index);
        if (i >= 0) {
            if (BankKeyExists(b, c_bankSecLevel, key)) {
                gvg_obsLevel[i] = BankValueGetAsInt(b, c_bankSecLevel, key);
            }
            if (BankKeyExists(b, c_bankSecBoxes, key)) {
                gvg_obsBoxes[i] = BankValueGetAsInt(b, c_bankSecBoxes, key);
            }
        }
        index = index + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// Writes one player's file, and records what was written.
//--------------------------------------------------------------------------------------------------
void Bank_WritePlayer (int player) {
    bank b;
    string key;
    int index;
    int i;

    b = gvg_bank[player];
    if (b == null) {
        return;
    }

    BankSectionCreate(b, c_bankSecLevel);
    BankSectionCreate(b, c_bankSecBoxes);

    index = 0;
    while (index < c_abnoCount) {
        key = gvg_abnoType[index];
        i = Cont_BoxIndex(player, index);
        if (i >= 0) {
            BankValueSetFromInt(b, c_bankSecLevel, key, gvg_obsLevel[i]);
            BankValueSetFromInt(b, c_bankSecBoxes, key, gvg_obsBoxes[i]);
            gvg_bankSavedLevel[i] = gvg_obsLevel[i];
            gvg_bankSavedBoxes[i] = gvg_obsBoxes[i];
        }
        index = index + 1;
    }

    BankSave(b);
}

//--------------------------------------------------------------------------------------------------
// Whether this player's live tables have moved away from what is on disk.
//--------------------------------------------------------------------------------------------------
bool Bank_Dirty (int player) {
    int index;
    int i;

    index = 0;
    while (index < c_abnoCount) {
        i = Cont_BoxIndex(player, index);
        if (i >= 0
            && (gvg_bankSavedLevel[i] != gvg_obsLevel[i]
                || gvg_bankSavedBoxes[i] != gvg_obsBoxes[i])) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

void Bank_SaveAll () {
    int player;

    if (!gv_bankLoaded) {
        return;
    }
    player = 1;
    while (player <= 15) {
        if (Slot_IsTablePlayer(player) && Bank_Dirty(player)) {
            Bank_WritePlayer(player);
        }
        player = player + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// Throws a player's save away. Debug only, and the reason it exists is that
// "does a fresh account work" is otherwise a question you can only ask once.
//--------------------------------------------------------------------------------------------------
void Bank_Wipe (int player) {
    bank b;
    int index;
    int i;

    b = gvg_bank[player];
    if (b != null) {
        BankSectionRemove(b, c_bankSecLevel);
        BankSectionRemove(b, c_bankSecBoxes);
        BankSave(b);
    }

    index = 0;
    while (index < c_abnoCount) {
        i = Cont_BoxIndex(player, index);
        if (i >= 0) {
            gvg_obsLevel[i] = 0;
            gvg_obsBoxes[i] = 0;
            gvg_bankSavedLevel[i] = 0;
            gvg_bankSavedBoxes[i] = 0;
        }
        index = index + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// Waits out the sync, then reads. Its own trigger because BankWait blocks and
// InitMap must not.
//--------------------------------------------------------------------------------------------------
bool Bank_Ready_Func (bool testConds, bool runActions) {
    int player;

    if (!runActions) {
        return true;
    }

    player = 1;
    while (player <= 15) {
        if (gvg_bank[player] != null) {
            BankWait(gvg_bank[player]);
        }
        player = player + 1;
    }

    player = 1;
    while (player <= 15) {
        if (gvg_bank[player] != null) {
            Bank_ReadPlayer(player);
        }
        player = player + 1;
    }

    // Only now, and this ordering is the whole safety property: until the last
    // file has been read, every table in memory is a lie about somebody's save.
    gv_bankLoaded = true;
    return true;
}

bool Bank_Tick_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    Bank_SaveAll();
    return true;
}

void Bank_Init () {
    int player;
    int i;

    gv_bankLoaded = false;

    i = 0;
    while (i < 1024) {
        gvg_bankSavedLevel[i] = 0;
        gvg_bankSavedBoxes[i] = 0;
        i = i + 1;
    }

    player = 1;
    while (player <= 15) {
        gvg_bank[player] = null;
        if (Slot_IsTablePlayer(player)) {
            gvg_bank[player] = BankLoad(c_bankName, player);
            BankOptionSet(gvg_bank[player], c_bankOptionSignature, true);
        }
        player = player + 1;
    }

    gt_bankReady = TriggerCreate("Bank_Ready_Func");
    TriggerExecute(gt_bankReady, true, false);

    gt_bankTick = TriggerCreate("Bank_Tick_Func");
    TriggerAddEventTimePeriodic(gt_bankTick, c_bankPeriod, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/20_devices.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Resource devices.
//
// Devices hold up the power grid while intact, and lethal damage disables them
// instead of destroying them, per the design baseline.
//
// Both halves of that live in data rather than here:
//
//   Power is the engine's supply meter. An online device carries Food, so the
//   engine counts it into supplies-made by itself, per owning player, which is
//   exactly the independent grid the baseline asks for and costs nothing. The
//   readout is free and turns red on its own. Nothing in this file writes it.
//
//   Disablement is a unit type. A device that takes a killing blow is replaced
//   by Lob_DeviceDown_Basic, which carries no Food and so leaves the grid the
//   moment it appears, and which is Invulnerable -- and Invulnerable happens to
//   mean exactly the two things wanted here, because the zergling weapon's
//   target filters exclude it while the Repair ability's filters do not. So
//   nothing keeps chewing on a device that is already down, and an SCV or the
//   player can still work on it.
//
// This module is therefore only the two morphs and a count for the readout.
// There is no "is it disabled" flag, no health threshold standing in for one,
// and no supply bookkeeping -- asking which units exist answers all of it.
//--------------------------------------------------------------------------------------------------

const fixed c_devicePeriod = 1.0;

// Type-name prefixes. A device and its downed form differ only in this segment,
// so one is derived from the other rather than tabulated; adding a variant
// means authoring the pair in the editor and nothing here.
const string c_deviceUpPrefix = "Lob_Device_";
const string c_deviceDownPrefix = "Lob_DeviceDown_";

// Devices online on the last tick, and devices in total. Only the greybox
// readout needs these; the grid itself is the engine's business.
int gv_devicesOnline;
int gv_devicesTotal;

trigger gt_deviceFatal;
trigger gt_deviceTick;

//--------------------------------------------------------------------------------------------------
// Devices worth sending a worker to: anything down, plus anything still online
// but chipped. Down comes first because a downed device is off the grid, while
// a chipped one is still paying out.
//--------------------------------------------------------------------------------------------------
unitgroup Devices_Damaged () {
    unitgroup found;
    unitgroup online;
    unit device;
    int count;
    int i;

    found = ObjectsGen_ScanDeviceDown();

    online = ObjectsGen_ScanDevice();
    count = UnitGroupCount(online, c_unitCountAlive);
    i = 1;
    while (i <= count) {
        device = UnitGroupUnit(online, i);
        if (device != null && UnitGetPropertyFixed(device, c_unitPropLifePercent, true) < 99.0) {
            UnitGroupAdd(found, device);
        }
        i = i + 1;
    }
    return found;
}

//--------------------------------------------------------------------------------------------------
// Intercepts the killing blow and puts the downed device in its place.
//--------------------------------------------------------------------------------------------------
bool Devices_Fatal_Func (bool testConds, bool runActions) {
    unit victim;

    if (!runActions) {
        return true;
    }

    victim = EventUnit();
    if (!ObjectsGen_IsDevice(victim)) {
        return true;
    }

    Downable_TakeDown(victim, c_deviceUpPrefix, c_deviceDownPrefix);
    return true;
}

//--------------------------------------------------------------------------------------------------
// Brings repaired devices back onto the grid, and counts for the readout.
//--------------------------------------------------------------------------------------------------
bool Devices_Tick_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }

    Downable_RestoreRepaired(ObjectsGen_ScanDeviceDown(),
                             c_deviceDownPrefix, c_deviceUpPrefix);

    gv_devicesOnline = UnitGroupCount(ObjectsGen_ScanDevice(), c_unitCountAlive);
    gv_devicesTotal = gv_devicesOnline
                      + UnitGroupCount(ObjectsGen_ScanDeviceDown(), c_unitCountAlive);
    return true;
}

void Devices_Init () {
    gv_devicesOnline = 0;
    gv_devicesTotal = 0;

    gt_deviceFatal = TriggerCreate("Devices_Fatal_Func");
    TriggerAddEventUnitDamaged(gt_deviceFatal, null, c_unitDamageTypeAny, c_unitDamageFatal, null);

    gt_deviceTick = TriggerCreate("Devices_Tick_Func");
    TriggerAddEventTimePeriodic(gt_deviceTick, c_devicePeriod, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/25_clearing.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Debris clearing.
//
// Clearing is modelled as damage, not as a custom progress bar: debris is a
// destructible with a large health pool, and both the player and the workers
// clear it by attacking it. That buys the health bar as progress feedback for
// free, and makes the "player clears far faster than a worker" curve a pure
// weapon-damage question that lives in data where it can be tuned, rather than
// in two hand-written rate constants here.
//
// Worker assignment lives in 30_workers.galaxy; this module only owns what
// clearing pays out.
//--------------------------------------------------------------------------------------------------

// Credit banked into the ore pile when a piece of debris is finished off.
//
// The pile is a real harvestable node, so this is the only place the number
// exists: from here on the engine owns it, and turning it into spendable
// resources is miners walking to it and carrying it back. Nothing converts it
// on their behalf.
// Sized against how long the pile then takes to drain, not against how much a
// piece of debris "should" be worth. At 25 the two starting miners ate a whole
// debris in five seconds, so the pile was empty essentially always -- which
// makes miner headcount irrelevant and quietly guts the separate miner upgrade
// line in baseline section 5.2. At 120 a debris is about 24 seconds of mining
// against about 30 seconds of a player clearing it, so the pile backs up as
// soon as the workers help, and more miners start being worth something.
const int c_oreCreditPerDebris = 120;

int gv_debrisCleared;

trigger gt_debrisDied;

//--------------------------------------------------------------------------------------------------
// Any unit death, filtered down to debris. Cheaper and far less bookkeeping
// than registering a death event per placed object, and it covers debris
// spawned at runtime for free -- which is where debris is headed.
//--------------------------------------------------------------------------------------------------
bool Clearing_DebrisDied_Func (bool testConds, bool runActions) {
    unit pile;

    if (!runActions) {
        return true;
    }
    if (!ObjectsGen_IsDebris(EventUnit())) {
        return true;
    }

    // Nearest pile, not "the" pile. With one sector that is the same thing;
    // with several it is the only reading that does not quietly pay a sector
    // for work done on the far side of the ship.
    pile = UnitGroupClosestToPoint(ObjectsGen_ScanPile(), UnitGetPosition(EventUnit()));
    if (pile != null) {
        UnitSetPropertyInt(pile, c_unitPropResources,
                           UnitGetPropertyInt(pile, c_unitPropResources, true)
                           + c_oreCreditPerDebris);
    }
    gv_debrisCleared = gv_debrisCleared + 1;
    return true;
}

void Clearing_Init () {
    gv_debrisCleared = 0;

    gt_debrisDied = TriggerCreate("Clearing_DebrisDied_Func");
    TriggerAddEventUnitDied(gt_debrisDied, null);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/26_fortify.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Fortifications.
//
// Rules from docs/usr/Defense.md. Baseline 6.2 asked for fixed positions and an
// upgrade button rather than free placement, and that document says what goes in
// the positions and what happens when a level lands.
//
// A LOCATION is a room or a corridor. The distinction is flavour -- both are
// regions with fortification positions in them and both take a level -- so
// nothing here branches on which kind it is.
//
//--------------------------------------------------------------------------------------------------
// Money and time are two separate costs, and that is the whole mechanic.
//
// The upgrade completes instantly and the location stays at that level however
// many buildings are destroyed. What does NOT happen instantly is the buildings:
// worker SCVs have to walk over and put them up, and they repair and rebuild for
// free forever after. So paying is a decision about minerals and getting the
// benefit is a decision about how many workers you built ten minutes ago.
//
// Two rules bite together and produce something worth noticing: a level cannot
// be bought until the previous level is fully standing, and buildings under
// sustained attack never finish. So A LOCATION THAT IS BEING OVERRUN CANNOT BE
// REINFORCED. You have to win the fight first and buy the answer afterwards,
// which is the opposite of panic-buying and is deliberate.
//
//--------------------------------------------------------------------------------------------------
// Free repair is free because the buildings cost nothing.
//
// SC2's Repair charges a fraction of the unit's own Cost, so "SCVs rebuild at no
// charge" is a data decision rather than a script: give the fortification
// buildings Cost 0 and take the minerals on the upgrade instead. Repair and
// rebuild are then free with nothing written.
//
// The same choice makes construction free too, which is why a building is put up
// at a sliver of life and left to the workers. That is not a simulation of
// construction, it IS the construction: build time becomes repair time, repair
// time falls with the number of workers, and "更多的scv让修建和修复都更快" comes
// out without a build-time constant existing anywhere.
//
//--------------------------------------------------------------------------------------------------
// The editor side: place the REAL unit, then it is read and deleted.
//
//     region  room_* / corridor_*     a location
//     group   fort1 / fort2 / fort3   a position, at that level
//
// Put the actual Lob_Turret_Basic or Lob_Guard_Marine exactly where it should
// stand and add it to the group for its level. At init this reads its type,
// position, facing and owner, then removes it. Building it later re-creates the
// same unit, in the same spot, facing the same way.
//
// This replaced a marker scheme -- Lob_Fort_L2_Guard_Marine parsed apart to mean
// "level 2, becomes Lob_Guard_Marine" -- and it is better on every count. There
// is no parallel marker unit to author, no string parsing, no naming convention
// to remember or mistype. Most of all it is WYSIWYG: a marker cannot tell you
// whether the turret actually FITS, and a turret placed in the editor is checked
// by the editor's own placement rules for free. Facing comes along for nothing,
// which a marker would have needed another channel for.
//
// The level moves to the editor group, which is a channel this project already
// has and which is preplaced-only -- exactly what a fixed position is.
//
// REMOVED rather than hidden, and that is the one part worth arguing. Hiding is
// possible: c_unitStateHidden is writable, as are Selectable, Targetable and
// Paused. But a hidden unit still occupies its footprint, so a level-3 turret
// emplacement would block its corridor from minute zero, and there is no unit
// state that turns pathing off. Hiding also means four flags that all have to be
// right, where each one forgotten is a bug that looks like something else --
// stray splash killing an invisible turret, a selection box catching nothing.
// Reading four fields and deleting the unit has none of that, and the editor
// still shows exactly what will be there.
//
// Whether a position is occupied is asked SPATIALLY -- is there a unit of that
// type standing on the spot -- so nothing bookkeeps which building belongs to
// which slot, and a building that dies simply makes its slot empty again.
//
// Anything whose type falls under Lob_Guard_* is garrison and warps in; anything
// else is a building and gets built. That is the only thing the distinction is
// for.
//
//--------------------------------------------------------------------------------------------------
// Positions are indexed once. Enemies arrive on an event.
//
// Positions cannot move -- they are gone from the map after init -- so their
// location, level and product are settled once and never asked again.
//
// Enemy presence is the opposite kind of fact: it changes constantly and is
// almost always "no", so it is an event rather than a poll.
// TriggerAddEventUnitRegion on each location fires when something walks in, and
// the garrison is roused from there. Polling every location every second to
// discover that nothing has happened is the same waste in the other direction.
//
// What is left on a timer is only "an idle guard has drifted off its post",
// which is genuinely periodic and iterates the indexed slots rather than the map.
//
//--------------------------------------------------------------------------------------------------
// Garrison arrives once per level, and death is permanent until the next one.
//
// Warping in happens the FIRST time a level's buildings all stand, and upgrading
// also tops up the dead from earlier levels. Rebuilding after a massacre does
// not. So a location whose garrison is wiped stays weaker until somebody spends
// money on it, or until a production building in the room or Central Command's
// passive replaces them -- neither of which exists yet, and both are noted where
// they go.
//
// That makes losing garrison genuinely cost something, which a free respawn
// would not.
//--------------------------------------------------------------------------------------------------

const int c_fortMaxLevel = 3;

// TUNING, all of it. Minerals for each step up. Nobody has designed an economy
// curve and these are placeholders that make the mechanic visible.
int[4] gvg_fortCost;

const fixed c_fortTick = 2.0;

// How close a unit has to be to a position to count as standing on it.
const fixed c_fortSlotRadius = 1.5;

// And how far an enemy has to be for the position to be usable at all. An
// occupied slot is refused rather than contested: docs/usr/Defense.md has the
// worker cancel and go do something else, which a command queue then covers.
const fixed c_fortEnemyRadius = 4.0;

// How far a garrison unit may drift from its post before being sent back.
const fixed c_fortPostSlack = 2.0;

// Editor groups: fort1, fort2, fort3.
const string c_fortGroupPrefix = "fort";

const int c_locMax = 32;
const int c_slotMax = 128;

int gv_locCount;
string[32] gvg_locName;
region[32] gvg_locRegion;
point[32] gvg_locCenter;
int[32] gvg_locLevel;

// Whether this location's level has ever stood complete, flattened
// location * 4 + level. What makes garrison a one-time arrival.
bool[128] gvg_locSeeded;

// Every fortification position on the map, read off the preplaced units before
// they were removed.
int gv_slotCount;
string[128] gvg_slotType;
point[128] gvg_slotAt;
fixed[128] gvg_slotFacing;
int[128] gvg_slotLoc;
int[128] gvg_slotLevel;
int[128] gvg_slotOwner;
bool[128] gvg_slotGuard;

// What is standing in this position right now, if anything.
//
// A HANDLE, not a type and not a flag. The occupancy test used to be spatial --
// "is a unit of gvg_slotType standing on this spot" -- and that was wrong twice
// over, because a unit type is not a stable identity and a slot's occupant does
// not have to stay on its spot:
//
//   a turret that BURROWS changes type. PerditionTurret morphs to
//   PerditionTurretUnderground when idle, the search stopped finding it, the
//   slot read empty, and workers stacked turret after turret on the same tile.
//
//   a guard that has been ROUSED walks away. Fort_Rouse could not find it to
//   give it a second order, and the post-drift check could not send it home,
//   because both looked at the spot rather than at the unit.
//
// This is not the bookkeeping the module avoids elsewhere. A tally of what is
// built could disagree with the world; a unit handle IS the world, and
// UnitIsAlive answers for it. What was replaced was not a ledger, it was a
// DESCRIPTION being used as an identity -- and the description turned out to
// fit more than one thing and fewer than all of them.
unit[128] gvg_slotUnit;

trigger gt_fortTick;
trigger gt_fortEnter;
trigger gt_fortBuilt;

//--------------------------------------------------------------------------------------------------
// Locations.
//--------------------------------------------------------------------------------------------------
int Fort_LocOfPoint (point where) {
    int i;

    i = 0;
    while (i < gv_locCount) {
        if (RegionContainsPoint(gvg_locRegion[i], where)) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

//--------------------------------------------------------------------------------------------------
// Is this unit in the same place as that point?
//
// A LOC is the honest answer -- a corridor's drawn region is what "the room"
// means, and it is what stops an explosion in one hallway from being felt
// through a wall. The radius is a fallback for a point that is in no drawn
// region at all, which most of the map still is: an effect that quietly hits
// nobody reads as a broken mechanic rather than as an unfinished map.
//
// Lives here because locations live here, and because two callers in two later
// files want the same question -- a worm coming up out of the floor and a robot
// finishing somebody are the same shape of "everyone who was standing there".
//--------------------------------------------------------------------------------------------------
bool Fort_InRoom (unit who, point at, int loc, fixed reach) {
    if (who == null || !UnitIsAlive(who)) {
        return false;
    }
    if (loc >= 0 && loc < gv_locCount) {
        return RegionContainsPoint(gvg_locRegion[loc], UnitGetPosition(who));
    }
    return DistanceBetweenPoints(UnitGetPosition(who), at) <= reach;
}

int Fort_LocByName (string name) {
    int i;

    i = 0;
    while (i < gv_locCount) {
        if (gvg_locName[i] == name) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

int Fort_LevelOf (int loc) {
    if (loc < 0 || loc >= gv_locCount) {
        return 0;
    }
    return gvg_locLevel[loc];
}

//--------------------------------------------------------------------------------------------------
// Whose location this is: the same spatial question the containment cells ask,
// answered the same way.
//
// The region's centre rather than anything that walks into it, because this has
// to be answerable for an EMPTY room -- who may upgrade it, and who the
// buildings will belong to, are both questions asked before anybody is there.
//--------------------------------------------------------------------------------------------------
int Fort_OwnerOf (int loc) {
    if (loc < 0 || loc >= gv_locCount) {
        return 0;
    }
    return Sector_OwnerNear(gvg_locCenter[loc]);
}

//--------------------------------------------------------------------------------------------------
// Levels bought across everything this player owns, added up.
//
// Safety Team 1 is "升级4个（累积等级）房间或走廊" -- four levels wherever they
// sit, so one corridor at 3 and one room at 1 is the same as four rooms at 1.
// The parenthesis in the doc is doing the work: it says accumulated LEVELS, not
// four separate places.
//
// Reads the level rather than counting standing buildings, because the level is
// what was paid for. A location whose emplacements have just been flattened has
// not un-bought them, and the design already says the level never falls.
//--------------------------------------------------------------------------------------------------
int Fort_LevelSumOf (int player) {
    int total;
    int loc;

    if (!Slot_IsTablePlayer(player)) {
        return 0;
    }

    total = 0;
    loc = 0;
    while (loc < gv_locCount) {
        if (Fort_OwnerOf(loc) == player) {
            total = total + gvg_locLevel[loc];
        }
        loc = loc + 1;
    }
    return total;
}

//--------------------------------------------------------------------------------------------------
// Whose a position's occupant should be. The editor's own answer first, so
// placing an emplacement under a specific player overrides the geometry.
//--------------------------------------------------------------------------------------------------
int Fort_SlotOwner (int slot) {
    if (slot < 0 || slot >= gv_slotCount) {
        return 0;
    }
    if (Slot_IsTablePlayer(gvg_slotOwner[slot])) {
        return gvg_slotOwner[slot];
    }
    return Fort_OwnerOf(gvg_slotLoc[slot]);
}

//--------------------------------------------------------------------------------------------------
// Positions, and whether they are occupied.
//--------------------------------------------------------------------------------------------------
unit Fort_OccupantOfSlot (int slot) {
    if (slot < 0 || slot >= gv_slotCount) {
        return null;
    }
    if (gvg_slotUnit[slot] == null || !UnitIsAlive(gvg_slotUnit[slot])) {
        return null;
    }
    return gvg_slotUnit[slot];
}

bool Fort_SlotFilled (int slot) {
    return Fort_OccupantOfSlot(slot) != null;
}

//--------------------------------------------------------------------------------------------------
// Whether what is standing there is still going up.
//--------------------------------------------------------------------------------------------------
bool Fort_SlotBuilding (int slot) {
    unit who;

    who = Fort_OccupantOfSlot(slot);
    return who != null && UnitTestState(who, c_unitStateUnderConstruction);
}

bool Fort_IsEnemyOf (unit who, int owner) {
    unitgroup one;

    if (who == null || owner < 1 || owner > 15) {
        return false;
    }
    one = UnitGroupEmpty();
    UnitGroupAdd(one, who);
    return UnitGroupCount(UnitGroupFilterAlliance(one, owner, c_unitAllianceEnemy, 0),
                          c_unitCountAlive) > 0;
}

bool Fort_SlotBlocked (int slot, int owner) {
    if (owner < 1 || owner > 15) {
        return false;
    }
    // Enemies only. An ally standing on the spot is not an obstacle, because the
    // building is created ignoring placement -- which is exactly the doc's
    // "friendly in the way means build anyway".
    return UnitCountAlliance(owner, c_unitAllianceEnemy,
                             RegionCircle(gvg_slotAt[slot], c_fortEnemyRadius),
                             null, c_unitCountAlive) > 0;
}

//--------------------------------------------------------------------------------------------------
// Whether every building up to a level is standing. Buildings only -- garrison
// arrives because the buildings are done, so waiting on it would deadlock.
//--------------------------------------------------------------------------------------------------
bool Fort_BuildingsComplete (int loc, int level) {
    int slot;

    slot = 0;
    while (slot < gv_slotCount) {
        // Under construction is NOT complete. Counting it would warp the
        // garrison into a room whose turrets are still holes in the ground, and
        // make the next level buyable before this one exists.
        if (gvg_slotLoc[slot] == loc && !gvg_slotGuard[slot]
            && gvg_slotLevel[slot] <= level
            && (!Fort_SlotFilled(slot) || Fort_SlotBuilding(slot))) {
            return false;
        }
        slot = slot + 1;
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// Putting a thing in a position, which is two different jobs.
//
// A GUARD is conjured whole. It is not built, it warps in, and UnitCreate is
// the honest expression of that.
//
// A BUILDING is ORDERED, not created. The worker is issued the map's own build
// command at the position and the engine does the rest: the placement ghost
// while it walks, the site put down at almost no life, the SCV locked to it,
// the timer, the cancel button. Two earlier attempts tried to imitate that
// from the outside and both failed in ways worth remembering:
//
//   life 8% + repair       Repair's TargetFilters exclude UnderConstruction, so
//                          an SCV is not permitted to repair an unfinished
//                          building. The order was rejected outright. And a
//                          Terran structure under a third life burns, so every
//                          emplacement began by quietly killing itself.
//
//   c_unitCreateConstruct  produces the finished unit wearing a site's
//                          appearance -- full life, and it shoots. There is no
//                          construction happening, only a costume.
//
// The lesson both times: construction is not a state you can paint onto a unit
// from outside, it is a relationship between a worker and a site that only the
// build ability creates. So the code stops trying to be the builder and becomes
// the thing that tells a builder what to build.
//
// The pair (ability, command index) comes from ObjectsGen, read out of the
// map's AbilData.xml at build time. Nothing else can supply it: the index is
// the position of a row in a CAbilBuild's InfoArray and it moves whenever
// somebody inserts a row above it.
//--------------------------------------------------------------------------------------------------
unit Fort_Warp (int slot) {
    unit made;
    int owner;

    owner = Fort_SlotOwner(slot);
    if (owner < 1 || owner > 15) {
        return null;
    }

    UnitCreate(1, gvg_slotType[slot], c_unitCreateIgnorePlacement, owner,
               gvg_slotAt[slot], gvg_slotFacing[slot]);
    made = UnitLastCreated();
    gvg_slotUnit[slot] = made;
    return made;
}

//--------------------------------------------------------------------------------------------------
// Whether anything can order this position built at all.
//--------------------------------------------------------------------------------------------------
bool Fort_SlotBuildable (int slot) {
    return ObjectsGen_BuildIndex(gvg_slotType[slot]) >= 0;
}

//--------------------------------------------------------------------------------------------------
// Whether a worker is already on its way to build here.
//
// Asked of the world rather than remembered: a worker's current order carries
// the ability and the point it is aimed at, so "somebody is already doing this"
// is a question the game can answer. A claim written down here would outlive
// the worker that made it.
//--------------------------------------------------------------------------------------------------
bool Fort_SlotClaimed (int slot) {
    unitgroup workers;
    unit who;
    string abil;
    int count;
    int i;

    abil = ObjectsGen_BuildAbil(gvg_slotType[slot]);
    if (abil == "") {
        return false;
    }

    workers = ObjectsGen_ScanSCV_Worker();
    count = UnitGroupCount(workers, c_unitCountAlive);
    i = 1;
    while (i <= count) {
        who = UnitGroupUnit(workers, i);
        if (who != null && UnitOrderCount(who) > 0 && UnitOrderHasAbil(who, abil)
            && DistanceBetweenPoints(OrderGetTargetPoint(UnitOrder(who, 0)),
                                     gvg_slotAt[slot]) <= c_fortSlotRadius) {
            return true;
        }
        i = i + 1;
    }
    return false;
}


//--------------------------------------------------------------------------------------------------
// Garrison arrival.
//
// `upTo` is inclusive. `replaceOnly` skips levels that have never landed, so
// upgrading tops up what is missing without pre-delivering the level being
// bought -- that one waits for its buildings.
//--------------------------------------------------------------------------------------------------
void Fort_SeedGarrison (int loc, int upTo, bool replaceOnly) {
    int slot;
    int lvl;

    slot = 0;
    while (slot < gv_slotCount) {
        lvl = gvg_slotLevel[slot];
        if (gvg_slotLoc[slot] == loc && gvg_slotGuard[slot] && lvl <= upTo
            && (!replaceOnly || gvg_locSeeded[loc * 4 + lvl])
            && !Fort_SlotFilled(slot)) {
            Fort_Warp(slot);
        }
        slot = slot + 1;
    }

    if (!replaceOnly) {
        lvl = 1;
        while (lvl <= upTo) {
            gvg_locSeeded[loc * 4 + lvl] = true;
            lvl = lvl + 1;
        }
    }
}

//--------------------------------------------------------------------------------------------------
// Upgrading.
//
// A reason rather than a bare false, the same as Work_Refusal: a button that
// does nothing is the same bug for a player and for whoever has to debug it.
//--------------------------------------------------------------------------------------------------
string Fort_UpgradeRefusal (int player, int loc) {
    if (loc < 0 || loc >= gv_locCount) {
        return "no such location";
    }
    if (!Slot_IsTablePlayer(player)) {
        return "not a player";
    }
    if (gvg_locLevel[loc] >= c_fortMaxLevel) {
        return "already at maximum";
    }
    if (!Fort_BuildingsComplete(loc, gvg_locLevel[loc])) {
        return "the current level is not finished being built";
    }
    if (PlayerGetPropertyInt(player, c_playerPropMinerals)
        < gvg_fortCost[gvg_locLevel[loc] + 1]) {
        return "not enough minerals";
    }
    // Cross-department permission is Control Team's business and lives in
    // usr/department.md: lv1 allows other sectors to level 1, lv2 to level 3,
    // lv3 and lv4 without limit. There is no upgrade tree in the map yet, so
    // nothing is refused here rather than something being invented.
    return "";
}

bool Fort_Upgrade (int player, int loc) {
    int cost;

    if (Fort_UpgradeRefusal(player, loc) != "") {
        return false;
    }

    cost = gvg_fortCost[gvg_locLevel[loc] + 1];
    PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSubtract, cost);
    gvg_locLevel[loc] = gvg_locLevel[loc] + 1;

    // Topping up earlier levels' dead garrison is part of buying a level, per
    // the doc. It happens now rather than when the new buildings finish, because
    // the earlier levels are already standing.
    Fort_SeedGarrison(loc, gvg_locLevel[loc] - 1, true);

    UIDisplayMessage(
        PlayerGroupAll(), c_messageAreaSubtitle,
        Msg2("Lob/Msg/FortLevel",
             "%PLACE%", StringToText(gvg_locName[loc]),
             "%LEVEL%", MsgInt(gvg_locLevel[loc])));
    return true;
}

//--------------------------------------------------------------------------------------------------
// Which emplacement a worker should go build, or -1.
//
// Asked by 30_workers before it considers devices or debris, which is the
// ordering docs/usr/Defense.md gives: a worker clears debris when it has nothing
// else to do.
//
// Nearest wins, so a worker does not walk past a hole to reach another one.
//
// A position is a job only if its level has been PAID FOR. gvg_slotLevel is
// what the position needs; gvg_locLevel is what the location has bought. An
// unbought position is not late, it does not exist yet.
//--------------------------------------------------------------------------------------------------
int Fort_JobFor (unit worker) {
    point where;
    fixed best;
    fixed d;
    int found;
    int slot;

    if (worker == null) {
        return -1;
    }

    where = UnitGetPosition(worker);
    found = -1;
    best = 0.0;

    slot = 0;
    while (slot < gv_slotCount) {
        if (!gvg_slotGuard[slot]
            && gvg_slotLevel[slot] <= Fort_LevelOf(gvg_slotLoc[slot])
            && !Fort_SlotFilled(slot)
            && Fort_SlotBuildable(slot)
            && !Fort_SlotBlocked(slot, Fort_SlotOwner(slot))
            && !Fort_SlotClaimed(slot)) {
            d = DistanceBetweenPoints(where, gvg_slotAt[slot]);
            if (found < 0 || d < best) {
                found = slot;
                best = d;
            }
        }
        slot = slot + 1;
    }
    return found;
}

//--------------------------------------------------------------------------------------------------
// Sends a worker to build a position.
//
// One order, and the engine owns everything after it -- the walk, the ghost,
// the site, the timer. There is no arrival check here any more because there is
// nothing to do on arrival: the previous version had to watch for the worker
// getting close so it could conjure the building itself, which is exactly the
// job this hands back.
//--------------------------------------------------------------------------------------------------
void Fort_OrderBuild (unit worker, int slot) {
    string abil;

    if (slot < 0 || slot >= gv_slotCount || worker == null) {
        return;
    }
    abil = ObjectsGen_BuildAbil(gvg_slotType[slot]);
    if (abil == "") {
        return;
    }

    UnitIssueOrder(
        worker,
        OrderTargetingPoint(AbilityCommand(abil, ObjectsGen_BuildIndex(gvg_slotType[slot])),
                            gvg_slotAt[slot]),
        c_orderQueueReplace);
}

//--------------------------------------------------------------------------------------------------
// Damaged fortification buildings, so 30_workers can repair them alongside
// devices.
//
// Walks the SLOTS rather than scanning for Lob_Turret_*, which is what it used
// to do. Two reasons, and the second is the one that bit: a slot knows what is
// standing in it whatever that thing is called, so a stock PerditionTurret
// dropped in for a test is repaired exactly like an authored one -- where the
// type scan quietly returned nothing and left the building at 8% life with a
// worker walking away from it.
//
// Guards are skipped. They are units, they are not built, and a wounded marine
// is not a job for an SCV.
//--------------------------------------------------------------------------------------------------
unitgroup Fort_Damaged () {
    unitgroup found;
    unit who;
    int slot;

    found = UnitGroupEmpty();
    slot = 0;
    while (slot < gv_slotCount) {
        if (!gvg_slotGuard[slot]) {
            who = Fort_OccupantOfSlot(slot);
            if (who != null && !Fort_SlotBuilding(slot)
                && UnitGetPropertyFixed(who, c_unitPropLifePercent, true) < 100.0) {
                UnitGroupAdd(found, who);
            }
        }
        slot = slot + 1;
    }
    return found;
}

//--------------------------------------------------------------------------------------------------
// A building binds to its position the moment it appears.
//
// Fort_Warp can record a guard's handle because it created the guard. A BUILDING
// is created by the engine partway through a build order, so the only moment the
// code can learn its handle is when it shows up -- hence an event, not a search.
//
// Without this gvg_slotUnit is never written for a building at all, the position
// reads empty forever, and the ONLY thing preventing a second turret is SC2's own
// placement check. That check stops applying the moment the turret retracts: the
// underground unit has no Footprint, so its tiles go free and the build order
// that was being refused every second suddenly succeeds.
//
// That is the third stack-of-turrets bug and the first two fixes were both real
// -- the search really did lose a burrowed turret, and a handle really is a
// better identity than a description. Neither was this, because nothing was
// filling the handle in.
//
// Matching is by position and type at BIRTH, which is not the identity mistake
// that was removed: the site is born as exactly what the position asked for, and
// after this instant the handle answers on its own.
//--------------------------------------------------------------------------------------------------
bool Fort_Built_Func (bool testConds, bool runActions) {
    unit made;
    point at;
    fixed best;
    fixed d;
    int found;
    int slot;

    if (!runActions) {
        return true;
    }

    made = EventUnitCreatedUnit();
    if (made == null) {
        return true;
    }
    at = UnitGetPosition(made);

    found = -1;
    best = 0.0;
    slot = 0;
    while (slot < gv_slotCount) {
        if (!gvg_slotGuard[slot] && !Fort_SlotFilled(slot)
            && UnitGetType(made) == gvg_slotType[slot]) {
            d = DistanceBetweenPoints(at, gvg_slotAt[slot]);
            if (d <= c_fortSlotRadius && (found < 0 || d < best)) {
                found = slot;
                best = d;
            }
        }
        slot = slot + 1;
    }

    if (found >= 0) {
        gvg_slotUnit[found] = made;
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// Something walked into a location.
//
// An event rather than a poll: enemy presence changes constantly and is almost
// always "no", so asking every location every second is a lot of work to learn
// nothing. This fires only when it is actually true.
//
// The whole garrison answers, which is the doc's rule -- one turret engaging
// pulls everybody at that location onto the same target. Read as "an enemy is
// here" rather than "a turret has a target", because a structure weapon firing
// on its own is not a thing script can reliably ask about.
//--------------------------------------------------------------------------------------------------
void Fort_Rouse (int loc, unit foe) {
    unit who;
    int slot;

    slot = 0;
    while (slot < gv_slotCount) {
        if (gvg_slotLoc[slot] == loc && gvg_slotGuard[slot]) {
            who = Fort_OccupantOfSlot(slot);
            if (who != null && UnitIsAlive(who)) {
                UnitIssueOrder(who, OrderTargetingUnit(AbilityCommand("attack", 0), foe),
                               c_orderQueueReplace);
            }
        }
        slot = slot + 1;
    }
}

bool Fort_Enter_Func (bool testConds, bool runActions) {
    unit who;
    int loc;

    if (!runActions) {
        return true;
    }

    who = EventUnit();
    if (who == null || !UnitIsAlive(who)) {
        return true;
    }

    loc = Fort_LocOfPoint(UnitGetPosition(who));
    if (loc >= 0 && Fort_IsEnemyOf(who, Fort_OwnerOf(loc))) {
        Fort_Rouse(loc, who);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// The only thing left that is genuinely periodic: a level that has just finished
// standing, and guards that have wandered off their posts.
//--------------------------------------------------------------------------------------------------
bool Fort_Tick_Func (bool testConds, bool runActions) {
    unit who;
    int loc;
    int slot;

    if (!runActions) {
        return true;
    }

    loc = 0;
    while (loc < gv_locCount) {
        // A level that has just finished standing for the first time delivers
        // its garrison. Rebuilding after a massacre does not come through here,
        // because the flag is already set.
        if (gvg_locLevel[loc] > 0
            && !gvg_locSeeded[loc * 4 + gvg_locLevel[loc]]
            && Fort_BuildingsComplete(loc, gvg_locLevel[loc])) {
            Fort_SeedGarrison(loc, gvg_locLevel[loc], false);
        }
        loc = loc + 1;
    }

    slot = 0;
    while (slot < gv_slotCount) {
        if (gvg_slotGuard[slot]) {
            who = Fort_OccupantOfSlot(slot);
            if (who != null && UnitOrderCount(who) == 0
                && DistanceBetweenPoints(UnitGetPosition(who), gvg_slotAt[slot])
                   > c_fortPostSlack) {
                UnitIssueOrder(who,
                               OrderTargetingPoint(AbilityCommand("move", 0), gvg_slotAt[slot]),
                               c_orderQueueReplace);
            }
        }
        slot = slot + 1;
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// Every room and corridor drawn in the editor, and every emplacement standing in
// one -- read off the real unit and then deleted.
//
// Everything is read BEFORE the removal, because after it the handle is a dead
// unit and every one of these questions answers wrong.
//--------------------------------------------------------------------------------------------------
void Fort_ReadLevel (int level) {
    unitgroup placed;
    unit who;
    int count;
    int loc;
    int i;

    placed = ObjectsGen_Group(c_fortGroupPrefix + IntToString(level));
    count = UnitGroupCount(placed, c_unitCountAlive);

    i = 1;
    while (i <= count && gv_slotCount < c_slotMax) {
        who = UnitGroupUnit(placed, i);
        if (who != null) {
            loc = Fort_LocOfPoint(UnitGetPosition(who));
            if (loc >= 0) {
                gvg_slotType[gv_slotCount] = UnitGetType(who);
                gvg_slotAt[gv_slotCount] = UnitGetPosition(who);
                gvg_slotFacing[gv_slotCount] = UnitGetFacing(who);
                gvg_slotOwner[gv_slotCount] = UnitGetOwner(who);
                gvg_slotGuard[gv_slotCount] = ObjectsGen_IsGuard(who);
                gvg_slotLoc[gv_slotCount] = loc;
                gvg_slotLevel[gv_slotCount] = level;
                gv_slotCount = gv_slotCount + 1;
            }
            // Gone either way. An emplacement outside every location has no
            // level to belong to, and leaving it standing would be a free
            // turret nobody paid for.
            UnitRemove(who);
        }
        i = i + 1;
    }
}

void Fort_BuildRegistry () {
    string name;
    int i;

    gv_locCount = 0;
    i = 0;
    while (i < c_regionCount && gv_locCount < c_locMax) {
        name = gvg_regionNames[i];
        if (StringSub(name, 1, 5) == "room_" || StringSub(name, 1, 9) == "corridor_") {
            gvg_locName[gv_locCount] = name;
            gvg_locRegion[gv_locCount] = ObjectsGen_Region(name);
            gvg_locCenter[gv_locCount] = RegionGetCenter(gvg_locRegion[gv_locCount]);
            gvg_locLevel[gv_locCount] = 0;
            gv_locCount = gv_locCount + 1;
        }
        i = i + 1;
    }

    gv_slotCount = 0;
    i = 1;
    while (i <= c_fortMaxLevel) {
        Fort_ReadLevel(i);
        i = i + 1;
    }
}

void Fortify_Init () {
    int i;

    gvg_fortCost[0] = 0;
    gvg_fortCost[1] = 150;
    gvg_fortCost[2] = 300;
    gvg_fortCost[3] = 600;

    i = 0;
    while (i < 128) {
        gvg_locSeeded[i] = false;
        i = i + 1;
    }

    Fort_BuildRegistry();

    gt_fortEnter = TriggerCreate("Fort_Enter_Func");
    i = 0;
    while (i < gv_locCount) {
        TriggerAddEventUnitRegion(gt_fortEnter, null, gvg_locRegion[i], true);
        i = i + 1;
    }

    // No ability filter. Filtering on the build ability's name would be tidier,
    // but there is one such name per building type and the handler already has
    // to prove the unit is standing on a position that wants exactly it -- so
    // the filter would buy nothing and could quietly match nothing.
    gt_fortBuilt = TriggerCreate("Fort_Built_Func");
    TriggerAddEventUnitCreated(gt_fortBuilt, null, null, null);

    gt_fortTick = TriggerCreate("Fort_Tick_Func");
    TriggerAddEventTimePeriodic(gt_fortTick, c_fortTick, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/27_ordeals.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Ordeals.
//
// The meltdown clock's other output. 13_meltdown turns a level into cells that
// have to be worked; this turns the same level into something that walks in and
// has to be killed. Both are the same pressure arriving through two doors, which
// is why nothing here has a timer of its own -- an Ordeal is not scheduled, it
// is a CONSEQUENCE of a meltdown level, and giving it an independent clock would
// let the two drift into arriving together by accident.
//
//   meltdown 2        -> Dawn
//   meltdown 3, 4, 5  -> Noon
//   meltdown 6, 7     -> Dusk
//   meltdown 8 and up -> Midnight
//
// Difficulty is a CEILING on the tier, not a schedule (Diff_OrdealCap, and the
// reasoning is in systems/difficulty.md). It SKIPS rather than clamps: on Casual
// the Dawn arrives and nothing after it does, because one Ordeal per tier per
// game is the schedule and a capped tier is a tier that does not happen. Clamping
// would have kept handing out Dawns at meltdown 3, 6 and 8 -- the same fight
// four times for four different rewards, which reads as padding rather than as
// an easier night.
//
// WHICH Ordeal is drawn from the units that exist. Lob_Ordeal_Dawn_Amber lands
// in the generated Ordeal_Dawn table, so the pool for a tier is whatever has
// been authored for it -- adding an Ordeal is building a unit, and this file
// does not change. A tier with no units draws nothing and says so.
//
// The next one is rolled the moment the previous is scheduled, because the
// design requires the players to KNOW what is coming and at which meltdown
// level. That is the whole tactical content of an Ordeal for the ten minutes
// before it lands: you cannot prepare for a surprise.
//
// Numbered 27 because it reads locations off 26_fortify and is called by nobody.
//--------------------------------------------------------------------------------------------------

// Percent of the shared energy target paid for suppressing one, by tier.
//
// Of the TARGET rather than of the pool, so an Ordeal is worth the same whether
// it arrives while you are flush or while you are scraping -- which is the point,
// since the tier is already the difficulty axis and the pool is not.
int[4] gvg_ordealRewardPct;

const fixed c_ordealTick = 1.0;

// Spawned entities, by handle. Same argument as the fortification slots: a
// handle IS the world, where a count could disagree with it.
const int c_ordealUnitMax = 64;
unit[64] gvg_ordealUnit;
int gv_ordealCount;

// What is running, if anything.
bool gv_ordealActive;
int gv_ordealTier;
string gv_ordealType;
int gv_ordealKilled;

// What is coming, and when. gv_ordealNextType is "" when a tier has no units
// authored yet, which is the inert-not-broken case.
int gv_ordealNextLevel;
int gv_ordealNextTier;
string gv_ordealNextType;

// The meltdown level each tier arrives at, drawn once at init from that tier's
// range, and whether it has already happened. One Ordeal per tier per game.
int[4] gvg_ordealAtLevel;
bool[4] gvg_ordealSpent;

//--------------------------------------------------------------------------------------------------
// What an Ordeal DOES beyond existing and being killable.
//
// Most of an Ordeal is unit data -- life, damage, speed, the four defences --
// and needs nothing here. Three of the dawns are not: Crimson robs cells and
// moves on, Violet is a timer that ends the night early if it is ignored, and
// Amber will not stay in the hallway you found it in. None of the three is
// expressible as a stat.
//
// The type-to-behaviour map is a hardcoded list in Ordeal_ActOf, which is worth
// being uncomfortable about: it is the one place an Ordeal's unit id has to be
// spelled out in script. It stays a list rather than a channel because there is
// no per-type value channel yet and inventing one here is what the standing note
// in build-order.md forbids. A type not in the list simply fights.
//--------------------------------------------------------------------------------------------------
const int c_ordealActPlain = 0;
const int c_ordealActThief = 1;
const int c_ordealActBomb = 2;
const int c_ordealActDigger = 3;

int gv_ordealAct;

// The ability a thief casts on a containment door. Its PrepTime IS the twenty
// seconds and the engine draws the bar; nothing here counts them.
const string c_ordealRobAbil = "Lob_Ordeal_Rob";

// Percent of that cell's PE boxes it leaves with.
const int c_ordealRobPct = 30;

// How long a bomb waits. Drawn per entity, so the departments do not all go up
// on the same second.
const fixed c_ordealFuseMin = 60.0;
const fixed c_ordealFuseMax = 70.0;

// White damage the burst does to everybody in that department.
const int c_ordealBurstMin = 10;
const int c_ordealBurstMax = 14;

// What a thief's corpse does. Red, in a radius, and it is the ONLY damage a
// Crimson Dawn ever deals -- they walk past employees without touching them,
// which is what makes ignoring one until it is convenient a real temptation.
// The doc measures the radius in spear lengths.
const int c_ordealBlastMin = 10;
const int c_ordealBlastMax = 15;
const fixed c_ordealBlastRadius = 2.0;

// How long a worm stays in one hallway before it goes under. The wiki's 40-60
// seconds, drawn per entity so the departments do not all lose sight of theirs
// on the same second.
const fixed c_ordealDigMin = 40.0;
const fixed c_ordealDigMax = 60.0;

// What comes up with it: Red on everyone standing where it surfaces. Small,
// because the point of a relocation is that it MOVED, not that it hit.
const int c_ordealSproutMin = 1;
const int c_ordealSproutMax = 2;
const fixed c_ordealSproutReach = 4.0;

// The dig, which is a CAST rather than a burrow.
//
// A real burrow is a CAbilMorph pair and it was written and thrown away, for a
// reason that had nothing to do with the script: THERE IS NO WORM MODEL. The
// Locust standing in for one has no Burrow animation to sink with -- stock's
// own LocustMP actor carries the burrow macros by template and has never once
// run them, because a Locust cannot burrow -- so the honest version of a
// morph would have been a Locust popping out of existence.
//
// What the mechanic actually needs is: a delay the player can see and
// interrupt, and a relocation. A cast is both, and it costs one ability with a
// PrepTime and no effect. The dirt is two detached models, the same way both
// explosions in this file are.
//
// Everything the morph forced is gone with it: no second CUnit, no duplicated
// defence table, no ability ids to discover, no window in which the worm is
// underground and unkillable.
const string c_ordealDigAbil = "Lob_Ordeal_Dig";

// The puffs, and these are ACTORS rather than models -- the difference matters
// and it is the one thing about this that cannot be guessed. Both explosions in
// this file name a CModel (DOM_Explosion_Sm, ArchonMergeExplosion) and get
// dropped with CreateModelAtPoint, which wraps the model in a generic actor
// that plays whatever the model does by default. The dirt is not that: the
// model is BurrowFXSmall for BOTH directions, and which of them you see is
// which ANIMATION the actor plays. So the actor is the thing to create.
//
// Down is stock's own, which has no host and can therefore be dropped at a
// point. Up is a copy of stock's minus the host, because stock's belongs to the
// unit climbing out of the ground and ours has nothing to belong to. See
// Lob_Dig_Up in ActorData.
const string c_ordealDigDownActor = "SmallBurrowDownEffects";
const string c_ordealDigUpActor = "Lob_Dig_Up";

// The two explosions, as pictures. See Ordeal_Boom for why they are only that.
const string c_ordealBlastModel = "DOM_Explosion_Sm";
const string c_ordealGlowModel = "ArchonMergeExplosion";

// Close enough to a door to start casting at it. The same number as the
// ability's Range and as Interact's, and it has to be: a door is a wall
// footprint, so range is measured from a centre nothing can stand on.
const fixed c_ordealReach = 4.0;

// Per entity, parallel to gvg_ordealUnit.
//
//   gvg_ordealHome   the department it belongs to -- a bomb's burst is scoped
//                    to it, and a thief prefers its own cells
//   gvg_ordealMark   the cell a thief is walking to or working on
//   gvg_ordealAt     the entity's one deadline, and each act reads it as its
//                    own: a bomb's fuse burning out, a worm's stay in this
//                    hallway running out. A thief has none -- its twenty
//                    seconds belong to the ability, not to this file
int[64] gvg_ordealHome;
unit[64] gvg_ordealMark;
fixed[64] gvg_ordealAt;

int Ordeal_ActOf (string type) {
    if (type == "Lob_Ordeal_Dawn_Crimson") {
        return c_ordealActThief;
    }
    if (type == "Lob_Ordeal_Dawn_Violet") {
        return c_ordealActBomb;
    }
    if (type == "Lob_Ordeal_Dawn_Amber") {
        return c_ordealActDigger;
    }
    return c_ordealActPlain;
}

int gv_ordealObj;

// Ordeals suppressed this game, by tier. Table-wide, because an Ordeal is:
// every department gets one entity and it is over when the last of them falls,
// so there is no per-player half of it to count. Control Team 4 and
// Disciplinary Team 4 read this.
int[4] gvg_ordealBeaten;

trigger gt_ordealTick;
trigger gt_ordealRob;
trigger gt_ordealDeath;
trigger gt_ordealDug;

//--------------------------------------------------------------------------------------------------
// How many Ordeals of at least this tier have been put down.
//
// At LEAST, because "survive a Dusk Ordeal" is satisfied by a Midnight. A task
// that asked for exactly a Dusk would get harder as the night got worse, which
// is backwards.
//--------------------------------------------------------------------------------------------------
int Ordeal_BeatenAtLeast (int tier) {
    int total;
    int i;

    total = 0;
    i = tier;
    while (i < c_diffCount) {
        if (i >= 0) {
            total = total + gvg_ordealBeaten[i];
        }
        i = i + 1;
    }
    return total;
}

//--------------------------------------------------------------------------------------------------
// The meltdown levels a tier is allowed to arrive at.
//
//   Dawn      2
//   Noon      3, 4, 5
//   Dusk      6, 7
//   Midnight  8
//
// A RANGE, not a set of separate occasions. Each tier happens exactly once in a
// game and the level inside its range is drawn at init, which is why the whole
// schedule can be announced before it starts. Reading the ranges as "every level
// in them" gave three Noons and then a Midnight at every level from 8 upward,
// and an Ordeal that keeps coming back is not an escalation, it is a wave timer
// wearing an Ordeal's name.
//--------------------------------------------------------------------------------------------------
int Ordeal_LevelMin (int tier) {
    if (tier == c_ordealDawn) { return 2; }
    if (tier == c_ordealNoon) { return 3; }
    if (tier == c_ordealDusk) { return 6; }
    if (tier == c_ordealMidnight) { return 8; }
    return 0;
}

int Ordeal_LevelMax (int tier) {
    if (tier == c_ordealDawn) { return 2; }
    if (tier == c_ordealNoon) { return 5; }
    if (tier == c_ordealDusk) { return 7; }
    if (tier == c_ordealMidnight) { return 8; }
    return 0;
}

//--------------------------------------------------------------------------------------------------
// Every type authored for a tier, drawable or not.
//
// Galaxy has no array parameters, so a tier cannot be looked up in a table --
// hence the four-way branch. It is written twice rather than once because the
// alternative is copying the type names into a table this file owns, and then
// there would be two lists of Ordeals that could disagree.
//--------------------------------------------------------------------------------------------------
int Ordeal_TierSize (int tier) {
    if (tier == c_ordealDawn) { return c_typesOrdeal_DawnCount; }
    if (tier == c_ordealNoon) { return c_typesOrdeal_NoonCount; }
    if (tier == c_ordealDusk) { return c_typesOrdeal_DuskCount; }
    if (tier == c_ordealMidnight) { return c_typesOrdeal_MidnightCount; }
    return 0;
}

string Ordeal_TierAt (int tier, int i) {
    if (i < 0 || i >= Ordeal_TierSize(tier)) {
        return "";
    }
    if (tier == c_ordealDawn) { return gvg_typesOrdeal_Dawn[i]; }
    if (tier == c_ordealNoon) { return gvg_typesOrdeal_Noon[i]; }
    if (tier == c_ordealDusk) { return gvg_typesOrdeal_Dusk[i]; }
    if (tier == c_ordealMidnight) { return gvg_typesOrdeal_Midnight[i]; }
    return "";
}

//--------------------------------------------------------------------------------------------------
// A unit that is the OTHER SHAPE of an Ordeal rather than an Ordeal.
//
// NOTHING CURRENTLY MATCHES THIS, and it is kept anyway. It was written for a
// burrowed worm that no longer exists -- Amber changes hallways by casting, not
// by morphing -- but the trap it caught is not hypothetical and is not about
// worms: a morph needs a second CUnit, the id convention that puts that CUnit
// in the right generated table (Lob_Turret_Fire_Underground is the map's, and
// the turret is a live example) ALSO drops it into the tier's DRAW POOL, and
// then one night in N opens with an Ordeal in a shape nothing will ever order
// out of. Silently: it spawns, and the night simply never starts.
//
// Naming such a form outside the Ordeal_ namespace would dodge the pool and
// break every scan that has to find it, so the suffix is load-bearing in both
// directions. Deleting this because the one thing it protected went away is
// how the bug comes back.
//--------------------------------------------------------------------------------------------------
const string c_ordealFormSuffix = "_Underground";

bool Ordeal_IsForm (string type) {
    return StringContains(type, c_ordealFormSuffix, c_stringEnd, c_stringNoCase);
}

//--------------------------------------------------------------------------------------------------
// The same tier, less the alternate forms: what a draw is allowed to land on.
//--------------------------------------------------------------------------------------------------
int Ordeal_PoolSize (int tier) {
    int size;
    int found;
    int i;

    size = Ordeal_TierSize(tier);
    found = 0;
    i = 0;
    while (i < size) {
        if (!Ordeal_IsForm(Ordeal_TierAt(tier, i))) {
            found = found + 1;
        }
        i = i + 1;
    }
    return found;
}

string Ordeal_PoolAt (int tier, int i) {
    int size;
    int j;

    if (i < 0) {
        return "";
    }
    size = Ordeal_TierSize(tier);
    j = 0;
    while (j < size) {
        if (!Ordeal_IsForm(Ordeal_TierAt(tier, j))) {
            if (i == 0) {
                return Ordeal_TierAt(tier, j);
            }
            i = i - 1;
        }
        j = j + 1;
    }
    return "";
}

string Ordeal_Draw (int tier) {
    int size;

    size = Ordeal_PoolSize(tier);
    if (size <= 0) {
        return "";
    }
    return Ordeal_PoolAt(tier, RandomInt(0, size - 1));
}

//--------------------------------------------------------------------------------------------------
// What to call one, for a player to read.
//
// The unit's own display name, not a second string of ours. The editor already
// wrote Unit/Name/Lob_Ordeal_Dawn_Amber and the panel already shows it; a
// parallel Lob/ key would be a copy free to drift from the thing it names.
//--------------------------------------------------------------------------------------------------
text Ordeal_NameOf (string type) {
    if (type == "") {
        return StringExternal("Lob/Ordeal/None");
    }
    return StringExternal("Unit/Name/" + type);
}

int Ordeal_RewardFor (int tier) {
    if (tier < 0 || tier >= c_diffCount) {
        return 0;
    }
    return gv_energyGoal * gvg_ordealRewardPct[tier] / 100;
}

//--------------------------------------------------------------------------------------------------
// The objective line, which is a STATUS line rather than a thing to complete.
//
// One line that says either what is coming or what is here. Bonus, because an
// Ordeal pays energy and energy is spent when the ship leaves -- the same
// reasoning that makes the energy target itself a bonus objective.
//--------------------------------------------------------------------------------------------------
void Ordeal_Refresh () {
    if (gv_ordealObj == c_invalidObjectiveId) {
        return;
    }

    if (gv_ordealActive) {
        ObjectiveSetName(
            gv_ordealObj,
            TextReplaceWord(StringExternal("Lob/Objective/Ordeal/Here"),
                            StringToText("%NAME%"), Ordeal_NameOf(gv_ordealType),
                            c_stringReplaceAll, c_stringCase)
            + StringToText(" <s val=\"" + c_questProgressStyle + "\">("
                           + IntToString(gv_ordealKilled) + "/"
                           + IntToString(gv_ordealCount) + ")</s>"));
        return;
    }

    if (gv_ordealNextType == "") {
        ObjectiveSetName(gv_ordealObj, StringExternal("Lob/Objective/Ordeal/Nothing"));
        return;
    }

    ObjectiveSetName(
        gv_ordealObj,
        TextReplaceWord(
            TextReplaceWord(StringExternal("Lob/Objective/Ordeal/Next"),
                            StringToText("%NAME%"), Ordeal_NameOf(gv_ordealNextType),
                            c_stringReplaceAll, c_stringCase),
            StringToText("%LEVEL%"), IntToText(gv_ordealNextLevel),
            c_stringReplaceAll, c_stringCase));
}

//--------------------------------------------------------------------------------------------------
// Picks the next tier that has not happened yet, and tells everybody.
//
// Called after each Ordeal is dispatched rather than when it is defeated, so
// the warning is as early as it can possibly be. An Ordeal announced while it
// is already walking down the corridor is not a warning.
//
// Difficulty SKIPS rather than clamps. On Casual the night has one Ordeal in it
// and then no more -- clamping instead would have meant a Dawn at every level
// forever, which is not a gentler night, it is a longer one.
//--------------------------------------------------------------------------------------------------
void Ordeal_ScheduleNext () {
    int tier;

    gv_ordealNextTier = -1;
    gv_ordealNextType = "";
    gv_ordealNextLevel = 0;

    tier = 0;
    while (tier < c_diffCount) {
        if (!gvg_ordealSpent[tier] && tier <= Diff_OrdealCap()) {
            gv_ordealNextTier = tier;
            gv_ordealNextLevel = gvg_ordealAtLevel[tier];
            gv_ordealNextType = Ordeal_Draw(tier);
            tier = c_diffCount;
        }
        else {
            tier = tier + 1;
        }
    }

    Ordeal_Refresh();

    if (gv_ordealNextType != "") {
        UIDisplayMessage(
            PlayerGroupAll(), c_messageAreaSubtitle,
            Msg2("Lob/Msg/OrdealNext",
                 "%NAME%", Ordeal_NameOf(gv_ordealNextType),
                 "%LEVEL%", MsgInt(gv_ordealNextLevel)));
    }
}

//--------------------------------------------------------------------------------------------------
// One of a player's corridors or rooms, at random, or -1 if they have none.
//
// AVOID is a loc to leave out of the draw, which is what makes a worm's
// relocation a relocation: coming up in the hallway you just left reads as the
// mechanic being broken, not as bad luck. Pass -1 to draw from all of them.
//
// A department with exactly one drawn location has nowhere else to be, and the
// draw falls back to including it rather than returning nothing -- staying put
// is the honest answer to "go somewhere else" when there is no somewhere else,
// and it still costs the room the sprout.
//--------------------------------------------------------------------------------------------------
int Ordeal_HallFor (int player, int avoid) {
    int found;
    int pick;
    int loc;

    found = 0;
    loc = 0;
    while (loc < gv_locCount) {
        if (Fort_OwnerOf(loc) == player && loc != avoid) {
            found = found + 1;
        }
        loc = loc + 1;
    }

    if (found == 0) {
        if (avoid >= 0) {
            return Ordeal_HallFor(player, -1);
        }
        return -1;
    }

    pick = RandomInt(1, found);
    loc = 0;
    while (loc < gv_locCount) {
        if (Fort_OwnerOf(loc) == player && loc != avoid) {
            pick = pick - 1;
            if (pick == 0) {
                return loc;
            }
        }
        loc = loc + 1;
    }
    return -1;
}

//--------------------------------------------------------------------------------------------------
// Where one entity belonging to a player appears.
//
// A corridor or room of theirs, chosen at random, which is the doc's "one per
// department in a random hallway". Their core is the fallback for a sector with
// no regions drawn yet, so the system works before the editor side is finished
// rather than silently spawning nothing.
//--------------------------------------------------------------------------------------------------
point Ordeal_SpawnPointFor (int player) {
    unit core;
    int loc;

    loc = Ordeal_HallFor(player, -1);
    if (loc >= 0) {
        return gvg_locCenter[loc];
    }

    core = Sector_AnyCore(player);
    if (core != null) {
        return UnitGetPosition(core);
    }
    return Point(0.0, 0.0);
}

//--------------------------------------------------------------------------------------------------
// A cell a thief could rob: a contained abnormality with a door still up.
//
// Its own department first, any department second. The doc has the clowns
// spawning in a hallway that has a Containment Unit's door, so a department
// with no cells at all should not make them stand still -- it should make them
// somebody else's problem, which is the same thing the meltdown does.
//--------------------------------------------------------------------------------------------------
unit Ordeal_CellFor (int player, bool ownOnly) {
    unit abno;
    int found;
    int pick;
    int slot;

    found = 0;
    slot = 0;
    while (slot < gv_cellCount) {
        abno = gvg_cellAbno[slot];
        if (abno != null && UnitIsAlive(abno) && Cont_State(abno) == c_cellContained
            && Cont_DoorIsUp(abno)
            && (!ownOnly || Cont_OwnerOf(slot) == player)) {
            found = found + 1;
        }
        slot = slot + 1;
    }

    if (found == 0) {
        if (ownOnly) {
            return Ordeal_CellFor(player, false);
        }
        return null;
    }

    pick = RandomInt(1, found);
    slot = 0;
    while (slot < gv_cellCount) {
        abno = gvg_cellAbno[slot];
        if (abno != null && UnitIsAlive(abno) && Cont_State(abno) == c_cellContained
            && Cont_DoorIsUp(abno)
            && (!ownOnly || Cont_OwnerOf(slot) == player)) {
            pick = pick - 1;
            if (pick == 0) {
                return abno;
            }
        }
        slot = slot + 1;
    }
    return null;
}

//--------------------------------------------------------------------------------------------------
// What a thief leaves with: 30% of that cell's boxes, and one off the counter.
//
// The boxes come off the CELL OWNER's pile, because that is whose research it
// was. The counter is the part that hurts on a delay -- a cell one step closer
// to zero is a breach that has not happened yet.
//--------------------------------------------------------------------------------------------------
void Ordeal_Rob (unit abno) {
    int slot;
    int owner;
    int index;
    int taken;

    slot = Cont_SlotOf(abno);
    index = AbnoGen_IndexOf(abno);
    if (slot < 0 || index < 0) {
        return;
    }
    owner = Cont_OwnerOf(slot);

    taken = 0;
    if (owner >= 1 && owner <= 15) {
        taken = Cont_BoxesOf(owner, index) * c_ordealRobPct / 100;
        Cont_AddBoxes(owner, index, -taken);
    }
    if (Cont_Counter(abno) > 0) {
        Cont_SetCounter(abno, Cont_Counter(abno) - 1);
    }

    // Told to the person whose cell it was. A theft nobody is told about is
    // indistinguishable from a bug in the counter.
    if (owner >= 1 && owner <= 15) {
        UIDisplayMessage(
            PlayerGroupSingle(owner), c_messageAreaSubtitle,
            Msg3("Lob/Msg/OrdealRobbed",
                 "%NAME%", Ordeal_NameOf(gv_ordealType),
                 "%ABNO%", AbnoGen_NameText(index),
                 "%BOXES%", MsgInt(taken)));
    }
}

//--------------------------------------------------------------------------------------------------
// One thief, once a tick.
//
// Three states and no flags to hold them: walking (has a mark, not there yet),
// working (gvg_ordealAt is set), and between jobs (no mark). Each is a question
// about the world rather than a bit somebody remembered to clear.
//--------------------------------------------------------------------------------------------------
void Ordeal_ThiefStep (int i) {
    unit who;
    unit door;

    who = gvg_ordealUnit[i];
    if (who == null || !UnitIsAlive(who)) {
        return;
    }

    // Already casting, or walking to somewhere to cast. The ability carries the
    // approach and the twenty seconds with it, so an entity with an order is an
    // entity with nothing to decide.
    if (UnitOrderCount(who) > 0) {
        return;
    }

    if (gvg_ordealMark[i] == null || !UnitIsAlive(gvg_ordealMark[i])
        || Cont_State(gvg_ordealMark[i]) != c_cellContained) {
        gvg_ordealMark[i] = Ordeal_CellFor(gvg_ordealHome[i], true);
    }
    if (gvg_ordealMark[i] == null) {
        return;
    }

    // The DOOR, never the abnormality. The abnormality is behind a wall the
    // clown cannot path through, so an order aimed at it is an order that never
    // arrives -- which is exactly what the first version did, silently.
    door = Cont_DoorOf(gvg_ordealMark[i]);
    if (door == null) {
        gvg_ordealMark[i] = null;
        return;
    }

    UnitIssueOrder(who,
                   OrderTargetingUnit(AbilityCommand(c_ordealRobAbil, 0), door),
                   c_orderQueueReplace);
}

//--------------------------------------------------------------------------------------------------
// A robbery finished.
//
// Heard rather than counted. The ability's PrepTime is the twenty seconds, so
// dying halfway through means this never fires and nothing was taken -- which is
// the fight the clown is supposed to be worth having, and which a script timer
// would have had to reimplement badly.
//
// Registered on every stage and filtered here, the same way 14_work does it,
// because the stage sequence of a prepare-time cast is not obvious and finding
// it out again would be a second trace through the same ground.
//--------------------------------------------------------------------------------------------------
bool Ordeal_Rob_Func (bool testConds, bool runActions) {
    unit who;
    unit door;
    int i;
    int slot;

    if (!runActions) {
        return true;
    }
    if (EventUnitAbilityStage() != c_unitAbilStageComplete) {
        return true;
    }

    who = EventUnit();
    door = EventUnitTargetUnit();
    if (who == null || door == null) {
        return true;
    }

    slot = 0;
    while (slot < gv_cellCount) {
        if (Cont_DoorAt(gvg_cellHome[slot]) == door) {
            Ordeal_Rob(gvg_cellAbno[slot]);
            slot = gv_cellCount;
        }
        else {
            slot = slot + 1;
        }
    }

    // The smoke cloud: it leaves the cell it just robbed and turns up somewhere
    // else in its own department, then picks a new one on the next tick.
    i = 0;
    while (i < gv_ordealCount) {
        if (gvg_ordealUnit[i] == who) {
            gvg_ordealMark[i] = null;
            UnitSetPosition(who, Ordeal_SpawnPointFor(gvg_ordealHome[i]), false);
            i = gv_ordealCount;
        }
        else {
            i = i + 1;
        }
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// An explosion, in two halves: the picture and the numbers.
//
// The picture is a detached model dropped at a point, and that is all the
// catalog does for either of these. The numbers are Emp_CombatDamage, in script.
// That split is not a shortcut taken to avoid learning the effect system -- it
// is forced, three times over, and it is worth writing down because a copied
// Baneling burst looks like it would do the job:
//
//   CEffectDamage cannot say White. The engine has Amount and Kind
//   (Melee / Ranged / Splash / Ability) and no field anywhere that means "spend
//   sanity", because sanity is ours and nothing in the catalog has heard of it.
//   Violet's burst is White, so a catalog effect cannot deal even part of it.
//
//   CEffectDamage cannot say "the department". AreaArray is a radius, and
//   Violet's burst is scoped to the employees ASSIGNED to a sector -- who may be
//   standing anywhere on the map, including next to somebody else's cells. A
//   radius wide enough to catch them all would also catch the ones it must not.
//
//   Crimson's blast IS Red, which the engine could deal honestly, and it still
//   must not. Damage dealt by the engine never passes through Emp_CombatDamage,
//   so it would skip Emp_DamageScale -- the seam E.G.O resistance lands on -- skip
//   the rule that an employee at zero life dies outright rather than going to a
//   downed state that does not exist, and skip Emp_DamageShown, which is where
//   the Information Team's damage numbers are going to be read from. One funnel,
//   or half the damage in this game is invisible.
//
// So: no CAbilEffectInstant, no CEffectDamage, no suicide effect. A model and a
// function call.
//--------------------------------------------------------------------------------------------------
void Ordeal_Boom (point at, string model) {
    if (at == null) {
        return;
    }
    libNtve_gf_CreateModelAtPoint(model, at);
}

//--------------------------------------------------------------------------------------------------
// The same idea one level up: an ACTOR at a point, not a model.
//
// A model gets wrapped in a generic actor that plays the model's default, which
// is all an explosion needs. The dirt needs more than that -- down and up are
// one model and two animations -- so what has to be created is the actor that
// knows which animation to play. Both of the ones used here destroy themselves
// when their animation finishes, so nothing owns them afterwards.
//--------------------------------------------------------------------------------------------------
void Ordeal_Puff (point at, string actorId) {
    if (at == null) {
        return;
    }
    libNtve_gf_CreateActorAtPoint(actorId, at);
}

//--------------------------------------------------------------------------------------------------
// Everybody of one kind close enough to the corpse.
//
// Split out because employees and players are two scans and the same rule, and
// because a player standing over the thing they just killed should eat the blast
// -- being the one holding the weapon is not cover.
//--------------------------------------------------------------------------------------------------
void Ordeal_BlastGroup (unitgroup people, point at, int amount) {
    unit who;
    int count;
    int j;

    count = UnitGroupCount(people, c_unitCountAlive);
    j = 1;
    while (j <= count) {
        who = UnitGroupUnit(people, j);
        if (who != null && UnitIsAlive(who)
            && DistanceBetweenPoints(UnitGetPosition(who), at) <= c_ordealBlastRadius) {
            Emp_CombatDamage(who, c_dmgRed, amount);
        }
        j = j + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// A thief's death.
//
// Rolled once and applied to everyone, rather than rolled per victim: it is one
// explosion, and two people standing shoulder to shoulder taking 10 and 15 from
// the same bang would read as a bug.
//--------------------------------------------------------------------------------------------------
void Ordeal_Blast (unit who) {
    point at;
    int amount;

    if (who == null) {
        return;
    }

    at = UnitGetPosition(who);
    amount = RandomInt(c_ordealBlastMin, c_ordealBlastMax);

    Ordeal_Boom(at, c_ordealBlastModel);
    Ordeal_BlastGroup(ObjectsGen_ScanEmp(), at, amount);
    Ordeal_BlastGroup(ObjectsGen_ScanHero(), at, amount);
}

//--------------------------------------------------------------------------------------------------
// Which types go off when killed.
//
// A second hardcoded list rather than another value on Ordeal_ActOf's enum,
// because robbing and exploding are two separate facts about a Crimson Dawn and
// only one of them is about to be shared: Green Dawn's overkill splash wants
// this hook and wants nothing to do with containment doors. Folding them into
// one enum would mean Green had to pretend to be a thief to get a death event.
//--------------------------------------------------------------------------------------------------
bool Ordeal_BlastsOnDeath (string type) {
    return type == "Lob_Ordeal_Dawn_Crimson";
}

//--------------------------------------------------------------------------------------------------
// Which spawned entity a unit is, or -1.
//--------------------------------------------------------------------------------------------------
int Ordeal_IndexOf (unit who) {
    int i;

    if (who == null) {
        return -1;
    }
    i = 0;
    while (i < gv_ordealCount) {
        if (gvg_ordealUnit[i] == who) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

//--------------------------------------------------------------------------------------------------
// Every death on the map, filtered down to ours.
//
// Registered on no unit in particular rather than per spawned entity, because
// the alternative accumulates event registrations on one trigger for the whole
// game -- sixty-four of them by the fourth Ordeal, all pointed at units that
// were removed. The filter is two comparisons and a short walk of an array that
// is at most the size of the table.
//
// Ordeal_End removes survivors with UnitRemove rather than killing them, which
// is what keeps a Violet burst from also setting off every clown still standing
// somewhere else: removal is not death and this never hears about it.
//--------------------------------------------------------------------------------------------------
bool Ordeal_Died_Func (bool testConds, bool runActions) {
    unit who;

    if (!runActions || !gv_ordealActive) {
        return true;
    }
    if (!Ordeal_BlastsOnDeath(gv_ordealType)) {
        return true;
    }

    who = EventUnit();
    if (Ordeal_IndexOf(who) < 0) {
        return true;
    }

    Ordeal_Blast(who);
    return true;
}

//--------------------------------------------------------------------------------------------------
// What a bomb does when nobody dealt with it.
//
// Every counter in that department to zero and White damage to everyone in it.
// Zeroing a counter is not "a breach happens" -- it is the condition under which
// one is about to, so the punishment arrives as a room full of cells that are
// all one bad second away, which is worse than any single explosion.
//--------------------------------------------------------------------------------------------------
void Ordeal_Burst (int i) {
    unitgroup people;
    unit abno;
    int player;
    int count;
    int slot;
    int j;

    player = gvg_ordealHome[i];

    // The doc's "large glow", and it goes off before the counters do so the
    // flash and the alarm arrive in that order.
    if (gvg_ordealUnit[i] != null) {
        Ordeal_Boom(UnitGetPosition(gvg_ordealUnit[i]), c_ordealGlowModel);
    }

    slot = 0;
    while (slot < gv_cellCount) {
        abno = gvg_cellAbno[slot];
        if (abno != null && UnitIsAlive(abno) && Cont_OwnerOf(slot) == player) {
            Cont_SetCounter(abno, 0);
        }
        slot = slot + 1;
    }

    people = Emp_Of(player);
    count = UnitGroupCount(people, c_unitCountAlive);
    j = 1;
    while (j <= count) {
        Emp_CombatDamage(UnitGroupUnit(people, j), c_dmgWhite,
                         RandomInt(c_ordealBurstMin, c_ordealBurstMax));
        j = j + 1;
    }

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle,
                     Msg1("Lob/Msg/OrdealBurst", "%NAME%", Ordeal_NameOf(gv_ordealType)));
}

//--------------------------------------------------------------------------------------------------
// Everyone standing where a worm comes up.
//
// The room if there is one drawn and a radius if there is not, which is
// Fort_InRoom's whole job -- a hallway's walls are the honest scope and most of
// the map does not have them yet.
//--------------------------------------------------------------------------------------------------
void Ordeal_SproutGroup (unitgroup people, point at, int loc, int amount) {
    unit who;
    int count;
    int j;

    count = UnitGroupCount(people, c_unitCountAlive);
    j = 1;
    while (j <= count) {
        who = UnitGroupUnit(people, j);
        if (Fort_InRoom(who, at, loc, c_ordealSproutReach)) {
            Emp_CombatDamage(who, c_dmgRed, amount);
        }
        j = j + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// The floor opening up. Rolled once for the room, the same way a blast is.
//--------------------------------------------------------------------------------------------------
void Ordeal_Sprout (unit who) {
    point at;
    int loc;
    int amount;

    if (who == null) {
        return;
    }
    at = UnitGetPosition(who);
    loc = Fort_LocOfPoint(at);
    amount = RandomInt(c_ordealSproutMin, c_ordealSproutMax);

    Ordeal_SproutGroup(ObjectsGen_ScanEmp(), at, loc, amount);
    Ordeal_SproutGroup(ObjectsGen_ScanHero(), at, loc, amount);
}

//--------------------------------------------------------------------------------------------------
// One worm, once a tick, and there is only one thing it can decide.
//
// NOT guarded on "has any order", the way a thief is. A thief has no attack
// ability at all, so an order is always one of its own; a worm is a fighter and
// would have an attack order most of the time, which would mean it never dug at
// all -- and never digging looks exactly like the mechanic being unwritten.
// The question is the narrow one: is it already digging.
//
// The order replaces whatever it was attacking. That is correct rather than
// merely convenient: a worm that would finish its swing first would be a worm
// whose relocation the players could delay by feeding it a target.
//--------------------------------------------------------------------------------------------------
void Ordeal_DigStep (int i) {
    unit who;

    who = gvg_ordealUnit[i];
    if (who == null || !UnitIsAlive(who)) {
        return;
    }
    if (GameGetMissionTime() < gvg_ordealAt[i]) {
        return;
    }
    if (UnitOrderHasAbil(who, c_ordealDigAbil)) {
        return;
    }

    UnitIssueOrder(who, Order(AbilityCommand(c_ordealDigAbil, 0)), c_orderQueueReplace);
}

//--------------------------------------------------------------------------------------------------
// A dig finished.
//
// Heard rather than counted, the same as a robbery and for the same reason: the
// ability's PrepTime IS the two seconds, so a worm killed partway through never
// gets here and never moves. Nothing in this file has to notice that it was
// interrupted, because being interrupted is simply this not happening.
//
// The two puffs and the move are one frame: dirt where it left, dirt where it
// arrived, and the worm in between. Nobody ever sees the Locust fail to have a
// burrow animation, which is the entire reason this is a cast and not a morph.
//
// Registered on every stage and filtered here, matching Ordeal_Rob_Func.
//--------------------------------------------------------------------------------------------------
bool Ordeal_Dug_Func (bool testConds, bool runActions) {
    unit who;
    point from;
    int i;
    int loc;

    if (!runActions || !gv_ordealActive) {
        return true;
    }
    if (EventUnitAbilityStage() != c_unitAbilStageComplete) {
        return true;
    }

    who = EventUnit();
    i = Ordeal_IndexOf(who);
    if (i < 0) {
        return true;
    }

    from = UnitGetPosition(who);
    loc = Ordeal_HallFor(gvg_ordealHome[i], Fort_LocOfPoint(from));

    Ordeal_Puff(from, c_ordealDigDownActor);
    if (loc >= 0) {
        UnitSetPosition(who, gvg_locCenter[loc], false);
    }
    Ordeal_Puff(UnitGetPosition(who), c_ordealDigUpActor);

    gvg_ordealAt[i] = GameGetMissionTime() + RandomFixed(c_ordealDigMin, c_ordealDigMax);
    Ordeal_Sprout(who);
    return true;
}

//--------------------------------------------------------------------------------------------------
// Puts the drawn Ordeal on the map, one entity per player at the table.
//
// One each, not a number scaled by anything. How many an Ordeal brings is a
// per-TYPE fact -- Amber Dawn's worms arrive in fives and the clowns arrive
// alone -- and there is no channel for a per-type number yet. That decision is
// pending and shared with three other systems (see build-order.md); inventing a
// fourth channel for it here is exactly what that note forbids.
//--------------------------------------------------------------------------------------------------
void Ordeal_Begin (int tier, string type) {
    unit made;
    int player;

    if (type == "") {
        return;
    }

    gv_ordealActive = true;
    gv_ordealTier = tier;
    gv_ordealType = type;
    gv_ordealCount = 0;
    gv_ordealKilled = 0;
    gv_ordealAct = Ordeal_ActOf(type);

    player = 1;
    while (player <= 15) {
        if (Slot_IsTablePlayer(player) && gv_ordealCount < c_ordealUnitMax) {
            UnitCreate(1, type, c_unitCreateIgnorePlacement, c_zergPlayer,
                       Ordeal_SpawnPointFor(player), 270.0);
            made = UnitLastCreated();
            if (made != null) {
                gvg_ordealUnit[gv_ordealCount] = made;
                gvg_ordealHome[gv_ordealCount] = player;
                gvg_ordealMark[gv_ordealCount] = null;
                // A bomb's fuse is drawn per entity so the departments do not
                // all reach zero on the same second; a thief starts with none.
                if (gv_ordealAct == c_ordealActBomb) {
                    gvg_ordealAt[gv_ordealCount] =
                        GameGetMissionTime()
                        + RandomFixed(c_ordealFuseMin, c_ordealFuseMax);
                }
                else if (gv_ordealAct == c_ordealActDigger) {
                    gvg_ordealAt[gv_ordealCount] =
                        GameGetMissionTime()
                        + RandomFixed(c_ordealDigMin, c_ordealDigMax);
                }
                else {
                    gvg_ordealAt[gv_ordealCount] = 0.0;
                }
                gv_ordealCount = gv_ordealCount + 1;
            }
        }
        player = player + 1;
    }

    if (gv_ordealCount == 0) {
        // Nowhere to put anything. Not an Ordeal that was survived.
        gv_ordealActive = false;
        return;
    }

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle,
                     Msg1("Lob/Msg/OrdealBegin", "%NAME%", Ordeal_NameOf(type)));

    Ordeal_Refresh();
}

//--------------------------------------------------------------------------------------------------
// How many of the spawned entities are still standing.
//--------------------------------------------------------------------------------------------------
int Ordeal_Standing () {
    int alive;
    int i;

    alive = 0;
    i = 0;
    while (i < gv_ordealCount) {
        if (gvg_ordealUnit[i] != null && UnitIsAlive(gvg_ordealUnit[i])) {
            alive = alive + 1;
        }
        i = i + 1;
    }
    return alive;
}

//--------------------------------------------------------------------------------------------------
// The end of one, and there are two of those.
//
// SUPPRESSED means every entity was put down, and it pays. Anything else does
// not -- an Ordeal that ended because a bomb went off is the failure case the
// bomb exists to threaten, and paying for it would make ignoring Violet the
// cheapest way to farm energy.
//
// Whatever is left standing is removed rather than left wandering: the Ordeal is
// over, and an entity that outlives it belongs to no bookkeeping at all.
//--------------------------------------------------------------------------------------------------
void Ordeal_End (bool suppressed) {
    int reward;
    int i;

    if (suppressed) {
        reward = Ordeal_RewardFor(gv_ordealTier);
        Energy_Add(reward);
        gvg_ordealBeaten[gv_ordealTier] = gvg_ordealBeaten[gv_ordealTier] + 1;
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle,
                         Msg2("Lob/Msg/OrdealDone",
                              "%NAME%", Ordeal_NameOf(gv_ordealType),
                              "%ENERGY%", MsgInt(reward)));
    }
    else {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle,
                         Msg1("Lob/Msg/OrdealLost", "%NAME%", Ordeal_NameOf(gv_ordealType)));
    }

    i = 0;
    while (i < gv_ordealCount) {
        if (gvg_ordealUnit[i] != null && UnitIsAlive(gvg_ordealUnit[i])) {
            UnitRemove(gvg_ordealUnit[i]);
        }
        gvg_ordealUnit[i] = null;
        gvg_ordealMark[i] = null;
        i = i + 1;
    }

    gv_ordealActive = false;
    gv_ordealCount = 0;
    gv_ordealKilled = 0;
    gv_ordealType = "";
    Ordeal_Refresh();
}

//--------------------------------------------------------------------------------------------------
// The one clock, and it is not the Ordeal's own.
//
// Two jobs, and both are readings of state that changes underneath rather than
// events this module could have subscribed to: the meltdown level is owned by a
// module that loads BEFORE this one and so cannot call into it, and "the last
// entity died" has no event that is not a death event per spawned unit.
//--------------------------------------------------------------------------------------------------
bool Ordeal_Tick_Func (bool testConds, bool runActions) {
    fixed now;
    int level;
    int killed;
    int i;

    if (!runActions) {
        return true;
    }

    if (gv_ordealActive) {
        now = GameGetMissionTime();

        // Per-entity behaviour first, because a bomb going off this tick ends
        // the Ordeal and there is nothing to count afterwards.
        i = 0;
        while (i < gv_ordealCount) {
            if (gvg_ordealUnit[i] != null && UnitIsAlive(gvg_ordealUnit[i])) {
                if (gv_ordealAct == c_ordealActThief) {
                    Ordeal_ThiefStep(i);
                }
                else if (gv_ordealAct == c_ordealActDigger) {
                    Ordeal_DigStep(i);
                }
                else if (gv_ordealAct == c_ordealActBomb && now >= gvg_ordealAt[i]) {
                    Ordeal_Burst(i);
                    UnitKill(gvg_ordealUnit[i]);
                    Ordeal_End(false);
                    return true;
                }
            }
            i = i + 1;
        }

        killed = gv_ordealCount - Ordeal_Standing();
        if (killed != gv_ordealKilled) {
            gv_ordealKilled = killed;
            Ordeal_Refresh();
        }
        if (Ordeal_Standing() == 0) {
            Ordeal_End(true);
        }
        return true;
    }

    // Not "the level changed" but "the level has reached it". A tier whose
    // level went by while an earlier Ordeal was still being fought is late
    // rather than cancelled, and arrives the moment the corridor is clear.
    level = Melt_Level();
    if (gv_ordealNextTier >= 0 && gv_ordealNextType != ""
        && level >= gv_ordealNextLevel) {
        gvg_ordealSpent[gv_ordealNextTier] = true;
        Ordeal_Begin(gv_ordealNextTier, gv_ordealNextType);
        Ordeal_ScheduleNext();
    }
    return true;
}

void Ordeals_Init () {
    int tier;

    // TUNING is not the word: these four are from the design directly, 10 / 15 /
    // 20 / 25 percent of the energy target by tier.
    gvg_ordealRewardPct[c_ordealDawn] = 10;
    gvg_ordealRewardPct[c_ordealNoon] = 15;
    gvg_ordealRewardPct[c_ordealDusk] = 20;
    gvg_ordealRewardPct[c_ordealMidnight] = 25;

    gv_ordealActive = false;
    gv_ordealCount = 0;
    gv_ordealKilled = 0;
    gv_ordealType = "";

    // Where in its range each tier lands, drawn once so the whole night's
    // schedule exists before the first minute of it does.
    tier = 0;
    while (tier < c_diffCount) {
        gvg_ordealAtLevel[tier] = RandomInt(Ordeal_LevelMin(tier), Ordeal_LevelMax(tier));
        gvg_ordealSpent[tier] = false;
        tier = tier + 1;
    }

    gvg_ordealBeaten[c_ordealDawn] = 0;
    gvg_ordealBeaten[c_ordealNoon] = 0;
    gvg_ordealBeaten[c_ordealDusk] = 0;
    gvg_ordealBeaten[c_ordealMidnight] = 0;

    gv_ordealObj = ObjectiveCreate(
        StringExternal("Lob/Objective/Ordeal/Nothing"),
        StringExternal("Lob/Objective/Ordeal/Desc"),
        c_objectiveStateActive,
        false);

    // The first warning goes out before anything has happened, which is the
    // point: the players should walk into meltdown 1 already knowing what
    // meltdown 2 brings.
    Ordeal_ScheduleNext();

    gt_ordealTick = TriggerCreate("Ordeal_Tick_Func");
    TriggerAddEventTimePeriodic(gt_ordealTick, c_ordealTick, c_timeGame);

    gt_ordealRob = TriggerCreate("Ordeal_Rob_Func");
    TriggerAddEventUnitAbility(gt_ordealRob, null, AbilityCommand(c_ordealRobAbil, 0),
                               c_unitAbilStageAll, true);

    gt_ordealDug = TriggerCreate("Ordeal_Dug_Func");
    TriggerAddEventUnitAbility(gt_ordealDug, null, AbilityCommand(c_ordealDigAbil, 0),
                               c_unitAbilStageAll, true);

    gt_ordealDeath = TriggerCreate("Ordeal_Died_Func");
    TriggerAddEventUnitDied(gt_ordealDeath, null);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/28_damage.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// The bridge between the engine's damage and ours.
//
// THE IDEA IN ONE LINE: the engine's Kind field IS our damage type.
//
//     RED    ->  Melee       WHITE  ->  Ranged
//     BLACK  ->  Spell       PALE   ->  Splash
//
// CEffectDamage's Kind takes exactly four values across the whole of stock, and
// we have exactly four types. That is not a coincidence we are exploiting so
// much as the only place in the engine where "what sort of damage was that"
// exists at all -- and it is read in every one of the places we need:
//
//     <DamageTakenFraction index="Ranged" value="1.3"/>   one abnormality's
//                                                         WHITE defence, from
//                                                         the wiki table, no
//                                                         script whatsoever
//     <DamageResponse Kind="Ranged" ModifyFraction="0"/>  intercept it
//     TriggerAddEventUnitDamaged(t, u, c_unitDamageTypeRanged, ...)
//                                                         hear it, in script
//
// So E.G.O weapons keep REAL numbers. No placeholder, no DisplayEffect, and the
// unit panel shows the truth because the truth is what the weapon deals. See
// docs/dev/damage-channel.md for the whole argument and the evidence.
//
// WHAT STILL NEEDS US. Only one direction, and only for people:
//
//     Anything into a PERSON     us, all four types. SP is not a thing
//                                CEffectDamage can reach and Pale is a fraction
//                                of MAXIMUM life, so two of them were never
//                                going to be the engine's -- and Red joined them
//                                for legibility rather than correctness. The
//                                argument is on c_dmgMindRed below and it comes
//                                down to this: the engine subtracts amounts that
//                                are nowhere on screen, and a number the player
//                                cannot derive is a number they cannot learn
//                                from.
//     Anything into a MONSTER     engine, for now. A monster has one pool and
//                                one multiplier per type, which is exactly what
//                                DamageTakenFraction is -- and that multiplier
//                                IS Lobotomy's resistance model, not
//                                StarCraft's armour. Pale against a monster is
//                                plain damage, so nothing here has to know.
//                                E.G.O GRADE will end this: a bonus that depends
//                                on attacker and defender together is pairwise
//                                and no catalog field is.
//
// The handoff is a DamageResponse that zeroes the life loss plus an event that
// tells us what the loss WOULD have been. Nothing is applied twice and nothing
// is estimated: EventUnitDamageAttempted is the engine's own number.
//
// THIS FILE IS A PROBE AS MUCH AS AN IMPLEMENTATION. Three things about the
// engine are asserted here on strong evidence and not yet witnessed:
//
//     1. that the damage event still fires when a DamageResponse has already
//        taken the number to zero. EventUnitDamageAttempted existing at all is
//        hard to explain otherwise, but this is the load-bearing one.
//     2. that a weapon whose filters permit Ally really does auto-acquire a
//        friendly unit.
//     3. what DamageTakenFraction does to the number the event reports --
//        whether resistance is already in it or not.
//
// Dmg_Trace answers all three out loud rather than leaving them to be inferred
// from a health bar. Turn it on with -dmg.
//
// Numbered 28 because it needs Emp_CombatDamage from 11 and Fort_LocOfPoint from
// 26, and is called by nobody. It was 17 until Green Dawn's overkill needed to
// know which ROOM somebody died in.
//--------------------------------------------------------------------------------------------------

// The mapping, and the ONLY place it is written down. c_unitDamageType* are the
// engine's own constants out of natives.galaxy, so this is a rename rather than
// a translation -- there is no table to fall out of step.
const int c_dmgKindRed = c_unitDamageTypeMelee;
const int c_dmgKindWhite = c_unitDamageTypeRanged;
const int c_dmgKindBlack = c_unitDamageTypeSpell;
const int c_dmgKindPale = c_unitDamageTypeSplash;

// One interceptor per type, because a behavior carries a single DamageResponse.
// Each takes its own type to zero life so the number can be spent here instead.
//
// ALL FOUR, INCLUDING RED. The engine could apply Red correctly and for a while
// it did -- the reason it no longer does is not correctness, it is legibility.
// A live shot read 10 against a weapon whose Amount said 12, and explaining the
// gap took a mod-dependency lookup (Void's LocustMPDamage is 10 where Swarm's is
// 12) and a field called ArmorReduction that cancelled the armour exactly. It
// turned out there was nothing wrong. THAT IS THE PROBLEM: a number nobody can
// derive is indistinguishable from a bug, and this game asks the player to
// compare four damage types across thirty abnormalities. Flat armour, attribute
// bonuses and armour-piercing all subtract amounts that are nowhere on screen.
//
// So the catalog now holds two things about a hit and only two: the base number
// and the type. Everything that modifies it is script, and there is one place to
// read to know why a number came out the way it did.
// Green Dawn's overkill. Five stabs, three White each, at everybody else in the
// room; the doc's "in quick succession", which here means all at once because
// nothing between the five could change the answer.
const int c_dmgOverkillHits = 5;
const int c_dmgOverkillEach = 3;

// Used only when a room has no region drawn around it yet. Generous, because the
// alternative is an execution that lands on nobody and looks broken.
const fixed c_dmgOverkillReach = 8.0;

const string c_dmgMindRed = "Lob_Mind_Red";
const string c_dmgMindWhite = "Lob_Mind_White";
const string c_dmgMindBlack = "Lob_Mind_Black";
const string c_dmgMindPale = "Lob_Mind_Pale";

// How much of the fight to narrate. Nested, so each level is the one before it
// plus something.
//
//   PEOPLE   employees and players. What the bridge actually arbitrates.
//   MORE     the above plus Ordeals and abnormalities -- everything the
//            Lobotomy layer owns, on both sides of a real fight.
//   ALL      plus the swarm, the turrets, the debris. Honest and unreadable:
//            a wave of zerglings chewing on a turret is ten lines a second and
//            drowns the one line you were waiting for.
//
// MORE is the one to leave on while playing. ALL is for the times the question
// is about the engine rather than about the game.
const int c_dmgTraceOff = 0;
const int c_dmgTracePeople = 1;
const int c_dmgTraceMore = 2;
const int c_dmgTraceAll = 3;

int gv_dmgTrace;

trigger gt_dmgRed;
trigger gt_dmgWhite;
trigger gt_dmgBlack;
trigger gt_dmgPale;
trigger gt_dmgBorn;

//--------------------------------------------------------------------------------------------------
// Whether this unit is somebody rather than something.
//
// Employees and players both: a player standing in front of a White weapon has a
// mind to lose in exactly the same way, and 11_employee's SP functions already
// treat the two alike.
//--------------------------------------------------------------------------------------------------
bool Dmg_IsPerson (unit who) {
    return who != null && (ObjectsGen_IsEmp(who) || ObjectsGen_IsHero(who));
}

//--------------------------------------------------------------------------------------------------
// Puts the interceptor on somebody.
//
// Applied from script rather than listed on the unit, so it reaches every
// employee and every player without thirty CUnit entries having to remember it
// -- and so that a unit copied from another one cannot arrive without a mind.
//--------------------------------------------------------------------------------------------------
void Dmg_GiveMind (unit who) {
    if (!Dmg_IsPerson(who)) {
        return;
    }
    Buffs_Set(who, c_dmgMindRed, true);
    Buffs_Set(who, c_dmgMindWhite, true);
    Buffs_Set(who, c_dmgMindBlack, true);
    Buffs_Set(who, c_dmgMindPale, true);
}

//--------------------------------------------------------------------------------------------------
// Whether this White hit is mercy rather than harm.
//
// THE RULE: a White weapon fired by one of the crew, at somebody who has already
// broken, gives sanity back instead of taking it. That is the recovery path from
// systems/sanity.md, and it lands here rather than in Emp_CombatDamage for a
// reason worth stating -- Violet Dawn's burst is White too, and a burst that
// healed the very people it is meant to break would be the opposite of the
// mechanic. The difference is not the type. It is who fired.
//
// Panic latches at zero and only opens at FULL, so this is not one shot: it is
// somebody standing there spending their attention on a colleague instead of on
// the thing in the corridor. That cost is the point.
//--------------------------------------------------------------------------------------------------
bool Dmg_IsMercy (unit victim, unit source) {
    if (source == null || !Emp_IsPanicked(victim)) {
        return false;
    }
    return Slot_IsTablePlayer(UnitGetOwner(source));
}

//--------------------------------------------------------------------------------------------------
// Says out loud what the engine just did. -dmg.
//
// Every number the event exposes, because the three open questions about this
// system are all questions about which of these numbers is which. Attempted
// against actual says whether the DamageResponse fired AND whether the event
// still arrives once it has; either of them against the weapon's own Amount says
// where DamageTakenFraction was applied.
//--------------------------------------------------------------------------------------------------
string Dmg_Word (unit who) {
    if (who == null) {
        return "nobody";
    }
    return UnitGetType(who) + "/p" + IntToString(UnitGetOwner(who));
}

//--------------------------------------------------------------------------------------------------
// Whether this hit is loud enough for the current level.
//
// Abnormalities are counted whether contained or breaching. A contained one
// cannot be reached to be hit, so in practice this means the ones that got out
// -- and if a contained one ever does take damage, that is a line worth seeing
// rather than one worth filtering.
//--------------------------------------------------------------------------------------------------
bool Dmg_Loud (unit victim, bool ours) {
    if (gv_dmgTrace == c_dmgTraceOff) {
        return false;
    }
    if (gv_dmgTrace >= c_dmgTraceAll) {
        return true;
    }
    if (ours) {
        return true;
    }
    return gv_dmgTrace >= c_dmgTraceMore
           && (ObjectsGen_IsOrdeal(victim) || ObjectsGen_IsAbno(victim));
}

void Dmg_Trace (string what, unit victim, unit source, bool ours) {
    string line;

    if (!Dmg_Loud(victim, ours)) {
        return;
    }

    line = what + " " + Dmg_Word(victim) + " <- " + Dmg_Word(source)
           + " attempted=" + FixedToString(EventUnitDamageAttempted(), 2)
           + " actual=" + FixedToString(EventUnitDamageAmount(), 2)
           + " effect=" + EventUnitDamageEffect();

    // WHO APPLIED IT, which is the whole question on the monster side. [engine]
    // means the number in "actual" is what the target really lost, after its
    // DamageTakenFraction -- so [engine] with attempted != actual is the engine
    // showing its working, and attempted already carrying the resistance would
    // show up as attempted being lower than the weapon's own Amount.
    if (ours) {
        line = line + " [ours]";
    }
    else {
        line = line + " [engine]";
    }
    if (Emp_IsPanicked(victim)) {
        line = line + " [panicked]";
    }
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringToText(line));
}

//--------------------------------------------------------------------------------------------------
// Every White hit that lands on anything.
//
// Monsters fall straight through: the engine already dealt it, their
// DamageTakenFraction already scaled it, and there is nothing about an
// abnormality that our arithmetic knows better.
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Everybody of one kind who has to watch.
//
// The room the body is in, or a radius around it when that stretch of corridor
// has no region drawn yet. The fallback matters: most of the map has no regions
// on it, and an execution that hits nobody reads as a mechanic that does not
// work rather than as a map that is unfinished.
//--------------------------------------------------------------------------------------------------
void Dmg_OverkillGroup (unitgroup people, unit dead, point at, int loc) {
    unit who;
    int count;
    int j;
    int hit;

    count = UnitGroupCount(people, c_unitCountAlive);
    j = 1;
    while (j <= count) {
        who = UnitGroupUnit(people, j);
        if (who != dead && Fort_InRoom(who, at, loc, c_dmgOverkillReach)) {
            hit = 0;
            while (hit < c_dmgOverkillHits) {
                Emp_CombatDamage(who, c_dmgWhite, c_dmgOverkillEach);
                hit = hit + 1;
            }
        }
        j = j + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// What a Green Dawn does after it has already won.
//
// It stabs the corpse five more times, and the cost lands on EVERYONE ELSE IN
// THE ROOM: three White apiece, five times. The victim pays nothing, being
// dead. That inversion is the whole mechanic; the doc's advice is not to send
// help while a robot is finishing somebody, because arriving is what puts you
// in the room.
//
// It hangs off a HIT rather than off a death, and that is why it lives in this
// file. The killing blow goes through Emp_CombatDamage, which calls UnitKill
// itself, so by the time anything hears a death event the attacker is no longer
// on the record. Asking "did that hit finish them" where the hit lands needs no
// bookkeeping at all.
//
// Fifteen White is enormous next to a work-damage tick, and it is meant to be.
// Watching a colleague taken apart is the fastest way to lose a room.
//--------------------------------------------------------------------------------------------------
void Dmg_Overkill (unit dead, unit killer) {
    point at;
    int loc;

    if (killer == null || !ObjectsGen_IsOrdeal_Dawn_Green(killer)) {
        return;
    }

    at = UnitGetPosition(dead);
    loc = Fort_LocOfPoint(at);

    Dmg_OverkillGroup(ObjectsGen_ScanEmp(), dead, at, loc);
    Dmg_OverkillGroup(ObjectsGen_ScanHero(), dead, at, loc);

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle,
                     StringExternal("Lob/Msg/Overkill"));
}

void Dmg_Hit (int type) {
    unit victim;
    unit source;
    int amount;
    bool ours;

    victim = EventUnit();
    source = EventUnitDamageSourceUnit();

    // A monster is not ours to arbitrate: it has one pool and one multiplier per
    // type, and DamageTakenFraction already did that. But it IS traced, because
    // "nothing printed" and "the trigger never fired" look identical from the
    // outside, and this readout is the only way to see where the engine applies
    // a resistance.
    ours = Dmg_IsPerson(victim);
    Dmg_Trace(AbnoGen_DmgName(type), victim, source, ours);
    if (!ours) {
        return;
    }

    // Attempted, not actual: actual is what survived the DamageResponse, and the
    // whole point of that response is that it is zero.
    amount = FixedToInt(EventUnitDamageAttempted());
    if (amount <= 0) {
        return;
    }

    if (type == c_dmgWhite && Dmg_IsMercy(victim, source)) {
        SP_Restore(victim, amount);
        return;
    }

    Emp_CombatDamage(victim, type, amount);

    // Asked here because this is the only place that knows both who died and
    // who did it.
    if (!UnitIsAlive(victim)) {
        Dmg_Overkill(victim, source);
    }
}

bool Dmg_Red_Func (bool testConds, bool runActions) {
    if (runActions) { Dmg_Hit(c_dmgRed); }
    return true;
}

bool Dmg_White_Func (bool testConds, bool runActions) {
    if (runActions) { Dmg_Hit(c_dmgWhite); }
    return true;
}

bool Dmg_Black_Func (bool testConds, bool runActions) {
    if (runActions) { Dmg_Hit(c_dmgBlack); }
    return true;
}

bool Dmg_Pale_Func (bool testConds, bool runActions) {
    if (runActions) { Dmg_Hit(c_dmgPale); }
    return true;
}

bool Dmg_Born_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    Dmg_GiveMind(EventUnitCreatedUnit());
    return true;
}

void Damage_Init () {
    unitgroup people;
    int count;
    int i;

    gv_dmgTrace = c_dmgTraceOff;

    // Everybody already standing on the map when it loads. The created event
    // below only ever hears about the future.
    people = ObjectsGen_ScanEmp();
    UnitGroupAddUnitGroup(people, ObjectsGen_ScanHero());
    count = UnitGroupCount(people, c_unitCountAlive);
    i = 1;
    while (i <= count) {
        Dmg_GiveMind(UnitGroupUnit(people, i));
        i = i + 1;
    }

    gt_dmgBorn = TriggerCreate("Dmg_Born_Func");
    TriggerAddEventUnitCreated(gt_dmgBorn, null, null, null);

    // One trigger per kind rather than one on c_unitDamageTypeAny, because the
    // event exposes no "which kind was that" function -- the registration IS the
    // answer, and a single trigger would have to guess.
    gt_dmgRed = TriggerCreate("Dmg_Red_Func");
    TriggerAddEventUnitDamaged(gt_dmgRed, null, c_dmgKindRed, c_unitDamageEither, null);

    gt_dmgWhite = TriggerCreate("Dmg_White_Func");
    TriggerAddEventUnitDamaged(gt_dmgWhite, null, c_dmgKindWhite, c_unitDamageEither, null);

    gt_dmgBlack = TriggerCreate("Dmg_Black_Func");
    TriggerAddEventUnitDamaged(gt_dmgBlack, null, c_dmgKindBlack, c_unitDamageEither, null);

    gt_dmgPale = TriggerCreate("Dmg_Pale_Func");
    TriggerAddEventUnitDamaged(gt_dmgPale, null, c_dmgKindPale, c_unitDamageEither, null);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/30_workers.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Worker assignment.
//
// Workers pick their own job, in the order docs/usr/Defense.md gives: put up
// missing fortifications, then repair, then clear debris. Debris is what a
// worker does when it has nothing else to do -- which is also why buying a
// defence level costs clearing throughput, not just minerals.
//
// That ordering is the NPC side of the same tension P0 is testing on the player:
// a damaged device pulls a worker off the debris it was chewing on, so losing
// devices costs clearing throughput as well as power.
//
// Only idle workers get an order. Reissuing every tick would reset the attack
// of a worker already mid-swing and nothing would ever finish.
//
// The work-order marking UI is deliberately not in P0 -- see
// docs/design/p0-scope.md. Until then this stands in for it.
//--------------------------------------------------------------------------------------------------

const fixed c_workerAssignPeriod = 1.0;

trigger gt_workerAssign;

bool Workers_Assign_Func (bool testConds, bool runActions) {
    unitgroup workers;
    unitgroup damaged;
    unitgroup debris;
    unit worker;
    unit target;
    point where;
    int count;
    int i;
    int slot;

    if (!runActions) {
        return true;
    }

    workers = ObjectsGen_ScanSCV_Worker();
    count = UnitGroupCount(workers, c_unitCountAlive);
    if (count == 0) {
        return true;
    }

    damaged = Devices_Damaged();
    UnitGroupAddUnitGroup(damaged, Fort_Damaged());
    debris = ObjectsGen_ScanDebris();

    i = 1;
    while (i <= count) {
        worker = UnitGroupUnit(workers, i);
        if (worker != null && UnitIsAlive(worker)) {
            where = UnitGetPosition(worker);

            if (UnitOrderCount(worker) == 0) {
                // The build order carries the walk with it, so an idle worker
                // is the only one worth asking. The previous version had to
                // pester busy ones too, because arriving was when it conjured
                // the building; the engine does that now.
                slot = Fort_JobFor(worker);
                if (slot >= 0) {
                    Fort_OrderBuild(worker, slot);
                }
                else {
                    target = UnitGroupClosestToPoint(damaged, where);
                    if (target != null) {
                        UnitIssueOrder(
                            worker,
                            OrderTargetingUnit(AbilityCommand("Repair", 0), target),
                            c_orderQueueReplace
                        );
                    }
                    else {
                        target = UnitGroupClosestToPoint(debris, where);
                        if (target != null) {
                            UnitIssueOrder(
                                worker,
                                OrderTargetingUnit(AbilityCommand("attack", 0), target),
                                c_orderQueueReplace
                            );
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return true;
}

void Workers_Init () {
    gt_workerAssign = TriggerCreate("Workers_Assign_Func");
    TriggerAddEventTimePeriodic(gt_workerAssign, c_workerAssignPeriod, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/40_economy.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// The second stage of the resource chain: ore pile -> spendable resources.
//
// There is no conversion step here any more, because there is nothing to
// convert. The pile is a harvestable node and the recycler is a drop-off, so
// miners walk over, carry, and walk back, and the engine credits the player.
// That was the point of the change: the old version moved numbers from a script
// variable into the player's account while the miners stood there, which is a
// claim about work that never happened.
//
// What is left is dispatch -- pointing idle miners at the pile -- and the
// greybox readout. Throughput is tuned on the pile's own CBehaviorResource:
// HarvestTime against HarvestAmount. (IdealHarvesterCount is display only and
// changes no yield.) Those get designed directly.
// Where the pile sits is a spatial question and should stay one; deriving the
// rate from the walk would tie two decisions together that want to move apart.
//
// Fully automatic and independent of power, per the design baseline. The player
// never touches this; their only job is to keep the pile stocked, which is what
// makes clearing feel like it feeds something rather than paying out directly.
//--------------------------------------------------------------------------------------------------

const fixed c_minerAssignPeriod = 2.0;

//--------------------------------------------------------------------------------------------------
// Salvage: a slow trickle into the ore pile.
//
// A level-0 fixture in a room, per docs/usr/Defense.md. Its job is narrow and
// worth stating so nobody later mistakes it for an economy: it exists so that a
// sector with every scrap of debris cleared and every abnormality temporarily
// unworkable does not sit at zero income with nothing to do about it.
//
// It pays into the PILE, not into the player's minerals, and that is the whole
// reason it does not change the shape of anything. Baseline 4.4 has the second
// stage of the chain fully automatic and driven by miners walking; this adds a
// floor under the FIRST stage instead of a bypass around the second. The player
// still needs miners, the miners still walk, and a player whose pile is being
// worked is not affected by this at all.
//
// The rate is deliberately bad. It is a floor, not a strategy.
//--------------------------------------------------------------------------------------------------
const fixed c_salvagePeriod = 10.0;

// TUNING. Per salvage device, per period, into the nearest pile.
const int c_salvageAmount = 5;

trigger gt_minerAssign;
trigger gt_salvage;

bool Economy_Salvage_Func (bool testConds, bool runActions) {
    unitgroup devices;
    unit device;
    unit pile;
    int count;
    int i;

    if (!runActions) {
        return true;
    }

    devices = ObjectsGen_ScanSalvage();
    count = UnitGroupCount(devices, c_unitCountAlive);

    i = 1;
    while (i <= count) {
        device = UnitGroupUnit(devices, i);
        if (device != null && UnitIsAlive(device)) {
            // Nearest pile, which is the same spatial idiom the doors and the
            // control panels use. A salvage device in a room feeds that room's
            // sector without anything having to be told which sector it is in.
            pile = UnitGroupClosestToPoint(ObjectsGen_ScanPile(), UnitGetPosition(device));
            if (pile != null && UnitIsAlive(pile)) {
                UnitSetPropertyInt(
                    pile, c_unitPropResources,
                    UnitGetPropertyInt(pile, c_unitPropResources, true) + c_salvageAmount);
            }
        }
        i = i + 1;
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// How much is sitting in the pile, across every pile there is.
//--------------------------------------------------------------------------------------------------
int Economy_PileContents () {
    unitgroup piles;
    unit pile;
    int total;
    int count;
    int i;

    piles = ObjectsGen_ScanPile();
    count = UnitGroupCount(piles, c_unitCountAlive);
    total = 0;

    i = 1;
    while (i <= count) {
        pile = UnitGroupUnit(piles, i);
        if (pile != null) {
            total = total + UnitGetPropertyInt(pile, c_unitPropResources, true);
        }
        i = i + 1;
    }
    return total;
}

//--------------------------------------------------------------------------------------------------
// Idle miners get sent to the nearest stocked pile. Only idle ones: a miner
// already hauling has a multi-step order queue that reissuing would reset, and
// it would never finish a trip.
//
// Skipping empty piles matters more than it looks. Without the check, miners
// ordered onto a dry pile go idle on arrival and get reordered every couple of
// seconds, which reads as a bug rather than as an economy waiting on the player.
//--------------------------------------------------------------------------------------------------
bool Economy_MinerAssign_Func (bool testConds, bool runActions) {
    unitgroup miners;
    unit miner;
    unit pile;
    int count;
    int i;

    if (!runActions) {
        return true;
    }

    miners = ObjectsGen_ScanSCV_Miner();
    count = UnitGroupCount(miners, c_unitCountAlive);

    i = 1;
    while (i <= count) {
        miner = UnitGroupUnit(miners, i);
        if (miner != null && UnitIsAlive(miner) && UnitOrderCount(miner) == 0) {
            pile = UnitGroupClosestToPoint(ObjectsGen_ScanPile(), UnitGetPosition(miner));
            if (pile != null && UnitGetPropertyInt(pile, c_unitPropResources, true) > 0) {
                UnitIssueOrder(
                    miner,
                    OrderTargetingUnit(AbilityCommand("SCVHarvest", 0), pile),
                    c_orderQueueReplace
                );
            }
        }
        i = i + 1;
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// Greybox readout, on request.
//
// It used to print itself into the subtitle area every five seconds, back when
// nothing else could report and the question P0 was asking -- does the loop
// really pull in three directions at once -- could only be answered by watching
// the numbers move. It answered it. What is left is a screen that cannot show
// anything else, including the one-shot startup scan and every message a real
// mechanic will want to send.
//
// So the line stays and the timer goes: 90_debug.galaxy prints this on -status.
// Nothing is lost, because a number you can ask for at any moment is strictly
// more than the same number arriving whether or not you wanted it.
//
// Anything ownable is counted for the asking player, and anything genuinely
// shared says so on the line. That distinction is not cosmetic: the whole
// baseline turns on which numbers are yours and which are the table's, and a
// readout that quietly showed six players' SCVs as "workers" would be teaching
// the opposite of the rule the design is built on.
//--------------------------------------------------------------------------------------------------
int Economy_CountOwned (unitgroup group, int player) {
    unit who;
    int count;
    int mine;
    int i;

    count = UnitGroupCount(group, c_unitCountAlive);
    mine = 0;
    i = 1;
    while (i <= count) {
        who = UnitGroupUnit(group, i);
        if (who != null && UnitGetOwner(who) == player) {
            mine = mine + 1;
        }
        i = i + 1;
    }
    return mine;
}

string Economy_StatusLine (int player) {
    return "debris left=" + IntToString(UnitGroupCount(ObjectsGen_ScanDebris(), c_unitCountAlive))
           + " (map)  cleared=" + IntToString(gv_debrisCleared)
           + "  pile=" + IntToString(Economy_PileContents())
           + "  power=" + IntToString(PlayerGetPropertyInt(player, c_playerPropSuppliesUsed))
           + "/" + IntToString(PlayerGetPropertyInt(player, c_playerPropSuppliesMade))
           + " (" + IntToString(gv_devicesOnline) + "/" + IntToString(gv_devicesTotal)
           + " devices online, map)"
           + "  dept=" + Dept_NameOf(player)
           + "  diff=" + Diff_NameOf(player)
           + "  inner=" + Sector_HeldText(player)
           + "  workers=" + IntToString(Economy_CountOwned(ObjectsGen_ScanSCV_Worker(), player))
           + "  miners=" + IntToString(Economy_CountOwned(ObjectsGen_ScanSCV_Miner(), player))
           + "  emp=" + IntToString(Economy_CountOwned(ObjectsGen_ScanEmp(), player))
           + "  melt=" + IntToString(Melt_Level())
           + "  energy=" + IntToString(gv_energy) + "/" + IntToString(gv_energyGoal)
           + " (table)";
}

void Economy_Init () {
    gt_minerAssign = TriggerCreate("Economy_MinerAssign_Func");
    TriggerAddEventTimePeriodic(gt_minerAssign, c_minerAssignPeriod, c_timeGame);

    gt_salvage = TriggerCreate("Economy_Salvage_Func");
    TriggerAddEventTimePeriodic(gt_salvage, c_salvagePeriod, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/50_waves.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Zerg waves.
//
// One wave per spawn marker on a fixed interval, walking in on attack-move.
//
// Waves aim at the nearest device rather than at the player, so that "leave the
// fight to go repair" and "leave the repair to go fight" are the same decision
// seen from two sides. Falling back to the nearest worker keeps them walking
// somewhere meaningful before any device is placed.
//
//--------------------------------------------------------------------------------------------------
// Personal waves, sized by the difficulty of whoever's sector they open into.
//
// Baseline 2 asks for personal waves so that a weak player cannot drag a strong
// one down and a strong one is not punished for developing. It said "scaled by
// that player's own development", and development is not a real quantity -- it
// would have to be invented out of some weighted count of devices and upgrades,
// and it would mean the better you play the harder it gets.
//
// A per-player difficulty setting is the answer instead, and 01_difficulty
// argues why it is better rather than merely easier. What is left here is the
// arithmetic: a marker belongs to the sector it stands in, that sector belongs
// to a player, and that player's setting sizes the wave that comes through it.
//
// A marker that belongs to nobody -- no core placed anywhere near it -- still
// spawns, at Normal. Silence would be worse: an unowned spawn point is a hole
// in the map that nothing would ever come out of, and that is invisible until
// somebody wonders why one corridor is peaceful.
//
// The per-wave ramp stays a placeholder. The baseline defers the strength curve
// until the mechanics it would be balancing against exist, and difficulty
// multiplies whatever that curve turns out to be rather than replacing it.
//--------------------------------------------------------------------------------------------------

const fixed c_waveInterval = 45.0;
const int c_waveBaseSize = 3;
const string c_waveUnitType = "Zergling";

int gv_waveNumber;

trigger gt_wave;

//--------------------------------------------------------------------------------------------------
// Whose wave this is. The marker's own owner first, so the editor can override
// the geometry by simply assigning it; otherwise the sector it stands in.
//--------------------------------------------------------------------------------------------------
int Waves_OwnerOf (unit post) {
    if (post == null) {
        return 0;
    }
    if (Slot_IsTablePlayer(UnitGetOwner(post))) {
        return UnitGetOwner(post);
    }
    return Sector_OwnerNear(UnitGetPosition(post));
}

int Waves_SizeFor (int player) {
    int size;
    int pct;

    pct = gvg_diffWavePct[c_diffNormal];
    if (player >= 1 && player <= 15) {
        pct = Diff_WavePct(player);
    }

    size = (c_waveBaseSize + gv_waveNumber) * pct / 100;
    if (size < 1) {
        size = 1;
    }
    return size;
}

//--------------------------------------------------------------------------------------------------
// What a wave spawning at `from` should walk towards.
//--------------------------------------------------------------------------------------------------
point Waves_TargetFrom (point from) {
    unit target;

    target = UnitGroupClosestToPoint(ObjectsGen_ScanDevice(), from);
    if (target == null) {
        target = UnitGroupClosestToPoint(ObjectsGen_ScanSCV(), from);
    }
    if (target == null) {
        return from;
    }
    return UnitGetPosition(target);
}

bool Waves_Spawn_Func (bool testConds, bool runActions) {
    unitgroup markers;
    unitgroup spawned;
    unit post;
    point where;
    int markerCount;
    int owner;
    int i;

    if (!runActions) {
        return true;
    }

    markers = ObjectsGen_ScanMarker_Spawn();
    markerCount = UnitGroupCount(markers, c_unitCountAlive);
    if (markerCount == 0) {
        return true;
    }

    gv_waveNumber = gv_waveNumber + 1;

    i = 1;
    while (i <= markerCount) {
        post = UnitGroupUnit(markers, i);
        where = UnitGetPosition(post);
        owner = Waves_OwnerOf(post);

        spawned = UnitCreate(
            Waves_SizeFor(owner),
            c_waveUnitType,
            c_unitCreateIgnorePlacement,
            c_zergPlayer,
            where,
            270.0
        );
        UnitGroupIssueOrder(
            spawned,
            OrderTargetingPoint(AbilityCommand("attack", 0), Waves_TargetFrom(where)),
            c_orderQueueReplace
        );

        // Told to the player whose sector it opens into, with their own number.
        // "wave 7 incoming" to everybody said nothing about who was about to be
        // busy, which on a map of scattered sectors is the only part that
        // matters.
        if (owner >= 1 && owner <= 15) {
            UIDisplayMessage(
                PlayerGroupSingle(owner), c_messageAreaSubtitle,
                Msg3("Lob/Msg/Wave",
                     "%WAVE%", MsgInt(gv_waveNumber),
                     "%COUNT%", MsgInt(Waves_SizeFor(owner)),
                     "%DIFFICULTY%", Diff_NameTextOf(owner)));
        }
        i = i + 1;
    }
    return true;
}

void Waves_Init () {
    gv_waveNumber = 0;

    gt_wave = TriggerCreate("Waves_Spawn_Func");
    TriggerAddEventTimePeriodic(gt_wave, c_waveInterval, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/60_quests.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Quests.
//
// docs/usr/quests_unlocks.md gives every department four tasks. This module
// counts them.
//
// Numbered 60 because it reads from nearly everything -- employees, cells, the
// meltdown, work, the departments and the fortifications -- and Galaxy needs
// every one of those declared first. Nothing calls INTO here, which is what
// makes that possible: quests observe, they do not participate.
//
//--------------------------------------------------------------------------------------------------
// Derive where you can, count only what erases itself.
//
// Most tasks are questions about the present, and the present is already
// stored somewhere: how many employees are at rank II, what a location's level
// is, how far an encyclopedia has been read. Those are asked fresh every tick
// and nothing is kept here, so there is no counter to drift out of step with
// the thing it was counting.
//
// Three are not, because they ask about EVENTS whose evidence is gone by the
// time anybody could look:
//
//   works finished, and works finished Good   14_work    gvg_workFinished/Good
//   meltdown rounds handled cleanly           13_meltdown gvg_meltClean
//   distinct abnormalities suppressed         13_containment gvg_contSuppressed
//
// Each of those lives in the module where the event happens rather than here,
// because that module is the only place that sees it. A counter kept anywhere
// else would need the event forwarded to it, and a forwarded event is one more
// thing that can be forgotten when somebody adds a second way for the event to
// happen.
//
//--------------------------------------------------------------------------------------------------
// A player only progresses their own department's tasks.
//
// Two of the tasks say "本部门" outright, and the rest are written from inside
// one department's job. Quest_StepProgress returns 0 for anything outside the
// player's department rather than computing something that would be wrong.
//
//--------------------------------------------------------------------------------------------------
// Completion latches.
//
// Progress can fall -- employees die, buildings are flattened, a rank drops
// when the Training Team core suppression bites. A task that has been done has
// been done. So completion is a one-way flag, and progress is only ever read to
// decide whether to set it.
//
//--------------------------------------------------------------------------------------------------
// What this does NOT do yet:
//
//   Persist. "永久奖励仅在完成任务后的下一局游戏起生效" means completion has to
//   reach 16_bank, and that needs a section format the bank does not have. The
//   flags are in memory only, so a quest completed today is forgotten tonight.
//
//   Reward. Nothing is granted on completion. The department passives and the
//   unlock chain ("解锁：完成4个任务") both read Quest_DoneCount when they exist.
//
//   Count the eleven tasks that are not countable. Four need Ordeals, four need
//   an end-of-game evaluation, one needs a zerg queen, and two are blank in the
//   source document. They are declared with their goals and marked uncountable,
//   so the readout says "not yet" instead of "0" -- a task that is impossible
//   and a task nobody has started look identical otherwise.
//--------------------------------------------------------------------------------------------------

const int c_questPerDept = 4;
const int c_questCount = 36;

// dept * 4 + (n - 1), so a quest index carries its department.
const int c_qMalkuth1 = 0;
const int c_qMalkuth2 = 1;
const int c_qMalkuth3 = 2;
const int c_qMalkuth4 = 3;
const int c_qYesod1 = 4;
const int c_qYesod2 = 5;
const int c_qYesod3 = 6;
const int c_qYesod4 = 7;
const int c_qNetzach1 = 8;
const int c_qNetzach4 = 11;
const int c_qHod1 = 12;
const int c_qHod2 = 13;
const int c_qHod3 = 14;
const int c_qHod4 = 15;

//--------------------------------------------------------------------------------------------------
// A task is one or more STEPS.
//
// Control 1 is "建立一个正常运转的收容单元 并 升级任意房间或走廊的防御设施" --
// two unrelated things joined by an "and". Counted as one number it reads
// "(1/2)", which tells a player how far along they are and nothing whatever
// about WHICH half they are missing. Two panel lines say it without a word.
//
// The two must hold AT THE SAME TIME for the task to complete, which falls out
// of the steps being derived rather than latched: each is re-read every tick,
// so a cell that breaks after the fortification was bought un-ticks its own
// line and the task goes back to unfinished. Only the TASK latches.
//
// Two is enough for every task in the source document. A third would be a
// constant and four array literals.
//--------------------------------------------------------------------------------------------------
const int c_questStepMax = 2;

int[36] gvg_questStepCount;

// Per step, flattened quest * 2 + step.
//
// String KEYS, not words. Everything a player reads lives in
// src/strings/enUS.txt and arrives through StringExternal; see the note at the
// top of that file for why inline English is a translation already lost.
string[72] gvg_questStepKey;
int[72] gvg_questStepGoal;

// The task as a whole, for the completion message and the debug summary. A
// single-step task uses the same key for both, so nothing is written twice.
string[36] gvg_questTitleKey;

// Whether the map can answer this task at all yet. False is not "hard", it is
// "there is no channel": no Ordeals, no end-of-game hook, no zerg queen, or the
// source document leaves the line blank.
bool[36] gvg_questCountable;

// The one mechanical thing about a task a player could not work out by reading
// its name. A key again, and a flag beside it because a localised string cannot
// be tested for emptiness -- there is no TextToString, so "has a note" has to be
// a fact the code states rather than one it discovers.
string[36] gvg_questNoteKey;
bool[36] gvg_questHasNote;

//--------------------------------------------------------------------------------------------------
// One task per game reaches the record. The rest are worth tonight only.
//
// A department's four are SEQUENTIAL: the second cannot be started until the
// first is done. That plus one rule gives the whole progression:
//
//     the first task you have not yet RECORDED is the one this game can record.
//     everything past it, you can still finish, and it pays only tonight.
//
// So a player holding Control Team with nothing recorded can bank Control 1 and
// no more. Finishing it opens Control 2, which is worth playing for -- it pays
// out now -- but comes back locked next game. Four games, four tasks, and every
// one of them a night that was worth playing past the point it stopped counting.
//
// This is what decides main versus bonus in the panel, and it is why that split
// could not be "challenge versus ordinary": the panel is showing the player
// which half of tonight survives it.
//
//--------------------------------------------------------------------------------------------------
// Recorded is a COUNT, not a set.
//
// Because the four are sequential, "which of them are done" is always a prefix,
// and a prefix is one number. gvg_questSaved is that number per player per
// department -- nine small ints a player, which is the entire persistent
// footprint of the quest system.
//
// It only ever changes BETWEEN games. Within a game the recorded count is
// fixed, which is what makes "the one bankable task" a constant index rather
// than something that walks forward as you play, and removes the bug where
// finishing the main task promotes the next one into being bankable too.
//
// Zero everywhere until 16_bank has a section for it; Quest_SetSaved is the
// hook, and -quest saved N drives it by hand in the meantime.
//--------------------------------------------------------------------------------------------------
int[144] gvg_questSaved;

// Completed during THIS game. Flattened player * 36 + quest, sized for 16
// players. A task already in the record is not repeated here.
bool[576] gvg_questDone;

//--------------------------------------------------------------------------------------------------
// The objectives panel.
//
// The stock objectives panel, which the engine already draws, sorts, animates
// on completion, splits into two sections and persists across the whole game.
// Writing any of that would have been writing something worse.
//
// Indexed player * 4 + n rather than by quest id, because a player only ever
// has their own department's four. So this is 64 entries and not 576, and
// changing department is destroy-four-create-four rather than a search.
//
// Two natives carry the whole thing:
//
//   ObjectiveCreateForPlayers   per player, which is what makes six players
//                               with six departments each see only their own
//   ObjectiveSetName            progress, exactly as Blizzard's campaigns do it:
//                               the count lives in the name, "(2/4)"
//
// The last count pushed is remembered so the name is only rewritten when the
// number actually moves. Every two seconds against four objectives times six
// players is 24 text rebuilds a tick otherwise, for a string that is usually
// identical to the one already there.
//
//--------------------------------------------------------------------------------------------------
// Main is the record. Bonus is tonight.
//
// The engine's two sections are labelled "Main Objectives" and "Bonus
// Objectives", and the line between them is not challenge versus ordinary. It
// is what survives the game versus what does not:
//
//   MAIN    the tasks already in your record, plus the ONE this game can add
//   BONUS   everything you open past that, worth playing for and gone tomorrow,
//           and tonight's energy quota (12_energy)
//
// So a player sees, before spending an evening on something, whether the
// evening is the point or the thing after it is. That is a question the split
// can answer and a "challenge/ordinary" split could not.
//
//--------------------------------------------------------------------------------------------------
// There are two text fields, not three.
//
// UI/Layout/UI/ObjectivePanel.SC2Layout puts the NAME in the list line and the
// DESCRIPTION in ObjectiveTooltip's TipLabel -- the description IS the hover
// tooltip, they are not separate slots. So the one tooltip carries both things
// worth saying, reward first because it is actionable and lore second because
// it is not:
//
//   Reward: ...          derived from the completed-task COUNT, because that is
//                        how usr/department.md keys its passives -- "与其已完成
//                        的任务数有关" -- not per task
//   <lore>               authored, and empty everywhere until it is written
//
// A task that is not open yet is created Hidden and revealed by
// Quest_Complete the moment the one in front of it ticks over, so the chain
// shows itself rather than being explained.
//
// An uncountable BONUS task stays hidden -- the panel is what a player reads,
// and a task the map cannot observe is noise there. An uncountable MAIN task is
// shown anyway, because hiding it would make a stalled department look like a
// finished one, which is the worse lie of the two; its tooltip says why it
// cannot move. -quest is what a developer reads and lists all thirty-six either
// way. When a missing system lands, flipping countable is the one change.
//--------------------------------------------------------------------------------------------------
int[128] gvg_questObj;
int[128] gvg_questShown;

const fixed c_questPeriod = 2.0;

trigger gt_questTick;

int Quest_DeptOf (int quest) {
    if (quest < 0 || quest >= c_questCount) {
        return c_deptNone;
    }
    return quest / c_questPerDept;
}

int Quest_NumberOf (int quest) {
    if (quest < 0 || quest >= c_questCount) {
        return 0;
    }
    return quest % c_questPerDept + 1;
}

int Quest_StepCount (int quest) {
    if (quest < 0 || quest >= c_questCount) {
        return 0;
    }
    return gvg_questStepCount[quest];
}

int Quest_StepGoal (int quest, int step) {
    if (quest < 0 || quest >= c_questCount || step < 0 || step >= c_questStepMax) {
        return 0;
    }
    return gvg_questStepGoal[quest * c_questStepMax + step];
}

text Quest_StepTitle (int quest, int step) {
    if (quest < 0 || quest >= c_questCount || step < 0 || step >= c_questStepMax) {
        return StringToText("");
    }
    return StringExternal(gvg_questStepKey[quest * c_questStepMax + step]);
}

bool Quest_IsCountable (int quest) {
    if (quest < 0 || quest >= c_questCount) {
        return false;
    }
    return gvg_questCountable[quest];
}

//--------------------------------------------------------------------------------------------------
// How many of a department's four this player has in the record.
//--------------------------------------------------------------------------------------------------
int Quest_SavedOf (int player, int dept) {
    if (player < 1 || player > 15 || dept < 0 || dept >= c_deptCount) {
        return 0;
    }
    return gvg_questSaved[player * c_deptCount + dept];
}

void Quest_SetSaved (int player, int dept, int count) {
    if (player < 1 || player > 15 || dept < 0 || dept >= c_deptCount) {
        return;
    }
    if (count < 0) {
        count = 0;
    }
    if (count > c_questPerDept) {
        count = c_questPerDept;
    }
    gvg_questSaved[player * c_deptCount + dept] = count;
}

bool Quest_IsSaved (int player, int quest) {
    if (quest < 0 || quest >= c_questCount) {
        return false;
    }
    return Quest_NumberOf(quest) <= Quest_SavedOf(player, Quest_DeptOf(quest));
}

bool Quest_IsDone (int player, int quest) {
    if (player < 1 || player > 15 || quest < 0 || quest >= c_questCount) {
        return false;
    }
    return Quest_IsSaved(player, quest) || gvg_questDone[player * c_questCount + quest];
}

//--------------------------------------------------------------------------------------------------
// The one task this game can put into the record: the first one that is not
// already in it. -1 once a department is finished.
//
// Read off gvg_questSaved, which does not move during a game, so this is a
// constant for the whole session however many tasks get finished.
//--------------------------------------------------------------------------------------------------
int Quest_MainOf (int player) {
    int dept;
    int saved;

    dept = Dept_Of(player);
    if (dept < 0 || dept >= c_deptCount) {
        return -1;
    }
    saved = Quest_SavedOf(player, dept);
    if (saved >= c_questPerDept) {
        return -1;
    }
    return dept * c_questPerDept + saved;
}

//--------------------------------------------------------------------------------------------------
// Whether a task can be worked on at all: the one before it has to be finished.
//
// Progress is NOT gated -- a counter that was already at four when the task
// opened reads four. Only finishing is. Punishing a player for the order they
// happened to do things is not what sequential means here; what it means is
// that the record advances one step at a time.
//--------------------------------------------------------------------------------------------------
bool Quest_IsOpen (int player, int quest) {
    if (quest < 0 || quest >= c_questCount) {
        return false;
    }
    if (Quest_NumberOf(quest) == 1) {
        return true;
    }
    return Quest_IsDone(player, quest - 1);
}

int Quest_DoneCount (int player) {
    int total;
    int quest;

    total = 0;
    quest = 0;
    while (quest < c_questCount) {
        if (Quest_IsDone(player, quest)) {
            total = total + 1;
        }
        quest = quest + 1;
    }
    return total;
}

//--------------------------------------------------------------------------------------------------
// The furthest a player has read any abnormality at or above a grade.
//
// Information Team 2 and its challenge are the same question at two grades and
// two depths, so they are one function. The grade floor is what separates them:
// "至少Zayin" is every abnormality, because Zayin is the bottom of the scale,
// and "至少WAW" is only the two grades that can actually hurt somebody.
//--------------------------------------------------------------------------------------------------
int Quest_BestObservation (int player, int minRisk) {
    int best;
    int obs;
    int i;

    best = 0;
    i = 0;
    while (i < c_abnoCount) {
        if (gvg_abnoRisk[i] >= minRisk) {
            obs = Cont_ObservationOfPlayer(player, i);
            if (obs > best) {
                best = obs;
            }
        }
        i = i + 1;
    }
    return best;
}

//--------------------------------------------------------------------------------------------------
// How far along a player is on ONE STEP.
//
// Never above the goal, so a readout can print progress/goal without clamping
// and a caller can compare the two without knowing which task it is holding.
//
// Single-step tasks ignore the step argument entirely, which is why it is at
// the end of every branch rather than the top of the function: the shape of a
// task with one step should not have to know that steps exist.
//--------------------------------------------------------------------------------------------------
int Quest_StepProgress (int player, int quest, int step) {
    int value;

    if (!Slot_IsTablePlayer(player) || quest < 0 || quest >= c_questCount) {
        return 0;
    }
    if (Quest_DeptOf(quest) != Dept_Of(player) || !gvg_questCountable[quest]) {
        return 0;
    }

    value = 0;

    // Control Team. Two halves of "the facility is running", and two lines in
    // the panel, because "(1/2)" never said which half was missing.
    if (quest == c_qMalkuth1) {
        if (step == 0) {
            value = Cont_WorkingOf(player);
        }
        else {
            value = Fort_LevelSumOf(player);
        }
    }
    else if (quest == c_qMalkuth2) {
        value = Work_GoodBy(player);
    }
    else if (quest == c_qMalkuth3) {
        value = Melt_CleanRoundsBy(player);
    }
    // Table-wide, like Training Team 3: an Ordeal arrives in every department
    // at once and ends when the last entity anywhere falls. There is no
    // per-player half of it that could be counted instead.
    else if (quest == c_qMalkuth4) {
        value = Ordeal_BeatenAtLeast(c_ordealDusk);
    }

    // Information Team.
    else if (quest == c_qYesod1) {
        value = Work_FinishedBy(player);
    }
    else if (quest == c_qYesod2) {
        value = Quest_BestObservation(player, c_riskZayin);
    }
    else if (quest == c_qYesod3) {
        value = Dept_LowestLineLevel(player);
    }
    else if (quest == c_qYesod4) {
        value = Quest_BestObservation(player, c_riskWAW);
    }

    // Safety Team.
    else if (quest == c_qNetzach1) {
        value = Fort_LevelSumOf(player);
    }

    // Training Team. Rank II is one promotion from the floor, so "提升2名员工的
    // 等级" is two employees standing above where they started.
    else if (quest == c_qHod1) {
        value = Emp_CountAtRank(player, 2);
    }
    else if (quest == c_qHod2) {
        value = Emp_CountAtRank(player, 4);
    }
    else if (quest == c_qHod3) {
        // Table-wide on purpose: the document says 队友的进度也计算在内.
        value = Cont_SuppressedDistinct();
    }

    // Disciplinary Team. The Midnight one; Geburah 2 and 3 are suppression
    // counts that still have no channel.
    else if (quest == c_deptGeburah * c_questPerDept + 3) {
        value = Ordeal_BeatenAtLeast(c_ordealMidnight);
    }

    if (value > Quest_StepGoal(quest, step)) {
        value = Quest_StepGoal(quest, step);
    }
    return value;
}

bool Quest_StepDone (int player, int quest, int step) {
    return Quest_StepProgress(player, quest, step) >= Quest_StepGoal(quest, step);
}

//--------------------------------------------------------------------------------------------------
// Every step standing at once, which is what finishing a task means.
//
// At once, not ever: the steps are re-read here and now. Control 1 asks for a
// working cell AND a fortified place, and a player who fortifies a room, loses
// the cell, and comes back tomorrow has not done it.
//--------------------------------------------------------------------------------------------------
bool Quest_AllStepsDone (int player, int quest) {
    int step;

    step = 0;
    while (step < gvg_questStepCount[quest]) {
        if (!Quest_StepDone(player, quest, step)) {
            return false;
        }
        step = step + 1;
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// Where a step's panel entry is kept: player, then which of the four, then
// which step of it.
//--------------------------------------------------------------------------------------------------
int Quest_Slot (int player, int quest, int step) {
    return player * c_questPerDept * c_questStepMax
           + (Quest_NumberOf(quest) - 1) * c_questStepMax + step;
}

int Quest_ObjectiveOf (int player, int quest, int step) {
    if (player < 1 || player > 15 || quest < 0 || quest >= c_questCount
        || step < 0 || step >= c_questStepMax) {
        return c_invalidObjectiveId;
    }
    if (Quest_DeptOf(quest) != Dept_Of(player)) {
        return c_invalidObjectiveId;
    }
    return gvg_questObj[Quest_Slot(player, quest, step)];
}

//--------------------------------------------------------------------------------------------------
// What the panel says. The counter format is Blizzard's own; see
// c_questProgressStyle in 00_config.galaxy for where it came from.
//--------------------------------------------------------------------------------------------------
text Quest_NameText (int player, int quest, int step) {
    if (!gvg_questCountable[quest] || Quest_StepGoal(quest, step) <= 1) {
        // A goal of one is a yes or a no, and "(0/1)" is a worse way of saying
        // it than the tick box already sitting next to the line.
        return Quest_StepTitle(quest, step);
    }
    // The count is punctuation and digits in every language, so it is built
    // here rather than being a format string somebody has to translate around.
    return Quest_StepTitle(quest, step)
           + StringToText(" <s val=\"" + c_questProgressStyle + "\">("
                          + IntToString(Quest_StepProgress(player, quest, step))
                          + "/" + IntToString(Quest_StepGoal(quest, step)) + ")</s>");
}

//--------------------------------------------------------------------------------------------------
// The hover tooltip: what finishing it is worth, then what it is about.
//
// The reward is stated as a COUNT because that is how the source keys it.
// usr/department.md gives each department a passive whose strength is "与其已
// 完成的任务数有关" -- four tiers against four tasks -- so which task you finish
// does not decide what you get, only how many.
//
// The half that changes is whether finishing it is KEPT, and that depends on
// where the task sits relative to the record, not on the task. Saying so
// plainly is the whole reason the panel is split: a player should be able to
// see, before spending an evening on something, whether the evening is the
// point or the thing after it is.
//--------------------------------------------------------------------------------------------------
text Quest_DescText (int player, int quest, int step) {
    text line;

    line = StringExternal(gvg_deptNameKey[Quest_DeptOf(quest)])
           + StringToText(" " + IntToString(Quest_NumberOf(quest)));

    // A split task says so on both of its lines, and says which one this is,
    // because the panel gives them no other reason to look related.
    if (gvg_questStepCount[quest] > 1) {
        line = line + StringToText(" (" + IntToString(step + 1) + "/"
                                   + IntToString(gvg_questStepCount[quest]) + ")");
    }

    if (gvg_questHasNote[quest]) {
        line = line + StringToText(" -- ") + StringExternal(gvg_questNoteKey[quest]);
    }
    line = line + StringToText("<n/><n/>");

    if (quest == Quest_MainOf(player)) {
        line = line + StringExternal("Lob/Quest/Reward/Main");
    }
    else if (Quest_IsSaved(player, quest)) {
        line = line + StringExternal("Lob/Quest/Reward/Record");
    }
    else {
        line = line + StringExternal("Lob/Quest/Reward/Bonus");
    }

    if (gvg_questStepCount[quest] > 1) {
        line = line + StringToText("<n/><n/>") + StringExternal("Lob/Quest/BothParts");
    }

    if (!gvg_questCountable[quest]) {
        line = line + StringToText("<n/><n/>") + StringExternal("Lob/Quest/NoChannel");
    }
    return line;
}

//--------------------------------------------------------------------------------------------------
// Pushes one step's line back to the panel.
//
// Both the name and the state, because a step is derived and can therefore go
// BACKWARDS -- lose the cell after buying the fortification and Control 1's
// first line un-ticks. That is not a glitch to hide, it is the "at the same
// time" rule making itself visible, and a tick that can come off is the only
// honest way to draw a condition that can stop being true.
//--------------------------------------------------------------------------------------------------
void Quest_ShowStep (int player, int quest, int step) {
    int obj;
    int state;

    obj = Quest_ObjectiveOf(player, quest, step);
    if (obj == c_invalidObjectiveId) {
        return;
    }

    state = c_objectiveStateActive;
    if (Quest_IsDone(player, quest) || Quest_StepDone(player, quest, step)) {
        state = c_objectiveStateCompleted;
    }

    ObjectiveSetName(obj, Quest_NameText(player, quest, step));
    ObjectiveSetState(obj, state);
    gvg_questShown[Quest_Slot(player, quest, step)] =
        Quest_StepProgress(player, quest, step);
}

//--------------------------------------------------------------------------------------------------
// Marks one done, once, and opens the one behind it.
//
// Revealing the next task here rather than on the tick is what makes the panel
// read as a chain: the moment one ticks over, the next appears under Bonus
// Objectives, and the player learns the rule by watching it happen instead of
// by being told.
//--------------------------------------------------------------------------------------------------
void Quest_Complete (int player, int quest) {
    int next;
    int step;

    if (player < 1 || player > 15 || quest < 0 || quest >= c_questCount) {
        return;
    }
    if (Quest_IsDone(player, quest)) {
        return;
    }
    gvg_questDone[player * c_questCount + quest] = true;

    // Every step of it, because the task latching is what freezes them: from
    // here on none of them may un-tick, whatever the world does.
    step = 0;
    while (step < gvg_questStepCount[quest]) {
        Quest_ShowStep(player, quest, step);
        step = step + 1;
    }

    if (Quest_NumberOf(quest) < c_questPerDept) {
        step = 0;
        while (step < gvg_questStepCount[quest + 1]) {
            next = Quest_ObjectiveOf(player, quest + 1, step);
            if (next != c_invalidObjectiveId && gvg_questCountable[quest + 1]) {
                ObjectiveSetState(next, c_objectiveStateActive);
            }
            step = step + 1;
        }
    }

    // The panel animates the tick itself; the subtitle is for the player who
    // was looking at the other end of the map when it happened.
    UIDisplayMessage(
        PlayerGroupSingle(player), c_messageAreaSubtitle,
        StringExternal("Lob/Quest/Complete") + StringToText(" ")
        + StringExternal(gvg_questTitleKey[quest]));
}

//--------------------------------------------------------------------------------------------------
// Builds a player's four panel entries, replacing whatever was there.
//
// Called at init and again whenever a player's department changes, which right
// now only the debug command does but a selection screen will do for real.
//--------------------------------------------------------------------------------------------------
void Quest_Publish (int player) {
    int dept;
    int quest;
    int state;
    int main;
    int n;
    int step;
    bool primary;

    n = 0;
    while (n < c_questPerDept * c_questStepMax) {
        if (gvg_questObj[player * c_questPerDept * c_questStepMax + n]
            != c_invalidObjectiveId) {
            ObjectiveDestroy(gvg_questObj[player * c_questPerDept * c_questStepMax + n]);
        }
        gvg_questObj[player * c_questPerDept * c_questStepMax + n] = c_invalidObjectiveId;
        gvg_questShown[player * c_questPerDept * c_questStepMax + n] = -1;
        n = n + 1;
    }

    dept = Dept_Of(player);
    if (dept < 0 || dept >= c_deptCount) {
        return;
    }

    main = Quest_MainOf(player);

    n = 0;
    while (n < c_questPerDept) {
        quest = dept * c_questPerDept + n;

        // Main is the record: everything already in it, plus the one task this
        // game can add to it. Everything past that is bonus -- finishable
        // tonight, gone tomorrow -- which is exactly what the engine's second
        // section means. Both halves of a split task sit on the same side of
        // that line, because they are one task.
        primary = Quest_IsSaved(player, quest) || quest == main;

        step = 0;
        while (step < gvg_questStepCount[quest]) {
            state = c_objectiveStateActive;
            if (Quest_IsDone(player, quest) || Quest_StepDone(player, quest, step)) {
                state = c_objectiveStateCompleted;
            }
            else if (!Quest_IsOpen(player, quest)) {
                // Not yet reachable. Shown the moment the one before it is done,
                // by Quest_Complete, so the chain reveals itself.
                state = c_objectiveStateHidden;
            }
            else if (!gvg_questCountable[quest] && !primary) {
                // A bonus task the map cannot observe is noise. The MAIN one is
                // shown even when it cannot be finished, because hiding it would
                // make a stalled department look like a finished one -- which is
                // the worse lie of the two, and the tooltip says why.
                state = c_objectiveStateHidden;
            }

            gvg_questObj[Quest_Slot(player, quest, step)] = ObjectiveCreateForPlayers(
                Quest_NameText(player, quest, step),
                Quest_DescText(player, quest, step),
                state,
                primary,
                PlayerGroupSingle(player));
            gvg_questShown[Quest_Slot(player, quest, step)] =
                Quest_StepProgress(player, quest, step);

            step = step + 1;
        }

        n = n + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// Polled rather than driven by events.
//
// Most of what a task reads is derived, so there is no event to hang it on --
// "four levels of fortification" changes when a location is upgraded, but also
// when a sector's owner changes hands, and "two employees at rank II" changes
// on a work result, a department upgrade and the Training Team core
// suppression. One place that reconciles beats six places that each remember
// to, and the same argument already put Emp_SyncRank on a tick.
//
// Every two seconds against a handful of integer comparisons is nothing, and
// completion is a latch, so the only cost of being a moment late is being a
// moment late.
//
// The panel is only written when a number actually moves. Rebuilding four
// identical strings per player per tick would be the whole cost of this module
// spent on saying nothing.
//--------------------------------------------------------------------------------------------------
bool Quest_Tick_Func (bool testConds, bool runActions) {
    int player;
    int quest;
    int dept;
    int step;
    int now;

    if (!runActions) {
        return true;
    }

    player = 1;
    while (player <= 15) {
        if (Slot_IsTablePlayer(player)) {
            dept = Dept_Of(player);
            if (dept >= 0 && dept < c_deptCount) {
                quest = dept * c_questPerDept;
                while (quest < dept * c_questPerDept + c_questPerDept) {
                    if (gvg_questCountable[quest] && !Quest_IsDone(player, quest)) {
                        // The chain: a task cannot finish before the one in
                        // front of it, even with every step already standing.
                        // The counters still show, so a player can see what
                        // they have banked up against a task not yet open.
                        if (Quest_IsOpen(player, quest)
                            && Quest_AllStepsDone(player, quest)) {
                            Quest_Complete(player, quest);
                        }
                        else {
                            step = 0;
                            while (step < gvg_questStepCount[quest]) {
                                now = Quest_StepProgress(player, quest, step);
                                if (now != gvg_questShown[Quest_Slot(player, quest, step)]) {
                                    Quest_ShowStep(player, quest, step);
                                }
                                step = step + 1;
                            }
                        }
                    }
                    quest = quest + 1;
                }
            }
        }
        player = player + 1;
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// The table.
//
// Goals are the numbers in docs/usr/quests_unlocks.md and nothing else. Where
// that document is blank the entry is still declared, with goal 0 and
// uncountable, so the count of tasks per department stays four everywhere and
// the unlock chain can be written against a shape that will not move.
//--------------------------------------------------------------------------------------------------
void Quest_Declare (int quest, int goal, bool countable, string titleKey) {
    gvg_questCountable[quest] = countable;
    gvg_questTitleKey[quest] = titleKey;
    gvg_questNoteKey[quest] = "";
    gvg_questHasNote[quest] = false;

    // One step, sharing the task's own title. A task that is one thing should
    // not have to say so twice, in the code or in the strings file.
    gvg_questStepCount[quest] = 1;
    gvg_questStepKey[quest * c_questStepMax] = titleKey;
    gvg_questStepGoal[quest * c_questStepMax] = goal;
}

//--------------------------------------------------------------------------------------------------
// Splits a task into two lines that must both be standing at once.
//
// For the tasks the document joins with an "and". The task keeps its own title
// for the completion message and the readout; the panel shows the halves.
//--------------------------------------------------------------------------------------------------
void Quest_Halves (int quest, string keyA, int goalA, string keyB, int goalB) {
    gvg_questStepCount[quest] = 2;
    gvg_questStepKey[quest * c_questStepMax] = keyA;
    gvg_questStepGoal[quest * c_questStepMax] = goalA;
    gvg_questStepKey[quest * c_questStepMax + 1] = keyB;
    gvg_questStepGoal[quest * c_questStepMax + 1] = goalB;
}

// The one mechanical thing about a task a player could not work out by reading
// its name. Sits on the department line, above the reward.
void Quest_Note (int quest, string noteKey) {
    gvg_questNoteKey[quest] = noteKey;
    gvg_questHasNote[quest] = true;
}

void Quests_Init () {
    int i;

    i = 0;
    while (i < c_questCount) {
        Quest_Declare(i, 0, false, "");
        i = i + 1;
    }

    // Nobody has a record yet. This is where 16_bank reads it in when it has a
    // section for it -- nine small ints a player, because sequential tasks make
    // "which are done" a prefix and a prefix is a count.
    i = 0;
    while (i < 15 * c_deptCount + c_deptCount) {
        gvg_questSaved[i] = 0;
        i = i + 1;
    }

    // Control Team.
    // Goal 0 because Quest_Halves replaces it: a split task's numbers are on
    // its halves, and repeating a total here would be a second place for them
    // to disagree from.
    Quest_Declare(c_qMalkuth1, 0, true, "Lob/Quest/Title/Malkuth1");
    Quest_Halves(c_qMalkuth1, "Lob/Quest/Step/Malkuth1a", 1,
                              "Lob/Quest/Step/Malkuth1b", 1);
    Quest_Declare(c_qMalkuth2, 4, true, "Lob/Quest/Title/Malkuth2");
    Quest_Declare(c_qMalkuth3, 3, true, "Lob/Quest/Title/Malkuth3");
    Quest_Declare(c_qMalkuth4, 1, true, "Lob/Quest/Title/Malkuth4");

    // Information Team.
    Quest_Declare(c_qYesod1, 3, true, "Lob/Quest/Title/Yesod1");
    Quest_Declare(c_qYesod2, 3, true, "Lob/Quest/Title/Yesod2");
    Quest_Declare(c_qYesod3, 2, true, "Lob/Quest/Title/Yesod3");
    Quest_Declare(c_qYesod4, 4, true, "Lob/Quest/Title/Yesod4");

    // Safety Team. 2 and 3 are blank in the source document.
    Quest_Declare(c_qNetzach1, 4, true, "Lob/Quest/Title/Netzach1");
    Quest_Declare(c_qNetzach1 + 1, 0, false, "Lob/Quest/Title/Netzach2");
    Quest_Declare(c_qNetzach1 + 2, 0, false, "Lob/Quest/Title/Netzach3");
    Quest_Declare(c_qNetzach4, 1, false, "Lob/Quest/Title/Netzach4");

    // Training Team.
    Quest_Declare(c_qHod1, 2, true, "Lob/Quest/Title/Hod1");
    Quest_Declare(c_qHod2, 1, true, "Lob/Quest/Title/Hod2");
    Quest_Declare(c_qHod3, 4, true, "Lob/Quest/Title/Hod3");
    Quest_Note(c_qHod3, "Lob/Quest/Note/Hod3");
    Quest_Declare(c_qHod4, 1, false, "Lob/Quest/Title/Hod4");

    // Central Command, Welfare, Record, Extraction: the source document lists
    // no tasks at all for these, so they are titles and nothing else.
    Quest_Declare(c_deptTiphereth * c_questPerDept + 0, 0, false, "Lob/Quest/Title/Tiphereth1");
    Quest_Declare(c_deptTiphereth * c_questPerDept + 1, 0, false, "Lob/Quest/Title/Tiphereth2");
    Quest_Declare(c_deptTiphereth * c_questPerDept + 2, 0, false, "Lob/Quest/Title/Tiphereth3");
    Quest_Declare(c_deptTiphereth * c_questPerDept + 3, 0, false, "Lob/Quest/Title/Tiphereth4");
    Quest_Declare(c_deptChesed * c_questPerDept + 0, 0, false, "Lob/Quest/Title/Chesed1");
    Quest_Declare(c_deptChesed * c_questPerDept + 1, 0, false, "Lob/Quest/Title/Chesed2");
    Quest_Declare(c_deptChesed * c_questPerDept + 2, 0, false, "Lob/Quest/Title/Chesed3");
    Quest_Declare(c_deptChesed * c_questPerDept + 3, 0, false, "Lob/Quest/Title/Chesed4");
    Quest_Declare(c_deptHokma * c_questPerDept + 0, 0, false, "Lob/Quest/Title/Hokma1");
    Quest_Declare(c_deptHokma * c_questPerDept + 1, 0, false, "Lob/Quest/Title/Hokma2");
    Quest_Declare(c_deptHokma * c_questPerDept + 2, 0, false, "Lob/Quest/Title/Hokma3");
    Quest_Declare(c_deptHokma * c_questPerDept + 3, 0, false, "Lob/Quest/Title/Hokma4");
    Quest_Declare(c_deptBinah * c_questPerDept + 0, 0, false, "Lob/Quest/Title/Binah1");
    Quest_Declare(c_deptBinah * c_questPerDept + 1, 0, false, "Lob/Quest/Title/Binah2");
    Quest_Declare(c_deptBinah * c_questPerDept + 2, 0, false, "Lob/Quest/Title/Binah3");
    Quest_Declare(c_deptBinah * c_questPerDept + 3, 0, false, "Lob/Quest/Title/Binah4");

    // Disciplinary Team. Unlocks at ten tasks, so nothing here is reachable
    // yet, but the goals are the document's and only the channels are missing.
    Quest_Declare(c_deptGeburah * c_questPerDept + 0, 1, false, "Lob/Quest/Title/Geburah1");
    Quest_Declare(c_deptGeburah * c_questPerDept + 1, 0, false, "Lob/Quest/Title/Geburah2");
    Quest_Halves(c_deptGeburah * c_questPerDept + 1,
                 "Lob/Quest/Step/Geburah2a", 3,
                 "Lob/Quest/Step/Geburah2b", 2);
    Quest_Declare(c_deptGeburah * c_questPerDept + 2, 3, false, "Lob/Quest/Title/Geburah3");
    Quest_Declare(c_deptGeburah * c_questPerDept + 3, 1, true, "Lob/Quest/Title/Geburah4");

    // After the table, because publishing reads it. Departments are dealt in
    // Departments_Init, which the build orders before this one.
    i = 0;
    while (i < 16 * c_questPerDept * c_questStepMax) {
        gvg_questObj[i] = c_invalidObjectiveId;
        i = i + 1;
    }

    i = 1;
    while (i <= 15) {
        if (Slot_IsTablePlayer(i)) {
            Quest_Publish(i);
        }
        i = i + 1;
    }

    gt_questTick = TriggerCreate("Quest_Tick_Func");
    TriggerAddEventTimePeriodic(gt_questTick, c_questPeriod, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/90_debug.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Chat commands.
//
// A test harness, not a feature. Everything here exists so that a mechanic can
// be driven by hand in a running game before the system that will drive it for
// real is written -- the alternative is testing employee stats only through a
// work order that does not exist yet, which would mean the first time either
// one runs is also the first time both run.
//
// Numbered last so it can call into anything.
//
// One trigger, one event per player, matching "-" loosely; every command is
// then parsed out of the message text. Registering an event per command would
// mean touching Init every time a command is added, and this file will collect
// commands for as long as there are unfinished systems.
//
// Deliberately not gated behind a flag. It only reaches things a player already
// owns, the map is not shipped from this branch, and a debug console that has
// to be switched on is a debug console nobody switches on. When that stops
// being true the gate goes in Debug_Init and nowhere else.
//--------------------------------------------------------------------------------------------------

const string c_debugPrefix = "-";

trigger gt_debugChat;

// The debug area, which is what it is for and which has room. Chat does not:
// -emp and -cont are several lines each and they push the actual conversation
// out of a window that is small to begin with.
//
// This went to chat for a while on a suspicion that the debug area was behind
// "TextError: 无法找到字体样式[]", because some DEBUG-tagged styles in core's
// FontStyles are marked requiredtoload. That suspicion is dead: the error was
// an unescaped <s> in the old chat help text, and the debug area never had
// anything to do with it.
//--------------------------------------------------------------------------------------------------
// What to call an abnormality in DEVELOPER output.
//
// Its unit type, not its display name. The name is a localised string now and
// cannot come back as a Galaxy string at all -- but the type is also the better
// answer: "O_03_03" is the document filename, the CUnit id and the thing you
// would grep for, where the display name is the player's handle for it.
//--------------------------------------------------------------------------------------------------
string Debug_AbnoName (unit abno) {
    int index;

    index = AbnoGen_IndexOf(abno);
    if (index < 0) {
        return UnitGetType(abno);
    }
    return gvg_abnoType[index];
}

void Debug_Say (int player, string line) {
    UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaDebug, StringToText(line));
}

// For a line that has to include a LOCALISED string. Galaxy has StringToText and
// no TextToString, so a localised string can never come back as a Galaxy string
// -- once a readout needs one of them it has to be assembled as text the whole
// way. Only the quest readout needs this; everything else in here is developer
// text and stays a plain string on purpose.
void Debug_SayText (int player, text line) {
    UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaDebug, line);
}

//--------------------------------------------------------------------------------------------------
// Which stat a word means. -1 for "all", -2 for "not a stat".
//--------------------------------------------------------------------------------------------------
const int c_debugStatAll = -1;
const int c_debugStatBad = -2;

int Debug_StatFromWord (string word) {
    if (StringEqual(word, "fort", false) || StringEqual(word, "f", false)) {
        return c_statFortitude;
    }
    if (StringEqual(word, "prud", false) || StringEqual(word, "p", false)) {
        return c_statPrudence;
    }
    if (StringEqual(word, "temp", false) || StringEqual(word, "t", false)) {
        return c_statTemperance;
    }
    if (StringEqual(word, "just", false) || StringEqual(word, "j", false)) {
        return c_statJustice;
    }
    if (StringEqual(word, "all", false) || StringEqual(word, "a", false)) {
        return c_debugStatAll;
    }
    return c_debugStatBad;
}

//--------------------------------------------------------------------------------------------------
// StringToInt raises a trigger error on an empty string rather than returning
// zero, and StringWord returns an empty string for a word that was not typed.
// So every optional argument has to come through here; -stat with no value and
// -emp spawn with no count both hit it.
//--------------------------------------------------------------------------------------------------
int Debug_Int (string word, int fallback) {
    if (word == "") {
        return fallback;
    }
    return StringToInt(word);
}

string Debug_PanicTag (unit who) {
    if (Emp_IsPanicked(who)) {
        return " PANICKED";
    }
    return "";
}

string Debug_RankName (int rank) {
    if (rank == 1) { return "I"; }
    if (rank == 2) { return "II"; }
    if (rank == 3) { return "III"; }
    if (rank == 4) { return "IV"; }
    if (rank == 5) { return "V"; }
    return "?";
}

string Debug_StatLevelName (int level) {
    if (level == 6) { return "EX"; }
    return Debug_RankName(level);
}

//--------------------------------------------------------------------------------------------------
// The employees in a player's current selection.
//
// Selection rather than a name or an index, because the point of the exercise
// is to look at one specific unit's panel while changing it. Falling back to
// every employee the player owns when nothing employee-ish is selected keeps
// "-stat all 90" useful for setting up a scenario.
//--------------------------------------------------------------------------------------------------
unitgroup Debug_TargetEmployees (int player) {
    unitgroup selected;
    unitgroup found;
    unit who;
    int count;
    int i;

    found = UnitGroupEmpty();
    selected = UnitGroupSelected(player);
    count = UnitGroupCount(selected, c_unitCountAlive);

    i = 1;
    while (i <= count) {
        who = UnitGroupUnit(selected, i);
        if (who != null && ObjectsGen_IsEmp(who)) {
            UnitGroupAdd(found, who);
        }
        i = i + 1;
    }

    if (UnitGroupCount(found, c_unitCountAlive) == 0) {
        found = Emp_Of(player);
    }
    return found;
}

//--------------------------------------------------------------------------------------------------
// Where a debug spawn goes: at the player's character, else at their core, else
// wherever they are looking.
//--------------------------------------------------------------------------------------------------
point Debug_SpawnPoint (int player) {
    unit hero;
    unit core;

    hero = Hero_Of(player);
    if (hero != null && UnitIsAlive(hero)) {
        return UnitGetPosition(hero);
    }
    core = Sector_AnyCore(player);
    if (core != null) {
        return UnitGetPosition(core);
    }
    return CameraGetTarget(player);
}

//--------------------------------------------------------------------------------------------------
// -emp
//
// One line per employee: the four raw values, the four levels they land on,
// their sum, and the rank that sum buys. Printed together on purpose -- the
// thing worth checking is that the derivation agrees with the panel, and that
// only shows up when every step of it is on screen at once.
//--------------------------------------------------------------------------------------------------
void Debug_ReportEmployees (int player) {
    unitgroup mine;
    unit who;
    int count;
    int i;
    int stat;
    int sum;
    string line;

    mine = Debug_TargetEmployees(player);
    count = UnitGroupCount(mine, c_unitCountAlive);

    if (count == 0) {
        Debug_Say(player, "emp: none (spawn some with -emp spawn 3)");
        return;
    }

    i = 1;
    while (i <= count) {
        who = UnitGroupUnit(mine, i);
        line = "emp " + IntToString(i) + ":";
        sum = 0;

        stat = 0;
        while (stat < c_statCount) {
            line = line + " " + StringSub(Emp_StatName(stat), 1, 4)
                   + "=" + IntToString(Emp_Stat(who, stat))
                   + "(" + Debug_StatLevelName(Emp_StatLevel(who, stat)) + ")";
            sum = sum + Emp_StatLevel(who, stat);
            stat = stat + 1;
        }

        line = line + "  sum=" + IntToString(sum)
               + " rank=" + Debug_RankName(Emp_Rank(who))
               + " panel=" + IntToString(UnitXPGetCurrentLevel(who, c_rankBehavior))
               + " sp=" + IntToString(Emp_SP(who)) + "/" + IntToString(Emp_SPMax(who));
        line = line + Debug_PanicTag(who);
        // Whether the room is doing anything for them. A broken employee cannot
        // walk, so one outside is not recovering at all until somebody shoots
        // them with a White round -- and that is invisible from the numbers.
        if (Sector_InRestHall(who)) {
            line = line + " [resting]";
        }
        Debug_Say(player, line);
        i = i + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// -cont
//
// One line per abnormality: grade, state, Qliphoth counter, and what its door
// is doing. The state and the door are printed together because the pairing is
// the whole mechanic -- an abnormality that has decided to leave and a door
// that is still standing is the only situation where anybody has time to react.
//--------------------------------------------------------------------------------------------------
string Debug_CellStateName (int state) {
    if (state == c_cellContained) { return "contained"; }
    if (state == c_cellEscaping) { return "ESCAPING (on its door)"; }
    if (state == c_cellLoose) { return "LOOSE"; }
    if (state == c_cellReturning) { return "returning"; }
    return "?";
}

void Debug_ReportCells (int player) {
    unit abno;
    unit door;
    unit panel;
    string line;
    int slot;
    int near;

    if (gv_cellCount == 0) {
        Debug_Say(player, "cont: no abnormality placed ("
                          + IntToString(c_abnoCount) + " have docs)");
        return;
    }

    slot = 0;
    while (slot < gv_cellCount) {
        abno = gvg_cellAbno[slot];
        door = Cont_DoorAt(gvg_cellHome[slot]);

        line = "cell " + IntToString(slot) + " " + Debug_AbnoName(abno)
               + " [" + Risk_Name(Risk_Of(abno)) + "]"
               + " " + Debug_CellStateName(gvg_cellState[slot])
               + " qlip=" + IntToString(Cont_Counter(abno))
               + " obs=" + IntToString(Cont_ObservationOfPlayer(player, AbnoGen_IndexOf(abno)))
               + "/4 box=" + IntToString(Cont_BoxesOf(player, AbnoGen_IndexOf(abno)))
               + "(next " + IntToString(AbnoGen_ObsCost(AbnoGen_IndexOf(abno),
                     Cont_ObservationOfPlayer(player, AbnoGen_IndexOf(abno)))) + ")";

        if (door == null) {
            line = line + " door=none";
        }
        else if (UnitIsAlive(door)) {
            line = line + " door=up "
                   + IntToString(FixedToInt(
                         UnitGetPropertyFixed(door, c_unitPropLifePercent, true)))
                   + "% strain=" + IntToString(UnitBehaviorCount(door, c_doorStrainBuff));
        }
        else {
            line = line + " door=DOWN";
        }

        // Who this cell answers to, and WHERE THAT ANSWER CAME FROM. Cont_OwnerOf
        // reads the panel's owner first and only falls back to the nearest core,
        // and those two disagreeing is the signature of a pasted cell: the editor
        // pastes a unit with the player it was copied FROM, so a cell duplicated
        // out of one department and dropped into another keeps answering to the
        // first one. Nothing else in the game would ever mention it -- the cell
        // simply belongs to somebody across the map, and their meltdowns name it.
        panel = Cont_PanelAt(gvg_cellHome[slot]);
        near = Sector_OwnerNear(gvg_cellHome[slot]);
        line = line + " own=" + Dept_NameOf(Cont_OwnerOf(slot));
        if (panel == null) {
            line = line + "(NO PANEL, by core)";
        }
        else if (!Slot_IsTablePlayer(UnitGetOwner(panel))) {
            line = line + "(panel unowned, by core)";
        }
        else if (UnitGetOwner(panel) != near) {
            line = line + "(PANEL SAYS SO, nearest core is " + Dept_NameOf(near) + ")";
        }

        if (Melt_IsHeld(slot)) {
            line = line + " melt=HELD";
        }
        else if (Melt_IsFlagged(slot)) {
            line = line + " melt=NAMED " + IntToString(FixedToInt(Melt_SecondsLeft(slot))) + "s";
        }

        Debug_Say(player, line);
        slot = slot + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// -ordeal | -ordeal now | -ordeal dawn|noon|dusk|midnight
//
// The pool per tier, what is coming, and what is standing.
//
// "now" runs the SCHEDULED one early and consumes it, which is the real path
// through the system. A tier name runs one of that tier out of band and does
// NOT consume the schedule -- it is how a Midnight gets looked at without a
// game that has reached meltdown 8, and how a tier the difficulty has skipped
// gets tested at all.
//--------------------------------------------------------------------------------------------------
string Debug_OrdealTier (int tier) {
    return Diff_OrdealName(tier) + " " + IntToString(Ordeal_PoolSize(tier)) + " type(s)";
}

int Debug_OrdealTierFromWord (string word) {
    if (StringEqual(word, "dawn", false)) { return c_ordealDawn; }
    if (StringEqual(word, "noon", false)) { return c_ordealNoon; }
    if (StringEqual(word, "dusk", false)) { return c_ordealDusk; }
    if (StringEqual(word, "midnight", false) || StringEqual(word, "mid", false)) {
        return c_ordealMidnight;
    }
    return -1;
}

void Debug_Ordeal (int player, string word) {
    string line;
    int tier;
    int loc;

    tier = Debug_OrdealTierFromWord(word);

    if (gv_ordealActive && (tier >= 0 || StringEqual(word, "now", false))) {
        Debug_Say(player, "ordeal: one is already running");
    }
    else if (tier >= 0) {
        if (Ordeal_PoolSize(tier) == 0) {
            Debug_Say(player, "ordeal: no " + Diff_OrdealName(tier) + " units authored");
        }
        else {
            // Out of band on purpose: the schedule is untouched, so the real
            // one still arrives at its own level afterwards.
            Ordeal_Begin(tier, Ordeal_Draw(tier));
        }
    }
    else if (StringEqual(word, "now", false)) {
        if (gv_ordealNextType == "") {
            Debug_Say(player, "ordeal: nothing scheduled -- no tier left within the cap");
        }
        else {
            gvg_ordealSpent[gv_ordealNextTier] = true;
            Ordeal_Begin(gv_ordealNextTier, gv_ordealNextType);
            Ordeal_ScheduleNext();
        }
    }

    line = "ordeal pool:";
    tier = 0;
    while (tier < c_diffCount) {
        line = line + "  " + Debug_OrdealTier(tier);
        tier = tier + 1;
    }
    Debug_Say(player, line);

    // The whole night's schedule, drawn at init. A spent tier will not come
    // back and a tier above the cap will never come at all.
    line = "ordeal schedule:";
    tier = 0;
    while (tier < c_diffCount) {
        line = line + "  " + Diff_OrdealName(tier) + "@" + IntToString(gvg_ordealAtLevel[tier]);
        if (tier > Diff_OrdealCap()) {
            line = line + "(capped)";
        }
        else if (gvg_ordealSpent[tier]) {
            line = line + "(done)";
        }
        tier = tier + 1;
    }
    Debug_Say(player, line);
    Debug_Say(player, "ordeal cap " + Diff_OrdealName(Diff_OrdealCap())
                      + "  melt " + IntToString(Melt_Level()));

    if (gv_ordealActive) {
        Debug_Say(player, "ordeal RUNNING " + gv_ordealType
                          + " (" + Diff_OrdealName(gv_ordealTier) + ")  standing "
                          + IntToString(Ordeal_Standing()) + "/" + IntToString(gv_ordealCount)
                          + "  pays " + IntToString(Ordeal_RewardFor(gv_ordealTier)));

        // What each entity is up to. A thief walking to a cell and a thief
        // standing next to one look identical on screen, and the twenty seconds
        // between them is the whole mechanic.
        tier = 0;
        while (tier < gv_ordealCount) {
            line = "  ent " + IntToString(tier) + " p" + IntToString(gvg_ordealHome[tier]);
            if (gvg_ordealUnit[tier] == null || !UnitIsAlive(gvg_ordealUnit[tier])) {
                line = line + " dead";
            }
            else if (gv_ordealAct == c_ordealActThief) {
                if (gvg_ordealMark[tier] == null) {
                    line = line + " idle -- no cell to rob";
                }
                else if (UnitOrderHasAbil(gvg_ordealUnit[tier], c_ordealRobAbil)) {
                    line = line + " on " + Debug_AbnoName(gvg_ordealMark[tier]);
                }
                else {
                    line = line + " marked " + Debug_AbnoName(gvg_ordealMark[tier])
                           + " but not ordered";
                }
            }
            else if (gv_ordealAct == c_ordealActBomb) {
                line = line + " fuse "
                       + IntToString(FixedToInt(gvg_ordealAt[tier] - GameGetMissionTime())) + "s";
            }
            else if (gv_ordealAct == c_ordealActDigger) {
                loc = Fort_LocOfPoint(UnitGetPosition(gvg_ordealUnit[tier]));
                if (loc >= 0) {
                    line = line + " in " + gvg_locName[loc];
                }
                else {
                    line = line + " in no drawn region";
                }

                // Digging and about-to-dig are two seconds apart and look the
                // same from outside, which is the whole reason the cast has a
                // bar. The countdown going negative and no DIGGING beside it
                // means the order is not landing.
                if (UnitOrderHasAbil(gvg_ordealUnit[tier], c_ordealDigAbil)) {
                    line = line + " DIGGING";
                }
                else {
                    line = line + " digs in "
                           + IntToString(FixedToInt(gvg_ordealAt[tier]
                                                    - GameGetMissionTime())) + "s";
                }
            }
            else {
                line = line + " alive";
            }
            Debug_Say(player, line);
            tier = tier + 1;
        }
        return;
    }

    if (gv_ordealNextTier < 0) {
        Debug_Say(player, "ordeal next: NONE -- every tier within the cap has happened");
    }
    else {
        line = "ordeal next at melt " + IntToString(gv_ordealNextLevel)
               + " (" + Diff_OrdealName(gv_ordealNextTier) + "): ";
        if (gv_ordealNextType == "") {
            line = line + "NOTHING -- no units authored for that tier";
        }
        else {
            line = line + gv_ordealNextType;
        }
        Debug_Say(player, line);
    }
    Debug_Say(player, "ordeal beaten: dusk+ " + IntToString(Ordeal_BeatenAtLeast(c_ordealDusk))
                      + "  midnight " + IntToString(Ordeal_BeatenAtLeast(c_ordealMidnight)));
}

//--------------------------------------------------------------------------------------------------
// -fort [slot]
//
// Every room and corridor: level, owner, how much of it is standing. With an
// index, buys the next level there -- standing in for the upgrade button, which
// needs a room UI that does not exist.
//
// Prints the refusal reason rather than failing quietly, because "the current
// level is not finished being built" is a rule people will hit constantly and
// a dead button teaches nothing.
//--------------------------------------------------------------------------------------------------
void Debug_Fortify (int player, string word) {
    string line;
    int loc;
    int slot;
    int standing;
    int total;
    int unbuildable;
    int want;

    want = Debug_Int(word, -1);
    if (want >= 0) {
        if (Fort_UpgradeRefusal(player, want) != "") {
            Debug_Say(player, "fort: " + Fort_UpgradeRefusal(player, want));
        }
        else {
            Fort_Upgrade(player, want);
        }
    }

    if (gv_locCount == 0) {
        Debug_Say(player, "fort: no room_* or corridor_* region drawn yet ("
                          + IntToString(c_regionCount) + " regions total)");
        return;
    }

    loc = 0;
    while (loc < gv_locCount) {
        standing = 0;
        total = 0;
        slot = 0;
        while (slot < gv_slotCount) {
            if (gvg_slotLoc[slot] == loc && gvg_slotLevel[slot] <= gvg_locLevel[loc]) {
                total = total + 1;
                if (Fort_SlotFilled(slot)) {
                    standing = standing + 1;
                }
            }
            slot = slot + 1;
        }

        line = "fort " + IntToString(loc) + " " + gvg_locName[loc]
               + "  lv" + IntToString(gvg_locLevel[loc]) + "/" + IntToString(c_fortMaxLevel)
               + "  owner=";
        if (Fort_OwnerOf(loc) == 0) {
            line = line + "NOBODY";
        }
        else {
            line = line + IntToString(Fort_OwnerOf(loc));
        }
        line = line + "  standing " + IntToString(standing) + "/" + IntToString(total);
        if (unbuildable > 0) {
            // No CAbilBuild row for that unit type, so nothing can order it
            // built and the position will stay empty forever. Silence here
            // would look exactly like a lazy worker.
            line = line + "  (" + IntToString(unbuildable) + " have no build command)";
        }
        if (gvg_locLevel[loc] < c_fortMaxLevel) {
            line = line + "  next " + IntToString(gvg_fortCost[gvg_locLevel[loc] + 1]) + "m";
        }
        Debug_Say(player, line);

        // One line per position. "standing 0/1" is what a slot whose handle was
        // never recorded prints, and it is indistinguishable from a worker that
        // has not got there yet -- which is how that bug stayed hidden. Say
        // what is actually in the slot instead.
        slot = 0;
        while (slot < gv_slotCount) {
            if (gvg_slotLoc[slot] == loc) {
                line = "  slot " + IntToString(slot)
                       + " lv" + IntToString(gvg_slotLevel[slot])
                       + " " + gvg_slotType[slot] + " ";
                if (gvg_slotGuard[slot]) {
                    line = line + "[guard] ";
                }
                if (!Fort_SlotFilled(slot)) {
                    line = line + "empty";
                    if (!Fort_SlotBuildable(slot)) {
                        line = line + " (no build command)";
                    }
                    else if (Fort_SlotClaimed(slot)) {
                        line = line + " (a worker is on it)";
                    }
                }
                else if (Fort_SlotBuilding(slot)) {
                    line = line + "under construction";
                }
                else {
                    line = line + "held by " + UnitGetType(Fort_OccupantOfSlot(slot));
                }
                Debug_Say(player, line);
            }
            slot = slot + 1;
        }
        loc = loc + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// -quest [0-8] | -quest saved N
//
// The four tasks of the department you are holding: progress against goal,
// whether it is done, and which of the two halves it is in. With a number,
// moves you to that department first -- there is no selection screen,
// departments are dealt round-robin, and one tester cannot otherwise reach the
// other three sets.
//
// "saved N" pretends you arrived with N of them already in the record, which is
// the only way to see the second, third and fourth game before 16_bank can
// remember anything. It is also the only way to reach the later tasks as MAIN
// objectives rather than as tonight's bonuses.
//
// An uncountable task prints WHY it cannot be counted rather than 0/1. A task
// nobody has started and a task the map has no channel for look identical
// otherwise, and only one of those is worth working on.
//--------------------------------------------------------------------------------------------------
void Debug_Quests (int player, string word, string second) {
    string line;
    string tail;
    int step;
    int want;
    int dept;
    int quest;
    int last;
    int main;

    if (StringEqual(word, "saved", false)) {
        Quest_SetSaved(player, Dept_Of(player), Debug_Int(second, 0));
        Quest_Publish(player);
    }
    else {
        want = Debug_Int(word, -1);
        if (want >= 0 && want < c_deptCount) {
            Dept_SetOf(player, want);
            // The panel is four objectives belonging to the department you were
            // holding a moment ago, so it has to be torn down and rebuilt.
            Quest_Publish(player);
            Debug_Say(player, "quest: you are now " + gvg_deptName[want]);
        }
    }

    dept = Dept_Of(player);
    if (dept < 0 || dept >= c_deptCount) {
        Debug_Say(player, "quest: you hold no department");
        return;
    }

    main = Quest_MainOf(player);
    Debug_Say(player, "quest: " + gvg_deptName[dept]
                      + " -- record " + IntToString(Quest_SavedOf(player, dept))
                      + "/" + IntToString(c_questPerDept)
                      + ", done this game " + IntToString(Quest_DoneCount(player)));

    quest = dept * c_questPerDept;
    last = quest + c_questPerDept;
    while (quest < last) {
        line = "  " + IntToString(Quest_NumberOf(quest)) + ". ";
        if (Quest_IsSaved(player, quest)) {
            line = line + "[record] ";
        }
        else if (quest == main) {
            line = line + "[MAIN] ";
        }
        else {
            line = line + "[bonus] ";
        }

        // One line per STEP, so a split task reads here the way it reads in
        // the panel. A task with one step is unchanged by this.
        step = 0;
        while (step < Quest_StepCount(quest)) {
            tail = "  ";
            if (Quest_IsDone(player, quest)) {
                tail = tail + "DONE";
            }
            else if (!Quest_IsCountable(quest)) {
                tail = tail + "(no channel yet)";
            }
            else {
                tail = tail + IntToString(Quest_StepProgress(player, quest, step))
                       + "/" + IntToString(Quest_StepGoal(quest, step));
                if (!Quest_IsOpen(player, quest)) {
                    tail = tail + " (locked)";
                }
            }

            if (step == 0) {
                Debug_SayText(player, StringToText(line)
                              + Quest_StepTitle(quest, step) + StringToText(tail));
            }
            else {
                Debug_SayText(player, StringToText("     and ")
                              + Quest_StepTitle(quest, step) + StringToText(tail));
            }
            step = step + 1;
        }
        quest = quest + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// -bank [save|wipe]
//
// What is on disk for this player, next to what is in memory. Printed together
// because the only interesting bank question is whether they agree.
//--------------------------------------------------------------------------------------------------
void Debug_Bank (int player, string word) {
    int index;
    string line;

    if (StringEqual(word, "wipe", false)) {
        Bank_Wipe(player);
        Debug_Say(player, "bank: wiped -- this is what a first game looks like");
    }
    else if (StringEqual(word, "save", false)) {
        if (!gv_bankLoaded) {
            Debug_Say(player, "bank: not loaded yet, refusing to write over it");
        }
        else {
            Bank_WritePlayer(player);
            Debug_Say(player, "bank: saved");
        }
    }

    if (!gv_bankLoaded) {
        Debug_Say(player, "bank: still syncing (nothing is written until it lands)");
        return;
    }

    line = "bank " + c_bankName;
    if (gvg_bank[player] == null) {
        Debug_Say(player, line + ": none for this slot");
        return;
    }
    if (!BankVerify(gvg_bank[player])) {
        line = line + " [UNSIGNED/edited -- accepted anyway, it only holds unlocks]";
    }
    Debug_Say(player, line);

    index = 0;
    while (index < c_abnoCount) {
        Debug_Say(player, "  " + gvg_abnoType[index]
                          + "  obs=" + IntToString(Cont_ObservationOfPlayer(player, index)) + "/4"
                          + "  box=" + IntToString(Cont_BoxesOf(player, index))
                          + "  (on disk obs="
                          + IntToString(gvg_bankSavedLevel[Cont_BoxIndex(player, index)])
                          + " box="
                          + IntToString(gvg_bankSavedBoxes[Cont_BoxIndex(player, index)]) + ")");
        index = index + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// -diff [easy|normal|hard|brutal]
//
// Stands in for the lobby dropdown. Prints the whole table, because the point of
// per-player difficulty is that the settings differ, and a readout that only
// showed yours would make that impossible to check.
//--------------------------------------------------------------------------------------------------
void Debug_Difficulty (int player, string word) {
    int level;
    int other;

    level = Diff_FromWord(word);
    if (word != "" && level < 0) {
        Debug_Say(player, "diff: want casual, normal, hard or brutal");
        return;
    }
    if (level >= 0) {
        Diff_SetOf(player, level);
        // Immediately. A debug command exists to put the game into a state so
        // it can be looked at, and one that changed a setting while leaving
        // everything derived from it at the old value would be testing a
        // situation that cannot occur in a real game.
        Energy_Retarget();
    }

    // The mean, and what hangs off it. Printed first because it is the thing
    // that changed when somebody typed this, and it is not visible from any one
    // player's row.
    Debug_Say(player, "table = " + Diff_GlobalName()
                      + "  ordeal cap " + Diff_OrdealName(Diff_OrdealCap())
                      + "  energy " + IntToString(gv_energy)
                      + "/" + IntToString(gv_energyGoal));

    other = 1;
    while (other <= 15) {
        if (Slot_IsTablePlayer(other)) {
            Debug_Say(player, "diff p" + IntToString(other) + " = "
                              + Diff_NameOf(other)
                              + " (waves " + IntToString(Diff_WavePct(other)) + "%"
                              + ", next " + IntToString(Waves_SizeFor(other)) + ")"
                              + "  dept=" + Dept_NameOf(other));
        }
        other = other + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// -melt [now]
//
// The clock, and a way to make it fire without waiting out the countdown.
//
// Prints the owner of every cell as well, because ownership is spatial -- panel
// first, nearest core second -- and a cell that silently belongs to nobody is
// a cell that is never named, which looks exactly like a broken meltdown.
//--------------------------------------------------------------------------------------------------
void Debug_Meltdown (int player, string word) {
    int slot;
    int owner;
    string line;

    if (StringEqual(word, "now", false)) {
        Melt_Advance();
    }

    Debug_Say(player, "meltdown level " + IntToString(Melt_Level())
                      + "  next round in " + IntToString(FixedToInt(Melt_SecondsToRound())) + "s"
                      + "  up to " + IntToString(Melt_Targets()) + " outstanding per player"
                      + "  answered=" + IntToString(Melt_AnsweredBy(player))
                      + " missed=" + IntToString(Melt_MissedBy(player)));

    slot = 0;
    while (slot < gv_cellCount) {
        owner = Cont_OwnerOf(slot);
        line = "  cell " + IntToString(slot) + " "
               + Debug_AbnoName(gvg_cellAbno[slot]) + " owner=";
        if (owner == 0) {
            line = line + "NOBODY (no panel, no core)";
        }
        else {
            line = line + IntToString(owner);
        }
        if (Melt_IsHeld(slot)) {
            line = line + " HELD (a work is still running)";
        }
        else if (Melt_IsFlagged(slot)) {
            line = line + " NAMED " + IntToString(FixedToInt(Melt_SecondsLeft(slot))) + "s left";
        }
        Debug_Say(player, line);
        slot = slot + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// -breach [slot]
//
// Drives the decision the meltdown clock will drive later: the abnormality
// decides to leave. It still has to get through its own door, which is the part
// worth watching.
//--------------------------------------------------------------------------------------------------
void Debug_Breach (int player, string slotWord) {
    int slot;

    if (gv_cellCount == 0) {
        Debug_Say(player, "breach: nothing to let out");
        return;
    }

    slot = Debug_Int(slotWord, 0);
    if (slot < 0 || slot >= gv_cellCount) {
        Debug_Say(player, "breach: slot 0.." + IntToString(gv_cellCount - 1));
        return;
    }

    Cont_BeginEscape(gvg_cellAbno[slot]);
    Debug_ReportCells(player);
}

//--------------------------------------------------------------------------------------------------
// -obs <slot>
//
// Buys the next section of that abnormality's encyclopedia with the boxes this
// player took out of it. Stands in for the panel's buttons, which cannot exist
// as a generic unit -- see the module note in 13_containment.
//--------------------------------------------------------------------------------------------------
void Debug_Observe (int player, string word) {
    int slot;
    int index;

    slot = Debug_Int(word, -1);
    if (slot < 0 || slot >= gv_cellCount) {
        Debug_Say(player, "obs: want a slot 0.." + IntToString(gv_cellCount - 1));
        return;
    }

    index = AbnoGen_IndexOf(gvg_cellAbno[slot]);
    if (!Cont_Observe(player, index)) {
        Debug_Say(player, "obs: not enough boxes, or nothing left to learn");
    }
    Debug_ReportCells(player);
}

//--------------------------------------------------------------------------------------------------
// -sp <n> | -sp me <n>
//
// Signed, so -sp -30 is how panic gets tested without waiting for thirty failed
// boxes. Panic latches at zero and only lets go at full, so getting back out is
// -sp 999 rather than -sp 1 -- which is the rule, not a rounding.
//
// "me" targets the player character, whose breakdown is a different behavior
// with different consequences and which nothing else in the greybox can reach:
// no source of player SP loss exists yet on purpose.
//--------------------------------------------------------------------------------------------------
void Debug_SP (int player, string word, string more) {
    unitgroup mine;
    unit who;
    int count;
    int i;

    if (StringEqual(word, "me", false)) {
        mine = UnitGroupEmpty();
        UnitGroupAdd(mine, Hero_Of(player));
    }
    else {
        mine = Debug_TargetEmployees(player);
        more = word;
    }

    // break / full are absolute; a bare number is a delta. Both forms exist
    // because "-sp 0" is what anybody reaches for first to break somebody, and
    // as a delta it does exactly nothing -- a command that silently no-ops is
    // worse than one that does not exist.
    count = UnitGroupCount(mine, c_unitCountAlive);
    i = 1;
    while (i <= count) {
        who = UnitGroupUnit(mine, i);
        if (StringEqual(more, "break", false)) {
            SP_Add(who, -Emp_SPMax(who));
        }
        else if (StringEqual(more, "full", false)) {
            SP_Add(who, Emp_SPMax(who));
        }
        else {
            SP_Add(who, Debug_Int(more, 0));
        }
        i = i + 1;
    }
    Debug_ReportEmployees(player);
    Debug_Say(player, "sp me " + IntToString(Emp_SP(Hero_Of(player)))
                      + "/" + IntToString(Emp_SPMax(Hero_Of(player)))
                      + Debug_PanicTag(Hero_Of(player)));
}

//--------------------------------------------------------------------------------------------------
// -work <inst|insi|atta|repr>
//
// Sets what the next employee sent to a door will do. Sending is the game's own
// right-click; there is no order UI yet and this stands in for the part of it
// that chooses.
//--------------------------------------------------------------------------------------------------
int Debug_WorkFromWord (string word) {
    if (StringEqual(word, "inst", false) || StringEqual(word, "i", false)) {
        return c_workInstinct;
    }
    if (StringEqual(word, "insi", false) || StringEqual(word, "n", false)) {
        return c_workInsight;
    }
    if (StringEqual(word, "atta", false) || StringEqual(word, "a", false)) {
        return c_workAttachment;
    }
    if (StringEqual(word, "repr", false) || StringEqual(word, "r", false)) {
        return c_workRepression;
    }
    return -1;
}

void Debug_Work (int player, string word) {
    unit abno;
    int work;
    int slot;
    string line;

    work = Debug_WorkFromWord(word);
    if (work >= 0) {
        Work_SetDefault(player, work);
    }

    Debug_Say(player, "work: sending an employee to a door does "
                      + Work_Name(Work_DefaultOf(player))
                      + " (inst|insi|atta|repr)");

    // The odds for that work against each abnormality, at this player's
    // employees' current level in the matching stat. This is the whole reason
    // to choose one work over another, so it should not need a wiki open.
    slot = 0;
    while (slot < gv_cellCount) {
        abno = gvg_cellAbno[slot];
        // The cost of being wrong belongs next to the odds of being wrong. On
        // one abnormality a missed box is a bad afternoon; on another it is a
        // funeral, and that is not visible from a percentage.
        line = "  " + Debug_AbnoName(abno)
               + " [miss: " + AbnoGen_DmgText(AbnoGen_IndexOf(abno)) + "]:";
        work = 0;
        while (work < c_workCount) {
            line = line + " " + StringSub(Work_Name(work), 1, 4) + "=";
            if (UnitGroupCount(Emp_Of(player), c_unitCountAlive) > 0) {
                line = line + IntToString(AbnoGen_Pref(
                    AbnoGen_IndexOf(abno), work,
                    Emp_StatLevel(UnitGroupUnit(Emp_Of(player), 1), Work_Stat(work))))
                    + "%";
            }
            else {
                line = line + IntToString(AbnoGen_Pref(AbnoGen_IndexOf(abno), work, 1))
                       + "%@I";
            }
            work = work + 1;
        }
        Debug_Say(player, line);
        slot = slot + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// -energy
//--------------------------------------------------------------------------------------------------
void Debug_Energy (int player, string word) {
    if (StringEqual(word, "submit", false)) {
        if (Energy_CanSubmit()) {
            Energy_Submit(player);
        }
        else {
            Debug_Say(player, "energy: not enough yet");
        }
        return;
    }
    if (word != "") {
        Energy_Add(Debug_Int(word, 0));
    }
    // Galaxy has no conditional expression, so this is two statements.
    if (Energy_CanSubmit()) {
        Debug_Say(player, "energy " + IntToString(gv_energy) + "/"
                          + IntToString(gv_energyGoal) + "  -- -energy submit to end it");
        return;
    }
    Debug_Say(player, "energy " + IntToString(gv_energy) + "/" + IntToString(gv_energyGoal));
}

//--------------------------------------------------------------------------------------------------
// -qlip <slot> <n>
//
// The counter without the thing that moves it, since the thing that moves it is
// the meltdown clock and work results, neither of which exists.
//--------------------------------------------------------------------------------------------------
void Debug_SetCounter (int player, string slotWord, string valueWord) {
    int slot;

    slot = Debug_Int(slotWord, -1);
    if (slot < 0 || slot >= gv_cellCount) {
        Debug_Say(player, "qlip: want a slot 0.." + IntToString(gv_cellCount - 1));
        return;
    }

    Cont_SetCounter(gvg_cellAbno[slot], Debug_Int(valueWord, 0));
    Debug_ReportCells(player);
}

//--------------------------------------------------------------------------------------------------
// -emp spawn [n]
//--------------------------------------------------------------------------------------------------
void Debug_SpawnEmployees (int player, int howMany) {
    if (c_typesEmpCount == 0) {
        Debug_Say(player, "emp: no Lob_Emp_* unit type is authored");
        return;
    }
    if (howMany < 1) {
        howMany = 1;
    }

    UnitCreate(howMany, gvg_typesEmp[0], c_unitCreateIgnorePlacement,
               player, Debug_SpawnPoint(player), 270.0);
    Debug_Say(player, "emp: spawned " + IntToString(howMany) + " " + gvg_typesEmp[0]);
}

//--------------------------------------------------------------------------------------------------
// -stat <fort|prud|temp|just|all> <value>
//
// A leading + or - on the value makes it relative, which is the only way to
// exercise Emp_StatAdd's signed path -- the one Training Team's "push a stat
// back down" will use.
//--------------------------------------------------------------------------------------------------
void Debug_SetStat (int player, string whichWord, string valueWord) {
    unitgroup mine;
    unit who;
    int which;
    int value;
    int count;
    int i;
    int stat;
    bool relative;
    string firstChar;

    which = Debug_StatFromWord(whichWord);
    if (which == c_debugStatBad) {
        Debug_Say(player, "stat: want fort|prud|temp|just|all");
        return;
    }
    if (valueWord == "") {
        Debug_Say(player, "stat: want a value, or +n / -n to move it");
        return;
    }

    firstChar = StringSub(valueWord, 1, 1);
    relative = firstChar == "+" || firstChar == "-";
    if (firstChar == "+") {
        // StringToInt does not have to know what a leading + means.
        valueWord = StringSub(valueWord, 2, StringLength(valueWord));
    }
    value = Debug_Int(valueWord, 0);

    mine = Debug_TargetEmployees(player);
    count = UnitGroupCount(mine, c_unitCountAlive);

    i = 1;
    while (i <= count) {
        who = UnitGroupUnit(mine, i);
        stat = 0;
        while (stat < c_statCount) {
            if (which == c_debugStatAll || which == stat) {
                if (relative) {
                    Emp_StatAdd(who, stat, value);
                }
                else {
                    Emp_StatSet(who, stat, value);
                }
            }
            stat = stat + 1;
        }
        Emp_SyncRank(who);
        i = i + 1;
    }

    Debug_ReportEmployees(player);
}

//--------------------------------------------------------------------------------------------------
// The command reference, in the help panel rather than in chat.
//
// Placeholders are written NAME and VALUE rather than <name> and <value>, and
// that is not a style preference. SC2 parses < > in displayed text as markup:
// <s> is the font style tag, and a style tag with no val asks for the style
// named "", which is where "TextError: 无法找到字体样式[]" came from. The old
// chat help printed "-stat <s> <v>", so that error fired every time somebody
// typed -help. Any angle bracket in text that reaches a player has to be
// escaped or avoided.
//
// It used to print itself into the chat window, and it had quietly stopped
// being a reference: the list outgrew the panel, so it scrolled its own top
// off, and a list you can only read the bottom of is worse than no list. The
// help panel is paged, scrollable and already bound to F12, and it is where a
// player looks for "what can I do".
//
// The descriptions say what the mechanic is rather than only what the syntax
// is, because there is room for that here and it is what somebody reading this
// actually wants. Half of these commands stand in for a system that does not
// exist yet, and which one is which is worth knowing.
//
// Added once at init, to everybody. Nothing removes them; the panel is not a
// place state lives.
//--------------------------------------------------------------------------------------------------
void Debug_Tip (string title, string body, string icon) {
    HelpPanelAddTip(PlayerGroupAll(), StringToText(title), StringToText(body),
                    StringToText(""), icon);
}

void Debug_BuildHelp () {
    Debug_Tip(
        "Debug console",
        "Type these into chat. Everything here is a test harness: it drives a "
        + "mechanic by hand so it can be watched before the system that will "
        + "drive it for real exists.<n/><n/>"
        + "Nothing here reaches anything a player does not already own.",
        "Assets\\Textures\\btn-ability-terran-battlefieldawareness.dds");

    Debug_Tip(
        "Employees",
        "<c val=\"ffff8a\">-emp</c>  the selected employees: four stats, the level "
        + "each lands on, their sum, the rank that sum buys, and SP.<n/>"
        + "<c val=\"ffff8a\">-emp spawn [n]</c>  spawn n at your character.<n/>"
        + "<c val=\"ffff8a\">-stat NAME VALUE</c>  set a stat. s is fort, prud, temp, just or all.<n/>"
        + "<c val=\"ffff8a\">-stat NAME +5</c>  move it instead of setting it; negatives work.<n/>"
        + "<c val=\"ffff8a\">-sp break</c>  straight to zero, which latches panic.  "
        + "<c val=\"ffff8a\">-sp full</c>  back to the top, which opens it.  "
        + "<c val=\"ffff8a\">-sp N</c>  move it by N.<n/>"
        + "Applies to the employees you have SELECTED, or to all of yours if "
        + "none are.  <c val=\"ffff8a\">-sp me break</c>  for your own character.<n/><n/>"
        + "Rank is the SUM of the four stat levels, not the lowest, so a "
        + "three-stat specialist with one stat left deliberately low is still "
        + "rank V. Abnormalities that require a stat to stay BELOW some value "
        + "depend on that.",
        "Assets\\Textures\\btn-upgrade-terran-infantryarmorlevel1.dds");

    Debug_Tip(
        "Containment",
        "<c val=\"ffff8a\">-cont</c>  every cell: grade, state, Qliphoth counter, "
        + "observation, and what its door is doing.<n/>"
        + "<c val=\"ffff8a\">-breach [slot]</c>  that abnormality decides to leave. It "
        + "still has to get through its own door, which is the part worth watching.<n/>"
        + "<c val=\"ffff8a\">-qlip SLOT N</c>  set a Qliphoth counter.<n/>"
        + "<c val=\"ffff8a\">-obs SLOT</c>  buy the next encyclopedia section with the "
        + "PE-Boxes taken out of that abnormality.<n/><n/>"
        + "Suppression is defeat, not death: a beaten abnormality goes home, its "
        + "counter resets and its door comes back whole. A breach costs "
        + "employees, time and everybody's attention, and never a slot.",
        "Assets\\Textures\\btn-ability-terran-holdfire.dds");

    Debug_Tip(
        "Work",
        "Select an employee, press Work, click a containment door. One second of "
        + "casting, then the boxes start.<n/><n/>"
        + "<c val=\"ffff8a\">-work TYPE</c>  what the next one will do: inst, insi, atta "
        + "or repr. Prints each abnormality's odds for all four at your "
        + "employees' current levels, so the choice needs no wiki.<n/><n/>"
        + "One roll per box. The chance is keyed to the LEVEL of the stat that "
        + "work uses, so 30 and 44 of a stat are the same to an abnormality.<n/><n/>"
        + "What a missed box costs is the abnormality's own, printed next to its "
        + "odds. <c val=\"ffff8a\">White</c> is the mind and shows nowhere until "
        + "the person breaks. <c val=\"ffff8a\">Red</c> is the body. "
        + "<c val=\"ffff8a\">Black</c> splits evenly between the two, so the "
        + "number printed is the total. "
        + "<c val=\"ffff8a\">Pale</c> is a percentage of maximum life -- and "
        + "since Fortitude IS maximum life, it is the one an employee cannot "
        + "outgrow. Employees do not go down; they die.",
        "Assets\\Textures\\btn-upgrade-terran-infantryweaponslevel1.dds");

    Debug_Tip(
        "Meltdown",
        "<c val=\"ffff8a\">-melt</c>  the clock, and who owns each cell.<n/>"
        + "<c val=\"ffff8a\">-melt now</c>  start the next round immediately.<n/><n/>"
        + "Every 60 seconds a meltdown names cells in each player's own sector, "
        + "and a named cell has 60 seconds for a work to BEGIN on it. Begin, not "
        + "finish: what it asks is that somebody was sent. A cell that is missed "
        + "has its Qliphoth counter set to zero, not reduced, and the table "
        + "loses a share of the energy pool.<n/><n/>"
        + "A cell that was already busy when it got named is HELD -- it does not "
        + "start counting until that work ends, however it ends. The employee "
        + "inside cannot be sent again, so the window would not be a window. The "
        + "work in flight does not answer the meltdown either; when it ends, "
        + "somebody still has to go.<n/><n/>"
        + "The clock is shared but the named cells are yours. A neighbour who "
        + "ignores theirs breaches their own abnormality, and what reaches you "
        + "is a fight -- never a cut to your income or your employees.",
        "Assets\\Textures\\btn-ability-terran-nuclearstrike.dds");

    Debug_Tip(
        "Energy, and how this ends",
        "<c val=\"ffff8a\">-energy</c>  the meter.  <c val=\"ffff8a\">-energy N</c>  add to it.  "
        + "<c val=\"ffff8a\">-energy submit</c>  end the game.<n/><n/>"
        + "Every box pays twice: once into your own stock for that one "
        + "abnormality's encyclopedia, and the same amount again into a pool the "
        + "whole table shares. Filling the pool is the win condition, so studying "
        + "abnormalities and winning are the same activity.<n/><n/>"
        + "Nothing is ever spent out of the pool and nobody's rate depends on "
        + "anybody else's. It is a scoreboard, not a wallet.",
        "Assets\\Textures\\btn-ability-terran-stimpack-color.dds");

    Debug_Tip(
        "Damage types, and the bridge",
        "<c val=\"ffff8a\">-dmg on</c>  every hit on a PERSON, with every number the "
        + "engine exposes.  <c val=\"ffff8a\">-dmg more</c>  adds Ordeals and "
        + "abnormalities and stops there — leave this one on while playing.  "
        + "<c val=\"ffff8a\">-dmg all</c>  the swarm and the turrets too, which is ten "
        + "lines a second.  <c val=\"ffff8a\">-dmg off</c>.<n/>"
        + "Each line is marked <c val=\"ffff8a\">[ours]</c> or "
        + "<c val=\"ffff8a\">[engine]</c> — who actually applied the number.<n/><n/>"
        + "THE ENGINE\'S Kind FIELD IS OUR DAMAGE TYPE.  Melee = RED, Ranged = "
        + "WHITE, Spell = BLACK, Splash = PALE.  Kind takes exactly four values "
        + "in all of StarCraft and we have exactly four types, so E.G.O weapons "
        + "carry REAL numbers and the unit panel shows the truth.<n/><n/>"
        + "An abnormality\'s four defences are then four lines of "
        + "DamageTakenFraction and no script at all -- the Crimson Dawn already "
        + "has its wiki table on it.<n/><n/>"
        + "ALL FOUR types landing on a PERSON are ours -- SP is not something the "
        + "engine can be told to spend, Pale is a fraction of MAXIMUM life, and "
        + "Red joined them because the engine subtracts amounts that are nowhere "
        + "on screen.  A hidden buff takes the life loss to zero and script "
        + "spends the number instead.<n/><n/>"
        + "Monsters are still the engine's: one pool and one multiplier per type "
        + "is exactly DamageTakenFraction, and Pale against a monster is plain "
        + "damage.  E.G.O grade will end that, being a bonus that depends on "
        + "both sides at once.<n/><n/>"
        + "The player carries a probe White weapon.  Point it at a broken "
        + "colleague: it should give sanity BACK, and it should pick them up on "
        + "its own without being ordered, because being broken sets Passive and "
        + "that is what the weapon hunts.",
        "Assets\\Textures\\btn-ability-terran-heal.dds");

    Debug_Tip(
        "Ordeals",
        "<c val=\"ffff8a\">-ordeal</c>  the whole night's schedule, what is coming, and "
        + "how many types each tier has to draw from.<n/>"
        + "<c val=\"ffff8a\">-ordeal now</c>  run the scheduled one early; it is used up.<n/>"
        + "<c val=\"ffff8a\">-ordeal dawn|noon|dusk|midnight</c>  run one out of band, "
        + "leaving the schedule alone.<n/><n/>"
        + "FOUR in a night, one per tier: a Dawn at meltdown 2, a Noon somewhere "
        + "in 3 to 5, a Dusk in 6 or 7, a Midnight at 8. Which level inside each "
        + "range is drawn when the game starts, so the schedule exists before the "
        + "first minute of it does.<n/><n/>"
        + "Difficulty SKIPS the tiers above it rather than weakening them. On "
        + "Casual the night has one Ordeal in it and then none.<n/><n/>"
        + "You are always told which one is next before it lands, because a "
        + "surprise cannot be prepared for and preparing is the whole game.<n/><n/>"
        + "One entity per department. Suppressing all of them pays 10 / 15 / 20 / "
        + "25 percent of the ENERGY TARGET into the pool, by tier.",
        "Assets\\Textures\\btn-ability-terran-holdfire.dds");

    Debug_Tip(
        "Fortifications",
        "<c val=\"ffff8a\">-fort</c>  every room and corridor: level, owner, how much "
        + "of it is standing.<n/>"
        + "<c val=\"ffff8a\">-fort N</c>  buy the next level there.<n/><n/>"
        + "The upgrade completes instantly and the level never drops, however "
        + "much is destroyed. The BUILDINGS are not instant -- workers walk over "
        + "and put them up, then repair and rebuild them free forever. So money "
        + "and time are separate costs, and how fast you get what you paid for "
        + "depends on how many workers you built ten minutes ago.<n/><n/>"
        + "A level cannot be bought until the previous one is fully standing, "
        + "and buildings under attack never finish. So a place that is being "
        + "overrun cannot be reinforced: win the fight, then buy the answer.<n/><n/>"
        + "Garrison warps in the first time a level stands, and buying a level "
        + "replaces earlier casualties. Rebuilding after a massacre does not -- "
        + "dead guards stay dead until somebody spends money.",
        "Assets\\Textures\\btn-building-terran-bunker.dds");

    Debug_Tip(
        "The save file",
        "<c val=\"ffff8a\">-bank</c>  what is in memory next to what is on disk.<n/>"
        + "<c val=\"ffff8a\">-bank save</c>  write now.  "
        + "<c val=\"ffff8a\">-bank wipe</c>  throw it away, which is the only way to "
        + "ask \"does a fresh account work\" more than once.<n/><n/>"
        + "It stores unlocks and never numbers: your observation level on each "
        + "abnormality and the PE-Boxes left to buy the next section with. Not "
        + "employee stats, not upgrades, not resources -- a persisted number "
        + "would make a character's strength a function of hours played rather "
        + "than of skill.<n/><n/>"
        + "Nothing is written until every player's file has finished syncing. "
        + "Writing during that window would put a fresh empty table over a real "
        + "save, and nobody would be able to tell what happened.<n/><n/>"
        + "<c val=\"ffff8a\">-codec</c>  round-trips the packer the save format "
        + "will switch to when a key per value stops being enough. Nothing uses "
        + "it yet; it exists so that \"compress it later\" is a checked plan "
        + "rather than an assumption.",
        "Assets\\Textures\\btn-ability-terran-supplydrop.dds");

    Debug_Tip(
        "Difficulty",
        "<c val=\"ffff8a\">-diff</c>  the whole table's settings.<n/>"
        + "<c val=\"ffff8a\">-diff casual|normal|hard|brutal</c>  set yours.<n/><n/>"
        + "Difficulty is PER PLAYER and sizes only your own waves, so a novice "
        + "can sit in a lobby of veterans on Casual and still be learning the "
        + "same game. It is not a handicap anybody else pays for -- fewer zerg "
        + "spawn in that sector, so fewer leak out of it into yours.<n/><n/>"
        + "Two things are shared and read the table's MEAN difficulty instead: "
        + "the energy target, and the worst Ordeal that can be dealt (Dawn, "
        + "Noon, Dusk, Midnight -- one per difficulty). The mean and not the "
        + "highest, so one player on Brutal cannot pull five others into "
        + "Midnight.<n/><n/>"
        + "Scaling the target is what keeps a personal setting honest against a "
        + "shared objective: Casual is a genuinely smaller game, not a discount "
        + "on a fixed one.<n/><n/>"
        + "This stands in for a lobby dropdown that does not exist yet; it reads "
        + "a per-player game attribute and answers Normal until one is created.",
        "Assets\\Textures\\btn-ability-terran-scannersweep.dds");

    Debug_Tip(
        "Tasks",
        "<c val=\"ffff8a\">-quest</c>  your department's four tasks.<n/>"
        + "<c val=\"ffff8a\">-quest 0-8</c>  move yourself to that department first.<n/><n/>"
        + "Eleven of the thirty-six are counted. The rest print \"no channel "
        + "yet\" rather than 0, because a task nobody has started and a task the "
        + "map cannot observe look identical as a number, and only one of them "
        + "is worth working on. Four need Ordeals, four need an end-of-game "
        + "hook, one needs a zerg queen, and two are blank in the source "
        + "document.<n/><n/>"
        + "Progress is read fresh every two seconds and kept nowhere, except for "
        + "four things that erase their own evidence: works finished, works "
        + "ending Good, meltdown rounds handled, and which abnormalities have "
        + "been suppressed. Those are counted where they happen.<n/><n/>"
        + "Completion is a latch -- employees die and buildings fall, but a task "
        + "that was done stays done. It is NOT saved yet, so it is forgotten "
        + "when the game ends.<n/><n/>"
        + "<c val=\"ffff8a\">-quest saved N</c>  arrive with N already "
        + "recorded.<n/><n/>"
        + "One task per game reaches the record: the first you have not "
        + "recorded. That one is a MAIN objective. Finishing it opens the next, "
        + "which appears under BONUS -- still worth playing for, but gone "
        + "tomorrow, and locked again next game.<n/><n/>"
        + "Nothing persists yet, so every game you can only bank task 1. "
        + "-quest saved N is the only way to see the second, third and fourth "
        + "game, and the only way to reach a later task as MAIN.<n/><n/>"
        + "Player-facing text is in src/strings/enUS.txt and reaches the panel "
        + "by key; this command is developer text and stays inline.",
        "Assets\\Textures\\btn-ability-terran-scannersweep.dds");

    Debug_Tip(
        "The world",
        "<c val=\"ffff8a\">-status</c>  debris, ore, power, devices, sector, energy.<n/>"
        + "<c val=\"ffff8a\">-scan</c>  what the generated object tables can actually see.<n/><n/>"
        + "If -scan shows a type count above zero next to a group count of zero, "
        + "the build did not run after the last editor save.",
        "Assets\\Textures\\btn-ability-terran-battlefieldawareness.dds");
}

//--------------------------------------------------------------------------------------------------
// -dmg -- echo every White hit the bridge intercepts.
//
// Off by default because it is loud, and the point of it is to answer three
// questions about the engine that were reasoned out rather than witnessed. See
// the header of 17_damage.galaxy.
//--------------------------------------------------------------------------------------------------
void Debug_DamageTrace (int player, string word) {
    if (StringEqual(word, "off", false)) {
        gv_dmgTrace = c_dmgTraceOff;
    }
    else if (StringEqual(word, "all", false)) {
        gv_dmgTrace = c_dmgTraceAll;
    }
    else if (StringEqual(word, "more", false)) {
        gv_dmgTrace = c_dmgTraceMore;
    }
    else if (StringEqual(word, "on", false) || word == "") {
        gv_dmgTrace = c_dmgTracePeople;
    }
    else {
        Debug_Say(player, "-dmg on | more | all | off");
        return;
    }

    if (gv_dmgTrace == c_dmgTraceMore) {
        Debug_Say(player, "damage trace MORE -- people, Ordeals and abnormalities, and "
                        + "nothing else. This is the one to leave on while playing. "
                        + "Monster lines are marked [engine] because the engine applied "
                        + "them; shoot a Crimson Dawn with the rifle and its RED defence "
                        + "of 0.8 should turn 20 into 16 in one of the two numbers.");
    }
    else if (gv_dmgTrace == c_dmgTraceAll) {
        Debug_Say(player, "damage trace ALL -- monsters too, marked [engine] because "
                        + "the engine applied them and we did not. Shoot a Crimson Dawn: "
                        + "its RED defence is 0.8, so a 20 rifle should read 16 in one of "
                        + "the two numbers, and WHICH one says whether the resistance "
                        + "lands before we see it.");
    }
    else if (gv_dmgTrace == c_dmgTracePeople) {
        Debug_Say(player, "damage trace on, people only, marked [ours] -- attempted is the "
                        + "number before Lob_Mind_* ate it and actual should be 0. "
                        + "-dmg all adds monsters, at the cost of one line per zergling bite.");
    }
    else {
        Debug_Say(player, "damage trace off");
    }
}

void Debug_Help (int player) {
    Debug_Say(player, "the command list is in the help panel -- press F12");
}

bool Debug_Chat_Func (bool testConds, bool runActions) {
    string message;
    string command;
    int player;

    if (!runActions) {
        return true;
    }

    player = EventPlayer();
    message = EventChatMessage(false);

    // The event matches loosely, so a message that merely contains a hyphen
    // gets here too. A command has to start with one.
    if (StringSub(message, 1, 1) != c_debugPrefix) {
        return true;
    }

    command = StringWord(message, 1);

    if (StringEqual(command, "-help", false)) {
        Debug_Help(player);
    }
    else if (StringEqual(command, "-emp", false)) {
        if (StringEqual(StringWord(message, 2), "spawn", false)) {
            Debug_SpawnEmployees(player, Debug_Int(StringWord(message, 3), 1));
        }
        else {
            Debug_ReportEmployees(player);
        }
    }
    else if (StringEqual(command, "-stat", false)) {
        Debug_SetStat(player, StringWord(message, 2), StringWord(message, 3));
    }
    else if (StringEqual(command, "-rank", false)) {
        Emp_Tick_Func(false, true);
        Debug_ReportEmployees(player);
    }
    else if (StringEqual(command, "-status", false)) {
        Debug_Say(player, Economy_StatusLine(player));
    }
    else if (StringEqual(command, "-scan", false)) {
        Debug_Say(player, Registry_ScanLine());
    }
    else if (StringEqual(command, "-cont", false)) {
        Debug_ReportCells(player);
    }
    else if (StringEqual(command, "-breach", false)) {
        Debug_Breach(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-obs", false)) {
        Debug_Observe(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-sp", false)) {
        Debug_SP(player, StringWord(message, 2), StringWord(message, 3));
    }
    else if (StringEqual(command, "-work", false)) {
        Debug_Work(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-energy", false)) {
        Debug_Energy(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-ordeal", false)) {
        Debug_Ordeal(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-fort", false)) {
        Debug_Fortify(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-quest", false)) {
        Debug_Quests(player, StringWord(message, 2), StringWord(message, 3));
    }
    else if (StringEqual(command, "-codec", false)) {
        Debug_Say(player, Codec_SelfTest());
    }
    else if (StringEqual(command, "-bank", false)) {
        Debug_Bank(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-diff", false)) {
        Debug_Difficulty(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-melt", false)) {
        Debug_Meltdown(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-dmg", false)) {
        Debug_DamageTrace(player, StringWord(message, 2));
    }
    else if (StringEqual(command, "-qlip", false)) {
        Debug_SetCounter(player, StringWord(message, 2), StringWord(message, 3));
    }
    return true;
}

void Debug_Init () {
    int player;

    Debug_BuildHelp();

    gt_debugChat = TriggerCreate("Debug_Chat_Func");
    player = 1;
    while (player <= 15) {
        TriggerAddEventChatMessage(gt_debugChat, player, c_debugPrefix, false);
        player = player + 1;
    }
}

