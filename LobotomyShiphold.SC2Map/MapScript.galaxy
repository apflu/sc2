//--------------------------------------------------------------------------------------------------
// The placed objects of a named editor group. Preplaced only -- runtime
// spawns have no group. Returns empty for an unknown name.
//--------------------------------------------------------------------------------------------------
unitgroup ObjectsGen_Group (string name) {
    unitgroup found;
    int i;
    int m;

    found = UnitGroupEmpty();
    i = 0;
    while (i < c_groupCount) {
        if (gvg_groupNames[i] == name) {
            m = gvg_groupFirst[i];
            while (m < gvg_groupFirst[i] + gvg_groupSize[i]) {
                UnitGroupAdd(found, UnitFromId(gvg_groupMembers[m]));
                m = m + 1;
            }
            return found;
        }
        i = i + 1;
    }
    return found;
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/10_registry.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Startup self-check.
//
// There is no registry object to maintain: the generated scan functions in
// 05_objects_gen.galaxy already answer "what is on the map", live, including
// for units spawned at runtime. This module only reports what they see once at
// startup, which is where authoring mistakes show up.
//
// Type counts come from a runtime scan; the group count comes from the build's
// snapshot of Objects. Printing them side by side is deliberate: a nonzero type
// count next to a zero group count means the build did not run after the last
// editor save, which is otherwise an invisible and very confusing state.
//--------------------------------------------------------------------------------------------------

void Registry_Init () {
    UIDisplayMessage(
        PlayerGroupAll(),
        c_messageAreaSubtitle,
        StringToText(
            "scan: hero=" + IntToString(UnitGroupCount(ObjectsGen_ScanHero(), c_unitCountAlive))
            + " debris=" + IntToString(UnitGroupCount(ObjectsGen_ScanDebris(), c_unitCountAlive))
            + " worker=" + IntToString(UnitGroupCount(ObjectsGen_ScanSCV_Worker(), c_unitCountAlive))
            + " miner=" + IntToString(UnitGroupCount(ObjectsGen_ScanSCV_Miner(), c_unitCountAlive))
            + " device=" + IntToString(UnitGroupCount(ObjectsGen_ScanDevice(), c_unitCountAlive))
            + " | group(debris)=" + IntToString(UnitGroupCount(ObjectsGen_Group("debris"), c_unitCountAlive))
        )
    );
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/15_hero.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// The player character.
//
// P0's whole proposition is that clearing, fighting and repairing all want the
// same pair of hands. That only means anything if the hands exist, so this
// module owns the one unit the player actually drives: handing it over at
// start, and putting it back after it dies.
//
// Death costs time and nothing else, per the design baseline -- no resources
// lost, no lasting penalty on the character. The cost is the walk back plus
// whatever fell apart in the meantime, and that is a real cost precisely
// because the other two jobs do not pause while the player is dead.
//
// The character's type is read from the generated table rather than named
// here, so renaming the unit in the editor does not need a code change. If no
// Hero unit has been authored yet the module simply does nothing.
//--------------------------------------------------------------------------------------------------

const fixed c_heroRespawnDelay = 15.0;

unit gv_hero;
point gv_heroHome;

trigger gt_heroDied;

//--------------------------------------------------------------------------------------------------
// Creates the character at its home point and hands it to the player.
//--------------------------------------------------------------------------------------------------
void Hero_Spawn () {
    if (c_typesHeroCount == 0) {
        return;
    }

    UnitCreate(1, gvg_typesHero[0], 0, c_p0Player, gv_heroHome, 270.0);
    gv_hero = UnitLastCreated();
    UnitSelect(gv_hero, c_p0Player, true);
    CameraPan(c_p0Player, gv_heroHome, 0.0, -1.0, 10.0, true);
}

//--------------------------------------------------------------------------------------------------
// Any unit death, filtered down to the character. Same shape as the debris
// death handler in 25_clearing.galaxy, and for the same reason: it covers a
// character that was spawned at runtime, which after the first respawn is
// every character there will ever be.
//--------------------------------------------------------------------------------------------------
bool Hero_Died_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    if (!ObjectsGen_IsHero(EventUnit())) {
        return true;
    }

    UIDisplayMessage(
        PlayerGroupAll(),
        c_messageAreaSubtitle,
        StringToText("agent down -- back in "
                     + IntToString(FixedToInt(c_heroRespawnDelay)) + "s")
    );
    Wait(c_heroRespawnDelay, c_timeGame);
    Hero_Spawn();
    return true;
}

void Hero_Init () {
    gv_hero = UnitGroupUnit(ObjectsGen_ScanHero(), 1);
    if (gv_hero == null) {
        return;
    }

    // Where the character was placed is where it comes back. Deliberately not
    // a separate marker: a respawn point that can drift away from the start
    // point is a bug waiting to happen, and P0 has nothing that would move it.
    gv_heroHome = UnitGetPosition(gv_hero);

    UnitSelect(gv_hero, c_p0Player, true);
    CameraPan(c_p0Player, gv_heroHome, 0.0, -1.0, 10.0, true);

    gt_heroDied = TriggerCreate("Hero_Died_Func");
    TriggerAddEventUnitDied(gt_heroDied, null);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/20_devices.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Resource devices.
//
// Devices produce power on a tick while intact, and lethal damage disables them
// instead of destroying them, per the design baseline. Disabling is not a
// separate state flag: a device is online when its health is above a threshold,
// and fatal damage is intercepted and clamped to near zero. Repair is then just
// the native SCV repair ability putting health back, and the device comes back
// online on its own.
//
// Modelling it that way means the health bar already shows the disabled state,
// repair needs no bespoke mechanic, and there is no flag that can drift out of
// sync with the unit it describes.
//--------------------------------------------------------------------------------------------------

const fixed c_devicePeriod = 3.0;
const int c_powerPerDevicePerTick = 3;

// Above this share of max health the device runs; below it, it is disabled.
const fixed c_deviceOnlineLifePercent = 50.0;

// What a device is left on after lethal damage. Not zero -- zero is death.
const fixed c_deviceDisabledLife = 1.0;

int gv_power;

trigger gt_deviceFatal;
trigger gt_deviceTick;

//--------------------------------------------------------------------------------------------------
// Devices that have taken any damage, for the workers to prioritise.
//--------------------------------------------------------------------------------------------------
unitgroup Devices_Damaged () {
    unitgroup all;
    unitgroup damaged;
    unit device;
    int count;
    int i;

    all = ObjectsGen_ScanDevice();
    damaged = UnitGroupEmpty();
    count = UnitGroupCount(all, c_unitCountAlive);

    i = 1;
    while (i <= count) {
        device = UnitGroupUnit(all, i);
        if (device != null && UnitGetPropertyFixed(device, c_unitPropLifePercent, true) < 99.0) {
            UnitGroupAdd(damaged, device);
        }
        i = i + 1;
    }
    return damaged;
}

//--------------------------------------------------------------------------------------------------
// Intercepts the killing blow and leaves the device standing at minimum health.
//--------------------------------------------------------------------------------------------------
bool Devices_Fatal_Func (bool testConds, bool runActions) {
    unit victim;

    if (!runActions) {
        return true;
    }

    victim = EventUnit();
    if (!ObjectsGen_IsDevice(victim)) {
        return true;
    }

    UnitSetPropertyFixed(victim, c_unitPropLife, c_deviceDisabledLife);
    return true;
}

bool Devices_Tick_Func (bool testConds, bool runActions) {
    unitgroup devices;
    unit device;
    int count;
    int i;

    if (!runActions) {
        return true;
    }

    devices = ObjectsGen_ScanDevice();
    count = UnitGroupCount(devices, c_unitCountAlive);

    i = 1;
    while (i <= count) {
        device = UnitGroupUnit(devices, i);
        if (device != null
            && UnitGetPropertyFixed(device, c_unitPropLifePercent, true) >= c_deviceOnlineLifePercent) {
            gv_power = gv_power + c_powerPerDevicePerTick;
        }
        i = i + 1;
    }
    return true;
}

void Devices_Init () {
    gv_power = 0;

    gt_deviceFatal = TriggerCreate("Devices_Fatal_Func");
    TriggerAddEventUnitDamaged(gt_deviceFatal, null, c_unitDamageTypeAny, c_unitDamageFatal, null);

    gt_deviceTick = TriggerCreate("Devices_Tick_Func");
    TriggerAddEventTimePeriodic(gt_deviceTick, c_devicePeriod, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/25_clearing.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Debris clearing.
//
// Clearing is modelled as damage, not as a custom progress bar: debris is a
// destructible with a large health pool, and both the player and the workers
// clear it by attacking it. That buys the health bar as progress feedback for
// free, and makes the "player clears far faster than a worker" curve a pure
// weapon-damage question that lives in data where it can be tuned, rather than
// in two hand-written rate constants here.
//
// Worker assignment lives in 30_workers.galaxy; this module only owns what
// clearing pays out.
//--------------------------------------------------------------------------------------------------

// Credit banked into the ore pile when a piece of debris is finished off. The
// pile is the inner-room stockpile; converting it into spendable resources is
// the miners' job, in 30_economy.galaxy.
const int c_oreCreditPerDebris = 25;

int gv_orePile;
int gv_debrisCleared;

trigger gt_debrisDied;

//--------------------------------------------------------------------------------------------------
// Any unit death, filtered down to debris. Cheaper and far less bookkeeping
// than registering a death event per placed object, and it covers debris
// spawned at runtime for free -- which is where debris is headed.
//--------------------------------------------------------------------------------------------------
bool Clearing_DebrisDied_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    if (!ObjectsGen_IsDebris(EventUnit())) {
        return true;
    }

    gv_orePile = gv_orePile + c_oreCreditPerDebris;
    gv_debrisCleared = gv_debrisCleared + 1;
    return true;
}

void Clearing_Init () {
    gv_orePile = 0;
    gv_debrisCleared = 0;

    gt_debrisDied = TriggerCreate("Clearing_DebrisDied_Func");
    TriggerAddEventUnitDied(gt_debrisDied, null);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/30_workers.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Worker assignment.
//
// Workers pick their own job, repair before clearing. That ordering is the NPC
// side of the same tension P0 is testing on the player: a damaged device pulls
// a worker off the debris it was chewing on, so losing devices costs clearing
// throughput as well as power.
//
// Only idle workers get an order. Reissuing every tick would reset the attack
// of a worker already mid-swing and nothing would ever finish.
//
// The work-order marking UI is deliberately not in P0 -- see
// docs/design/p0-scope.md. Until then this stands in for it.
//--------------------------------------------------------------------------------------------------

const fixed c_workerAssignPeriod = 1.0;

trigger gt_workerAssign;

bool Workers_Assign_Func (bool testConds, bool runActions) {
    unitgroup workers;
    unitgroup damaged;
    unitgroup debris;
    unit worker;
    unit target;
    point where;
    int count;
    int i;

    if (!runActions) {
        return true;
    }

    workers = ObjectsGen_ScanSCV_Worker();
    count = UnitGroupCount(workers, c_unitCountAlive);
    if (count == 0) {
        return true;
    }

    damaged = Devices_Damaged();
    debris = ObjectsGen_ScanDebris();

    i = 1;
    while (i <= count) {
        worker = UnitGroupUnit(workers, i);
        if (worker != null && UnitIsAlive(worker) && UnitOrderCount(worker) == 0) {
            where = UnitGetPosition(worker);

            target = UnitGroupClosestToPoint(damaged, where);
            if (target != null) {
                UnitIssueOrder(
                    worker,
                    OrderTargetingUnit(AbilityCommand("Repair", 0), target),
                    c_orderQueueReplace
                );
            }
            else {
                target = UnitGroupClosestToPoint(debris, where);
                if (target != null) {
                    UnitIssueOrder(
                        worker,
                        OrderTargetingUnit(AbilityCommand("attack", 0), target),
                        c_orderQueueReplace
                    );
                }
            }
        }
        i = i + 1;
    }
    return true;
}

void Workers_Init () {
    gt_workerAssign = TriggerCreate("Workers_Assign_Func");
    TriggerAddEventTimePeriodic(gt_workerAssign, c_workerAssignPeriod, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/40_economy.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// The second stage of the resource chain: ore pile -> spendable resources.
//
// Fully automatic and independent of power, per the design baseline. The player
// never touches this; their only job is to keep the pile stocked, which is what
// makes clearing feel like it feeds something rather than paying out directly.
//
// Throughput scales with the miner headcount, so miners are a real investment
// and losing them is a real setback -- without ever letting a teammate's
// mistake touch this rate. See docs/design/gameplay-baseline.md section 1.
//--------------------------------------------------------------------------------------------------

const fixed c_minePeriod = 2.0;
const int c_minePerMinerPerTick = 5;

const fixed c_statusPeriod = 5.0;

trigger gt_mineTick;
trigger gt_status;

bool Economy_MineTick_Func (bool testConds, bool runActions) {
    int miners;
    int moved;

    if (!runActions) {
        return true;
    }

    miners = UnitGroupCount(ObjectsGen_ScanSCV_Miner(), c_unitCountAlive);
    moved = miners * c_minePerMinerPerTick;
    if (moved > gv_orePile) {
        moved = gv_orePile;
    }
    if (moved <= 0) {
        return true;
    }

    gv_orePile = gv_orePile - moved;
    PlayerModifyPropertyInt(c_p0Player, c_playerPropMinerals, c_playerPropOperAdd, moved);
    return true;
}

//--------------------------------------------------------------------------------------------------
// Greybox readout. P0 is about whether the loop pulls in three directions at
// once, so the numbers that matter have to be visible without alt-tabbing to
// read a log. Goes away once there is a real UI.
//--------------------------------------------------------------------------------------------------
bool Economy_Status_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }

    UIDisplayMessage(
        PlayerGroupAll(),
        c_messageAreaSubtitle,
        StringToText(
            "debris left=" + IntToString(UnitGroupCount(ObjectsGen_ScanDebris(), c_unitCountAlive))
            + "  cleared=" + IntToString(gv_debrisCleared)
            + "  pile=" + IntToString(gv_orePile)
            + "  power=" + IntToString(gv_power)
            + "  workers=" + IntToString(UnitGroupCount(ObjectsGen_ScanSCV_Worker(), c_unitCountAlive))
            + "  miners=" + IntToString(UnitGroupCount(ObjectsGen_ScanSCV_Miner(), c_unitCountAlive))
        )
    );
    return true;
}

void Economy_Init () {
    gt_mineTick = TriggerCreate("Economy_MineTick_Func");
    TriggerAddEventTimePeriodic(gt_mineTick, c_minePeriod, c_timeGame);

    gt_status = TriggerCreate("Economy_Status_Func");
    TriggerAddEventTimePeriodic(gt_status, c_statusPeriod, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/50_waves.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Zerg waves.
//
// One wave per spawn marker on a fixed interval, walking in on attack-move.
// Wave size grows by one per wave -- a placeholder ramp, not a difficulty
// curve. The baseline deliberately defers that until the mechanics it would be
// balancing against exist.
//
// Waves aim at the nearest device rather than at the player, so that "leave the
// fight to go repair" and "leave the repair to go fight" are the same decision
// seen from two sides. Falling back to the nearest worker keeps them walking
// somewhere meaningful before any device is placed.
//--------------------------------------------------------------------------------------------------

const fixed c_waveInterval = 45.0;
const int c_waveBaseSize = 3;
const string c_waveUnitType = "Zergling";

int gv_waveNumber;

trigger gt_wave;

//--------------------------------------------------------------------------------------------------
// What a wave spawning at `from` should walk towards.
//--------------------------------------------------------------------------------------------------
point Waves_TargetFrom (point from) {
    unit target;

    target = UnitGroupClosestToPoint(ObjectsGen_ScanDevice(), from);
    if (target == null) {
        target = UnitGroupClosestToPoint(ObjectsGen_ScanSCV(), from);
    }
    if (target == null) {
        return from;
    }
    return UnitGetPosition(target);
}

bool Waves_Spawn_Func (bool testConds, bool runActions) {
    unitgroup markers;
    unitgroup spawned;
    point where;
    int markerCount;
    int i;

    if (!runActions) {
        return true;
    }

    markers = ObjectsGen_ScanMarker_Spawn();
    markerCount = UnitGroupCount(markers, c_unitCountAlive);
    if (markerCount == 0) {
        return true;
    }

    gv_waveNumber = gv_waveNumber + 1;

    i = 1;
    while (i <= markerCount) {
        where = UnitGetPosition(UnitGroupUnit(markers, i));
        spawned = UnitCreate(
            c_waveBaseSize + gv_waveNumber,
            c_waveUnitType,
            0,
            c_p0Zerg,
            where,
            270.0
        );
        UnitGroupIssueOrder(
            spawned,
            OrderTargetingPoint(AbilityCommand("attack", 0), Waves_TargetFrom(where)),
            c_orderQueueReplace
        );
        i = i + 1;
    }

    UIDisplayMessage(
        PlayerGroupAll(),
        c_messageAreaSubtitle,
        StringToText("wave " + IntToString(gv_waveNumber) + " incoming")
    );
    return true;
}

void Waves_Init () {
    gv_waveNumber = 0;

    gt_wave = TriggerCreate("Waves_Spawn_Func");
    TriggerAddEventTimePeriodic(gt_wave, c_waveInterval, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// Map Initialization
//--------------------------------------------------------------------------------------------------
void InitMap () {
    libNtve_InitLib();
    ObjectsGen_Init();
    Registry_Init();
    Hero_Init();
    Devices_Init();
    Clearing_Init();
    Workers_Init();
    Economy_Init();
    Waves_Init();
}
