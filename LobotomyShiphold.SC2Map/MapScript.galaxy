//--------------------------------------------------------------------------------------------------
// src/galaxy/00_config.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Shared constants.
//
// Lives in the lowest-numbered module because Galaxy needs a declaration before
// its use and modules are concatenated in filename order.
//--------------------------------------------------------------------------------------------------

// Slots, read out of the map's own MapInfo rather than remembered: the player
// records carry their race id in slot order, and they read
//
//     1-6  Terr          the six players
//     7    Zerg          the swarm
//     8    Abnormality   whatever is loose
//
// The zerg used to be slot 2, which is now a player, so anything still saying 2
// would have been spawning waves for a teammate.
//
// Slot 8 is its own race because a loose abnormality has to be hostile to the
// zerg as well as to everybody else -- design 5.1 makes releasing an easy one
// to meet a wave a real tactic, and that is an alliance setting rather than
// anything script can arrange.
const int c_zergPlayer = 7;
const int c_abnoPlayer = 8;

// There used to be a c_p0Player = 1 here, for the parts of P0 that had not been
// made per-player yet -- the character, the department, the economy readout. It
// is gone because they all have been, and nothing refers to it. If a new one
// appears, that is the signal to write the per-player version instead: this
// constant is how a single-player assumption spreads, because it reads like a
// configuration value and is actually a claim that there is one player.

//--------------------------------------------------------------------------------------------------
// Somebody at the table, as opposed to the swarm or whatever is loose.
//
// Asked of PlayerStatus rather than of Dept_Of: a department is chosen on a
// selection screen that does not exist, so today only player 1 has one, and
// anything keyed to that would treat a six-player game as a single-player one.
//
// Here rather than in a system module because it is a fact about slots, and
// slots are what this file is.
//--------------------------------------------------------------------------------------------------
bool Slot_IsTablePlayer (int player) {
    if (player < 1 || player > 15) {
        return false;
    }
    if (player == c_zergPlayer || player == c_abnoPlayer) {
        return false;
    }
    return PlayerStatus(player) == c_playerStatusActive;
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/01_difficulty.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Difficulty, chosen per player.
//
// This replaces "scaled by that player's own development" as the thing personal
// wave strength reads. Development was never a real quantity -- it would have
// had to be invented out of some weighted count of devices and upgrades, and
// inventing a number to hang a system on is the mistake this project already
// made once with a User2 attribute that does not exist.
//
// A difficulty setting is better than the metric it replaces on its own merits,
// not merely as a stand-in:
//
//   It is chosen rather than measured, so nobody is punished for playing well.
//   Scaling by development means the better you do the harder it gets, which is
//   a treadmill dressed as a curve.
//
//   It is per player, so a novice can take Easy and still sit in a lobby of
//   people who have played fifty games. That is the same shape as the
//   encyclopedia admission rule in design 4.4 -- the table's difficulty is a
//   function of what each person can actually handle, and nobody has to be told
//   they are the reason everyone else is being held back.
//
//   It is legible. "I am on Hard" is something a player can say out loud, and
//   "my development coefficient is 1.4" is not.
//
// A novice on Easy is not a heavier burden on their neighbours either: fewer
// zerg spawn in their sector, so fewer leak out of it. The one negative transfer
// the baseline allows gets smaller, not larger.
//
//--------------------------------------------------------------------------------------------------
// The channel is a per-player lobby Game Attribute.
//
// GameAttributePlayerValue(name, player) is exactly "a dropdown in the lobby,
// one per slot", which is the thing being described, and it is the same channel
// design 7.8 already picked for core suppression. It returns "" when no such
// attribute exists, so this reads the native channel today and quietly answers
// Normal until somebody creates the attribute in the editor -- no code changes
// when it lands, and no half-built lobby in the meantime.
//
// Values are matched loosely on their first letters, so whatever the attribute's
// value ids end up being named, they work.
//
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// There is a global difficulty as well, and it is the MEAN.
//
// Personal difficulty sizes personal waves. But two things are shared and so
// cannot read a personal number: the energy target, and the ceiling on how bad
// an Ordeal is allowed to be.
//
// The mean, not the maximum. Baseline 2 already settled this exact argument for
// the ship-wide surge -- "按全队总量缩放，而非按最强玩家缩放" -- and the reason
// carries over intact: taking the max lets one player on Brutal drag the whole
// table into Midnight Ordeals, which is a person's choice reaching into
// everybody else's game. Taking the mean means each player moves the shared
// number by their own share of it and no further.
//
// It also closes a hole this file used to have to apologise for. The energy
// target is shared while difficulty is personal, so a table that all picked
// Casual would have been beating an unchanged objective with weakened
// opposition. Scaling the target by the mean makes Casual a genuinely smaller
// game rather than a discount on a fixed one, which is what a difficulty setting
// is supposed to mean.
//
//--------------------------------------------------------------------------------------------------
// Ordeals are not implemented. Their CEILING is, because it is a fact about
// difficulty rather than a fact about Ordeals: four difficulties map onto the
// four tiers one for one, so Diff_OrdealCap is the whole of what difficulty has
// to say and needs nothing that does not exist yet.
//
// When Ordeals land they read Diff_OrdealCap and Diff_Of. Nothing should grow a
// second copy of either scale.
//--------------------------------------------------------------------------------------------------

// Blizzard's campaign scale, which is where the names come from. The bottom
// rung is Casual; this said Easy for one commit and that was simply wrong.
const int c_diffCasual = 0;
const int c_diffNormal = 1;
const int c_diffHard = 2;
const int c_diffBrutal = 3;
const int c_diffCount = 4;

// The four Ordeal tiers, in the order they get worse. One per difficulty, which
// is not a coincidence to be tidied away later -- it is the mapping.
const int c_ordealDawn = 0;
const int c_ordealNoon = 1;
const int c_ordealDusk = 2;
const int c_ordealMidnight = 3;

string[4] gvg_ordealName;

const string c_diffAttribute = "difficulty";

string[4] gvg_diffName;

// TUNING. Percent of the baseline personal wave. Blizzard's own campaign scale
// is the reference for the NAMES, not for these numbers -- nobody has designed
// a curve, and this is a deliberately plain spread rather than a guess dressed
// up as one.
int[4] gvg_diffWavePct;

// TUNING. Percent of the baseline energy target, read off the MEAN difficulty.
// Deliberately flatter than the wave spread: a harder game should be a longer
// game as well as a busier one, but doubling both at once multiplies.
int[4] gvg_diffGoalPct;

int[16] gvg_diffOf;

int Diff_Of (int player) {
    if (player < 1 || player > 15) {
        return c_diffNormal;
    }
    return gvg_diffOf[player];
}

void Diff_SetOf (int player, int level) {
    if (player < 1 || player > 15 || level < 0 || level >= c_diffCount) {
        return;
    }
    gvg_diffOf[player] = level;
}

string Diff_Name (int level) {
    if (level < 0 || level >= c_diffCount) {
        return "?";
    }
    return gvg_diffName[level];
}

string Diff_NameOf (int player) {
    return Diff_Name(Diff_Of(player));
}

int Diff_WavePct (int player) {
    return gvg_diffWavePct[Diff_Of(player)];
}

//--------------------------------------------------------------------------------------------------
// The table's difficulty: the mean of everybody's, rounded to nearest.
//
// Rounded to nearest rather than down. Three on Brutal and one on Casual comes
// to 2.25 and lands on Hard; rounding down would call that table Normal and cap
// its Ordeals at Noon, which is one player's pick quietly deciding for three who
// chose otherwise -- the same objection as taking the maximum, pointed the other
// way.
//
// An empty table answers Normal. Nothing should ever ask before players exist,
// but a difficulty of "no players" is not a thing and the alternative is a
// division by zero.
//--------------------------------------------------------------------------------------------------
int Diff_Global () {
    int total;
    int count;
    int player;

    total = 0;
    count = 0;
    player = 1;
    while (player <= 15) {
        if (Slot_IsTablePlayer(player)) {
            total = total + gvg_diffOf[player];
            count = count + 1;
        }
        player = player + 1;
    }
    if (count == 0) {
        return c_diffNormal;
    }
    return (total * 2 + count) / (count * 2);
}

string Diff_GlobalName () {
    return Diff_Name(Diff_Global());
}

//--------------------------------------------------------------------------------------------------
// The worst Ordeal this table can be dealt. A ceiling, not a schedule: which
// Ordeal actually arrives and when is the Ordeal system's business, and it does
// not exist yet.
//--------------------------------------------------------------------------------------------------
int Diff_OrdealCap () {
    return Diff_Global();
}

string Diff_OrdealName (int tier) {
    if (tier < 0 || tier > c_ordealMidnight) {
        return "?";
    }
    return gvg_ordealName[tier];
}

//--------------------------------------------------------------------------------------------------
// What the shared energy target should be, given a baseline.
//--------------------------------------------------------------------------------------------------
int Diff_GoalFrom (int base) {
    int goal;

    goal = base * gvg_diffGoalPct[Diff_Global()] / 100;
    if (goal < 1) {
        goal = 1;
    }
    return goal;
}

//--------------------------------------------------------------------------------------------------
// Which level a word means, or -1. First letter only, because this has to accept
// both what a player types into chat and whatever the lobby attribute's value
// ids turn out to be called.
//--------------------------------------------------------------------------------------------------
int Diff_FromWord (string word) {
    string first;

    if (word == "") {
        return -1;
    }
    first = StringCase(StringSub(word, 1, 1), false);

    if (first == "c") { return c_diffCasual; }
    if (first == "n") { return c_diffNormal; }
    if (first == "h") { return c_diffHard; }
    if (first == "b") { return c_diffBrutal; }

    // Melee calls its bottom rung Easy and half the people typing this will
    // reach for that word, so it means the same thing.
    if (first == "e") { return c_diffCasual; }
    return -1;
}

void Difficulty_Init () {
    int player;
    int level;

    gvg_diffName[c_diffCasual] = "Casual";
    gvg_diffName[c_diffNormal] = "Normal";
    gvg_diffName[c_diffHard] = "Hard";
    gvg_diffName[c_diffBrutal] = "Brutal";

    gvg_ordealName[c_ordealDawn] = "Dawn";
    gvg_ordealName[c_ordealNoon] = "Noon";
    gvg_ordealName[c_ordealDusk] = "Dusk";
    gvg_ordealName[c_ordealMidnight] = "Midnight";

    gvg_diffWavePct[c_diffCasual] = 60;
    gvg_diffWavePct[c_diffNormal] = 100;
    gvg_diffWavePct[c_diffHard] = 145;
    gvg_diffWavePct[c_diffBrutal] = 200;

    gvg_diffGoalPct[c_diffCasual] = 70;
    gvg_diffGoalPct[c_diffNormal] = 100;
    gvg_diffGoalPct[c_diffHard] = 125;
    gvg_diffGoalPct[c_diffBrutal] = 155;

    player = 1;
    while (player <= 15) {
        gvg_diffOf[player] = c_diffNormal;
        level = Diff_FromWord(GameAttributePlayerValue(c_diffAttribute, player));
        if (level >= 0) {
            gvg_diffOf[player] = level;
        }
        player = player + 1;
    }
}

