// Map Initialization
//--------------------------------------------------------------------------------------------------
void InitMap () {
    libNtve_InitLib();
    ObjectsGen_Init();
    Sector_Init();
    Registry_Init();
    Employee_Init();
    Departments_Init();
    Containment_Init();
    Hero_Init();
    Devices_Init();
    Clearing_Init();
    Workers_Init();
    Economy_Init();
    Waves_Init();
    Debug_Init();
}
