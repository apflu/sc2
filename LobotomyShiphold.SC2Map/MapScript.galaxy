bool ObjectsGen_IsDebris (unit target) {
    int i;

    if (target == null) {
        return false;
    }
    i = 0;
    while (i < c_typesDebrisCount) {
        if (UnitGetType(target) == gvg_typesDebris[i]) {
            return true;
