// Unit types, by the category segment of their id.
const int c_typesDebrisCount = 1;
string[1] gvg_typesDebris;
const int c_typesSCVCount = 1;
string[1] gvg_typesSCV;

// Editor object groups, flattened: names[i] owns the members
// slice starting at groupFirst[i] and running groupSize[i] long.
const int c_groupCount = 1;
string[1] gvg_groupNames;
int[1] gvg_groupFirst;
int[1] gvg_groupSize;
int[2] gvg_groupMembers;

void ObjectsGen_Init () {
    gvg_typesDebris[0] = "Lob_Debris_Normal";
    gvg_typesSCV[0] = "Lob_SCV";
    gvg_groupNames[0] = "debris";
    gvg_groupFirst[0] = 0;
    gvg_groupSize[0] = 2;
    gvg_groupMembers[0] = 982629277;
    gvg_groupMembers[1] = 1070187309;
}

//--------------------------------------------------------------------------------------------------
// Every live Debris unit on the map, whichever variant and whoever owns it.
// Works for runtime-spawned units too, unlike anything keyed on placed ids.
//--------------------------------------------------------------------------------------------------
unitgroup ObjectsGen_ScanDebris () {
    unitgroup found;
    int i;

    found = UnitGroupEmpty();
    i = 0;
    while (i < c_typesDebrisCount) {
        UnitGroupAddUnitGroup(found, UnitGroup(gvg_typesDebris[i], c_playerAny,
                                               RegionEntireMap(), null, 0));
        i = i + 1;
    }
    return found;
}

//--------------------------------------------------------------------------------------------------
// Every live SCV unit on the map, whichever variant and whoever owns it.
// Works for runtime-spawned units too, unlike anything keyed on placed ids.
//--------------------------------------------------------------------------------------------------
unitgroup ObjectsGen_ScanSCV () {
    unitgroup found;
    int i;

    found = UnitGroupEmpty();
    i = 0;
    while (i < c_typesSCVCount) {
        UnitGroupAddUnitGroup(found, UnitGroup(gvg_typesSCV[i], c_playerAny,
                                               RegionEntireMap(), null, 0));
        i = i + 1;
    }
    return found;
}

//--------------------------------------------------------------------------------------------------
// The placed objects of a named editor group. Preplaced only -- runtime
// spawns have no group. Returns empty for an unknown name.
//--------------------------------------------------------------------------------------------------
unitgroup ObjectsGen_Group (string name) {
    unitgroup found;
    int i;
    int m;

    found = UnitGroupEmpty();
    i = 0;
    while (i < c_groupCount) {
        if (gvg_groupNames[i] == name) {
            m = gvg_groupFirst[i];
            while (m < gvg_groupFirst[i] + gvg_groupSize[i]) {
                UnitGroupAdd(found, UnitFromId(gvg_groupMembers[m]));
                m = m + 1;
            }
            return found;
        }
        i = i + 1;
    }
    return found;
}

//--------------------------------------------------------------------------------------------------
// src/galaxy/10_registry.galaxy
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Object registry.
//
// What the code side knows about the editor side. Objects are identified by
// UNIT TYPE, resolved through the tables in 05_objects_gen.galaxy.
//
// Type rather than placed id, because the editor assigns ids randomly and they
// cannot be chosen by hand -- and more importantly because type is the one
// channel that also covers units spawned at runtime, which is where debris is
// eventually headed.
//
// Type rather than owning player, because ownership carries engine semantics we
// do not control (alliance, default right-click, selection, minimap colour) and
// there are only fifteen slots to spend on six players plus the swarm.
//--------------------------------------------------------------------------------------------------

unitgroup gv_debris;
unitgroup gv_scvs;

//--------------------------------------------------------------------------------------------------
// Prints what the scan found. While greyboxing this is the fastest way to spot
// a unit placed with the wrong type -- the count comes back short.
//--------------------------------------------------------------------------------------------------
void Registry_Report () {
    UIDisplayMessage(
        PlayerGroupAll(),
        c_messageAreaSubtitle,
        StringToText(
            "registry: debris=" + IntToString(UnitGroupCount(gv_debris, c_unitCountAlive))
            + " scv=" + IntToString(UnitGroupCount(gv_scvs, c_unitCountAlive))
            + " group(debris)=" + IntToString(UnitGroupCount(ObjectsGen_Group("debris"), c_unitCountAlive))
        )
    );
}

void Registry_Init () {
    gv_debris = ObjectsGen_ScanDebris();
    gv_scvs = ObjectsGen_ScanSCV();
    Registry_Report();
}

//--------------------------------------------------------------------------------------------------
// Map Initialization
//--------------------------------------------------------------------------------------------------
void InitMap () {
    libNtve_InitLib();
    P0Smoke_Init();
    ObjectsGen_Init();
    Registry_Init();
}
