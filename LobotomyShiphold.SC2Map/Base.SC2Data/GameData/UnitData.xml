    <!-- The player character.-->
    <!--         Parented rather than flattened: everything not listed here is a-->
    <!--         Marine, so this entry reads as a diff against one. Marine's ability-->
    <!--         list is stop/attack/move/Stimpack, so Repair swaps straight into-->
    <!--         index 3 and its button into card slot 5, and the character ends up-->
    <!--         with no harvest and no build. The only things that can want it are-->
    <!--         the three P0 is testing, which is what makes "the player is busy"-->
    <!--         have exactly one explanation.-->
    <!--         Intended target is RaynorCommando, which is already almost this unit;-->
    <!--         it needs a campaign dependency the map does not have yet. See-->
    <!--         docs/dev/authoring-contract.md.-->
    <!--         Death costs only time, handled in src/galaxy/15_hero.galaxy, because-->
    <!--         that is a design rule rather than a data one. -->
    <CUnit id="Lob_Hero_Agent" parent="Marine">
        <FlagArray index="Hero" value="1"/>
        <LifeStart value="250"/>
        <LifeMax value="250"/>
        <LifeArmor value="1"/>
        <!-- Slow constant regeneration. Nothing in P0 heals, and chip damage
             that never comes back would quietly turn every wave into a
             countdown to a death the player cannot avoid, which is the
             opposite of "death costs only time". -->
        <LifeRegenRate value="1"/>
        <Speed value="3"/>
        <Food value="0"/>
        <!-- Light and Biological are risk levels here (Teth / Zayin), not body
             types. Marine carries both; an employee is not an abnormality, so
             they come back off. See docs/dev/authoring-contract.md. -->
        <Attributes index="Light" value="0"/>
        <Attributes index="Biological" value="0"/>
        <AbilArray index="3" Link="Repair"/>
        <AbilArray Link="Lob_Debug_Haste"/>
        <WeaponArray index="0" Link="Lob_Hero_Rifle"/>
        <CardLayouts index="0">
