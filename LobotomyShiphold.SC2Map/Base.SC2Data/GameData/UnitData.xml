    <!-- A disabled device.

         Invulnerable does both halves of the job at once, and neither needed
         inventing: the zergling weapon's target filters exclude Invulnerable,
         so nothing keeps chewing on a device that is already down, while the
         Repair ability's filters do not, so an SCV or the player can still
         work on it. Starts at 1 life so repair has the full bar to climb.

         Food is absent, so the engine drops this device from the grid the
         instant it morphs. That is the entire disable mechanic. -->
    <CUnit id="Lob_DeviceDown_Basic" parent="Lob_Device_Basic">
        <Food value="0"/>
        <FlagArray index="Invulnerable" value="1"/>
        <LifeStart value="1"/>
        <EditorCategories value="ObjectType:Structure,ObjectFamily:Campaign"/>
    </CUnit>
    <!-- The stockpile the baseline's resource chain runs through, expressed as
         a mineral node so the second stage is performed rather than asserted:
         miners walk to it, carry, and walk back. Nothing scripts the payout. -->
    <CUnit id="Lob_Pile_Ore" parent="MineralFieldDefault">
        <BehaviorArray index="0" Link="Lob_Pile_Ore"/>
        <EditorCategories value="ObjectType:Resource,ObjectFamily:Campaign"/>
    </CUnit>
    <!-- Where miners take it. Native harvest needs a drop-off or it has nowhere
         to carry to; this is the recycler in baseline 4.4, and putting it in the
         inner room is what gives the haul a length worth caring about. -->
    <CUnit id="Lob_Recycler_Basic" parent="Lob_Device_Basic">
        <Food value="0"/>
        <ResourceDropOff index="Minerals" value="1"/>
        <EditorCategories value="ObjectType:Structure,ObjectFamily:Campaign"/>
    </CUnit>
    <!-- The rest hall core. Baseline 3.2 lists it as inner-layer content, and
         making it a real unit is what lets one object carry everything the
         inner layer has to answer: where the rest hall is, whether it is still
         held, and later the command card that department upgrades live on.

         It goes down the same way a device does, because baseline 3.2 also says
         losing the inner layer is reversible. Same mechanic, same code. -->
    <CUnit id="Lob_Core_Basic">
