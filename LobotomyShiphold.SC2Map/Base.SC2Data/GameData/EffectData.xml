<?xml version="1.0" encoding="utf-8"?>
<Catalog>
    <!-- The player character's damage. Split out from the weapon because SC2
         keeps "how hard it hits" in the effect and "how often" in the weapon;
         the two together are what P0 tunes when asking whether a player clears
         debris meaningfully faster than a worker does. -->
    <CEffectDamage id="Lob_Hero_Rifle" parent="DU_WEAP">
        <Amount value="20"/>
    </CEffectDamage>
    <!-- The first White E.G.O, and a probe. 12 White, and against a person that
         is 12 off SP rather than 12 off life, because Lob_Mind_White eats the
         life half and 17_damage spends the rest.

         Aimed at a broken colleague it gives 12 BACK. That branch is in script
         and not here on purpose: Violet Dawn's burst is White as well, and a
         rule written into the damage type would have made an Ordeal heal the
         people it exists to break. Who fired is what separates them. -->
    <CEffectDamage id="Lob_Ego_Mercy" parent="DU_WEAP">
        <Kind value="Ranged"/>
        <Amount value="12"/>
    </CEffectDamage>
    <CEffectApplyBehavior id="Lob_Debug_Haste"/>
    <!-- Deliberately empty. An ability has to point at an effect; this one's
         whole job is to be pressable so a trigger can hear it. -->
    <CEffectSet id="Lob_Nothing"/>
    <!-- What the work ability fires.

         Apply-behavior, which is Larva Swarm's shape; Snipe uses damage. Either
         is a real effect on a real unit, and that is the part that matters: an
         Effect-Target ability whose effect does not unambiguously act on a unit
         never becomes a targeting command, so pressing the button does nothing
         and no cursor appears.

         Two earlier attempts both had that failure. A CEffectSet with no members
         points at nothing. A CEffectModifyUnit with no fields modifies nothing,
         which turns out not to be the same as acting on something.

         No validator here any more either. IsContainmentGate has a WhichUnit
         field it does not set, so it was very likely testing the caster — an
         employee, which is not a Structure — and failing, which makes the
         ability unusable rather than the target illegal. TargetFilters does the
         target check, and 14_work refuses anything that is not a door anyway.
         It can come back once this works, with WhichUnit set to Target. -->
    <CEffectApplyBehavior id="Lob_WorkCheck">
        <Behavior value="Lob_Worked"/>
    </CEffectApplyBehavior>
    <!-- The far end of Lob_Ordeal_Rob. It does nothing to the door; the theft
         itself is 27_ordeals' business. This exists because an Effect-Target
         ability needs an effect that unambiguously acts on a unit or the
         command never becomes a targeting command — the same lesson as
         Lob_WorkCheck above, and the same shape. -->
    <CEffectApplyBehavior id="Lob_Ordeal_RobHit">
        <Behavior value="Lob_Worked"/>
    </CEffectApplyBehavior>
    <!-- Retracting is not something the turret decides. Nothing in the morph
         ability makes it happen; a hidden behavior tries once a second and the
         ability's NotAttacking validator is what turns "there are no enemies"
         into "go down". So the ability named here has to be OURS — the stock
         effect names PerditionTurretBurrow, which our turret does not have, and
         an order for an ability a unit does not own is simply dropped. That is
         a turret that builds correctly and then never retracts, with nothing
         anywhere saying why.

         Coming back up is the opposite: that one IS on the ability, as autocast
         with a range and a filter, so it needs no help from here. -->
    <CEffectIssueOrder id="Lob_Turret_Fire_BurrowOrder">
        <WhichUnit Value="Caster"/>
        <Abil value="Lob_Turret_Fire_Burrow"/>
        <CmdFlags index="Preempt" value="1"/>
    </CEffectIssueOrder>
    <!-- A worm's bite. Two things came across from the Locust it was copied
         from and both had to go.

         Kind was Ranged, which under our mapping is WHITE, so Amber has been
         quietly costing employees SANITY instead of blood since it was first
         put on the map. It looked entirely normal. The doc says RED, which is
         Melee here; Kind is our damage-type channel and has nothing to say
         about how far away the biter is standing.

         ArmorReduction was Blizzard's answer to flat armour and we no longer
         have flat armour, so it was a modifier that could only ever surprise
         somebody. See docs/dev/damage-channel.md.

         AMOUNT IS FLAT AT 2 AND THE DOC SAYS 1-2. CEffectDamage has one number
         and no way to state a range, and script cannot roll one either: it
         learns the amount from EventUnitDamageAttempted, which is a number and
         not a range. Every hit in this game is written as a range, so this
         wants a table of (effect, min, max) generated from the docs ; the same
         per-type value channel four other systems are waiting on. Two rather
         than one because a ceiling is the honest placeholder for a range. -->
    <CEffectDamage id="Lob_Ordeal_Dawn_Amber_Damage">
        <EditorCategories value="Race:Zerg"/>
        <ResponseFlags index="Acquire" value="1"/>
        <ResponseFlags index="Flee" value="1"/>
        <Flags index="Notification" value="1"/>
        <Kind value="Melee"/>
        <Amount value="2"/>
        <Death value="Disintegrate"/>
        <SearchFlags index="CallForHelp" value="1"/>
        <SearchFlags index="OffsetByUnitRadius" value="1"/>
    </CEffectDamage>
    <!-- The missile is why this was copied rather than written. AmmoUnit is the
         projectile, and with it come the launch actor, the flight and the
         impact; a hand-written CEffectDamage has none of those and the worm
         bites at nothing. -->
    <CEffectLaunchMissile id="Lob_Ordeal_Dawn_Amber_Missile">
        <EditorCategories value="Race:Zerg"/>
        <ImpactEffect value="Lob_Ordeal_Dawn_Amber_Damage"/>
        <AmmoUnit value="LocustMPWeapon"/>
    </CEffectLaunchMissile>
    <CEffectDamage id="Lob_Ordeal_Dawn_Green_Damage" parent="DU_WEAP">
        <ValidatorArray value="NotHidden"/>
        <EditorCategories value="Race:Protoss"/>
        <Amount value="8"/>
        <Death value="Eviscerate"/>
    </CEffectDamage>
    <CEffectCreatePersistent id="Lob_Ordeal_Dawn_Green_Burst">
        <EditorCategories value="Race:Protoss"/>
        <WhichLocation Value="TargetUnit"/>
        <TimeScaleSource Value="Caster"/>
        <Flags index="Channeled" value="1"/>
        <PeriodCount value="2"/>
        <PeriodicEffectArray value="Lob_Ordeal_Dawn_Green_Damage"/>
        <PeriodicPeriodArray value="0"/>
        <PeriodicPeriodArray value="0.28"/>
    </CEffectCreatePersistent>
</Catalog>
