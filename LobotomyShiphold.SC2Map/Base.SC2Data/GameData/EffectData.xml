<?xml version="1.0" encoding="utf-8"?>
<Catalog>
    <!-- The player character's damage. Split out from the weapon because SC2
         keeps "how hard it hits" in the effect and "how often" in the weapon;
         the two together are what P0 tunes when asking whether a player clears
         debris meaningfully faster than a worker does. -->
    <CEffectDamage id="Lob_Hero_Rifle" parent="DU_WEAP">
        <Kind value="Ranged"/>
        <Amount value="20"/>
    </CEffectDamage>

    <CEffectApplyBehavior id="Lob_Debug_Haste">
        <Behavior value="Lob_Debug_Haste"/>
    </CEffectApplyBehavior>
    <!-- Deliberately empty. An ability has to point at an effect; this one's
         whole job is to be pressable so a trigger can hear it. -->
    <CEffectSet id="Lob_Nothing"/>
    <!-- The same, plus the one thing the ability could not carry itself: which
         targets are legal. CAbilEffectTarget has no ValidatorArray field, so for
         that class the check belongs on the effect it fires. Separate from
         Lob_Nothing because the encyclopedia buttons share that one and must not
         inherit a rule about doors. -->
    <CEffectSet id="Lob_WorkCheck">
        <ValidatorArray value="IsContainmentGate"/>
    </CEffectSet>
</Catalog>
