<?xml version="1.0" encoding="utf-8"?>
<Catalog>
    <!-- The player character's damage. Split out from the weapon because SC2
         keeps "how hard it hits" in the effect and "how often" in the weapon;
         the two together are what P0 tunes when asking whether a player clears
         debris meaningfully faster than a worker does. -->
    <CEffectDamage id="Lob_Hero_Rifle" parent="DU_WEAP">
        <Kind value="Ranged"/>
        <Amount value="20"/>
    </CEffectDamage>

    <CEffectApplyBehavior id="Lob_Debug_Haste">
        <Behavior value="Lob_Debug_Haste"/>
    </CEffectApplyBehavior>
    <!-- Deliberately empty. An ability has to point at an effect; this one's
         whole job is to be pressable so a trigger can hear it. -->
    <CEffectSet id="Lob_Nothing"/>
    <!-- What the work ability fires, and why it is not a CEffectSet.

         An Effect-Target ability takes its target type FROM ITS EFFECT. An empty
         CEffectSet points at nothing, so there was nothing to derive a unit
         target from and pressing the button never entered targeting mode — no
         cursor, nothing to click. ModifyUnit acts on a unit by definition, so
         the ability becomes a unit-target ability, and modifying none of that
         unit's fields is a perfectly good way to change nothing.

         It also carries the validator, which the ability could not:
         ValidatorArray is a field of CAbilBehavior, CAbilMorph, CAbilInteract
         and CAbilRevive, and not of CAbilEffectTarget.

         Separate from Lob_Nothing because the four encyclopedia buttons point at
         that one — they are instant and want no target at all, which is exactly
         why an empty set suits them and not this. -->
    <CEffectModifyUnit id="Lob_WorkCheck">
        <ValidatorArray value="IsContainmentGate"/>
    </CEffectModifyUnit>
</Catalog>
