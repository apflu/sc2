    <CActorUnit id="Lob_Hero_Agent" parent="GenericUnitStandard" unitName="Lob_Hero_Agent">
        <!-- Parented to the abstract base, NOT to Marine, even though the unit
             above is parented to the Marine CUnit. Unit catalogs are inert data
             and inherit cleanly; actors are message-bus subscribers, and the
             subscriptions a parent actor carries are baked to the parent's unit
             name. Setting unitName on the child does not retarget them, so a
             child of the Marine actor still listens for UnitBirth.Marine and
             nothing answers for ours: "Unable to create unit actor".

             Blizzard's own CarrierInterceptorDummy (parent="Carrier") shows the
             alternative, and shows why we are not taking it: it has to rewrite
             the inherited subscriptions by array index, On index="0" through
             "5", which silently rots the moment Blizzard reorders the parent. -->
        <Aliases value="_UnitSmall"/>
        <Macros value="UnloadDropAnim"/>
        <Macros value="PhysicsDeathsSwarmGround"/>
        <!-- Attack bracket subscribed on WeaponStart.* rather than by weapon
             name, exactly as the stock Marine actor does, so the animation
             follows the character's weapon whatever we rename it to later. -->
        <On Terms="Abil.attack.ReadyStart" Send="AnimGroupApply Ready"/>
        <On Terms="Abil.attack.ReadyStop" Send="AnimGroupRemove Ready"/>
        <On Terms="WeaponStart.*.AttackStart" Send="AnimBracketStart Attack Attack"/>
        <On Terms="WeaponStop.*.AttackStop" Send="AnimBracketStop Attack"/>
        <!-- Greybox tell, same idea as the SCV tints below: in a fight the
             player's own unit has to be the one that obviously is not
             everything else. -->
        <On Terms="UnitBirth.Lob_Hero_Agent" Send="SetTintColor 120,255,140"/>
        <Model value="Marine"/>
        <ModelFlags index="OutlineEmitter" value="1"/>
        <BuildModel value="Marine"/>
        <PlacementModel value="Marine"/>
        <DeathArray index="Normal" ModelLink="MarineDeath"/>
        <PortraitModel value="MarinePortrait"/>
        <WalkAnimMoveSpeed value="2.25"/>
        <BarOffset value="40"/>
        <BarWidth value="36"/>
        <GroupIcon>
            <Image value="Assets\Textures\Wireframe-Terran-Marine.dds"/>
        </GroupIcon>
        <HeroIcon value="Assets\Textures\btn-unit-terran-marine.dds"/>
        <UnitIcon value="Assets\Textures\btn-unit-terran-marine.dds"/>
        <LifeArmorIcon value="Assets\Textures\btn-upgrade-terran-infantryarmorlevel0.dds"/>
        <Wireframe>
            <Image value="Assets\Textures\Wireframe-Terran-Marine.dds"/>
        </Wireframe>
    </CActorUnit>
    <CActorUnit id="Lob_SCV" parent="GenericUnitStandard" unitName="None">
        <!-- One actor for every SCV role: the models are identical, so the roles
             differ only in what the script lets them do. Listed explicitly rather
             than via unitName so no role is privileged as "the" host. -->
        <On Terms="UnitBirth.Lob_SCV_Unassigned" Send="Create"/>
        <On Terms="UnitBirth.Lob_SCV_Miner" Send="Create"/>
        <On Terms="UnitBirth.Lob_SCV_Worker" Send="Create"/>
        <!-- Greybox tell: identical models are impossible to tell apart while
             watching both roles work. Drop these once the roles get real art. -->
        <On Terms="UnitBirth.Lob_SCV_Miner" Send="SetTintColor 80,160,255"/>
        <On Terms="UnitBirth.Lob_SCV_Worker" Send="SetTintColor 255,180,60"/>
