<?xml version="1.0" encoding="utf-8"?>
<Catalog>
    <!-- Sending an employee to work.

         Effect-Target rather than Interact, and the whole of it is PrepTime:
         the ability does nothing, it just takes a moment and can be aimed at a
         containment door. 14_work.galaxy hears the cast complete and starts the
         work; the cast bar is the "短暂读条" docs/usr/containment.md asks for,
         and it is the engine drawing it rather than anything of ours.

         The previous version read the employee's order queue and inferred
         intent from an order pointed at a door. That worked and was wrong: it
         made every move order near a cell ambiguous, it could not show a cast
         bar, and it had no way to refuse. A real ability has TargetFilters and
         a validator for that, and picks up the right-click behaviour later from
         SmartCast without any of this changing.

         Uninterruptible is deliberately NOT set. Walking away has to cancel it,
         because "the wave arrived, pull them out" is a decision the player is
         supposed to be able to make. -->
    <CAbilEffectTarget id="Interact">
        <EditorCategories value="AbilityorEffectType:Units"/>
        <!-- The validator lives on the effect, not here: ValidatorArray is a
             field of CAbilBehavior, CAbilMorph, CAbilInteract and CAbilRevive,
             but not of CAbilEffectTarget. For this class the target is checked
             by TargetFilters and by whatever the effect itself validates. -->
        <Effect value="Lob_WorkCheck"/>
        <PrepTime value="1"/>
        <Range value="2"/>
        <Arc value="360"/>
        <TargetFilters value="Structure,Visible;Self"/>
        <CmdButtonArray index="Execute" DefaultButtonFace="Interact"/>
    </CAbilEffectTarget>
    <!-- Debug only. No cost, no cooldown, recastable to refresh. -->
    <CAbilEffectInstant id="Lob_Debug_Haste">
        <Flags index="Transient" value="1"/>
        <Effect value="Lob_Debug_Haste"/>
        <CmdButtonArray index="Execute" DefaultButtonFace="Lob_Debug_Haste">
            <Flags index="ToSelection" value="1"/>
        </CmdButtonArray>
    </CAbilEffectInstant>
    <!-- The encyclopedia, as four buttons on a containment control panel.

         Four generic abilities serve every abnormality, because the text on
         them is set per unit INSTANCE with UnitSetInfoButtonTooltip rather than
         being baked into the catalog. So thirty abnormalities need no abilities
         of their own and the lore stays where it is written, in the doc.

         An unbought section is an ability you can press: pressing it spends
         that abnormality's PE-Boxes. A bought one is disabled — which is what
         "becomes passive" means in engine terms, and it keeps its tooltip, so
         the button turns into the page it bought.

         The effect does nothing. 13_containment.galaxy handles the press off
         the ability event; the ability exists to be a button. -->
    <CAbilEffectInstant id="Lob_Obs_1">
        <EditorCategories value="AbilityorEffectType:Units"/>
        <Effect value="Lob_Nothing"/>
        <CmdButtonArray index="Execute" DefaultButtonFace="Lob_Obs_1"/>
    </CAbilEffectInstant>
    <CAbilEffectInstant id="Lob_Obs_2">
        <EditorCategories value="AbilityorEffectType:Units"/>
        <Effect value="Lob_Nothing"/>
        <CmdButtonArray index="Execute" DefaultButtonFace="Lob_Obs_2"/>
    </CAbilEffectInstant>
    <CAbilEffectInstant id="Lob_Obs_3">
        <EditorCategories value="AbilityorEffectType:Units"/>
        <Effect value="Lob_Nothing"/>
        <CmdButtonArray index="Execute" DefaultButtonFace="Lob_Obs_3"/>
    </CAbilEffectInstant>
    <CAbilEffectInstant id="Lob_Obs_4">
        <EditorCategories value="AbilityorEffectType:Units"/>
        <Effect value="Lob_Nothing"/>
        <CmdButtonArray index="Execute" DefaultButtonFace="Lob_Obs_4"/>
    </CAbilEffectInstant>
</Catalog>
