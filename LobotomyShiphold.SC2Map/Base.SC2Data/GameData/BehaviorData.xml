<?xml version="1.0" encoding="utf-8"?>
<Catalog>
    <!-- Debug only. Deliberately a buff rather than a change to the weapon:
         the player-DPS to worker-DPS ratio is the single number P0 exists to
         measure, so retuning the weapon to make testing comfortable would
         quietly destroy the thing being tested. This leaves the real numbers
         alone and can be switched on when the loop needs to be driven fast.

         Expires on its own, and carries an icon on the unit while it is up, so
         a session cannot be measured with it accidentally left running. -->
    <CBehaviorBuff id="Lob_Debug_Haste">
        <Alignment value="Positive"/>
        <InfoIcon value="Assets\Textures\btn-ability-terran-stimpack.dds"/>
        <Duration value="600"/>
        <Modification MoveSpeedMultiplier="2" AttackSpeedMultiplier="10"/>
    </CBehaviorBuff>

    <!-- The inner-room stockpile, as a real harvestable node.

         RemoveWhenEmpty is off, which is the whole reason this works: a stock
         mineral field deletes itself when it runs dry, and this one has to
         survive being emptied so clearing more debris can top it back up.
         Capacity is far above anything a session will reach, because the cap
         is not a design number, how fast debris fills it is.

         IdealHarvesterCount is display only, a suggestion shown in the UI; it
         does not change yield. Throughput is HarvestTime against HarvestAmount,
         and those are the two numbers to design. -->
    <CBehaviorResource id="Lob_Pile_Ore">
        <InfoIcon value="Assets\Textures\icon-mineral.dds"/>
        <Capacity value="100000"/>
        <Contents value="0"/>
        <HarvestTime value="2.786"/>
        <HarvestAmount value="5"/>
        <Flags index="RemoveWhenEmpty" value="0"/>
        <ReturnDelay value="0.5"/>
        <IdealHarvesterCount value="2"/>
    </CBehaviorResource>

    <!-- Recovery in the rest hall (baseline 8). Applied and removed by script
         according to where the character is and whether the core is still held,
         but the rate itself is data, so a welfare-department upgrade later
         changes a number here rather than any code. -->
    <CBehaviorBuff id="Lob_RestHall_Recovery">
        <Alignment value="Positive"/>
        <InfoIcon value="Assets\Textures\btn-ability-terran-scannersweep.dds"/>
        <Modification>
            <VitalRegenArray index="Life" value="12"/>
            <!-- SP. The employee unit regenerates none on its own, on purpose:
                 the design has SP coming back from the rest hall and from
                 Welfare Team, not from standing anywhere. This is the first of
                 those two, and without it the room did nothing for the people
                 it exists for. Slower than life on purpose — a wound is a
                 delay, a mind is the resource the whole loop spends. -->
            <VitalRegenArray index="Energy" value="2"/>
        </Modification>
    </CBehaviorBuff>

    <!-- ============================================================
         Employee stats.

         Two behaviors per stat, because the engine splits the job in two and
         the split is not optional:

           CBehaviorAttribute  displays the stat and carries its per-point
                               effect. core's InfoPaneHero layout reserves
                               AttributeLabel1..5 down the right of the hero
                               pane to draw exactly these, named from
                               Behavior/Name and Behavior/Tooltip. MaxPoints
                               caps it. War3's STR/AGI/INT are this catalog.

         Points are read and written with UnitGetAttributePoint and
         UnitSetAttributePoint. They are NOT the behavior's stack count, which
         is why UnitBehaviorCount on one of these answers zero however much you
         add — and the point natives are declared in natives_missing.galaxy
         rather than natives.galaxy, which is why an earlier version routed the
         number through a stackable carrier buff per stat instead. Four
         behaviors and an indirection, gone.

         MaxPoints and MaxStackCount are both 100 so EX is representable.
         Galaxy still clamps to 99, which is what keeps EX behind whatever ends
         up lifting it.

         Modification is empty on all four attributes. Fortitude is life,
         Justice is attack speed, Temperance is work speed, Prudence is SP; the
         first two have engine-side homes today and the other two do not exist
         yet, and a number invented here would be balance hidden in the last
         place anyone would look. When they land, they land here, per point, no
         script.

         Icons are all from the Void (Mod) dependency chain. Two of the
         originals were campaign-only assets, which the map cannot resolve.
         ============================================================ -->
    <!-- Fortitude IS max life, one point for one, the same way Prudence is max
         SP. Not a bonus on top of a base: the unit's own LifeMax is 1, so the
         number on the health bar is the number in the panel and there is nothing
         to add up in your head.

         That 1 is the reason employees have a minimum stat. A unit exists for an
         instant before anything can set its points, and a LifeMax of 0 in that
         instant is not survivable, so the base is the smallest number that is
         not zero and 11_employee seeds the stats on the creation event. -->
    <CBehaviorAttribute id="Lob_Attr_Fortitude">
        <EditorCategories value="AbilityorEffectType:Units"/>
        <MaxPoints value="100"/>
        <InfoIcon value="Assets\Textures\btn-upgrade-terran-infantryarmorlevel1.dds"/>
        <Modification>
            <VitalMaxArray index="Life" value="1"/>
        </Modification>
    </CBehaviorAttribute>
    <!-- Prudence is the only stat with its Modification filled in, because it is
         the only one whose target already exists: SP is the Energy vital, so a
         point of Prudence is a point of SP ceiling and nothing in Galaxy has to
         know that. One for one is a choice, but it is the choice that needs no
         curve — the number on the panel IS the number of points of mind.

         Fortitude wants VitalMaxArray Life and Justice wants attack speed; both
         are waiting on someone to decide how much, not on a mechanism. -->
    <CBehaviorAttribute id="Lob_Attr_Prudence">
        <EditorCategories value="AbilityorEffectType:Units"/>
        <MaxPoints value="100"/>
        <InfoIcon value="Assets\Textures\btn-ability-terran-battlefieldawareness.dds"/>
        <Modification>
            <VitalMaxArray index="Energy" value="1"/>
        </Modification>
    </CBehaviorAttribute>
    <CBehaviorAttribute id="Lob_Attr_Temperance">
        <EditorCategories value="AbilityorEffectType:Units"/>
        <MaxPoints value="100"/>
        <InfoIcon value="Assets\Textures\btn-ability-terran-holdfire.dds"/>
    </CBehaviorAttribute>
    <CBehaviorAttribute id="Lob_Attr_Justice">
        <EditorCategories value="AbilityorEffectType:Units"/>
        <MaxPoints value="100"/>
        <InfoIcon value="Assets\Textures\btn-upgrade-terran-infantryweaponslevel1.dds"/>
    </CBehaviorAttribute>

    <!-- Employee rank, as the unit's one veterancy.

         Rank is the sum of the four stat levels, and the hero pane's level
         display is a sum over veterancy behaviors — so with exactly one
         veterancy on the unit, the native level readout IS the rank and the
         experience bar IS the progress toward the next one. That is what the
         five rank buffs were faking, and they are gone.

         XP is fed the sum of the four stat levels (4 at minimum, 24 at all-EX)
         by src/galaxy/11_employee.galaxy, and the rows below are the design's
         thresholds written straight out:

             I (sum 4-5)    II 6    III 9    IV 12    V 16

         MinVeterancyXP is the ABSOLUTE total for that level, not the increment
         to reach it. Measured, not assumed: with the rows written as increments
         (0 6 3 3 4) an employee at 6 XP came out level V, because 6 clears 6, 3,
         3 and 4 all at once. Stock data reads either way — Dehaka has 100 on
         every row, which is the same curve under both — so the flat repeats
         there are not evidence for increments, and War3's rising 100/150/200
         series is the shape an absolute table has anyway.

         Every XPFraction is zero: rank is derived, so nothing may feed it
         except the line that recomputes it. A kill that nudged this would put
         the panel out of step with Emp_Rank, which is the number every rule
         actually reads. -->
    <CBehaviorVeterancy id="Lob_Rank">
        <EditorCategories value="AbilityorEffectType:Units"/>
        <Flags index="CombineXP" value="0"/>
        <XPFraction index="Kills" value="0"/>
        <XPFraction index="DamageDealt" value="0"/>
        <XPFraction index="DamageTaken" value="0"/>
        <VeterancyLevelArray/>
        <VeterancyLevelArray MinVeterancyXP="6"/>
        <VeterancyLevelArray MinVeterancyXP="9"/>
        <VeterancyLevelArray MinVeterancyXP="12"/>
        <VeterancyLevelArray MinVeterancyXP="16"/>
    </CBehaviorVeterancy>

    <!-- ============================================================
         Containment.
         See src/galaxy/13_containment.galaxy and docs/usr/containment.md.
         ============================================================ -->

    <!-- Contained. "在收容单元中的异想体是无敌的（不可被攻击），且不会做任何
         事情。" — all of that is one Modification, so the state and every one
         of its consequences are the same object, and the script only adds or
         removes the state.

         Removing it is the formal moment of escape. It goes back on the instant
         the thing is suppressed, so nothing keeps hitting it during the walk
         home. -->
    <CBehaviorBuff id="Lob_Contained">
        <EditorCategories value="AbilityorEffectType:Units"/>
        <BehaviorFlags index="Permanent" value="1"/>
        <Alignment value="Neutral"/>
        <InfoIcon value="Assets\Textures\btn-ability-terran-holdfire.dds"/>
        <Modification>
            <StateFlags index="Invulnerable" value="1"/>
            <StateFlags index="Uncommandable" value="1"/>
            <StateFlags index="Passive" value="1"/>
            <StateFlags index="SuppressAttack" value="1"/>
        </Modification>
    </CBehaviorBuff>

    <!-- The Qliphoth counter, as a stack count.

         A number the engine already stores, caps and draws with the count on
         the icon — the same reason employee stats are stack counts. Nothing in
         Galaxy keeps a copy.

         MaxStackCount is well above anything an abnormality should carry; the
         real per-abnormality default has nowhere to live yet, which the module
         header says at length. -->
    <CBehaviorBuff id="Lob_Qliphoth">
        <EditorCategories value="AbilityorEffectType:Units"/>
        <MaxStackCount value="20"/>
        <BehaviorFlags index="Permanent" value="1"/>
        <Alignment value="Neutral"/>
        <InfoIcon value="Assets\Textures\btn-ability-terran-battlefieldawareness.dds"/>
    </CBehaviorBuff>

    <!-- Strain on a door its occupant is trying to get through.

         "这一机制无法被修理阻拦，只能被短暂拖延" is a hard requirement, and a
         fixed damage number cannot meet it: any fixed rate can be out-repaired
         by enough SCVs. Removing life regeneration per stack can, because the
         stacks keep coming. 13_containment.galaxy adds grade+1 stacks a period,
         so an Aleph outruns a repair rate a Zayin never will, and no per-grade
         damage table has to be invented to get there.

         Cleared when the door is restored, since a restored door is a new unit.

         The 0.5 is tuning, not design. It is the one number that decides how
         long a door holds. -->
    <CBehaviorBuff id="Lob_DoorStrain">
        <EditorCategories value="AbilityorEffectType:Units"/>
        <MaxStackCount value="200"/>
        <BehaviorFlags index="Permanent" value="1"/>
        <Alignment value="Negative"/>
        <InfoIcon value="Assets\Textures\btn-ability-terran-stimpack-color.dds"/>
        <Modification>
            <VitalRegenArray index="Life" value="-0.5"/>
        </Modification>
    </CBehaviorBuff>

    <!-- Panicked: SP has run out.

         Applied at zero and removed above it by 11_employee.galaxy, so the
         state and its consequences are one object, the same arrangement as
         Lob_Contained.

         A broken employee STOPS. Which breakdown they suffer is meant to be
         chosen by their highest stat — a proud one and a careful one do not come
         apart the same way — but none of those are written yet, so there is one
         and it is the simplest thing that is visibly a breakdown and easy to
         test against. Disabling CAbilMove is the whole of it; refusing work is
         14_work's, and 11_employee issues a stop so a person who breaks mid-walk
         does not keep walking.

         The way back up is a White E.G.O round and nothing else: the same damage
         that takes an abnormality's mind apart puts an employee's back together.
         Not Black, which touches SP but is a mixed type and heals nobody. The
         rest hall's trickle is switched off below. See systems/sanity.md. -->
    <CBehaviorBuff id="Lob_Panicked">
        <EditorCategories value="AbilityorEffectType:Units"/>
        <BehaviorFlags index="Permanent" value="1"/>
        <Alignment value="Negative"/>
        <InfoIcon value="Assets\Textures\btn-ability-terran-stimpack-color.dds"/>
        <Modification>
            <AbilClassDisableArray index="CAbilMove" value="1"/>
            <!-- The rest hall must not quietly undo this. Its Energy trickle is
                 regeneration, so one flag stops it without splitting that buff
                 in two and without touching its life regen: a broken employee
                 sitting in the room still gets their wounds seen to, and still
                 does not get their mind back for free. -->
            <StateFlags index="SuppressEnergyRegen" value="1"/>
            <!-- The marker that makes "is this one broken" a question a WEAPON
                 can ask. Weapons select targets by filters only — they have no
                 validators, so a behavior is invisible to them — and of the
                 flags a buff can set, this is the one that is also true:
                 somebody who has stopped functioning has stopped fighting.
                 Their own rifle goes quiet as a consequence, which is the
                 "strike" half of baseline 8 arriving for free.
                 See systems/sanity.md for what reads it. -->
            <StateFlags index="Passive" value="1"/>
        </Modification>
    </CBehaviorBuff>

    <!-- The same state on a player character, which is a different thing.

         Baseline 8 forbids taking control away, and that rule survives intact:
         every input still works, the camera still follows, nothing is stunned.
         What goes is the E.G.O — CAbilAttack, since a player's weapon IS their
         E.G.O — plus a little speed, so being broken is felt as being unable to
         fight rather than as being unable to play.

         Deliberately NOT CAbilMove. Freezing a person holding a mouse is exactly
         the experience baseline 8 rules out; freezing an NPC is a consequence. -->
    <CBehaviorBuff id="Lob_Panicked_Hero">
        <EditorCategories value="AbilityorEffectType:Units"/>
        <BehaviorFlags index="Permanent" value="1"/>
        <Alignment value="Negative"/>
        <InfoIcon value="Assets\Textures\btn-ability-terran-stimpack-color.dds"/>
        <Modification MoveSpeedMultiplier="0.85">
            <AbilClassDisableArray index="CAbilAttack" value="1"/>
        </Modification>
    </CBehaviorBuff>

    <!-- What the work ability applies, and it is nothing.

         An Effect-Target ability needs an effect that unambiguously acts on a
         unit, or the command never becomes a targeting command. Snipe uses
         damage and Larva Swarm uses apply-behavior; this is the second shape,
         with a behavior that does nothing for half a second. -->
    <CBehaviorBuff id="Lob_Worked">
        <EditorCategories value="AbilityorEffectType:Units"/>
        <Duration value="0.5"/>
        <InfoFlags index="Hidden" value="1"/>
    </CBehaviorBuff>

    <!-- The clock behind the turret retracting. Replaces stock TurretBurrow,
         which fires the same shape at PerditionTurretBurrow by name. -->
    <CBehaviorBuff id="Lob_Turret_Fire_BurrowLoop">
        <EditorCategories value="Race:Terran,AbilityorEffectType:Structures"/>
        <InfoFlags index="Hidden" value="1"/>
        <Period value="1"/>
        <PeriodicEffect value="Lob_Turret_Fire_BurrowOrder"/>
    </CBehaviorBuff>
    <!-- A mind and a body, as far as the engine is concerned. One per damage
         type, because a behavior carries a single DamageResponse and nothing in
         stock carries two.

         Each takes its own type down to zero life so that 17_damage can work
         out what the hit really costs. ALL FOUR, including Red — which the
         engine could apply correctly — because the arithmetic has to live in
         one place to be readable. See docs/dev/damage-channel.md.

         THE SHAPE OF DamageResponse IS NOT GUESSABLE and the editor only says
         "Unable to find field", so it is written out once here.

         It is a field of the BEHAVIOR, not of Modification. Modification is the
         "what does carrying this change about you" half — speed, armour,
         DamageTakenFraction; a response is a thing that happens when you are
         hit, and it sits beside Modification rather than inside it.
         DeathResponse, confusingly, IS inside.

         Kind is an opt-OUT array, not a value. Every kind responds by default
         and you switch off the ones you do not want, which is why each of these
         lists the three it ignores rather than the one it catches.
         GuardianShield and HardenedShield are the stock models. NoProc is off
         everywhere: it is what damage with no Kind at all counts as, and our
         mapping has no meaning for it.

         ModifyFraction is a MULTIPLIER — stock uses 2 for a vulnerability and
         0.5 for a resistance — so 0 is "none of it lands", which is what
         DamageTakenNone, SpectreShield and ProtectiveBarrier all do.
         ModifyMinimumDamage rides along in every one of those, because the
         engine otherwise insists a hit takes at least a point, and one leaked
         point of life is a slow death by mercy. -->
    <CBehaviorBuff id="Lob_Mind_Red">
        <EditorCategories value="AbilityorEffectType:Units"/>
        <BehaviorFlags index="Permanent" value="1"/>
        <InfoFlags index="Hidden" value="1"/>
        <DamageResponse ModifyFraction="0" ModifyMinimumDamage="1">
            <Kind index="Ranged" value="0"/>
            <Kind index="Spell" value="0"/>
            <Kind index="Splash" value="0"/>
            <Kind index="NoProc" value="0"/>
            <Chance value="1"/>
        </DamageResponse>
    </CBehaviorBuff>
    <CBehaviorBuff id="Lob_Mind_White">
        <EditorCategories value="AbilityorEffectType:Units"/>
        <BehaviorFlags index="Permanent" value="1"/>
        <InfoFlags index="Hidden" value="1"/>
        <DamageResponse ModifyFraction="0" ModifyMinimumDamage="1">
            <Kind index="Melee" value="0"/>
            <Kind index="Spell" value="0"/>
            <Kind index="Splash" value="0"/>
            <Kind index="NoProc" value="0"/>
            <Chance value="1"/>
        </DamageResponse>
    </CBehaviorBuff>
    <CBehaviorBuff id="Lob_Mind_Black">
        <EditorCategories value="AbilityorEffectType:Units"/>
        <BehaviorFlags index="Permanent" value="1"/>
        <InfoFlags index="Hidden" value="1"/>
        <DamageResponse ModifyFraction="0" ModifyMinimumDamage="1">
            <Kind index="Melee" value="0"/>
            <Kind index="Ranged" value="0"/>
            <Kind index="Splash" value="0"/>
            <Kind index="NoProc" value="0"/>
            <Chance value="1"/>
        </DamageResponse>
    </CBehaviorBuff>
    <CBehaviorBuff id="Lob_Mind_Pale">
        <EditorCategories value="AbilityorEffectType:Units"/>
        <BehaviorFlags index="Permanent" value="1"/>
        <InfoFlags index="Hidden" value="1"/>
        <DamageResponse ModifyFraction="0" ModifyMinimumDamage="1">
            <Kind index="Melee" value="0"/>
            <Kind index="Ranged" value="0"/>
            <Kind index="Spell" value="0"/>
            <Kind index="NoProc" value="0"/>
            <Chance value="1"/>
        </DamageResponse>
    </CBehaviorBuff>
    <!-- The Crimson Dawn's four defences, straight off the wiki table:

             RED 0.8 (endured)   WHITE 1.3 (weak)
             BLACK 1.3 (weak)    PALE 2.0 (vulnerable)

         THIS IS THE POINT OF THE WHOLE Kind MAPPING. Every abnormality and every
         Ordeal has one of these tables, thirty-odd of them are coming, and this
         is what one costs: four lines, no script, and the engine applies it to
         every weapon in the game without being told.

         Pale 2.0 applies to a clown because a clown has no maximum-life
         percentage to speak of — against a monster Pale is plain damage, and
         this fraction is the only thing that makes it special. -->
    <CBehaviorBuff id="Lob_Def_Ordeal_Dawn_Crimson">
        <EditorCategories value="AbilityorEffectType:Units"/>
        <BehaviorFlags index="Permanent" value="1"/>
        <InfoFlags index="Hidden" value="1"/>
        <Modification>
        <!-- READ THE VALUES BELOW TWICE. DamageTakenFraction is ADDITIVE, not a
             multiplier: the engine computes base * (1 + value). So the wiki's
             number minus one goes here, and pasting the wiki number straight in
             gives you the OPPOSITE of what it says.

             Measured, not guessed. A 20-damage Red rifle against value="0.8"
             dealt 36, which is 20 * 1.8. Stock only uses this field twice and
             both agree: FlashBangGrenade sets 0.15 on a unit it has just
             stunned, which is fifteen percent MORE damage taken, not eighty-five
             percent less.

                 wiki 0.8 Endured     -> -0.2      wiki 1.0 Normal    -> 0
                 wiki 1.3 Weak        ->  0.3      wiki 2.0 Vulnerable-> 1.0

             This conversion is exactly the sort of thing that should happen once
             in a generator rather than thirty times by hand; see the note on
             the per-type value channel in docs/dev/damage-channel.md. -->
            <DamageTakenFraction index="Melee" value="-0.2"/>
            <DamageTakenFraction index="Ranged" value="0.3"/>
            <DamageTakenFraction index="Spell" value="0.3"/>
            <DamageTakenFraction index="Splash" value="1.0"/>
        </Modification>
    </CBehaviorBuff>
    <CBehaviorBuff id="Lob_Def_Ordeal_Dawn_Amber">
        <EditorCategories value="AbilityorEffectType:Units"/>
        <BehaviorFlags index="Permanent" value="1"/>
        <InfoFlags index="Hidden" value="1"/>
        <Modification>
            <DamageTakenFraction index="Melee" value="1.0"/>
            <DamageTakenFraction index="Splash" value="1.0"/>
        </Modification>
    </CBehaviorBuff>
</Catalog>
