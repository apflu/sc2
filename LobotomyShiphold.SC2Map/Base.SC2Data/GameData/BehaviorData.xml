    <!-- Employee rank, I to V.
         A readout, not an effect: rank is the sum of the four stat levels and
         is therefore derived, so nothing here may modify anything. Its job is
         to put the rank on the unit's buff bar and in its tooltip without a
         line of custom UI, and to give a data-side hook to anything that wants
         to key off rank later.
         Applied and removed through 07_buffs.galaxy like everything else that
         has to be able to stop, which matters here because Training Team can
         push a stat back DOWN and the rank has to follow it down. -->
    <CBehaviorBuff id="Lob_Rank_1">
        <Alignment value="Neutral"/>
        <InfoIcon value="Assets\Textures\btn-ability-terran-setrallypoint.dds"/>
    </CBehaviorBuff>
    <CBehaviorBuff id="Lob_Rank_2" parent="Lob_Rank_1"/>
    <CBehaviorBuff id="Lob_Rank_3" parent="Lob_Rank_1"/>
    <CBehaviorBuff id="Lob_Rank_4" parent="Lob_Rank_1"/>
    <CBehaviorBuff id="Lob_Rank_5" parent="Lob_Rank_1"/>
</Catalog>
