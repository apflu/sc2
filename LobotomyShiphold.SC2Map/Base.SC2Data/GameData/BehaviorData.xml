    <CBehaviorVeterancy id="Lob_Stat_Temperance">
        <EditorCategories value="AbilityorEffectType:Units"/>
        <InfoIcon value="Assets\Textures\btn-ability-terran-holdfire.dds"/>
        <Flags index="CombineXP" value="0"/>
        <XPFraction index="Kills" value="0"/>
        <XPFraction index="DamageDealt" value="0"/>
        <XPFraction index="DamageTaken" value="0"/>
        <VeterancyLevelArray/>
        <VeterancyLevelArray MinVeterancyXP="30"/>
        <VeterancyLevelArray MinVeterancyXP="15"/>
        <VeterancyLevelArray MinVeterancyXP="20"/>
        <VeterancyLevelArray MinVeterancyXP="20"/>
        <VeterancyLevelArray MinVeterancyXP="15"/>
    </CBehaviorVeterancy>
    <CBehaviorVeterancy id="Lob_Stat_Justice">
        <EditorCategories value="AbilityorEffectType:Units"/>
        <InfoIcon value="Assets\Textures\btn-ability-terran-ignorearmor.dds"/>
        <Flags index="CombineXP" value="0"/>
        <XPFraction index="Kills" value="0"/>
        <XPFraction index="DamageDealt" value="0"/>
